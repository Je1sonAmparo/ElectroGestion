@inherits LayoutComponentBase
@implements IDisposable
@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager

<Toasts class="p-3" Placement="ToastsPlacement.TopRight" />

@if (!AppState.IsAuthenticated)
{
    <ElectroGestion.Components.Pages.Login />
}
else
{
    <div style="min-height:100vh;display:flex">
        <aside class="@(SidebarCollapsed ? "is-collapsed" : "is-open")"
          style="width:@(SidebarCollapsed ? "80px" : "250px");flex:0 0 @(SidebarCollapsed ? "80px" : "250px");background:#fff;border-right:1px solid #E3E5EE;display:flex;flex-direction:column;padding:24px 0;position:sticky;top:0;height:100vh;transition:width 0.3s cubic-bezier(0.4, 0, 0.2, 1)">
          <button @onclick="ToggleSidebar" class="sidebar-toggle-btn"
            style="position:absolute;top:28px;right:-14px;width:28px;height:28px;border:1px solid #E3E5EE;background:#fff;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#6B7085;z-index:10;box-shadow:0 2px 5px rgba(0,0,0,0.05)">
            @if (SidebarCollapsed)
            {
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.3"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18l6-6-6-6" />
              </svg>
            }
            else
            {
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.3"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            }
          </button>
          
          <div style="padding:32px 0 28px;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:3px;overflow:hidden;width:100%;cursor:pointer" @onclick='() => NavManager.NavigateTo("/")'>
            @if (!SidebarCollapsed)
            {
              <div style="display:flex;align-items:center;justify-content:center;width:100%;padding-left:14px;padding-right:14px">
                <svg viewBox="10 0 74 60" width="42" height="34" style="flex:0 0 auto">
                  <defs>
                    <mask id="bolt-mask-sidebar-row">
                      <rect width="100" height="60" fill="white" />
                      <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="black" stroke="black" stroke-width="2.5"
                        stroke-linejoin="round" />
                    </mask>
                  </defs>
                  <text x="10" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#1D4ED8" letter-spacing="-1.5">E</text>
                  <text x="44" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#F59E0B" mask="url(#bolt-mask-sidebar-row)" letter-spacing="-1.5">G</text>
                  <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="#F59E0B" stroke="#F59E0B" stroke-width="0" stroke-linejoin="round" />
                </svg>
                <div style="font-family:'Manrope';font-weight:900;font-size:20px;letter-spacing:-0.5px;white-space:nowrap;line-height:1;margin-top:2px;margin-left:4px">
                  <span style="color:#1D4ED8">ELECTRO</span><span style="color:#334155">GESTIÓN</span>
                </div>
              </div>
            }
            else
            {
              <div style="display:flex;align-items:center;justify-content:center;width:100%">
                <svg viewBox="10 0 74 60" width="52" height="42">
                  <defs>
                    <mask id="bolt-mask-sidebar-col">
                      <rect width="100" height="60" fill="white" />
                      <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="black" stroke="black" stroke-width="2.5" stroke-linejoin="round" />
                    </mask>
                  </defs>
                  <text x="10" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#1D4ED8" letter-spacing="-1.5">E</text>
                  <text x="44" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#F59E0B" mask="url(#bolt-mask-sidebar-col)" letter-spacing="-1.5">G</text>
                  <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="#F59E0B" stroke="#F59E0B" stroke-width="0" stroke-linejoin="round" />
                </svg>
              </div>
            }
          </div>

          <nav style="display:flex;flex-direction:column;gap:4px;padding:0 12px;overflow:hidden">
                <NavLink class="nav-item-btn" href="/" Match="NavLinkMatch.All" style="@($"padding: 12px {(SidebarCollapsed ? "16px" : "14px")}")">
                    <div style="position:relative;display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex:0 0 24px">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" style="position:relative;z-index:1">
                            <rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                    </div>
                    @if (!SidebarCollapsed) { <span style="white-space:nowrap">Inicio</span> }
                </NavLink>

                <NavLink class="nav-item-btn" href="solicitudes" style="@($"padding: 12px {(SidebarCollapsed ? "16px" : "14px")}")">
                    <div style="position:relative;display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex:0 0 24px">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" style="position:relative;z-index:1">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    @if (!SidebarCollapsed) { <span style="white-space:nowrap">Solicitudes</span> }
                </NavLink>

                <NavLink class="nav-item-btn" href="agenda" style="@($"padding: 12px {(SidebarCollapsed ? "16px" : "14px")}")">
                    <div style="position:relative;display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex:0 0 24px">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" style="position:relative;z-index:1">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    @if (!SidebarCollapsed) { <span style="white-space:nowrap">Agenda</span> }
                </NavLink>

                <NavLink class="nav-item-btn" href="levantamientos" style="@($"padding: 12px {(SidebarCollapsed ? "16px" : "14px")}")">
                    <div style="position:relative;display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex:0 0 24px">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" style="position:relative;z-index:1">
                            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline>
                        </svg>
                    </div>
                    @if (!SidebarCollapsed) { <span style="white-space:nowrap">Levantamientos</span> }
                </NavLink>

                <NavLink class="nav-item-btn" href="ordenes" style="@($"padding: 12px {(SidebarCollapsed ? "16px" : "14px")}")">
                    <div style="position:relative;display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex:0 0 24px">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" style="position:relative;z-index:1">
                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                        </svg>
                    </div>
                    @if (!SidebarCollapsed) { <span style="white-space:nowrap">Órdenes de Trabajo</span> }
                </NavLink>

                <NavLink class="nav-item-btn" href="clientes" style="@($"padding: 12px {(SidebarCollapsed ? "16px" : "14px")}")">
                    <div style="position:relative;display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex:0 0 24px">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" style="position:relative;z-index:1">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    @if (!SidebarCollapsed) { <span style="white-space:nowrap">Clientes</span> }
                </NavLink>

                <NavLink class="nav-item-btn" href="historial" style="@($"padding: 12px {(SidebarCollapsed ? "16px" : "14px")}")">
                    <div style="position:relative;display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex:0 0 24px">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" style="position:relative;z-index:1">
                            <circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    @if (!SidebarCollapsed) { <span style="white-space:nowrap">Historial</span> }
                </NavLink>

                <NavLink class="nav-item-btn" href="reportes" style="@($"padding: 12px {(SidebarCollapsed ? "16px" : "14px")}")">
                    <div style="position:relative;display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex:0 0 24px">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" style="position:relative;z-index:1">
                            <line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line>
                        </svg>
                    </div>
                    @if (!SidebarCollapsed) { <span style="white-space:nowrap">Reportes</span> }
                </NavLink>

                <NavLink class="nav-item-btn" href="servicios" style="@($"padding: 12px {(SidebarCollapsed ? "16px" : "14px")}")">
                    <div style="position:relative;display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex:0 0 24px">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" style="position:relative;z-index:1">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                    </div>
                    @if (!SidebarCollapsed) { <span style="white-space:nowrap">Servicios</span> }
                </NavLink>

                @if (AppState.EsGerente)
                {
                    <NavLink class="nav-item-btn" href="usuarios" style="@($"padding: 12px {(SidebarCollapsed ? "16px" : "14px")}")">
                        <div style="position:relative;display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex:0 0 24px">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" style="position:relative;z-index:1">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        @if (!SidebarCollapsed) { <span style="white-space:nowrap">Usuarios</span> }
                    </NavLink>
                }
          </nav>

          <div style="margin-top:auto;border-top:1px solid #EFF0F6;padding-top:18px;width:100%">
            @if (!SidebarCollapsed)
            {
              <div style="display:flex;align-items:center;gap:11px;padding-left:26px;padding-right:20px;width:100%;box-sizing:border-box">
                <div style="width:38px;height:38px;border-radius:50%;background:#1D4ED8;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-family:'Manrope';flex:0 0 38px">
                  @(AppState.Session?.Inicial ?? "U")</div>
                <div style="min-width:0">
                  <div style="font-weight:700;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                    @(AppState.Session?.Nombre ?? "Usuario")</div>
                  <div style="font-size:12px;color:#8B90A3">@(AppState.Session?.Rol ?? "Rol")</div>
                </div>
              </div>
              <button @onclick="Logout" class="logout-btn" style="margin:12px 20px 0;width:calc(100% - 40px);padding:9px;border:1px solid #E3E5EE;background:#fff;border-radius:9px;font-size:13px;font-weight:700;color:#C4141B;cursor:pointer">Cerrar sesión</button>
            }
            else
            {
              <div style="display:flex;align-items:center;justify-content:center;width:100%">
                <div style="width:38px;height:38px;border-radius:50%;background:#1D4ED8;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-family:'Manrope';flex:0 0 38px"
                  title="@(AppState.Session?.Nombre ?? "Usuario")">@(AppState.Session?.Inicial ?? "U")</div>
              </div>
              <button @onclick="Logout" class="logout-btn" title="Cerrar sesión"
                style="margin:12px 12px 0;padding:9px;border:1px solid #E3E5EE;background:#fff;border-radius:9px;font-size:13px;font-weight:700;color:#C4141B;cursor:pointer;display:flex;align-items:center;justify-content:center">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
                  <path d="M16 17l5-5-5-5"></path>
                  <path d="M21 12H9"></path>
                </svg>
              </button>
            }
          </div>
        </aside>
        
        <div class="sidebar-backdrop" @onclick="ToggleSidebar"></div>

        <main style="flex:1;min-width:0;padding:32px 38px 60px" class="resp-main">
          @Body
        </main>
    </div>
}

@code {
    private bool SidebarCollapsed { get; set; } = false;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    private void ToggleSidebar()
    {
        SidebarCollapsed = !SidebarCollapsed;
    }

    private void Logout()
    {
        AppState.Logout();
        NavManager.NavigateTo("/");
    }
}
