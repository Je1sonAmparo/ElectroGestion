@page "/agenda"
@implements IDisposable
@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager

<PageTitle>Agenda | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div style="display:flex;align-items:flex-start;">
        <div>
            <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Agenda</div>
            <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Visitas programadas y su ubicación.</div>
        </div>
    </div>
    <button @onclick="OpenNuevaVisitaModal" style="background:#1D4ED8;color:#fff;border:none;padding:10px 18px;border-radius:8px;font-size:13.5px;font-weight:700;cursor:pointer">+ Nueva visita</button>
</div>

<div style="display:grid;grid-template-columns:1.55fr 1fr;gap:16px;align-items:start">
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:20px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:16px">
            <select value="@VistaActual" @onchange="OnVistaActualChanged" style="padding:9px 14px;border:1px solid #D5D8E6;border-radius:9px;font-weight:700;font-size:13.5px;background:#fff;color:#14162B;cursor:pointer">
                <option value="Hoy">Hoy</option>
                <option value="Semanal">Semanal</option>
                <option value="Mensual">Mensual</option>
            </select>
            <div style="color:#6B7085;font-size:13.5px">@AgendaRango</div>
        </div>

        @if (VistaActual == "Semanal")
        {
            <div>
                <div style="display:grid;grid-template-columns:56px repeat(7,1fr);border-bottom:1px solid #E3E5EE">
                    <div></div>
                    @foreach (var d in Semana)
                    {
                        <div style="text-align:center;padding:6px 0 12px;min-width:0">
                            <div style="font-size:11px;font-weight:800;color:#8B90A3;text-transform:uppercase;letter-spacing:.07em">@d.Dia</div>
                            <div style="margin:7px auto 0;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Manrope';font-weight:800;font-size:15px;background:@d.PillBg;color:@d.NumColor">@d.Num</div>
                        </div>
                    }
                </div>
                <div style="display:grid;grid-template-columns:56px repeat(7,1fr);position:relative">
                    <div>
                        @foreach (var h in HorasSem)
                        {
                            <div style="height:45px;font-size:11px;font-weight:700;color:#8B90A3;text-align:right;padding-right:9px;transform:translateY(-6px)">@h</div>
                        }
                    </div>
                    @foreach (var d in Semana)
                    {
                        <div style="position:relative;border-left:1px solid #EFF0F6;background:@d.ColBg;min-width:0">
                            @foreach (var h in HorasSem)
                            {
                                <div style="height:45px;border-bottom:1px solid #F4F5FB"></div>
                            }
                            @foreach (var ev in d.Eventos)
                            {
                                <div @onclick="() => SelectEvent(ev)" style="position:absolute;left:3px;right:3px;top:@(ev.Top)px;height:@(ev.H)px;background:@ev.Bg;border-left:3px solid @ev.Line;border-radius:6px;padding:4px 5px;cursor:pointer;overflow:hidden;min-width:0">
                                    <div style="font-size:10px;font-weight:800;color:#4A4E63;line-height:1.2">@ev.Hora</div>
                                    <div style="font-size:10.5px;font-weight:700;line-height:1.22;margin-top:1px;overflow-wrap:anywhere">@ev.Cliente</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (VistaActual == "Mensual")
        {
            <div>
                <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:6px">
                    @foreach (var ds in DiasSemana)
                    {
                        <div style="text-align:center;font-size:11px;font-weight:800;color:#8B90A3;text-transform:uppercase;letter-spacing:.06em;padding:4px 0">@ds</div>
                    }
                </div>
                <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:6px">
                    @foreach (var d in Mes)
                    {
                        <div style="background:@d.Bg;border:1px solid @d.Border;border-radius:9px;min-height:92px;min-width:0;padding:7px 8px;display:flex;flex-direction:column;gap:4px">
                            <div style="font-size:12.5px;font-weight:800;color:@d.NumColor">@d.Num</div>
                            @foreach (var ev in d.Eventos)
                            {
                                <div @onclick="() => SelectEvent(ev)" style="background:@ev.Bg;border-left:3px solid @ev.Line;border-radius:5px;padding:3px 5px;cursor:pointer;font-size:10.5px;font-weight:700;white-space:nowrap;min-width:0;overflow:hidden;text-overflow:ellipsis">@ev.Corto</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (VistaActual == "Hoy")
        {
            <div style="position:relative">
                @foreach (var h in HorasSem)
                {
                    <div style="display:flex;gap:12px;height:64px;border-top:1px solid #F0F1F7">
                        <div style="width:66px;flex:0 0 66px;font-size:12px;color:#8B90A3;font-weight:700;padding-top:4px">@h</div>
                    </div>
                }
                @foreach (var ev in DiariaEventos)
                {
                    <div @onclick="() => SelectEvent(ev)" style="position:absolute;left:78px;right:6px;top:@(ev.Top)px;height:@(ev.H)px;background:@ev.Bg;border-left:4px solid @ev.Line;border-radius:9px;padding:11px 13px;cursor:pointer;overflow:hidden">
                        <div style="font-weight:700;font-size:14px">@ev.Cliente</div>
                        <div style="font-size:12.5px;color:#4A4E63;margin-top:3px">@ev.TipoServicio</div>
                        <div style="font-size:12px;color:#6B7085;margin-top:2px">@ev.Rango</div>
                    </div>
                }
            </div>
        }
    </div>

    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:20px">
        @if (Detalle != null)
        {
            <div>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
                    <div style="font-family:'Manrope';font-weight:800;font-size:18px">Detalle</div>
                    <button class="clear-btn" @onclick="ClearDetalle" style="width:28px;height:28px;border:1px solid #E3E5EE;background:#fff;border-radius:7px;cursor:pointer;color:#6B7085">✕</button>
                </div>
                <div style="display:flex;flex-direction:column;gap:15px;font-size:14.5px">
                    <div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Cliente</div>
                        <div style="font-weight:700;margin-top:3px">@Detalle.Cliente</div>
                    </div>
                    <div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Tipo de servicio</div>
                        <div style="margin-top:3px">@Detalle.TipoServicio</div>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px" class="resp-grid-2">
                        <div>
                            <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Fecha</div>
                            <div style="margin-top:3px">@Detalle.Fecha</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Hora</div>
                            <div style="margin-top:3px">@Detalle.Hora</div>
                        </div>
                    </div>
                    <div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Dirección</div>
                        <div style="margin-top:3px">@Detalle.Direccion</div>
                    </div>
                    <div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Estado</div>
                        <div style="margin-top:5px">
                            <span style="display:inline-block;padding:5px 11px;border-radius:20px;font-size:12px;font-weight:800;background:@Detalle.Bg;color:@Detalle.Fg">@Detalle.Estado</span>
                        </div>
                    </div>
                </div>
                <div style="display:flex;flex-direction:column;gap:9px;margin-top:22px">
                    <button class="action-btn" style="padding:11px;border:1px solid #D5D8E6;background:#fff;border-radius:9px;font-size:13.5px;font-weight:700;cursor:pointer">Ver ubicación</button>
                    <button class="action-btn" @onclick="OpenEditarVisitaModal" style="padding:11px;border:1px solid #D5D8E6;background:#fff;border-radius:9px;font-size:13.5px;font-weight:700;cursor:pointer">Editar visita</button>
                    @if (Detalle.Estado == "Cancelada")
                    {
                        <button class="reactivate-btn" @onclick="OpenReactivarModal" style="padding:11px;border:1px solid #4E9A63;background:#fff;border-radius:9px;font-size:13.5px;font-weight:700;cursor:pointer;color:#17803D">Reactivar visita</button>
                    }
                    else
                    {
                        <button class="cancel-btn" @onclick="OpenCancelarModal" style="padding:11px;border:1px solid #F5C2C4;background:#fff;border-radius:9px;font-size:13.5px;font-weight:700;cursor:pointer;color:#C4141B">Cancelar visita</button>
                    }
                </div>
            </div>
        }
        else
        {
            <div style="color:#8B90A3;font-size:14px;text-align:center;padding:40px 10px">Selecciona una visita del calendario para ver su detalle.</div>
        }
    </div>
</div>

@if (showNuevaVisita)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9999">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:540px;padding:24px;box-shadow:0 10px 25px rgba(0,0,0,0.1)">
            <h2 style="margin:0 0 4px;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">Nueva visita</h2>
            <p style="margin:0 0 20px;color:#6B7085;font-size:14px">Asigna fecha y hora para la visita.</p>

            <div style="display:flex;flex-direction:column;gap:16px">
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Solicitud *</label>
                    <select style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                        <option>Seleccionar solicitud pendiente...</option>
                        <option>#101 - Instalación de Paneles Solares - Juan Pérez</option>
                        <option>#104 - Mantenimiento Eléctrico - María Gómez</option>
                    </select>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Fecha *</label>
                        <input type="date" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Hora *</label>
                        <input type="time" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                </div>
                <div style="background:#F4F5FB;padding:12px 14px;border-radius:8px;font-size:13px;color:#6B7085;margin-top:4px">
                    El estado de la cita se llena automáticamente con el estado de la solicitud.
                </div>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:24px">
                <button @onclick="CloseModals" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cancelar</button>
                <button @onclick="CloseModals" style="padding:10px 18px;border:none;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;cursor:pointer">Guardar visita</button>
            </div>
        </div>
    </div>
}

@if (showEditarVisita)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9999">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:540px;padding:24px;box-shadow:0 10px 25px rgba(0,0,0,0.1)">
            <h2 style="margin:0 0 4px;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">Editar visita</h2>
            <p style="margin:0 0 20px;color:#6B7085;font-size:14px">Modifica los detalles de la visita seleccionada.</p>

            <div style="display:flex;flex-direction:column;gap:16px">
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Cliente *</label>
                    <select style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                        <option>@Detalle?.Cliente</option>
                    </select>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Tipo de servicio *</label>
                        <select style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                            <option>@Detalle?.TipoServicio</option>
                        </select>
                    </div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Dirección *</label>
                        <input type="text" value="@Detalle?.Direccion" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Fecha *</label>
                        <input type="date" value="2026-08-03" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Hora *</label>
                        <input type="time" value="09:00" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                </div>
                <div style="background:#F4F5FB;padding:12px 14px;border-radius:8px;font-size:13px;color:#6B7085;margin-top:4px">
                    El estado de la cita se llena automáticamente con el estado de la solicitud.
                </div>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:24px">
                <button @onclick="CloseModals" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cancelar</button>
                <button @onclick="CloseModals" style="padding:10px 18px;border:none;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;cursor:pointer">Guardar cambios</button>
            </div>
        </div>
    </div>
}

@if (showCancelar)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9999">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:400px;padding:24px;box-shadow:0 10px 25px rgba(0,0,0,0.1)">
            <h2 style="margin:0 0 12px;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">Cancelar visita</h2>
            <p style="margin:0 0 24px;color:#4A4E63;font-size:14.5px;line-height:1.4">
                ¿Confirmas cancelar la visita de <strong>@Detalle?.Cliente</strong>?<br/>
                El estado del servicio pasará a Cancelada.
            </p>

            <div style="display:flex;justify-content:flex-end;gap:12px">
                <button @onclick="CloseModals" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cancelar</button>
                <button @onclick="ConfirmarCancelar" style="padding:10px 18px;border:none;background:#C4141B;color:#fff;border-radius:8px;font-weight:700;cursor:pointer">Sí, cancelar</button>
            </div>
        </div>
    </div>
}

@if (showReactivar)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9999">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:400px;padding:24px;box-shadow:0 10px 25px rgba(0,0,0,0.1)">
            <h2 style="margin:0 0 12px;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">Reactivar visita</h2>
            <p style="margin:0 0 24px;color:#4A4E63;font-size:14.5px;line-height:1.4">
                ¿Confirmas reactivar la visita de <strong>@Detalle?.Cliente</strong>?<br/>
                El estado del servicio pasará a En proceso.
            </p>

            <div style="display:flex;justify-content:flex-end;gap:12px">
                <button @onclick="CloseModals" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cancelar</button>
                <button @onclick="ConfirmarReactivar" style="padding:10px 18px;border:none;background:#17803D;color:#fff;border-radius:8px;font-weight:700;cursor:pointer">Sí, reactivar</button>
            </div>
        </div>
    </div>
}
@code {
    private string VistaActual = "Hoy";
    private string AgendaRango = "";

    private bool showNuevaVisita = false;
    private bool showEditarVisita = false;
    private bool showCancelar = false;
    private bool showReactivar = false;

    private List<string> DiasSemana = new() { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" };
    private List<string> HorasSem = new() { "08 AM", "09 AM", "10 AM", "11 AM", "12 PM", "01 PM", "02 PM", "03 PM", "04 PM", "05 PM", "06 PM" };

    public class Evento
    {
        public int Id { get; set; }
        public int Top { get; set; }
        public int H { get; set; }
        public string Bg { get; set; } = "";
        public string Line { get; set; } = "";
        public string Hora { get; set; } = "";
        public string Cliente { get; set; } = "";
        public string TipoServicio { get; set; } = "";
        public string Direccion { get; set; } = "";
        public string Estado { get; set; } = "";
        public string Fg { get; set; } = "";
        public string Fecha { get; set; } = "";
        public string Rango { get; set; } = "";
        public string Corto { get; set; } = "";
    }

    public class DiaSemana
    {
        public string Dia { get; set; } = "";
        public string Num { get; set; } = "";
        public string PillBg { get; set; } = "transparent";
        public string NumColor { get; set; } = "#4A4E63";
        public string ColBg { get; set; } = "transparent";
        public List<Evento> Eventos { get; set; } = new();
    }

    public class DiaMes
    {
        public string Num { get; set; } = "";
        public string NumColor { get; set; } = "#4A4E63";
        public string Bg { get; set; } = "#fff";
        public string Border { get; set; } = "#E3E5EE";
        public List<Evento> Eventos { get; set; } = new();
    }

    private List<DiaSemana> Semana = new();
    private List<DiaMes> Mes = new();
    private List<Evento> DiariaEventos = new();
    private Evento? Detalle;

    protected override void OnInitialized()
    {
        AppState.OnChange += OnStateChanged;
        UpdateData();
        
        if (VistaActual == "Hoy")
        {
            Detalle = DiariaEventos.FirstOrDefault();
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void OnVistaActualChanged(ChangeEventArgs e)
    {
        VistaActual = e.Value?.ToString() ?? "Semanal";
        UpdateData();
    }

    private void UpdateData()
    {
        var hoyD = DateTime.Today;
        var hoyStr = hoyD.ToString("yyyy-MM-dd");

        var MES = new[] { "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre" };

        var visibles = AppState.Solicitudes.Where(x => !string.IsNullOrEmpty(x.Fecha) && !string.IsNullOrEmpty(x.Hora)).ToList();

        var lunes = hoyD.AddDays(-((int)hoyD.DayOfWeek == 0 ? 6 : (int)hoyD.DayOfWeek - 1));
        var finSem = lunes.AddDays(6);

        if (VistaActual == "Semanal")
        {
            AgendaRango = $"{lunes.Day} - {finSem.Day} de {MES[finSem.Month - 1]} {finSem.Year}";
        }
        else if (VistaActual == "Mensual")
        {
            AgendaRango = char.ToUpper(MES[hoyD.Month - 1][0]) + MES[hoyD.Month - 1].Substring(1) + " " + hoyD.Year;
        }
        else
        {
            AgendaRango = AppStateService.FormatFechaLarga(hoyStr);
        }

        Semana.Clear();
        for (int i = 0; i < 7; i++)
        {
            var d = lunes.AddDays(i);
            var f = d.ToString("yyyy-MM-dd");
            var esHoy = f == hoyStr;

            var evs = visibles.Where(x => x.Fecha == f).OrderBy(x => x.Hora).Select(x => {
                var hm = x.Hora.Split(':');
                var hh = int.Parse(hm[0]);
                var mm = int.Parse(hm[1]);
                var cancel = x.Estado == "Cancelada";
                var fin = x.Estado == "Finalizada";
                var colors = AppStateService.GetBadgeColors(x.Estado);
                return new Evento {
                    Id = x.Id,
                    Top = Math.Max(0, (int)((hh - 8) * 45 + (mm / 60.0) * 45 + 1)),
                    H = 58,
                    Bg = cancel ? "#FDE9EA" : (fin ? "#E4F6EA" : "#EAF3EC"),
                    Line = cancel ? "#E11B22" : (fin ? "#17803D" : "#4E9A63"),
                    Hora = AppStateService.FormatHora12(x.Hora),
                    Cliente = x.Cliente,
                    TipoServicio = x.TipoServicio,
                    Direccion = x.Direccion,
                    Estado = x.Estado,
                    Fg = colors.Fg,
                    Fecha = AppStateService.FormatFechaLarga(x.Fecha),
                    Rango = AppStateService.FormatHora12(x.Hora) + " - " + AppStateService.FormatHora12(AppStateService.AddMinutes(x.Hora, 150))
                };
            }).ToList();

            Semana.Add(new DiaSemana {
                Dia = DiasSemana[i],
                Num = d.Day.ToString(),
                ColBg = esHoy ? "#FBFBFF" : "transparent",
                PillBg = esHoy ? "#EDEBFF" : "transparent",
                NumColor = esHoy ? "#1D4ED8" : "#4A4E63",
                Eventos = evs
            });
        }

        var prim = new DateTime(hoyD.Year, hoyD.Month, 1);
        var ini = prim.AddDays(-((int)prim.DayOfWeek == 0 ? 6 : (int)prim.DayOfWeek - 1));
        
        Mes.Clear();
        for (int i = 0; i < 42; i++)
        {
            var d = ini.AddDays(i);
            var f = d.ToString("yyyy-MM-dd");
            var esHoy = f == hoyStr;
            var otro = d.Month != hoyD.Month;

            var evs = visibles.Where(x => x.Fecha == f).OrderBy(x => x.Hora).Select(x => {
                var cancel = x.Estado == "Cancelada";
                var fin = x.Estado == "Finalizada";
                var colors = AppStateService.GetBadgeColors(x.Estado);
                var horaFmt = AppStateService.FormatHora12(x.Hora);
                return new Evento {
                    Id = x.Id,
                    Bg = cancel ? "#FDE9EA" : (fin ? "#E4F6EA" : "#EAF3EC"),
                    Line = cancel ? "#E11B22" : (fin ? "#17803D" : "#4E9A63"),
                    Hora = horaFmt,
                    Cliente = x.Cliente,
                    TipoServicio = x.TipoServicio,
                    Direccion = x.Direccion,
                    Estado = x.Estado,
                    Fg = colors.Fg,
                    Fecha = AppStateService.FormatFechaLarga(x.Fecha),
                    Rango = horaFmt + " - " + AppStateService.FormatHora12(AppStateService.AddMinutes(x.Hora, 150)),
                    Corto = (horaFmt.Length > 5 ? horaFmt.Substring(0, 5) : horaFmt) + " " + x.Cliente
                };
            }).ToList();

            Mes.Add(new DiaMes {
                Num = d.Day.ToString(),
                Bg = esHoy ? "#F5F4FF" : (otro ? "#FAFAFC" : "#fff"),
                Border = esHoy ? "#C9C3F5" : "#EFF0F6",
                NumColor = esHoy ? "#1D4ED8" : (otro ? "#C0C4D2" : "#14162B"),
                Eventos = evs
            });
        }

        DiariaEventos = visibles.Where(x => x.Fecha == hoyStr).Select(x => {
            var hm = x.Hora.Split(':');
            var hh = int.Parse(hm[0]);
            var mm = int.Parse(hm[1]);
            var cancel = x.Estado == "Cancelada";
            var fin = x.Estado == "Finalizada";
            var colors = AppStateService.GetBadgeColors(x.Estado);
            return new Evento {
                Id = x.Id,
                Top = Math.Max(0, (int)((hh - 8) * 64 + (mm / 60.0) * 64 + 2)),
                H = (int)(150 / 60.0 * 64 - 6),
                Bg = cancel ? "#FDE9EA" : (fin ? "#E4F6EA" : "#EAF3EC"),
                Line = cancel ? "#E11B22" : (fin ? "#17803D" : "#4E9A63"),
                Hora = AppStateService.FormatHora12(x.Hora),
                Cliente = x.Cliente,
                TipoServicio = x.TipoServicio,
                Direccion = x.Direccion,
                Estado = x.Estado,
                Fg = colors.Fg,
                Fecha = AppStateService.FormatFechaLarga(x.Fecha),
                Rango = AppStateService.FormatHora12(x.Hora) + " - " + AppStateService.FormatHora12(AppStateService.AddMinutes(x.Hora, 150))
            };
        }).ToList();
    }

    private void SelectEvent(Evento ev)
    {
        Detalle = ev;
    }

    private void ClearDetalle()
    {
        Detalle = null;
    }

    private void OpenNuevaVisitaModal() => showNuevaVisita = true;
    private void OpenEditarVisitaModal() => showEditarVisita = true;
    private void OpenCancelarModal() => showCancelar = true;
    private void OpenReactivarModal() => showReactivar = true;

    private void CloseModals()
    {
        showNuevaVisita = false;
        showEditarVisita = false;
        showCancelar = false;
        showReactivar = false;
    }

    private void ConfirmarCancelar()
    {
        if (Detalle != null)
        {
            // Solo para prototipo estático
            Detalle.Estado = "Cancelada";
            Detalle.Bg = "#FDE9EA";
            Detalle.Fg = "#E11B22";
            Detalle.Line = "#E11B22";
        }
        CloseModals();
    }

    private void ConfirmarReactivar()
    {
        if (Detalle != null)
        {
            // Solo para prototipo estático
            Detalle.Estado = "En proceso";
            Detalle.Bg = "#EAF3EC";
            Detalle.Fg = "#4E9A63";
            Detalle.Line = "#4E9A63";
        }
        CloseModals();
    }
}
