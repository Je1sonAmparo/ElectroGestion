@page "/clientes"
@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager

<PageTitle>Clientes | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div style="display:flex;align-items:flex-start;">
        <div>
            <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Directorio de Clientes</div>
            <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Gestiona la información de tus clientes.</div>
        </div>
    </div>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;overflow:hidden">
    <div style="padding:18px;border-bottom:1px solid #EFF0F6">
        <input @bind="SearchTerm" @bind:event="oninput" placeholder="Buscar cliente por nombre..."
            style="width:100%;max-width:420px;padding:11px 14px;border:1px solid #D5D8E6;border-radius:9px;font-size:14px" />
    </div>

    <div style="display:grid;grid-template-columns:1.3fr 1fr 1.6fr .8fr 110px;padding:14px 18px;font-size:12px;font-weight:800;color:#8B90A3;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #EFF0F6"
        class="resp-table-row">
        <div>Cliente</div>
        <div>Teléfono</div>
        <div>Dirección</div>
        <div>Servicios</div>
        <div style="text-align:right">Acciones</div>
    </div>

    @if (!FilteredClientes.Any())
    {
        <div style="padding:38px;text-align:center;color:#8B90A3;font-size:14px">
            No se encontraron clientes.
        </div>
    }
    else
    {
        @foreach (var c in FilteredClientes)
        {
            // Simulate number of services for this mock view
            var numServicios = AppState.Solicitudes.Count(s => s.Cliente == c.Nombre);

            <div style="display:grid;grid-template-columns:1.3fr 1fr 1.6fr .8fr 110px;padding:16px 18px;border-bottom:1px solid #F4F5FB;align-items:center;font-size:14px"
                class="resp-table-row">
                <div style="font-weight:700">@c.Nombre</div>
                <div style="color:#6B7085">@c.Telefono</div>
                <div style="color:#6B7085">@c.Direccion</div>
                <div style="font-weight:700">@numServicios</div>
                <div style="display:flex;gap:8px;justify-content:flex-end">
                    <button class="view-btn" title="Ver detalle"
                        style="width:32px;height:32px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer;color:#4A4E63">◉</button>
                    <button class="edit-btn" title="Editar"
                        style="width:32px;height:32px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer;color:#4A4E63">✎</button>
                </div>
            </div>
        }
    }
</div>

@code {
    private string SearchTerm = "";

    private List<ElectroGestion.Models.Cliente> FilteredClientes => AppState.Clientes
        .Where(c => string.IsNullOrEmpty(SearchTerm) || c.Nombre.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderBy(c => c.Nombre)
        .ToList();
}
