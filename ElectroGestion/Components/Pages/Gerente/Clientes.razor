@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager
@inject ToastService ToastService

<PageTitle>Clientes (Gestión Comercial) | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Directorio de Clientes</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Gestión de cartera, datos fiscales, contactos comerciales e historial de servicios.</div>
    </div>
    <button @onclick="NuevoCliente" style="padding:12px 18px;background:#1D4ED8;color:#fff;border:0;border-radius:10px;font-weight:700;font-size:14.5px;cursor:pointer;font-family:'Manrope';white-space:nowrap">
        + Nuevo Cliente
    </button>
</div>

@* Resumen métrico de clientes *@
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px" class="resp-grid-3">
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;padding:16px 20px">
        <div style="font-size:12.5px;color:#6B7085;font-weight:700">Total Clientes Activos</div>
        <div style="font-family:'Manrope';font-weight:800;font-size:30px;color:#1D4ED8;margin-top:4px">@AppState.Clientes.Count</div>
    </div>
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;padding:16px 20px">
        <div style="font-size:12.5px;color:#6B7085;font-weight:700">Empresas con RNC</div>
        <div style="font-family:'Manrope';font-weight:800;font-size:30px;color:#F59E0B;margin-top:4px">@AppState.Clientes.Count(c => !string.IsNullOrEmpty(c.Rnc))</div>
    </div>
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;padding:16px 20px">
        <div style="font-size:12.5px;color:#6B7085;font-weight:700">Servicios Realizados</div>
        <div style="font-family:'Manrope';font-weight:800;font-size:30px;color:#10B981;margin-top:4px">@AppState.Clientes.Sum(c => c.Servicios)</div>
    </div>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;overflow:hidden">
    <div style="padding:18px;border-bottom:1px solid #EFF0F6">
        <input @bind="SearchTerm" @bind:event="oninput" placeholder="Buscar cliente por nombre, RNC, correo o teléfono..."
            style="width:100%;max-width:440px;padding:11px 14px;border:1px solid #D5D8E6;border-radius:9px;font-size:14px" />
    </div>

    <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:14px">
            <thead>
                <tr style="border-bottom:1px solid #EFF0F6;background:#FAFAFC;color:#6B7085;font-family:'Manrope';font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:0.5px">
                    <th style="padding:14px 20px;text-align:left">Cliente</th>
                    <th style="padding:14px 20px;text-align:left">RNC / Cédula</th>
                    <th style="padding:14px 20px;text-align:left">Contacto</th>
                    <th style="padding:14px 20px;text-align:left">Dirección</th>
                    <th style="padding:14px 20px;text-align:center">Servicios</th>
                    <th style="padding:14px 20px;text-align:right">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredClientes.Any())
                {
                    <tr>
                        <td colspan="6" style="padding:32px;text-align:center;color:#6B7085">
                            No se encontraron clientes con el criterio de búsqueda.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in FilteredClientes)
                    {
                        <tr style="border-bottom:1px solid #EFF0F6">
                            <td style="padding:16px 20px">
                                <div style="font-weight:700;color:#14162B">@c.Nombre</div>
                                <div style="font-size:12.5px;color:#6B7085">@c.Correo</div>
                            </td>
                            <td style="padding:16px 20px;font-family:ui-monospace,monospace;color:#4A4E63">
                                @(string.IsNullOrEmpty(c.Rnc) ? "—" : c.Rnc)
                            </td>
                            <td style="padding:16px 20px;color:#4A4E63">
                                <div>@c.Telefono</div>
                                @if (!string.IsNullOrEmpty(c.Telefono2))
                                {
                                    <div style="font-size:12px;color:#8B90A3">@c.Telefono2</div>
                                }
                            </td>
                            <td style="padding:16px 20px;color:#6B7085;max-width:260px">
                                @c.Direccion
                            </td>
                            <td style="padding:16px 20px;text-align:center">
                                <span style="font-weight:800;color:#1D4ED8;background:#EDEBFF;padding:4px 10px;border-radius:12px;font-size:13px">
                                    @c.Servicios
                                </span>
                            </td>
                            <td style="padding:16px 20px;text-align:right">
                                <button @onclick="() => Editar(c.Id)" style="padding:6px 12px;background:#fff;border:1px solid #D5D8E6;border-radius:6px;font-weight:700;font-size:13px;cursor:pointer;color:#1D4ED8">
                                    Editar
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* Modal para Registrar o Editar Cliente *@
@if (IsModalOpen)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:520px;padding:30px;box-shadow:0 20px 40px rgba(0,0,0,0.2);animation:tin 0.2s ease-out">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
                <div style="font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">@ModalTitle</div>
                <button @onclick="() => IsModalOpen = false" style="background:none;border:0;font-size:22px;color:#A1A5B7;cursor:pointer">&times;</button>
            </div>

            <div style="display:flex;flex-direction:column;gap:14px">
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;margin-bottom:5px">Nombre o Razón Social *</label>
                    <input @bind="FormNombre" placeholder="ej. Inversiones Dominicana SRL" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" />
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;margin-bottom:5px">RNC / Cédula</label>
                        <input @bind="FormRnc" placeholder="ej. 101-98765-2" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" />
                    </div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;margin-bottom:5px">Correo Electrónico</label>
                        <input @bind="FormCorreo" placeholder="contacto@empresa.com" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" />
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;margin-bottom:5px">Teléfono Principal *</label>
                        <input @bind="FormTelefono" placeholder="809-555-0101" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" />
                    </div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;margin-bottom:5px">Teléfono Secundario</label>
                        <input @bind="FormTelefono2" placeholder="829-555-0102" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" />
                    </div>
                </div>
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;margin-bottom:5px">Dirección Completa *</label>
                    <input @bind="FormDireccion" placeholder="ej. Av. 27 de Febrero #45, Santiago" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" />
                </div>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:24px">
                <button @onclick="() => IsModalOpen = false" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;color:#4A4E63">
                    Cancelar
                </button>
                <button @onclick="GuardarCliente" style="padding:10px 22px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">
                    Guardar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchTerm = "";
    private bool IsModalOpen = false;
    private string ModalTitle = "";
    private int? EditId = null;

    private string FormNombre = "";
    private string FormRnc = "";
    private string FormCorreo = "";
    private string FormTelefono = "";
    private string FormTelefono2 = "";
    private string FormDireccion = "";

    private List<ElectroGestion.Models.Cliente> FilteredClientes => AppState.Clientes
        .Where(c => string.IsNullOrEmpty(SearchTerm) ||
                    c.Nombre.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    c.Correo.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    c.Telefono.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(c.Rnc) && c.Rnc.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(c => c.Nombre)
        .ToList();

    private void NuevoCliente()
    {
        EditId = null;
        ModalTitle = "Nuevo Cliente";
        FormNombre = "";
        FormRnc = "";
        FormCorreo = "";
        FormTelefono = "";
        FormTelefono2 = "";
        FormDireccion = "";
        IsModalOpen = true;
    }

    private void Editar(int id)
    {
        var c = AppState.Clientes.FirstOrDefault(x => x.Id == id);
        if (c != null)
        {
            EditId = c.Id;
            ModalTitle = "Editar Cliente";
            FormNombre = c.Nombre;
            FormRnc = c.Rnc;
            FormCorreo = c.Correo;
            FormTelefono = c.Telefono;
            FormTelefono2 = c.Telefono2;
            FormDireccion = c.Direccion;
            IsModalOpen = true;
        }
    }

    private void GuardarCliente()
    {
        if (string.IsNullOrWhiteSpace(FormNombre) || string.IsNullOrWhiteSpace(FormTelefono) || string.IsNullOrWhiteSpace(FormDireccion))
        {
            ToastService.ShowWarning("Por favor complete los campos obligatorios.", "Atención");
            return;
        }

        if (EditId.HasValue)
        {
            var c = AppState.Clientes.FirstOrDefault(x => x.Id == EditId.Value);
            if (c != null)
            {
                c.Nombre = FormNombre;
                c.Rnc = FormRnc;
                c.Correo = FormCorreo;
                c.Telefono = FormTelefono;
                c.Telefono2 = FormTelefono2;
                c.Direccion = FormDireccion;
                ToastService.ShowSuccess("Cliente actualizado exitosamente.");
            }
        }
        else
        {
            var newId = AppState.Clientes.Any() ? AppState.Clientes.Max(x => x.Id) + 1 : 1;
            AppState.Clientes.Add(new ElectroGestion.Models.Cliente
            {
                Id = newId,
                Nombre = FormNombre,
                Rnc = FormRnc,
                Correo = FormCorreo,
                Telefono = FormTelefono,
                Telefono2 = FormTelefono2,
                Direccion = FormDireccion,
                Servicios = 0
            });
            ToastService.ShowSuccess("Cliente registrado exitosamente.", "Éxito");
        }

        IsModalOpen = false;
    }
}
