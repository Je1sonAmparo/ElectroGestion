@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager

<PageTitle>Panel Gerencial | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">
            ¡Bienvenida, @(AppState.Session?.Nombre.Split(' ')[0] ?? "Gerente")!
        </div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Panel ejecutivo y supervisión general de servicios eléctricos.</div>
    </div>
    <div style="display:flex;align-items:center;gap:10px">
        <span style="background:#EDEBFF;color:#1D4ED8;padding:6px 12px;border-radius:20px;font-size:13px;font-weight:700">
            Rol: Gerente General
        </span>
    </div>
</div>

@* 4 Métricas Ejecutivas del Gerente *@
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px" class="resp-grid-4">
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:18px 20px">
        <div style="font-size:13px;color:#6B7085;font-weight:700;line-height:1.35">Total Solicitudes</div>
        <div style="font-family:'Manrope';font-weight:800;font-size:38px;margin:10px 0 12px;color:#1D4ED8">@TotalSolicitudes</div>
        <div style="display:flex;gap:8px;font-size:12px;color:#6B7085">
            <span style="color:#B45309;font-weight:700">@Pendientes pendientes</span> · 
            <span style="color:#10B981;font-weight:700">@Finalizadas listas</span>
        </div>
        <button @onclick='() => NavManager.NavigateTo("/solicitudes")' class="link-btn" style="background:none;border:0;color:#1D4ED8;font-weight:700;font-size:13px;cursor:pointer;padding:0;margin-top:10px">Gestionar solicitudes &rarr;</button>
    </div>
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:18px 20px">
        <div style="font-size:13px;color:#6B7085;font-weight:700;line-height:1.35">Órdenes de Trabajo Activas</div>
        <div style="font-family:'Manrope';font-weight:800;font-size:38px;margin:10px 0 12px;color:#1D4ED8">@OrdenesActivas</div>
        <div style="font-size:12px;color:#6B7085">En ejecución en terreno</div>
        <button @onclick='() => NavManager.NavigateTo("/ordenes")' class="link-btn" style="background:none;border:0;color:#1D4ED8;font-weight:700;font-size:13px;cursor:pointer;padding:0;margin-top:10px">Supervisar órdenes &rarr;</button>
    </div>
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:18px 20px">
        <div style="font-size:13px;color:#6B7085;font-weight:700;line-height:1.35">Cartera de Clientes</div>
        <div style="font-family:'Manrope';font-weight:800;font-size:38px;margin:10px 0 12px;color:#1D4ED8">@TotalClientes</div>
        <div style="font-size:12px;color:#6B7085">Empresas y Residenciales</div>
        <button @onclick='() => NavManager.NavigateTo("/clientes")' class="link-btn" style="background:none;border:0;color:#1D4ED8;font-weight:700;font-size:13px;cursor:pointer;padding:0;margin-top:10px">Ver directorio &rarr;</button>
    </div>
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:18px 20px">
        <div style="font-size:13px;color:#6B7085;font-weight:700;line-height:1.35">Servicios en Catálogo</div>
        <div style="font-family:'Manrope';font-weight:800;font-size:38px;margin:10px 0 12px;color:#1D4ED8">@TotalServicios</div>
        <div style="font-size:12px;color:#6B7085">Servicios eléctricos activos</div>
        <button @onclick='() => NavManager.NavigateTo("/servicios")' class="link-btn" style="background:none;border:0;color:#1D4ED8;font-weight:700;font-size:13px;cursor:pointer;padding:0;margin-top:10px">Catálogo de precios &rarr;</button>
    </div>
</div>

@* Bloque Operativo Central: Resumen de Estado de Solicitudes y Accesos Administrativos *@
<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:16px;margin-top:16px" class="resp-grid-2">
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:22px">
        <div style="font-family:'Manrope';font-weight:800;font-size:17px;margin-bottom:16px">Distribución Operativa de Solicitudes</div>
        <div style="display:flex;flex-direction:column;gap:16px">
            <div>
                <div style="display:flex;justify-content:space-between;font-size:13.5px;font-weight:700;margin-bottom:6px">
                    <span style="color:#B45309">Pendientes de Asignación / Visita</span>
                    <span>@Pendientes (@((Pendientes * 100) / (TotalSolicitudes > 0 ? TotalSolicitudes : 1))%)</span>
                </div>
                <div style="width:100%;height:10px;background:#EFF0F6;border-radius:5px;overflow:hidden">
                    <div style="width:@((Pendientes * 100) / (TotalSolicitudes > 0 ? TotalSolicitudes : 1))%;height:100%;background:#F59E0B"></div>
                </div>
            </div>
            <div>
                <div style="display:flex;justify-content:space-between;font-size:13.5px;font-weight:700;margin-bottom:6px">
                    <span style="color:#1D4ED8">En Proceso / Levantamiento</span>
                    <span>@EnProceso (@((EnProceso * 100) / (TotalSolicitudes > 0 ? TotalSolicitudes : 1))%)</span>
                </div>
                <div style="width:100%;height:10px;background:#EFF0F6;border-radius:5px;overflow:hidden">
                    <div style="width:@((EnProceso * 100) / (TotalSolicitudes > 0 ? TotalSolicitudes : 1))%;height:100%;background:#1D4ED8"></div>
                </div>
            </div>
            <div>
                <div style="display:flex;justify-content:space-between;font-size:13.5px;font-weight:700;margin-bottom:6px">
                    <span style="color:#10B981">Finalizadas Exitosamente</span>
                    <span>@Finalizadas (@((Finalizadas * 100) / (TotalSolicitudes > 0 ? TotalSolicitudes : 1))%)</span>
                </div>
                <div style="width:100%;height:10px;background:#EFF0F6;border-radius:5px;overflow:hidden">
                    <div style="width:@((Finalizadas * 100) / (TotalSolicitudes > 0 ? TotalSolicitudes : 1))%;height:100%;background:#10B981"></div>
                </div>
            </div>
        </div>

        <div style="margin-top:24px;padding-top:18px;border-top:1px solid #EFF0F6;display:flex;gap:20px;align-items:center">
            <div style="width:42px;height:42px;border-radius:10px;background:#EDEBFF;display:flex;align-items:center;justify-content:center;color:#1D4ED8;font-size:20px">
                📊
            </div>
            <div>
                <div style="font-weight:800;font-size:14.5px">Reportes e Indicadores de Consumo</div>
                <div style="color:#6B7085;font-size:13px">Consulta el análisis de consumo de materiales por técnico y servicios del último año.</div>
            </div>
            <button @onclick='() => NavManager.NavigateTo("/reportes")' style="margin-left:auto;padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:9px;font-weight:700;font-size:13px;cursor:pointer;white-space:nowrap">
                Ver reporte
            </button>
        </div>
    </div>

    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:22px;display:flex;flex-direction:column;justify-content:space-between">
        <div>
            <div style="font-family:'Manrope';font-weight:800;font-size:17px;margin-bottom:14px">Herramientas de Administración</div>
            <div style="display:flex;flex-direction:column;gap:10px">
                <button @onclick='() => NavManager.NavigateTo("/solicitudes")' style="display:flex;align-items:center;gap:12px;padding:12px;border:1px solid #E3E5EE;border-radius:10px;background:#FAFAFC;cursor:pointer;text-align:left;transition:all 0.2s">
                    <div style="width:36px;height:36px;border-radius:8px;background:#EDEBFF;display:flex;align-items:center;justify-content:center;color:#1D4ED8;font-weight:800">📋</div>
                    <div>
                        <div style="font-weight:700;font-size:14px;color:#14162B">Registrar Solicitud</div>
                        <div style="font-size:12px;color:#6B7085">Crear nueva solicitud de cliente</div>
                    </div>
                </button>
                <button @onclick='() => NavManager.NavigateTo("/cotizaciones")' style="display:flex;align-items:center;gap:12px;padding:12px;border:1px solid #E3E5EE;border-radius:10px;background:#FAFAFC;cursor:pointer;text-align:left;transition:all 0.2s">
                    <div style="width:36px;height:36px;border-radius:8px;background:#FEF3C7;display:flex;align-items:center;justify-content:center;color:#D97706;font-weight:800">📄</div>
                    <div>
                        <div style="font-weight:700;font-size:14px;color:#14162B">Cotizaciones de Clientes</div>
                        <div style="font-size:12px;color:#6B7085">Emitir y gestionar presupuestos</div>
                    </div>
                </button>
                <button @onclick='() => NavManager.NavigateTo("/inventario")' style="display:flex;align-items:center;gap:12px;padding:12px;border:1px solid #E3E5EE;border-radius:10px;background:#FAFAFC;cursor:pointer;text-align:left;transition:all 0.2s">
                    <div style="width:36px;height:36px;border-radius:8px;background:#DCFCE7;display:flex;align-items:center;justify-content:center;color:#16A34A;font-weight:800">📦</div>
                    <div>
                        <div style="font-weight:700;font-size:14px;color:#14162B">Inventario y Proveedores</div>
                        <div style="font-size:12px;color:#6B7085">Existencias y órdenes de compra</div>
                    </div>
                </button>
                <button @onclick='() => NavManager.NavigateTo("/usuarios")' style="display:flex;align-items:center;gap:12px;padding:12px;border:1px solid #E3E5EE;border-radius:10px;background:#FAFAFC;cursor:pointer;text-align:left;transition:all 0.2s">
                    <div style="width:36px;height:36px;border-radius:8px;background:#E0E7FF;display:flex;align-items:center;justify-content:center;color:#4F46E5;font-weight:800">👥</div>
                    <div>
                        <div style="font-weight:700;font-size:14px;color:#14162B">Control de Usuarios</div>
                        <div style="font-size:12px;color:#6B7085">Administrar personal y roles</div>
                    </div>
                </button>
            </div>
        </div>
    </div>
</div>

@* Tabla de Últimas Solicitudes Recibidas *@
<div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:22px;margin-top:16px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
        <div style="font-family:'Manrope';font-weight:800;font-size:17px">Últimas solicitudes recibidas en el sistema</div>
        <button @onclick='() => NavManager.NavigateTo("/solicitudes")' style="background:none;border:0;color:#1D4ED8;font-weight:700;font-size:13px;cursor:pointer">Ver todas las solicitudes &rarr;</button>
    </div>
    <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:13.5px">
            <thead>
                <tr style="border-bottom:2px solid #EFF0F6;text-align:left;color:#6B7085">
                    <th style="padding:10px 14px">ID</th>
                    <th style="padding:10px 14px">Cliente</th>
                    <th style="padding:10px 14px">Tipo de Servicio</th>
                    <th style="padding:10px 14px">Fecha Solicitud</th>
                    <th style="padding:10px 14px">Estado</th>
                    <th style="padding:10px 14px;text-align:right">Gestión</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in AppState.Solicitudes.Take(5))
                {
                    <tr style="border-bottom:1px solid #EFF0F6">
                        <td style="padding:12px 14px;font-weight:800;color:#1D4ED8">#@s.Id.ToString("D4")</td>
                        <td style="padding:12px 14px;font-weight:700">@s.Cliente</td>
                        <td style="padding:12px 14px;color:#4A4E63">@s.TipoServicio</td>
                        <td style="padding:12px 14px;color:#6B7085">@AppStateService.FormatFecha(s.FechaSolicitud)</td>
                        <td style="padding:12px 14px">
                            <span style="display:inline-block;padding:4px 10px;border-radius:6px;font-size:12px;font-weight:700;background:@(s.Estado == "Pendiente" ? "#FEF3C7" : s.Estado == "En proceso" ? "#EDEBFF" : "#DCFCE7");color:@(s.Estado == "Pendiente" ? "#B45309" : s.Estado == "En proceso" ? "#1D4ED8" : "#16A34A")">
                                @s.Estado
                            </span>
                        </td>
                        <td style="padding:12px 14px;text-align:right">
                            <button @onclick='() => NavManager.NavigateTo("/solicitudes")' style="padding:6px 12px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;font-size:12.5px;font-weight:700;cursor:pointer;color:#1D4ED8">
                                Ver y Asignar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div style="font-family:'Manrope';font-weight:800;font-size:18px;margin:28px 0 14px">Accesos rápidos</div>
<div style="display:grid;grid-template-columns:repeat(5,1fr);gap:14px" class="resp-grid-5">
    @foreach (var q in AccesosGerente)
    {
        <button class="acceso-rapido-btn" @onclick='() => NavManager.NavigateTo(q.Href)'
            style="background:#fff;border:1px solid #E3E5EE;border-radius:13px;padding:20px 14px;cursor:pointer;text-align:center;font-size:13.5px;font-weight:700;color:#14162B;transition:all 0.2s"
            onmouseover="this.style.borderColor='#1D4ED8';this.style.color='#1D4ED8'"
            onmouseout="this.style.borderColor='#E3E5EE';this.style.color='#14162B'">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="display:block;margin:0 auto 12px">
                <path class="path-d1" d="@q.D1" stroke="#1D4ED8"></path>
                <path class="path-d2" d="@q.D2" stroke="#F59E0B"></path>
            </svg>
            @q.Label
        </button>
    }
</div>

@code {
    public record AccesoRapido(string Label, string Href, string D1, string D2);

    private List<AccesoRapido> AccesosGerente = new()
    {
        new("Nueva Solicitud", "/solicitudes", "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6", "M12 18v-6 M9 15h6"),
        new("Cotizar", "/cotizaciones", "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z", "M12 18v-6 M9 15h6"),
        new("Asignar", "/ordenes", "M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z", "M12 11v6 M9 14h6"),
        new("Nuevo Cliente", "/clientes", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M7.5 7a4 4 0 1 1 8 0 4 4 0 0 1-8 0", "M19 13v6 M16 16h6"),
        new("Cobrar", "/cobros", "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18", "M12 7v10 M8.5 13.5h7")
    };

    private int TotalSolicitudes => AppState.Solicitudes.Count;
    private int Pendientes => AppState.Solicitudes.Count(s => s.Estado == "Pendiente");
    private int EnProceso => AppState.Solicitudes.Count(s => s.Estado == "En proceso");
    private int Finalizadas => AppState.Solicitudes.Count(s => s.Estado == "Finalizada");
    private int OrdenesActivas => AppState.Ordenes.Count(o => o.Estado == "En proceso");
    private int TotalClientes => AppState.Clientes.Count;
    private int TotalServicios => AppState.Servicios.Count;
}
