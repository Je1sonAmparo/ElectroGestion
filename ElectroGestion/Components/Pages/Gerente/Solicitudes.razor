@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager
@inject ToastService ToastService

<PageTitle>Solicitudes (Administración) | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Solicitudes</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Gestión, programación y asignación de solicitudes de servicio de clientes.</div>
    </div>
    <button class="primary-btn" @onclick="NuevaSolicitud"
        style="padding:12px 18px;background:#1D4ED8;color:#fff;border:0;border-radius:10px;font-weight:700;font-size:14.5px;cursor:pointer;font-family:'Manrope';white-space:nowrap">
        + Nueva Solicitud
    </button>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;overflow:hidden">
    <div style="display:flex;flex-direction:column;gap:18px;padding:22px;border-bottom:1px solid #EFF0F6">
        <div style="display:flex;align-items:center;gap:40px" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" @bind:event="oninput" placeholder="ID de solicitud"
                    style="width:140px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Cliente:</span>
                <input @bind="SearchCliente" @bind:event="oninput" placeholder="Nombre del cliente"
                    style="width:200px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Tipo de Servicio:</span>
                <select @bind="SearchTipo" style="width:190px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="">Seleccione Servicio</option>
                    @foreach (var t in TiposServicio)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:40px" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Fecha Solicitud:</span>
                <input type="date" @bind="SearchFecha"
                    style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Estado:</span>
                <select @bind="SearchEstado" style="width:170px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="Todos los estados">Todos los estados</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="En proceso">En proceso</option>
                    <option value="Finalizada">Finalizada</option>
                    <option value="Cancelada">Cancelada</option>
                </select>
            </div>
            <div style="width:190px;display:flex;justify-content:flex-end;margin-left:auto">
                <button class="primary-btn" @onclick="Filtrar"
                    style="padding:9px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">
                    Buscar
                </button>
            </div>
        </div>
    </div>

    <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:14px">
            <thead>
                <tr style="border-bottom:1px solid #EFF0F6;background:#FAFAFC;color:#6B7085;font-family:'Manrope';font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:0.5px">
                    <th style="padding:14px 20px;text-align:left">ID</th>
                    <th style="padding:14px 20px;text-align:left">Cliente</th>
                    <th style="padding:14px 20px;text-align:left">Tipo de Servicio</th>
                    <th style="padding:14px 20px;text-align:left">Fecha Solicitud</th>
                    <th style="padding:14px 20px;text-align:left">Visita Programada</th>
                    <th style="padding:14px 20px;text-align:left">Estado</th>
                    <th style="padding:14px 20px;text-align:right">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredSolicitudes.Count == 0)
                {
                    <tr>
                        <td colspan="7" style="padding:32px;text-align:center;color:#6B7085">
                            No se encontraron solicitudes con los filtros indicados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in FilteredSolicitudes)
                    {
                        <tr style="border-bottom:1px solid #EFF0F6;transition:background 0.15s">
                            <td style="padding:16px 20px">
                                <div style="font-family:ui-monospace,monospace;color:#6B7085">@s.Id.ToString("D4")</div>
                            </td>
                            <td style="padding:16px 20px;font-weight:700;color:#14162B">
                                @s.Cliente
                            </td>
                            <td style="padding:16px 20px;color:#4A4E63">
                                @s.TipoServicio
                            </td>
                            <td style="padding:16px 20px;color:#6B7085">
                                @AppStateService.FormatFecha(s.FechaSolicitud)
                            </td>
                            <td style="padding:16px 20px;color:#4A4E63">
                                @if (!string.IsNullOrEmpty(s.Fecha))
                                {
                                    <span>@AppStateService.FormatFecha(s.Fecha) @(string.IsNullOrEmpty(s.Hora) ? "" : "· " + AppStateService.FormatHora12(s.Hora))</span>
                                }
                                else
                                {
                                    <span style="color:#A1A5B7">Sin programar</span>
                                }
                            </td>
                            <td style="padding:16px 20px">
                                <span style="display:inline-block;padding:5px 12px;border-radius:20px;font-size:12.5px;font-weight:700;background:@(s.Estado == "Pendiente" ? "#FEF3C7" : s.Estado == "En proceso" ? "#EDEBFF" : s.Estado == "Finalizada" ? "#DCFCE7" : "#FEE2E2");color:@(s.Estado == "Pendiente" ? "#B45309" : s.Estado == "En proceso" ? "#1D4ED8" : s.Estado == "Finalizada" ? "#16A34A" : "#DC2626")">
                                    @s.Estado
                                </span>
                            </td>
                            <td style="padding:16px 20px;text-align:right">
                                <div style="display:flex;gap:8px;justify-content:flex-end">
                                    <button @onclick="() => VerDetalle(s.Id)" title="Ver detalle" style="width:32px;height:32px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer;color:#4A4E63;font-size:13px;display:flex;align-items:center;justify-content:center" onmouseover="this.style.borderColor='#1D4ED8';this.style.color='#1D4ED8'" onmouseout="this.style.borderColor='#D5D8E6';this.style.color='#4A4E63'">◉</button>
                                    <button @onclick="() => Editar(s.Id)" title="Editar" style="width:32px;height:32px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer;color:#4A4E63;font-size:13px;display:flex;align-items:center;justify-content:center" onmouseover="this.style.borderColor='#1D4ED8';this.style.color='#1D4ED8'" onmouseout="this.style.borderColor='#D5D8E6';this.style.color='#4A4E63'">✎</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* Modal Detalle de la Solicitud *@
@if (IsDetalleModalOpen && SelectedSolicitud != null)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:620px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,0.2);animation:tin 0.2s ease-out">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
                <div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:22px;letter-spacing:-.4px;color:#0E1028">Detalle de la solicitud</div>
                    <div style="font-size:14px;color:#6B7085;margin-top:2px">Solicitud @SelectedSolicitud.Id.ToString("D4")</div>
                </div>
                <button @onclick="CerrarDetalle" style="background:none;border:1px solid #E3E5EE;border-radius:8px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#8B90A3" onmouseover="this.style.background='#F7F8FC'" onmouseout="this.style.background='none'">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px" class="resp-grid-2">
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px">
                    <div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Cliente</div>
                    <div style="font-size:14.5px;margin-top:4px;font-weight:700;color:#0E1028">@SelectedSolicitud.Cliente</div>
                </div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px">
                    <div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Contacto</div>
                    <div style="font-size:14.5px;margin-top:4px;font-weight:700;color:#0E1028">@SelectedSolicitud.Contacto</div>
                </div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px">
                    <div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Tipo de servicio</div>
                    <div style="font-size:14.5px;margin-top:4px;font-weight:700;color:#0E1028">@SelectedSolicitud.TipoServicio</div>
                </div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px">
                    <div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Dirección</div>
                    <div style="font-size:14.5px;margin-top:4px;font-weight:700;color:#0E1028">@SelectedSolicitud.Direccion</div>
                </div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px">
                    <div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Fecha de solicitud</div>
                    <div style="font-size:14.5px;margin-top:4px;font-weight:700;color:#0E1028">@AppStateService.FormatFecha(SelectedSolicitud.FechaSolicitud)</div>
                </div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px">
                    <div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Fecha del levantamiento</div>
                    <div style="font-size:14.5px;margin-top:4px;font-weight:700;color:#0E1028">@AppStateService.FormatFecha(SelectedSolicitud.Fecha)</div>
                </div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px">
                    <div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Hora</div>
                    <div style="font-size:14.5px;margin-top:4px;font-weight:700;color:#0E1028">@AppStateService.FormatHora12(SelectedSolicitud.Hora)</div>
                </div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px">
                    <div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Estado</div>
                    <div style="font-size:14.5px;margin-top:4px;font-weight:700;color:#0E1028">@SelectedSolicitud.Estado</div>
                </div>
            </div>
            <div style="margin-top:24px;display:flex;justify-content:flex-end;border-top:1px solid #EFF0F6;padding-top:20px">
                <button @onclick="CerrarDetalle" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;font-size:14px;color:#4A4E63">Cerrar</button>
            </div>
        </div>
    </div>
}

@* Modal de Formulario de Solicitud *@
@if (IsFormModalOpen)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:540px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,0.2);animation:tin 0.2s ease-out">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
                <div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B">@ModalTitle</div>
                    <div style="color:#6B7085;font-size:13.5px;margin-top:4px">@ModalSub</div>
                </div>
                <button @onclick="CloseModal" style="background:none;border:0;font-size:22px;color:#A1A5B7;cursor:pointer">&times;</button>
            </div>

            <div style="display:flex;flex-direction:column;gap:16px">
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Cliente *</label>
                    <select @bind="FormCliente" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;background:#fff">
                        <option value="">Seleccione un cliente registrado</option>
                        @foreach (var c in AppState.Clientes)
                        {
                            <option value="@c.Nombre">@c.Nombre</option>
                        }
                    </select>
                </div>

                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Tipo de Servicio *</label>
                    <select @bind="FormTipo" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;background:#fff">
                        <option value="">Seleccione el tipo de servicio</option>
                        @foreach (var t in TiposServicio)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>

                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Dirección del Servicio *</label>
                    <input @bind="FormDireccion" placeholder="ej. Calle Principal #12, Santiago" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" />
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Fecha de Visita</label>
                        <input type="date" @bind="FormFecha" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" />
                    </div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Hora de Visita</label>
                        <input type="time" @bind="FormHora" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" />
                    </div>
                </div>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:28px">
                <button @onclick="CloseModal" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;color:#4A4E63">
                    Cancelar
                </button>
                <button @onclick="SaveModal" style="padding:10px 24px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">
                    Guardar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchId { get; set; } = "";
    private string SearchCliente { get; set; } = "";
    private string SearchTipo { get; set; } = "";
    private DateTime? SearchFecha { get; set; } = null;
    private string SearchEstado { get; set; } = "Todos los estados";

    private List<ElectroGestion.Models.Solicitud> FilteredSolicitudes = new();

    private bool IsFormModalOpen = false;
    private string ModalTitle = "";
    private string ModalSub = "";
    private int? FormId;
    private string FormCliente = "";
    private string FormTipo = "";
    private string FormDireccion = "";
    private DateTime? FormFecha;
    private TimeOnly? FormHora;
    private List<string> TiposServicio = new() {
        "Instalación Solar", "Instalación de Sistema UPS", "Mantenimiento Eléctrico",
        "Instalación de Planta Eléctrica", "Cableado Estructurado"
    };

    protected override void OnInitialized()
    {
        Filtrar();
    }

    private void Filtrar()
    {
        var q = AppState.Solicitudes.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchId))
        {
            q = q.Where(x => x.Id.ToString("D4").Contains(SearchId, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(SearchCliente))
        {
            q = q.Where(x => x.Cliente.Contains(SearchCliente, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(SearchTipo))
        {
            q = q.Where(x => x.TipoServicio == SearchTipo);
        }

        if (SearchFecha.HasValue)
        {
            var dateStr = SearchFecha.Value.ToString("yyyy-MM-dd");
            q = q.Where(x => x.FechaSolicitud.StartsWith(dateStr));
        }

        if (SearchEstado != "Todos los estados")
        {
            q = q.Where(x => x.Estado == SearchEstado);
        }

        FilteredSolicitudes = q.OrderByDescending(x => x.Id).ToList();
    }

    private void NuevaSolicitud()
    {
        IsFormModalOpen = true;
        ModalTitle = "Nueva Solicitud";
        ModalSub = "Complete los datos para registrar una nueva solicitud de servicio.";
        FormCliente = "";
        FormTipo = "";
        FormDireccion = "";
        FormFecha = null;
        FormHora = null;
        FormId = null;
    }

    private void Editar(int id)
    {
        var s = AppState.Solicitudes.FirstOrDefault(x => x.Id == id);
        if (s != null)
        {
            IsFormModalOpen = true;
            ModalTitle = "Editar Solicitud";
            ModalSub = "Modifique los datos de la solicitud.";
            FormCliente = s.Cliente;
            FormTipo = s.TipoServicio;
            FormDireccion = s.Direccion;
            FormFecha = string.IsNullOrEmpty(s.Fecha) ? null : DateTime.Parse(s.Fecha);
            FormHora = string.IsNullOrEmpty(s.Hora) ? null : TimeOnly.Parse(s.Hora);
            FormId = s.Id;
        }
    }

    private bool IsDetalleModalOpen = false;
    private ElectroGestion.Models.Solicitud? SelectedSolicitud = null;

    private void VerDetalle(int id)
    {
        SelectedSolicitud = AppState.Solicitudes.FirstOrDefault(s => s.Id == id);
        if (SelectedSolicitud != null)
        {
            IsDetalleModalOpen = true;
        }
    }

    private void CerrarDetalle()
    {
        IsDetalleModalOpen = false;
        SelectedSolicitud = null;
    }

    private void CloseModal()
    {
        IsFormModalOpen = false;
    }

    private void SaveModal()
    {
        if (string.IsNullOrWhiteSpace(FormCliente) || string.IsNullOrWhiteSpace(FormTipo) || string.IsNullOrWhiteSpace(FormDireccion))
        {
            ToastService.ShowWarning("Por favor complete los campos requeridos.", "Atención");
            return;
        }

        if (FormId.HasValue)
        {
            var s = AppState.Solicitudes.FirstOrDefault(x => x.Id == FormId.Value);
            if (s != null)
            {
                s.Cliente = FormCliente;
                s.TipoServicio = FormTipo;
                s.Direccion = FormDireccion;
                s.Fecha = FormFecha?.ToString("yyyy-MM-dd") ?? "";
                s.Hora = FormHora?.ToString("HH:mm") ?? "";
                ToastService.ShowSuccess("Solicitud actualizada correctamente.");
            }
        }
        else
        {
            var newId = AppState.Solicitudes.Any() ? AppState.Solicitudes.Max(x => x.Id) + 1 : 1;
            AppState.Solicitudes.Add(new ElectroGestion.Models.Solicitud
            {
                Id = newId,
                Cliente = FormCliente,
                TipoServicio = FormTipo,
                Direccion = FormDireccion,
                FechaSolicitud = DateTime.Today.ToString("yyyy-MM-dd"),
                Fecha = FormFecha?.ToString("yyyy-MM-dd") ?? "",
                Hora = FormHora?.ToString("HH:mm") ?? "",
                Estado = "Pendiente"
            });
            ToastService.ShowSuccess("Solicitud registrada correctamente.");
        }

        CloseModal();
        Filtrar();
    }
}
