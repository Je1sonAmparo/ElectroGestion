@page "/login"
@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager
@inject BlazorBootstrap.ToastService ToastService

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#F4F5FB;padding:20px;background-image:radial-gradient(circle at top right, rgba(29,78,216,0.05), transparent 40%), radial-gradient(circle at bottom left, rgba(245,158,11,0.05), transparent 40%)">
  <div style="width:100%;max-width:440px;background:#fff;border-radius:24px;box-shadow:0 24px 48px rgba(20,22,43,0.04), 0 2px 8px rgba(20,22,43,0.02);padding:48px 44px">
    
    <div style="display:flex;align-items:center;justify-content:center;margin-bottom:36px">
      <div style="width:56px;height:56px;background:linear-gradient(135deg, #1D4ED8, #3B82F6);border-radius:14px;display:flex;align-items:center;justify-content:center;box-shadow:0 12px 24px rgba(29,78,216,0.25)">
        <span style="font-family:'Manrope';font-weight:900;color:#fff;font-size:24px;letter-spacing:-1px">EG</span>
      </div>
    </div>
    
    <div style="text-align:center;margin-bottom:44px">
      <h1 style="font-family:'Manrope';font-weight:800;font-size:32px;color:#14162B;margin:0 0 10px;letter-spacing:-1px">Electro<span style="color:#1D4ED8">Gestión</span></h1>
      <p style="color:#6B7085;font-size:16px;margin:0;font-weight:400">Selecciona tu perfil demo para ingresar</p>
    </div>

    <div style="display:flex;flex-direction:column;gap:16px">
      <button @onclick="LoginTecnico" style="width:100%;background:#F8FAFC;border:2px solid #E2E8F0;color:#1E293B;padding:18px 24px;border-radius:16px;font-family:'Manrope';font-weight:700;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;transition:all 0.2s">
        <div style="display:flex;align-items:center;gap:14px">
          <div style="width:40px;height:40px;background:#E0E7FF;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#4F46E5">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div style="text-align:left">
            <div style="color:#0F172A;font-size:16px;margin-bottom:2px">Perfil Técnico</div>
            <div style="color:#64748B;font-size:13px;font-weight:500">Operador en campo</div>
          </div>
        </div>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#94A3B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <button @onclick="LoginGerente" style="width:100%;background:#F8FAFC;border:2px solid #E2E8F0;color:#1E293B;padding:18px 24px;border-radius:16px;font-family:'Manrope';font-weight:700;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;transition:all 0.2s">
        <div style="display:flex;align-items:center;gap:14px">
          <div style="width:40px;height:40px;background:#FEF3C7;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#D97706">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
          </div>
          <div style="text-align:left">
            <div style="color:#0F172A;font-size:16px;margin-bottom:2px">Perfil Gerente</div>
            <div style="color:#64748B;font-size:13px;font-weight:500">Administrador del sistema</div>
          </div>
        </div>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#94A3B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>

  </div>
</div>

@code {
    private void LoginTecnico()
    {
        var u = AppState.Usuarios.First(x => x.Rol == "Técnico");
        AppState.Login(u);
        ToastService.Notify(new ToastMessage(ToastType.Success, $"Bienvenido, {u.Nombre.Split(' ')[0]}."));
        NavManager.NavigateTo("/");
    }

    private void LoginGerente()
    {
        var u = AppState.Usuarios.First(x => x.Rol == "Gerente");
        AppState.Login(u);
        ToastService.Notify(new ToastMessage(ToastType.Success, $"Bienvenido, {u.Nombre.Split(' ')[0]}."));
        NavManager.NavigateTo("/");
    }
}
