@page "/login"
@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager
@inject BlazorBootstrap.ToastService ToastService

<div class="eg-login-page">
    <div class="eg-login-card">
        <div class="eg-login-logo">EG</div>
        <div class="eg-login-title">ElectroGestion</div>
        <div class="eg-login-sub">Accede a tu cuenta para continuar</div>

        <input @bind="Username" placeholder="Usuario" class="eg-login-input" />
        
        <div style="position:relative;display:flex;align-items:center;">
            <input type="@(ShowPassword ? "text" : "password")" @bind="Password" placeholder="Contraseña" class="eg-login-input" style="margin-bottom:0; padding-right:44px;" />
            <button @onclick="TogglePassword" title="Mostrar contraseña" style="position:absolute;right:5px;width:32px;height:32px;border:0;background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;border-radius:8px;">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#6B7085" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    @if (ShowPassword)
                    {
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>
                    }
                    else
                    {
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>
                    }
                </svg>
            </button>
        </div>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="eg-login-error">@Error</div>
        }

        <button class="eg-login-btn" style="margin-top:20px;" @onclick="HandleLogin">Ingresar</button>

        <div class="eg-login-divider">O ingresa como demo</div>

        <div class="eg-login-demo-btns">
            <button class="eg-login-demo-btn" @onclick="LoginTecnico">Técnico</button>
            <button class="eg-login-demo-btn" @onclick="LoginGerente">Gerente</button>
        </div>
    </div>
</div>

@code {
    private string Username { get; set; } = "";
    private string Password { get; set; } = "";
    private string Error { get; set; } = "";
    private bool ShowPassword { get; set; } = false;

    private void TogglePassword() => ShowPassword = !ShowPassword;

    private void HandleLogin()
    {
        Error = "";
        var u = AppState.Usuarios.FirstOrDefault(x => x.UsuarioLogin == Username && x.Password == Password);
        if (u != null)
        {
            AppState.Login(u);
            ToastService.Notify(new ToastMessage(ToastType.Success, $"Bienvenido, {u.Nombre.Split(' ')[0]}."));
            NavManager.NavigateTo("/");
        }
        else
        {
            Error = "Usuario o contraseña incorrectos.";
        }
    }

    private void LoginTecnico()
    {
        var u = AppState.Usuarios.First(x => x.Rol == "Técnico");
        AppState.Login(u);
        ToastService.Notify(new ToastMessage(ToastType.Success, $"Bienvenido, {u.Nombre.Split(' ')[0]}."));
        NavManager.NavigateTo("/");
    }

    private void LoginGerente()
    {
        var u = AppState.Usuarios.First(x => x.Rol == "Gerente");
        AppState.Login(u);
        ToastService.Notify(new ToastMessage(ToastType.Success, $"Bienvenido, {u.Nombre.Split(' ')[0]}."));
        NavManager.NavigateTo("/");
    }
}
