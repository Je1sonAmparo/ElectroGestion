}

.home-quick-card svg {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
}

.home-quick-card:hover,
.home-quick-card:focus-visible {
    border-color: #1D4ED8;
    background: #F8FAFF;
    color: #1D4ED8;
}

@media (max-width: 900px) {
    .home-metrics {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 760px) {
    .home-heading h1 {
        font-size: 22px;
    }

    .home-operations {
        grid-template-columns: 1fr;
    }

    .home-quick-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 420px) {
    .home-metrics,
    .home-quick-grid {
        grid-template-columns: 1fr;
    }

    .home-visit-content {
        grid-template-columns: 1fr;
    }

    .home-map {
        min-height: 140px;
    }
}
