}
.toast-container .toast .btn-close { display: none !important; }
.toast-container .toast .bi { display: none !important; }
.toast-container .toast .d-flex { gap: 0 !important; align-items: center; }
.toast-container .toast-body { padding: 13px 17px !important; display: flex !important; width: 100%; }

