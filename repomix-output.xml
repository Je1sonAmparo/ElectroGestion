<file path="Components/Pages/Tecnico/Ordenes.razor">
@implements IDisposable
@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager
@inject ToastService ToastService

<PageTitle>Órdenes de Trabajo (Campo) | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Órdenes de Trabajo</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Documentos técnicos asignados por Administración para ejecución en terreno.</div>
    </div>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;overflow:hidden;margin-bottom:16px">
    <div style="display:flex;flex-direction:column;gap:18px;padding:18px 18px 12px;border-bottom:1px solid #EFF0F6">
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" @bind:event="oninput" placeholder="ID de orden"
                    style="width:140px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Cliente:</span>
                <input @bind="SearchCliente" @bind:event="oninput" placeholder="Nombre del cliente"
                    style="width:200px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Tipo de Servicio:</span>
                <input @bind="SearchTipo" @bind:event="oninput" placeholder="Tipo de servicio"
                    style="width:190px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Fecha:</span>
                <input type="date" @bind="SearchFecha"
                    style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Estado:</span>
                <select @bind="SearchEstado" style="width:170px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="Todas">Todas</option>
                    <option value="En proceso">En proceso</option>
                    <option value="Finalizada">Finalizada</option>
                </select>
            </div>
            <div style="width:190px;display:flex;justify-content:flex-end;margin-left:auto">
                <button class="primary-btn" @onclick="Filtrar"
                    style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Buscar</button>
            </div>
        </div>
    </div>
</div>

<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px" class="resp-grid-2">
    @foreach (var o in FilteredOrdenes)
    {
        var s = AppState.Solicitudes.FirstOrDefault(x => x.Id == o.SolicitudId);
        var cliente = s?.Cliente?.Nombre ?? "Cliente";
        var servicioNombre = s?.Servicio?.Nombre ?? "Servicio Eléctrico";
        var colors = AppStateService.GetBadgeColors(o.Estado);

        <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:22px;display:flex;flex-direction:column">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
                <div>
                    <div style="font-family:ui-monospace,monospace;font-size:12px;color:#8B90A3;font-weight:700">ORDEN @(string.IsNullOrEmpty(o.Code) ? o.Id.ToString("D4") : o.Code)</div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:19px;margin-top:4px">@cliente</div>
                    <div style="color:#6B7085;font-size:14px;margin-top:2px">@servicioNombre</div>
                </div>
                <span style="display:inline-block;padding:5px 11px;border-radius:20px;font-size:12px;font-weight:800;background:@colors.Bg;color:@colors.Fg;white-space:nowrap">
                    @o.Estado
                </span>
            </div>
            
            <div style="margin-top:18px;font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">
                Tareas a realizar (Checklist Técnico)
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;margin-top:10px">
                @if (o.Trabajos != null)
                {
                    @for (int i = 0; i < o.Trabajos.Count; i++)
                    {
                        <div style="display:flex;gap:10px;align-items:flex-start;font-size:14px">
                            <span style="flex:0 0 22px;height:22px;border-radius:6px;background:#EDEBFF;color:#1D4ED8;font-weight:800;font-size:12px;display:flex;align-items:center;justify-content:center">
                                @(i + 1)
                            </span>
                            <span>@o.Trabajos[i]</span>
                        </div>
                    }
                }
            </div>

            <div style="margin-top:18px;font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">
                Materiales y herramientas asignadas
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
                @if (o.Materiales != null)
                {
                    @foreach (var m in o.Materiales)
                    {
                        <span style="padding:5px 11px;border:1px solid #E3E5EE;border-radius:20px;font-size:12.5px;background:#F7F8FC;color:#14162B">@m</span>
                    }
                }
            </div>

            @if (!string.IsNullOrEmpty(o.Observaciones))
            {
                <div style="margin-top:18px;font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">
                    Instrucciones de campo
                </div>
                <div style="font-size:14px;margin-top:7px;color:#4A4E63;line-height:1.55;background:#FAFAFC;padding:10px 14px;border-radius:8px;border:1px solid #EFF0F6">
                    @o.Observaciones
                </div>
            }

            <div style="margin-top:auto;padding-top:20px">
                @if (o.Estado != "Finalizada")
                {
                    <button @onclick="() => FinalizarOrden(o.Id)"
                        style="width:100%;padding:12px;border:0;background:#1D4ED8;color:#fff;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';transition:all 0.2s">
                        Completar Trabajo en Campo &check;
                    </button>
                }
                else
                {
                    <div style="text-align:center;color:#10B981;font-weight:700;font-size:13.5px;padding:8px">
                        &check; Orden Finalizada
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (!FilteredOrdenes.Any())
{
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:40px;text-align:center;color:#8B90A3;font-size:14px">
        No hay órdenes de trabajo asignadas con el filtro seleccionado.
    </div>
}

@code {
    private string SearchId = "";
    private string SearchCliente = "";
    private string SearchTipo = "";
    private DateTime? SearchFecha = null;
    private string SearchEstado = "Todas";

    private void Filtrar()
    {
        StateHasChanged();
    }

    private List<ElectroGestion.Models.OrdenTrabajo> FilteredOrdenes => AppState.Ordenes
        .Where(o => {
            var s = AppState.Solicitudes.FirstOrDefault(x => x.Id == o.SolicitudId);
            var cliente = s?.Cliente?.Nombre ?? "";
            var tipo = s?.Servicio?.Nombre ?? "";
            bool matchId = string.IsNullOrEmpty(SearchId) || o.Id.ToString().Contains(SearchId) || (!string.IsNullOrEmpty(o.Code) && o.Code.Contains(SearchId, StringComparison.OrdinalIgnoreCase));
            bool matchCliente = string.IsNullOrEmpty(SearchCliente) || cliente.Contains(SearchCliente, StringComparison.OrdinalIgnoreCase);
            bool matchTipo = string.IsNullOrEmpty(SearchTipo) || tipo.Contains(SearchTipo, StringComparison.OrdinalIgnoreCase);
            bool matchFecha = !SearchFecha.HasValue || (s != null && s.Fecha.ToString("yyyy-MM-dd") == SearchFecha.Value.ToString("yyyy-MM-dd"));
            bool matchEstado = SearchEstado == "Todas" || o.Estado == SearchEstado;
            return matchId && matchCliente && matchTipo && matchFecha && matchEstado;
        })
        .OrderByDescending(x => x.Id).ToList();

    protected override void OnInitialized()
    {
        AppState.OnChange += OnStateChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void FinalizarOrden(int id)
    {
        var o = AppState.Ordenes.FirstOrDefault(x => x.Id == id);
        if (o != null)
        {
            o.Estado = "Finalizada";
            var s = AppState.Solicitudes.FirstOrDefault(x => x.Id == o.SolicitudId);
            if (s != null)
            {
                s.EstadoSolicitudId = 3;
                s.EstadoSolicitud = AppState.EstadosSolicitud.FirstOrDefault(e => e.Id == 3);
            }
            ToastService.ShowSuccess($"Orden #{o.Code ?? o.Id.ToString()} finalizada con éxito.", "Éxito");
        }
    }
}
</file>

<file path="Components/Pages/Tecnico/Solicitudes.razor">
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.SolicitudService SolicitudService
@inject ElectroGestion.Services.ClienteService ClienteService
@inject ElectroGestion.Services.ServicioService ServicioService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject ToastService ToastService

<PageTitle>Solicitudes de Campo | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:18px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.8px;color:#1f2430;line-height:1.15">Solicitudes</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Registro de las necesidades de los clientes.</div>
    </div>
    <button @onclick="NuevaSolicitud" style="padding:10px 16px 10px 18px;background:#1D4ED8;color:#fff;border:0;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';white-space:nowrap;display:flex;align-items:center;gap:8px">
        <span style="font-size:20px;line-height:1;transform:translateY(-1px)">+</span>
        <span>Nueva solicitud</span>
    </button>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;overflow:hidden">
    <div style="display:flex;flex-direction:column;gap:18px;padding:18px 18px 12px;border-bottom:1px solid #EFF0F6">
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px;min-width:180px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" placeholder="ID de solicitud" style="width:150px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px;min-width:260px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Cliente:</span>
                <input @bind="SearchCliente" placeholder="Nombre del cliente" style="width:210px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px;min-width:260px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Tipo de Servicio:</span>
                <select @bind="SearchTipo" style="width:220px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="">Seleccione Servicio</option>
                    @foreach (var tipo in TiposServicio)
                    {
                        <option value="@tipo">@tipo</option>
                    }
                </select>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px;min-width:230px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Fecha Solicitud:</span>
                <input type="date" @bind="SearchFecha" style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px;min-width:250px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Estado:</span>
                <select @bind="SearchEstado" style="width:180px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="Todos los estados">Todos los estados</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="En proceso">En proceso</option>
                    <option value="Finalizada">Finalizada</option>
                    <option value="Cancelada">Cancelada</option>
                </select>
            </div>
            <div style="margin-left:auto;display:flex;justify-content:flex-end">
                <button @onclick="Filtrar" style="padding:10px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';display:flex;align-items:center;justify-content:center;gap:8px;min-width:130px">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 5 5"/></svg>
                    <span>Buscar</span>
                </button>
            </div>
        </div>
    </div>

    <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:14px;table-layout:fixed">
            <thead>
                <tr style="border-bottom:1px solid #EFF0F6;background:#FAFAFC;color:#6B7085;font-family:'Manrope';font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:0.5px">
                    <th @onclick='() => OrdenarPor("Id")' style="padding:14px 18px;text-align:left;width:12%;cursor:pointer;user-select:none" title="Ordenar por ID">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>ID</span>
                            @if (SortColumn == "Id") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Cliente")' style="padding:14px 18px;text-align:left;width:22%;cursor:pointer;user-select:none" title="Ordenar por Cliente">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Cliente</span>
                            @if (SortColumn == "Cliente") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Servicio")' style="padding:14px 18px;text-align:left;width:22%;cursor:pointer;user-select:none" title="Ordenar por Tipo de Servicio">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Tipo de Servicio</span>
                            @if (SortColumn == "Servicio") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Fecha")' style="padding:14px 18px;text-align:left;width:18%;cursor:pointer;user-select:none" title="Ordenar por Fecha Solicitud">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Fecha Solicitud</span>
                            @if (SortColumn == "Fecha") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Estado")' style="padding:14px 18px;text-align:left;width:15%;cursor:pointer;user-select:none" title="Ordenar por Estado">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Estado</span>
                            @if (SortColumn == "Estado") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th style="padding:14px 18px;text-align:right;width:11%">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredSolicitudes.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="padding:32px;text-align:center;color:#6B7085">
                            No se encontraron solicitudes con los filtros indicados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in FilteredSolicitudes)
                    {
                        <tr style="border-bottom:1px solid #EFF0F6">
                            <td style="padding:18px;vertical-align:middle">
                                <span style="font-family:ui-monospace,'SFMono-Regular',Consolas,monospace;font-size:14px;font-weight:700;letter-spacing:.05em;color:#5B6173">@s.Id.ToString("D4")</span>
                            </td>
                            <td style="padding:18px;vertical-align:middle;font-weight:700;color:#14162B">
                                @s.Cliente?.Nombre
                            </td>
                            <td style="padding:18px;vertical-align:middle;color:#4A4E63">
                                @s.Servicio?.Nombre
                            </td>
                            <td style="padding:18px;vertical-align:middle;color:#6B7085">
                                @AppStateService.FormatFecha(s.FechaSolicitud.ToString("yyyy-MM-dd"))
                            </td>
                            <td style="padding:18px;vertical-align:middle">
                                <span style="display:inline-block;padding:5px 12px;border-radius:999px;font-size:12.5px;font-weight:700;line-height:1.2;background:@(s.EstadoSolicitud?.Nombre == "Pendiente" ? "#F7E7C9" : s.EstadoSolicitud?.Nombre == "En proceso" ? "#DDE7FF" : s.EstadoSolicitud?.Nombre == "Finalizada" ? "#DDF7E8" : "#F9E6E6");color:@(s.EstadoSolicitud?.Nombre == "Pendiente" ? "#B57A00" : s.EstadoSolicitud?.Nombre == "En proceso" ? "#2B5BDB" : s.EstadoSolicitud?.Nombre == "Finalizada" ? "#198754" : "#C0392B")">
                                    @s.EstadoSolicitud?.Nombre
                                </span>
                            </td>
                            <td style="padding:18px;text-align:right;vertical-align:middle">
                                <div style="display:flex;gap:8px;justify-content:flex-end">
                                    <button @onclick="() => VerDetalle(s.Id)" title="Ver detalle" aria-label="Ver detalle" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    <button @onclick="() => Editar(s.Id)" title="Editar" aria-label="Editar" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (IsDetalleModalOpen && SelectedSolicitud != null)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:620px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,.2);animation:tin .2s ease-out">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
                <div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B">Detalle de la solicitud</div>
                    <div style="font-size:14px;color:#6B7085;margin-top:3px">Solicitud @SelectedSolicitud.Id.ToString("D4")</div>
                </div>
                <button @onclick="CerrarDetalle" aria-label="Cerrar" style="width:32px;height:32px;border:1px solid #E3E5EE;border-radius:8px;background:#fff;display:flex;align-items:center;justify-content:center;color:#8B90A3;cursor:pointer"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px" class="resp-grid-2">
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Cliente</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedSolicitud.Cliente?.Nombre</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Contacto</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedSolicitud.Contacto</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Tipo de servicio</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedSolicitud.Servicio?.Nombre</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Dirección</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedSolicitud.Direccion</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Fecha de solicitud</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@AppStateService.FormatFecha(SelectedSolicitud.FechaSolicitud.ToString("yyyy-MM-dd"))</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Fecha del levantamiento</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@AppStateService.FormatFecha(SelectedSolicitud.Fecha.ToString("yyyy-MM-dd"))</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Hora</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@AppStateService.FormatHora12(SelectedSolicitud.Hora)</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Estado</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedSolicitud.EstadoSolicitud?.Nombre</div></div>
            </div>
            <div style="margin-top:24px;display:flex;justify-content:flex-end;border-top:1px solid #EFF0F6;padding-top:17px"><button @onclick="CerrarDetalle" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cerrar</button></div>
        </div>
    </div>
}

@if (IsFormModalOpen)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:540px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,.2);animation:tin .2s ease-out">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
                <div><div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B">@ModalTitle</div><div style="color:#6B7085;font-size:13.5px;margin-top:4px">@ModalSub</div></div>
                <button @onclick="CloseModal" aria-label="Cerrar" style="width:32px;height:32px;border:1px solid #E3E5EE;border-radius:8px;background:#fff;display:flex;align-items:center;justify-content:center;color:#8B90A3;cursor:pointer"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
            </div>
            <div style="display:flex;flex-direction:column;gap:16px">
                <div><label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Cliente *</label><select @bind="FormCliente" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;background:#fff"><option value="">Seleccione un cliente registrado</option>@foreach (var cliente in clientes) { <option value="@cliente.Nombre">@cliente.Nombre</option> }</select></div>
                <div><label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Tipo de Servicio *</label><select @bind="FormTipo" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;background:#fff"><option value="">Seleccione el tipo de servicio</option>@foreach (var tipo in TiposServicio) { <option value="@tipo">@tipo</option> }</select></div>
                <div><label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Dirección del Servicio *</label><input @bind="FormDireccion" placeholder="ej. Calle Principal #12, Santiago" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" /></div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px" class="resp-grid-2">
                    <div><label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Fecha de Visita</label><input type="date" @bind="FormFecha" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" /></div>
                    <div><label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Hora de Visita</label><input type="time" @bind="FormHora" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" /></div>
                </div>
            </div>
            <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:28px">
                <button @onclick="CloseModal" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;color:#4A4E63">Cancelar</button>
                <button @onclick="SaveModal" style="padding:10px 24px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Guardar</button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchId { get; set; } = "";
    private string SearchCliente { get; set; } = "";
    private string SearchTipo { get; set; } = "";
    private DateTime? SearchFecha { get; set; }
    private string SearchEstado { get; set; } = "Todos los estados";
    private bool IsFormModalOpen;
    private string ModalTitle = "";
    private string ModalSub = "";
    private int? FormId;
    private string FormCliente = "";
    private string FormTipo = "";
    private string FormDireccion = "";
    private DateTime? FormFecha;
    private TimeOnly? FormHora;
    private List<string> TiposServicio = new();

    private string SortColumn = "Id";
    private bool SortAscending = false;

    private List<ElectroGestion.Models.Solicitud> solicitudes = new();
    private List<ElectroGestion.Models.Cliente> clientes = new();
    private List<ElectroGestion.Models.Servicio> servicios = new();
    private List<ElectroGestion.Models.Solicitud> FilteredSolicitudes = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private void OrdenarPor(string columna)
    {
        if (SortColumn == columna)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortColumn = columna;
            SortAscending = true;
        }
        Filtrar();
    }

    private async Task CargarDatos()
    {
        solicitudes = await SolicitudService.GetList(s => true);
        clientes = await ClienteService.GetList(c => true);
        servicios = await ServicioService.GetList(s => true);
        TiposServicio = servicios.Select(s => s.Nombre).Distinct().ToList();
        Filtrar();
    }

    private void Filtrar()
    {
        var q = solicitudes.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchId))
        {
            q = q.Where(x => x.Id.ToString("D4").Contains(SearchId, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(SearchCliente))
        {
            q = q.Where(x => x.Cliente != null && x.Cliente.Nombre.Contains(SearchCliente, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(SearchTipo))
        {
            q = q.Where(x => x.Servicio != null && x.Servicio.Nombre == SearchTipo);
        }

        if (SearchFecha.HasValue)
        {
            var dateStr = SearchFecha.Value.ToString("yyyy-MM-dd");
            q = q.Where(x => x.FechaSolicitud.ToString("yyyy-MM-dd").StartsWith(dateStr));
        }

        if (SearchEstado != "Todos los estados")
        {
            q = q.Where(x => x.EstadoSolicitud != null && x.EstadoSolicitud.Nombre == SearchEstado);
        }

        FilteredSolicitudes = (SortColumn switch
        {
            "Id" => SortAscending ? q.OrderBy(x => x.Id) : q.OrderByDescending(x => x.Id),
            "Cliente" => SortAscending ? q.OrderBy(x => x.Cliente != null ? x.Cliente.Nombre : "") : q.OrderByDescending(x => x.Cliente != null ? x.Cliente.Nombre : ""),
            "Servicio" => SortAscending ? q.OrderBy(x => x.Servicio != null ? x.Servicio.Nombre : "") : q.OrderByDescending(x => x.Servicio != null ? x.Servicio.Nombre : ""),
            "Fecha" => SortAscending ? q.OrderBy(x => x.FechaSolicitud) : q.OrderByDescending(x => x.FechaSolicitud),
            "Estado" => SortAscending ? q.OrderBy(x => x.EstadoSolicitud != null ? x.EstadoSolicitud.Nombre : "") : q.OrderByDescending(x => x.EstadoSolicitud != null ? x.EstadoSolicitud.Nombre : ""),
            _ => SortAscending ? q.OrderBy(x => x.Id) : q.OrderByDescending(x => x.Id)
        }).ToList();
    }

    private async Task NuevaSolicitud()
    {
        await CargarDatos();
        ModalTitle = "Nueva Solicitud";
        ModalSub = "Complete los datos para registrar una nueva solicitud de servicio.";
        FormId = null;
        FormCliente = FormTipo = FormDireccion = "";
        FormFecha = null;
        FormHora = null;
        IsFormModalOpen = true;
    }

    private async Task Editar(int id)
    {
        await CargarDatos();
        var solicitud = solicitudes.FirstOrDefault(s => s.Id == id);
        if (solicitud == null) return;

        ModalTitle = "Editar Solicitud";
        ModalSub = "Modifique los datos de la solicitud.";
        FormId = solicitud.Id;
        FormCliente = solicitud.Cliente?.Nombre ?? "";
        FormTipo = solicitud.Servicio?.Nombre ?? "";
        FormDireccion = solicitud.Direccion;
        FormFecha = solicitud.Fecha;
        FormHora = TimeOnly.TryParse(solicitud.Hora, out var h) ? h : null;
        IsFormModalOpen = true;
    }

    private async Task SaveModal()
    {
        if (string.IsNullOrWhiteSpace(FormCliente) || string.IsNullOrWhiteSpace(FormTipo) || string.IsNullOrWhiteSpace(FormDireccion))
        {
            ToastService.ShowWarning("Por favor complete los campos requeridos.", "Atención");
            return;
        }

        var clienteEntity = clientes.FirstOrDefault(c => c.Nombre == FormCliente);
        var servicioEntity = servicios.FirstOrDefault(serv => serv.Nombre == FormTipo);

        if (clienteEntity == null || servicioEntity == null)
        {
            ToastService.ShowWarning("Por favor seleccione un cliente y tipo de servicio válidos.", "Atención");
            return;
        }

        var editing = FormId.HasValue;
        if (editing)
        {
            var solicitudId = FormId.GetValueOrDefault();
            var solicitud = solicitudes.FirstOrDefault(s => s.Id == solicitudId);
            if (solicitud != null)
            {
                solicitud.ClienteId = clienteEntity.Id;
                solicitud.Contacto = clienteEntity.Nombre;
                solicitud.ServicioId = servicioEntity.Id;
                solicitud.Direccion = FormDireccion;
                if (FormFecha.HasValue) solicitud.Fecha = FormFecha.Value;
                solicitud.Hora = FormHora?.ToString("HH:mm") ?? "";

                var resultado = await SolicitudService.Guardar(solicitud);
                if (resultado) ToastService.ShowSuccess("Solicitud actualizada correctamente.");
                else ToastService.ShowError("Error al actualizar la solicitud.");
            }
        }
        else
        {
            var s = new ElectroGestion.Models.Solicitud
            {
                ClienteId = clienteEntity.Id,
                ServicioId = servicioEntity.Id,
                Contacto = clienteEntity.Nombre,
                Direccion = FormDireccion,
                FechaSolicitud = DateTime.Today,
                Fecha = FormFecha ?? DateTime.Today,
                Hora = FormHora?.ToString("HH:mm") ?? "",
                EstadoSolicitudId = 1
            };

            var resultado = await SolicitudService.Guardar(s);
            if (resultado)
            {
                clienteEntity.Servicios++;
                clienteEntity.Ultimo = servicioEntity.Nombre;
                await ClienteService.Guardar(clienteEntity);
                ToastService.ShowSuccess("Solicitud registrada correctamente.");
            }
            else
            {
                ToastService.ShowError("Error al registrar la solicitud.");
            }
        }

        IsFormModalOpen = false;
        await CargarDatos();
    }

    private void CloseModal() => IsFormModalOpen = false;

    private bool IsDetalleModalOpen;
    private ElectroGestion.Models.Solicitud? SelectedSolicitud;

    private void VerDetalle(int id)
    {
        SelectedSolicitud = solicitudes.FirstOrDefault(s => s.Id == id);
        IsDetalleModalOpen = SelectedSolicitud != null;
    }

    private void CerrarDetalle()
    {
        IsDetalleModalOpen = false;
        SelectedSolicitud = null;
    }

    private void AbrirMapa(string direccion)
    {
        var url = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(direccion)}";
        JS.InvokeVoidAsync("open", url, "_blank");
    }

    private void IrALevantamiento(int id)
    {
        NavManager.NavigateTo("/levantamientos");
    }
}
</file>

