            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px" class="resp-grid-2">
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Nombre</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedProveedor.Nombre</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">RNC</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedProveedor.Rnc</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Correo</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedProveedor.Correo</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Teléfono</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedProveedor.Telefono</div></div>
                <div style="grid-column:1 / -1;background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Dirección</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedProveedor.Direccion</div></div>
