                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" @bind:event="oninput" placeholder="ID de orden"
                    style="width:140px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Cliente:</span>
                <input @bind="SearchCliente" @bind:event="oninput" placeholder="Nombre del cliente"
                    style="width:200px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Tipo de Servicio:</span>
                <input @bind="SearchTipo" @bind:event="oninput" placeholder="Tipo de servicio"
                    style="width:190px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Fecha:</span>
                <input type="date" @bind="SearchFecha"
                    style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Estado:</span>
                <select @bind="SearchEstado" style="width:170px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="Todas">Todas</option>
                    <option value="En proceso">En proceso</option>
                    <option value="Finalizada">Finalizada</option>
                </select>
            </div>
            <div style="width:190px;display:flex;justify-content:flex-end;margin-left:auto">
                <button class="primary-btn" @onclick="Filtrar"
                    style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Buscar</button>
            </div>
        </div>
    </div>
</div>

<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px" class="resp-grid-2">
    @foreach (var o in FilteredOrdenes)
    {
        var s = AppState.Solicitudes.FirstOrDefault(x => x.Id == o.SolicitudId);
        var cliente = s?.Cliente?.Nombre ?? "Cliente";
        var tipoServicio = s?.Servicio?.Nombre ?? "Servicio Eléctrico";
        var colors = ElectroGestion.Services.AppStateService.GetBadgeColors(o.Estado);

        <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:22px;display:flex;flex-direction:column">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
                <div>
                    <div style="font-family:ui-monospace,monospace;font-size:12px;color:#8B90A3;font-weight:700">ORDEN @(string.IsNullOrEmpty(o.Code) ? o.Id.ToString("D4") : o.Code)</div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:19px;margin-top:4px">@cliente</div>
                    <div style="color:#6B7085;font-size:14px;margin-top:2px">@tipoServicio</div>
                </div>
                <span style="display:inline-block;padding:5px 11px;border-radius:20px;font-size:12px;font-weight:800;background:@colors.Bg;color:@colors.Fg;white-space:nowrap">
                    @o.Estado
                </span>
            </div>
            
            <div style="margin-top:18px;font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">
                Tareas a realizar (Checklist Técnico)
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;margin-top:10px">
                @if (o.Trabajos != null)
                {
                    @for (int i = 0; i < o.Trabajos.Count; i++)
                    {
                        <div style="display:flex;gap:10px;align-items:flex-start;font-size:14px">
                            <span style="flex:0 0 22px;height:22px;border-radius:6px;background:#EDEBFF;color:#1D4ED8;font-weight:800;font-size:12px;display:flex;align-items:center;justify-content:center">
                                @(i + 1)
                            </span>
                            <span style="color:#4A4E63">@o.Trabajos[i]</span>
                        </div>
                    }
                }
            </div>

            <div style="margin-top:18px;font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">
                Materiales y herramientas asignadas
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
                @if (o.Materiales != null)
                {
                    @foreach (var m in o.Materiales)
                    {
                        <span style="padding:5px 11px;border:1px solid #E3E5EE;border-radius:20px;font-size:12.5px;background:#F7F8FC;color:#14162B">@m</span>
                    }
                }
            </div>

            @if (!string.IsNullOrEmpty(o.Observaciones))
            {
                <div style="margin-top:18px;font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">
                    Instrucciones de campo
                </div>
                <div style="font-size:14px;margin-top:7px;color:#4A4E63;line-height:1.55;background:#FAFAFC;padding:10px 14px;border-radius:8px;border:1px solid #EFF0F6">
                    @o.Observaciones
                </div>
            }

            <div style="margin-top:auto;padding-top:20px;display:flex;gap:10px">
                <button @onclick="() => EditarOrden(o.Id)"
                    style="width:33%;padding:12px;border:1px solid #E3E5EE;background:#fff;color:#4A4E63;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:8px">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg>
                    Editar
                </button>
                <button @onclick="() => ConfirmarEliminar(o.Id)"
                    style="width:33%;padding:12px;border:1px solid #F5C2C4;background:#fff;color:#C4141B;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:8px">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                    Eliminar
                </button>
                <button @onclick="() => ToggleEstado(o.Id)"
                    style="width:34%;padding:12px;border:1px solid #1D4ED8;background:#1D4ED8;color:#fff;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';transition:all 0.2s">
                    Cambiar Estado
                </button>
            </div>
        </div>
    }
</div>

@if (IsDeleteModalOpen)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:400px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,0.2);animation:tin 0.2s ease-out">
            <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B;margin-bottom:10px">Eliminar Orden</div>
            <div style="color:#4A4E63;font-size:14px;margin-bottom:24px">¿Está seguro que desea eliminar esta orden de trabajo? Esta acción no se puede deshacer.</div>
            <div style="display:flex;justify-content:flex-end;gap:12px">
                <button @onclick="CerrarEliminar" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;color:#4A4E63">
                    Cancelar
                </button>
                <button @onclick="EjecutarEliminar" style="padding:10px 24px;border:0;background:#C0392B;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">
                    Eliminar
                </button>
            </div>
        </div>
    </div>
}

@if (!FilteredOrdenes.Any())
{
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:40px;text-align:center;color:#8B90A3;font-size:14px">
        No hay órdenes de trabajo asignadas con el filtro seleccionado.
    </div>
}

@if (IsModalOpen)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(20,22,43,0.4);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px" @onclick="CerrarModal">
        <div style="background:#fff;width:100%;max-width:600px;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,0.1);display:flex;flex-direction:column;max-height:90vh" @onclick:stopPropagation>
            <div style="padding:24px;border-bottom:1px solid #E3E5EE;display:flex;align-items:center;justify-content:space-between">
                <h3 style="margin:0;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">Nueva Orden de Trabajo</h3>
                <button @onclick="CerrarModal" style="background:none;border:0;color:#6B7085;cursor:pointer;padding:4px">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            
            <div style="padding:24px;overflow-y:auto;display:flex;flex-direction:column;gap:16px">

                
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Seleccionar Cotización Aprobada</label>
                    <select @bind="FormCotizacionId" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var c in AppState.Cotizaciones.Where(x => x.Estado == "Aprobada"))
                        {
                            <option value="@c.Id">Cotización #@c.Id - @c.Cliente</option>
                        }
                    </select>
                </div>

                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Cliente Asignado</label>
                    <input @bind="FormCliente" readonly style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#6B7085;background:#F8F9FC" placeholder="Se llena automáticamente" />
                </div>

                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Tipo de Servicio</label>
                    <input @bind="FormTipoServicio" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="Ej: Instalación Eléctrica" />
                </div>

                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Checklist de Tareas (Una por línea)</label>
                    <textarea @bind="FormTrabajos" rows="4" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;resize:vertical" placeholder="Ejemplo:&#10;1. Inspección inicial&#10;2. Conexión de cables"></textarea>
                </div>

                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Materiales y Herramientas (Separados por coma)</label>
                    <textarea @bind="FormMateriales" rows="2" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;resize:vertical" placeholder="Ej: Multímetro, Cables THHN, Breaker 60A"></textarea>
                </div>

                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Observaciones / Instrucciones</label>
                    <textarea @bind="FormObservaciones" rows="3" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;resize:vertical" placeholder="Notas especiales para los técnicos"></textarea>
                </div>
            </div>

            <div style="padding:20px 24px;border-top:1px solid #E3E5EE;display:flex;justify-content:flex-end;gap:12px;background:#F8F9FC;border-radius:0 0 16px 16px">
                <button @onclick="CerrarModal" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;color:#4A4E63;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Cancelar</button>
                <button @onclick="GuardarOrden" style="padding:10px 22px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Crear Orden</button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchId = "";
    private string SearchCliente = "";
    private string SearchTipo = "";
    private DateTime? SearchFecha = null;
    private string SearchEstado = "Todas";

    private bool IsModalOpen = false;
    private bool IsDeleteModalOpen = false;
    private int? DeleteId;

    private void ConfirmarEliminar(int id)
    {
        DeleteId = id;
        IsDeleteModalOpen = true;
    }

    private void EjecutarEliminar()
    {
        if (DeleteId.HasValue)
        {
            var o = AppState.Ordenes.FirstOrDefault(x => x.Id == DeleteId.Value);
            if (o != null)
            {
                AppState.Ordenes.Remove(o);
                ToastService.Notify(new ToastMessage(ToastType.Success, "Orden de trabajo eliminada exitosamente."));
                
                // Actualizar estado de solicitud si aplica
                var s = AppState.Solicitudes.FirstOrDefault(x => x.Id == o.SolicitudId);
                if (s != null)
                {
                    s.EstadoSolicitudId = 1; // Pendiente
                    s.EstadoSolicitud = AppState.EstadosSolicitud.FirstOrDefault(e => e.Id == 1);
                }
                AppState.NotifyStateChanged();
            }
        }
        IsDeleteModalOpen = false;
        DeleteId = null;
    }

    private void CerrarEliminar()
    {
        IsDeleteModalOpen = false;
        DeleteId = null;
    }

    private int _formCotizacionId;
    private int FormCotizacionId
    {
        get => _formCotizacionId;
        set
        {
            _formCotizacionId = value;
            var cot = AppState.Cotizaciones.FirstOrDefault(c => c.Id == value);
            FormCliente = cot?.Cliente ?? "";
        }
    }

    private string FormCliente = "";
    private string FormTipoServicio = "";
    private string FormTrabajos = "";
    private string FormMateriales = "";
    private string FormObservaciones = "";

    private void Filtrar()
    {
        StateHasChanged();
    }

    private List<ElectroGestion.Models.OrdenTrabajo> FilteredOrdenes => AppState.Ordenes
        .Where(o => {
            var s = AppState.Solicitudes.FirstOrDefault(x => x.Id == o.SolicitudId);
            var cliente = string.IsNullOrEmpty(o.Cliente) ? (s?.Cliente?.Nombre ?? "") : o.Cliente;
            var tipo = string.IsNullOrEmpty(o.TipoServicio) ? (s?.Servicio?.Nombre ?? "") : o.TipoServicio;
            bool matchId = string.IsNullOrEmpty(SearchId) || o.Id.ToString().Contains(SearchId) || (!string.IsNullOrEmpty(o.Code) && o.Code.Contains(SearchId, StringComparison.OrdinalIgnoreCase));
            bool matchCliente = string.IsNullOrEmpty(SearchCliente) || cliente.Contains(SearchCliente, StringComparison.OrdinalIgnoreCase);
            bool matchTipo = string.IsNullOrEmpty(SearchTipo) || tipo.Contains(SearchTipo, StringComparison.OrdinalIgnoreCase);
            bool matchFecha = !SearchFecha.HasValue || (s != null && s.Fecha.Date == SearchFecha.Value.Date);
            bool matchEstado = SearchEstado == "Todas" || o.Estado == SearchEstado;
            return matchId && matchCliente && matchTipo && matchFecha && matchEstado;
        })
        .OrderByDescending(x => x.Id).ToList();

    protected override void OnInitialized()
    {
        AppState.OnChange += OnStateChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleEstado(int id)
    {
        var o = AppState.Ordenes.FirstOrDefault(x => x.Id == id);
        if (o != null)
        {
            o.Estado = o.Estado == "En proceso" ? "Finalizada" : "En proceso";
            
            // Actualizar estado de solicitud si aplica
            var s = AppState.Solicitudes.FirstOrDefault(x => x.Id == o.SolicitudId);
            if (s != null && o.Estado == "Finalizada")
            {
                // Estado actualizado
            }
            
            ToastService.Notify(new ToastMessage(ToastType.Success, $"Estado de orden #{o.Code ?? o.Id.ToString()} actualizado a '{o.Estado}'."));
        }
    }

    private int? EditId = null;

    private void AbrirModal()
    {
        EditId = null;
        FormCotizacionId = 0;
        FormCliente = "";
        FormTipoServicio = "";
        FormTrabajos = "";
        FormMateriales = "";
        FormObservaciones = "";
        IsModalOpen = true;
    }

    private void EditarOrden(int id)
    {
        var o = AppState.Ordenes.FirstOrDefault(x => x.Id == id);
        if (o != null)
        {
            EditId = id;
            var s = AppState.Solicitudes.FirstOrDefault(x => x.Id == o.SolicitudId);
            FormCotizacionId = 0; // Opcional: buscar la cotización si se requiere
            FormCliente = o.Cliente;
            FormTipoServicio = o.TipoServicio;
            FormTrabajos = o.Trabajos != null ? string.Join("\n", o.Trabajos) : "";
            FormMateriales = o.Materiales != null ? string.Join(", ", o.Materiales) : "";
            FormObservaciones = o.Observaciones ?? "";
            IsModalOpen = true;
        }
    }

    private void CerrarModal()
    {
        IsModalOpen = false;
    }
    private void GuardarOrden()
    {
        var listTrabajos = FormTrabajos.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                                       .Select(x => x.Trim()).ToList();
                                       
        var listMateriales = FormMateriales.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                                         .Select(x => x.Trim()).ToList();

        if (EditId.HasValue)
        {
            var o = AppState.Ordenes.FirstOrDefault(x => x.Id == EditId.Value);
            if (o != null)
            {
                o.Cliente = FormCliente;
                o.TipoServicio = FormTipoServicio;
                o.Trabajos = listTrabajos;
                o.Materiales = listMateriales;
                o.Observaciones = FormObservaciones;
                ToastService.Notify(new ToastMessage(ToastType.Success, $"Orden de Trabajo {o.Code ?? o.Id.ToString("D4")} actualizada exitosamente."));
            }
        }
        else
        {
            if (FormCotizacionId <= 0)
            {
                ToastService.Notify(new ToastMessage(ToastType.Warning, "Debe seleccionar una cotización aprobada."));
                return;
            }

            var id = AppState.NextOrdenId();
            var code = "OT-" + id.ToString("D4");

            var nuevaOrden = new ElectroGestion.Models.OrdenTrabajo
            {
                Id = id,
                Code = code,
                Cliente = FormCliente,
                TipoServicio = FormTipoServicio,
                Estado = "En proceso",
                Trabajos = listTrabajos,
                Materiales = listMateriales,
                Observaciones = FormObservaciones
            };

            AppState.Ordenes.Add(nuevaOrden);
            ToastService.Notify(new ToastMessage(ToastType.Success, $"Orden de Trabajo {code} creada exitosamente."));
        }

        AppState.NotifyStateChanged();
        CerrarModal();
    }
}
</file>

<file path="Components/Pages/Gerente/Proveedores.razor">
@page "/proveedores"
@inject ElectroGestion.Services.AppStateService AppState
@inject BlazorBootstrap.ToastService ToastService

<PageTitle>Proveedores | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Proveedores</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Gestión de proveedores y suplidores.</div>
    </div>
    <button class="primary-btn" @onclick="() => AbrirModal()"
        style="padding:11px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:9px;font-weight:700;font-size:14.5px;cursor:pointer;font-family:'Manrope';display:flex;align-items:center;gap:8px;box-shadow:0 4px 12px rgba(29,78,216,0.25)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Nuevo Proveedor
    </button>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;overflow:hidden">
    <div style="display:flex;flex-direction:column;gap:18px;padding:18px 18px 12px;border-bottom:1px solid #EFF0F6">
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" @bind:event="oninput" placeholder="ID"
                    style="width:140px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Nombre:</span>
                <input @bind="SearchNombre" @bind:event="oninput" placeholder="Nombre proveedor"
                    style="width:200px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">RNC:</span>
                <input @bind="SearchRnc" @bind:event="oninput" placeholder="RNC"
                    style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Teléfono:</span>
                <input @bind="SearchTelefono" @bind:event="oninput" placeholder="Teléfono"
                    style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;justify-content:flex-end;margin-left:auto">
                <button class="primary-btn" @onclick="Filtrar"
                    style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Buscar</button>
            </div>
        </div>
    </div>

    <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:14px">
            <thead style="background:#F8F9FC;border-bottom:1px solid #E3E5EE">
                <tr>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">ID</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Nombre</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">RNC</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Correo</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Teléfono</th>
                    <th style="padding:14px 18px;text-align:center;color:#4A4E63;font-weight:700">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredProveedores.Any())
                {
                    <tr>
                        <td colspan="6" style="padding:24px;text-align:center;color:#6B7085">No se encontraron proveedores.</td>
                    </tr>
                }
                else
                {
                    @foreach (var prov in FilteredProveedores)
                    {
                        <tr style="border-bottom:1px solid #EFF0F6;background:#fff">
                            <td style="padding:14px 18px;color:#14162B;font-weight:600">@prov.Id</td>
                            <td style="padding:14px 18px;color:#4A4E63">@prov.Nombre</td>
                            <td style="padding:14px 18px;color:#4A4E63">@prov.Rnc</td>
                            <td style="padding:14px 18px;color:#4A4E63">@prov.Correo</td>
                            <td style="padding:14px 18px;color:#4A4E63">@prov.Telefono</td>
                            <td style="padding:14px 18px;text-align:center">
                                <div style="display:flex;gap:8px;justify-content:center">
                                    <button @onclick="() => VerDetalle(prov.Id)" title="Ver detalle" aria-label="Ver detalle" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    <button @onclick="() => AbrirModal(prov.Id)" title="Editar" aria-label="Editar" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (IsModalOpen)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(20,22,43,0.4);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px" @onclick="CerrarModal">
        <div style="background:#fff;width:100%;max-width:550px;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,0.1);display:flex;flex-direction:column;max-height:90vh" @onclick:stopPropagation>
            <div style="padding:24px;border-bottom:1px solid #E3E5EE;display:flex;align-items:center;justify-content:space-between">
                <h3 style="margin:0;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">@ModalTitle</h3>
                <button @onclick="CerrarModal" style="background:none;border:0;color:#6B7085;cursor:pointer;padding:4px">
