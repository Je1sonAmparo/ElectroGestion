@code {
    private const string ActionButtonStyle = "width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0";
    private const string DetailCellStyle = "background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px;display:flex;flex-direction:column;gap:4px";
    private const string SecondaryButtonStyle = "padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;color:#4A4E63";
    private const string PrimaryButtonStyle = "padding:10px 20px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'";

    private string Vista = "Inicio";
    private bool Cargando;
    private bool MostrarSolicitud;
    private bool ModoRecuperarSolicitud;
    private bool SolicitudEnConfirmacion;
    private bool MostrarVisita;
    private bool ModoRecuperarVisita;
    private bool VisitaEnConfirmacion;
    private Solicitud? SolicitudSeleccionada;
    private Visita? VisitaSeleccionada;
    private List<Solicitud> SolicitudesEliminadas = new();
    private List<Visita> VisitasEliminadas = new();
    private string SearchSolicitudId = "";
    private string SearchSolicitudCliente = "";
    private string SearchSolicitudServicio = "";
    private DateTime? SearchSolicitudFecha;
    private string SearchSolicitudEstado = "";
    private string SearchVisitaId = "";
    private string SearchVisitaCliente = "";
    private string SearchVisitaServicio = "";
    private DateTime? SearchVisitaFecha;
    private string SearchVisitaEstado = "";
    private List<Solicitud> SolicitudesFiltradas = new();
    private List<Visita> VisitasFiltradas = new();
    private List<string> ServiciosSolicitud = new();
    private List<string> EstadosSolicitud = new();
    private List<string> ServiciosVisita = new();
    private List<string> EstadosVisita = new();

    protected override async Task OnInitializedAsync()
    {
        if (AppState.EsAdministrador)
        {
            await CargarDatosAsync();
        }
    }

    private async Task CargarDatosAsync()
    {
        Cargando = true;
        try
        {
            SolicitudesEliminadas = await SolicitudService.ObtenerEliminadasAsync();
            VisitasEliminadas = await VisitaService.ObtenerEliminadasAsync();
            ServiciosSolicitud = SolicitudesEliminadas.Select(s => s.Servicio?.Nombre).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().OrderBy(n => n).Select(n => n!).ToList();
            EstadosSolicitud = SolicitudesEliminadas.Select(s => s.EstadoSolicitud?.Nombre).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().OrderBy(n => n).Select(n => n!).ToList();
            ServiciosVisita = VisitasEliminadas.Select(v => v.Solicitud?.Servicio?.Nombre).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().OrderBy(n => n).Select(n => n!).ToList();
            EstadosVisita = VisitasEliminadas.Select(v => v.Estado).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().OrderBy(n => n).Select(n => n!).ToList();
            FiltrarSolicitudes();
            FiltrarVisitas();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudieron cargar los registros eliminados.");
            ToastService.ShowError("Ocurrió un error al cargar los datos de recuperación.", "Error");
        }
        finally
        {
            Cargando = false;
        }
    }

    private void CambiarVista(string vista) => Vista = vista;

    private void FiltrarSolicitudes()
    {
        IEnumerable<Solicitud> resultado = SolicitudesEliminadas;
        if (!string.IsNullOrWhiteSpace(SearchSolicitudId)) resultado = resultado.Where(s => s.Id.ToString("D4").Contains(SearchSolicitudId.Trim(), StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(SearchSolicitudCliente)) resultado = resultado.Where(s => (s.Cliente?.Nombre ?? "").Contains(SearchSolicitudCliente.Trim(), StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(SearchSolicitudServicio)) resultado = resultado.Where(s => s.Servicio?.Nombre == SearchSolicitudServicio);
        if (SearchSolicitudFecha.HasValue) resultado = resultado.Where(s => s.FechaSolicitud.Date == SearchSolicitudFecha.Value.Date);
        if (!string.IsNullOrWhiteSpace(SearchSolicitudEstado)) resultado = resultado.Where(s => s.EstadoSolicitud?.Nombre == SearchSolicitudEstado);
        SolicitudesFiltradas = resultado.OrderBy(s => s.Id).ToList();
    }

    private void FiltrarVisitas()
    {
        IEnumerable<Visita> resultado = VisitasEliminadas;
        if (!string.IsNullOrWhiteSpace(SearchVisitaId)) resultado = resultado.Where(v => v.Id.ToString("D4").Contains(SearchVisitaId.Trim(), StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(SearchVisitaCliente)) resultado = resultado.Where(v => (v.Solicitud?.Cliente?.Nombre ?? "").Contains(SearchVisitaCliente.Trim(), StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(SearchVisitaServicio)) resultado = resultado.Where(v => v.Solicitud?.Servicio?.Nombre == SearchVisitaServicio);
        if (SearchVisitaFecha.HasValue) resultado = resultado.Where(v => v.Fecha.Date == SearchVisitaFecha.Value.Date);
        if (!string.IsNullOrWhiteSpace(SearchVisitaEstado)) resultado = resultado.Where(v => v.Estado == SearchVisitaEstado);
        VisitasFiltradas = resultado.OrderBy(v => v.Id).ToList();
    }

    private void AbrirDetalleSolicitud(Solicitud solicitud) { SolicitudSeleccionada = solicitud; ModoRecuperarSolicitud = false; MostrarSolicitud = true; }
    private void AbrirRecuperarSolicitud(Solicitud solicitud) { SolicitudSeleccionada = solicitud; ModoRecuperarSolicitud = true; MostrarSolicitud = true; }
    private void CerrarSolicitud() { MostrarSolicitud = false; SolicitudEnConfirmacion = false; SolicitudSeleccionada = null; }
    private void SolicitarConfirmacionSolicitud() { MostrarSolicitud = false; SolicitudEnConfirmacion = true; }
    private void CancelarConfirmacionSolicitud() { SolicitudEnConfirmacion = false; MostrarSolicitud = true; }

    private async Task RecuperarSolicitudAsync()
    {
        if (!AppState.EsAdministrador || SolicitudSeleccionada is null) return;
        var id = SolicitudSeleccionada.Id;
        try
        {
            if (!await SolicitudService.RecuperarAsync(id))
            {
                ToastService.ShowWarning("La solicitud ya no está disponible para recuperar.", "Atención");
                return;
            }
            SolicitudEnConfirmacion = false;
            SolicitudSeleccionada = null;
            await CargarDatosAsync();
            ToastService.ShowSuccess("La solicitud y sus visitas recuperables volvieron a estar disponibles.", "Éxito");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo recuperar la solicitud {SolicitudId}.", id);
            ToastService.ShowError("Ocurrió un error al recuperar la solicitud.", "Error");
        }
    }

    private void AbrirDetalleVisita(Visita visita) { VisitaSeleccionada = visita; ModoRecuperarVisita = false; MostrarVisita = true; }
    private void AbrirRecuperarVisita(Visita visita) { VisitaSeleccionada = visita; ModoRecuperarVisita = true; MostrarVisita = true; }
    private void CerrarVisita() { MostrarVisita = false; VisitaEnConfirmacion = false; VisitaSeleccionada = null; }
    private void SolicitarConfirmacionVisita() { MostrarVisita = false; VisitaEnConfirmacion = true; }
    private void CancelarConfirmacionVisita() { VisitaEnConfirmacion = false; MostrarVisita = true; }

    private async Task RecuperarVisitaAsync()
    {
        if (!AppState.EsAdministrador || VisitaSeleccionada is null) return;
        var id = VisitaSeleccionada.Id;
        try
        {
            if (!await VisitaService.RecuperarAsync(id))
            {
                ToastService.ShowWarning("La visita ya no está disponible para recuperar.", "Atención");
                return;
            }
            VisitaEnConfirmacion = false;
            VisitaSeleccionada = null;
            await CargarDatosAsync();
            ToastService.ShowSuccess("La visita volvió a estar disponible en la agenda y los levantamientos.", "Éxito");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo recuperar la visita {VisitaId}.", id);
            ToastService.ShowError("Ocurrió un error al recuperar la visita.", "Error");
        }
    }
}
</file>

<file path="Components/Pages/Gerente/Cobros.razor">
@page "/cobros"
@inject ElectroGestion.Services.CobroService CobroService
@inject ElectroGestion.Services.AppStateService AppState
@inject BlazorBootstrap.ToastService ToastService

<PageTitle>Cobros | ElectroGestion</PageTitle>
<style>
    .cobros-filtros{display:flex;flex-direction:column;gap:18px;padding:18px;border-bottom:1px solid #EFF0F6}.cobros-fila{display:flex;align-items:center;gap:18px;flex-wrap:wrap}.cobro-filtro{display:flex;align-items:center;gap:9px}.cobro-filtro label{font-family:'Manrope';font-size:14px;font-weight:800;color:#14162B;white-space:nowrap}.cobro-filtro input,.cobro-filtro select{padding:9px 11px;border:1px solid #D5D8E6;border-radius:7px;background:#fff;color:#4A4E63}
</style>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap"><div><div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Cobros</div><div style="color:#6B7085;font-size:14.5px;margin-top:5px">Registra pagos de órdenes listas para cobro y emite su factura.</div></div><button @onclick="AbrirNuevo" disabled="@(!OrdenesCobrables.Any())" style="padding:11px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:9px;font-weight:700;cursor:pointer">+ Nuevo cobro</button></div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;overflow:hidden;margin-bottom:18px"><div class="cobros-filtros"><div class="cobros-fila">
    <div class="cobro-filtro"><label for="cobro-id">ID:</label><input id="cobro-id" @bind="FiltroId" @bind:event="oninput" placeholder="ID" style="width:120px" /></div>
    <div class="cobro-filtro"><label for="cobro-cliente">Cliente:</label><input id="cobro-cliente" @bind="FiltroCliente" @bind:event="oninput" placeholder="Nombre del cliente" style="width:220px" /></div>
    <div class="cobro-filtro"><label for="cobro-factura">Factura:</label><input id="cobro-factura" @bind="FiltroFactura" @bind:event="oninput" placeholder="Número" style="width:140px" /></div>
    <div class="cobro-filtro"><label for="cobro-estado">Estado:</label><select id="cobro-estado" @bind="FiltroEstado" style="width:170px"><option value="">Todos</option><option value="Pendiente de cobro">Pendiente de cobro</option><option>Finalizada</option></select></div>
    <button @onclick="() => StateHasChanged()" style="margin-left:auto;padding:9px 20px;border:0;border-radius:7px;background:#1D4ED8;color:#fff;font-weight:700;cursor:pointer">Buscar</button>
</div></div>
<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:14px"><thead style="background:#F8F9FC"><tr><th style="padding:14px 12px;text-align:left">ID</th><th style="padding:14px 12px;text-align:left">Orden</th><th style="padding:14px 12px;text-align:left">Cliente</th><th style="padding:14px 12px;text-align:left">Factura</th><th style="padding:14px 12px;text-align:left">Fecha</th><th style="padding:14px 12px;text-align:left">Método</th><th style="padding:14px 12px;text-align:right">Monto</th><th style="padding:14px 12px;text-align:left">Estado</th><th style="padding:14px 12px;text-align:center">Acciones</th></tr></thead><tbody>
@if (Cargando) { <tr><td colspan="9" style="padding:25px;text-align:center">Cargando cobros...</td></tr> }
else if (!Filtrados.Any()) { <tr><td colspan="9" style="padding:25px;text-align:center;color:#6B7085">No hay cobros para los filtros seleccionados.</td></tr> }
else { @foreach (var cobro in Filtrados) { var (bg, fg) = ElectroGestion.Services.AppStateService.GetBadgeColors(cobro.Estado); <tr style="border-top:1px solid #EFF0F6"><td style="padding:13px 12px">@cobro.Id</td><td style="padding:13px 12px">@cobro.OrdenTrabajo?.Code</td><td style="padding:13px 12px">@cobro.Cliente</td><td style="padding:13px 12px">@cobro.FacturaId</td><td style="padding:13px 12px">@cobro.Fecha.ToString("dd/MM/yyyy")</td><td style="padding:13px 12px">@cobro.MetodoPago</td><td style="padding:13px 12px;text-align:right;font-weight:700">RD$ @cobro.Monto.ToString("N2")</td><td style="padding:13px 12px"><span style="padding:4px 10px;border-radius:20px;font-size:12px;font-weight:700;background:@bg;color:@fg">@cobro.Estado</span></td><td style="padding:13px 12px"><div style="display:flex;justify-content:center;gap:7px"><button @onclick="() => VerFactura(cobro)" style="padding:7px 9px;background:#fff;border:1px solid #D5D8E6;border-radius:7px;cursor:pointer">Factura</button>@if (cobro.Estado == "Pendiente de cobro") { <button @onclick="() => ConfirmarCobroId = cobro.Id" style="padding:7px 9px;background:#059669;color:white;border:0;border-radius:7px;cursor:pointer">Finalizar</button> }</div></td></tr> } }
</tbody></table></div></div>

@if (ModalAbierto)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px" @onclick="CerrarModal"><div style="background:#fff;border-radius:16px;width:100%;max-width:540px;padding:28px;box-shadow:0 20px 40px rgba(0,0,0,.2)" @onclick:stopPropagation><h2 style="margin:0 0 18px;font-family:'Manrope'">Nuevo cobro</h2><label style="font-weight:700">Orden pendiente de cobro</label><select @bind="OrdenSeleccionadaId" style="display:block;width:100%;padding:10px;margin:6px 0 15px;border:1px solid #D5D8E6;border-radius:8px"><option value="0">Seleccione una orden</option>@foreach(var orden in OrdenesCobrables){<option value="@orden.Id">@orden.Code · @orden.Cliente</option>}</select>@if (OrdenSeleccionada is not null){<div style="background:#F7F8FC;padding:12px;border-radius:9px;margin-bottom:15px"><b>Cliente:</b> @OrdenSeleccionada.Cliente<br/><b>Total de cotización:</b> RD$ @(OrdenSeleccionada.Cotizacion?.MontoTotal.ToString("N2") ?? "0.00")</div>}<label style="font-weight:700">Método de pago</label><select @bind="MetodoPago" style="display:block;width:100%;padding:10px;margin:6px 0 20px;border:1px solid #D5D8E6;border-radius:8px"><option>Efectivo</option><option>Transferencia</option><option>Cheque</option><option>Tarjeta de Crédito</option></select><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="CerrarModal" style="padding:10px 16px;border:1px solid #D5D8E6;background:white;border-radius:8px">Cancelar</button><button @onclick="GuardarCobro" style="padding:10px 18px;border:0;background:#1D4ED8;color:white;border-radius:8px">Crear cobro</button></div></div></div> }

@if (ConfirmarCobroId.HasValue)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:10000;padding:20px"><div style="background:#fff;border-radius:16px;max-width:400px;padding:28px"><h3>Finalizar cobro</h3><p>¿Confirma que el pago fue recibido? La orden y la solicitud pasarán a finalizadas.</p><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="() => ConfirmarCobroId = null">Cancelar</button><button @onclick="FinalizarCobro" style="padding:9px 16px;background:#059669;color:white;border:0;border-radius:8px">Confirmar pago</button></div></div></div> }

@if (FacturaSeleccionada?.OrdenTrabajo?.Cotizacion is not null)
{ <CotizacionDocumento Cotizacion="FacturaSeleccionada.OrdenTrabajo.Cotizacion" OnClose="CerrarFactura" EsFactura="true" NumeroFactura="FacturaSeleccionada.FacturaId" MetodoPago="FacturaSeleccionada.MetodoPago" /> }

@code {
    private List<ElectroGestion.Models.Cobro> ListaCobros = [];
    private List<ElectroGestion.Models.OrdenTrabajo> OrdenesCobrables = [];
    private bool Cargando, ModalAbierto;
    private string FiltroId = "", FiltroCliente = "", FiltroFactura = "", FiltroEstado = "", MetodoPago = "Transferencia";
    private int OrdenSeleccionadaId;
    private int? ConfirmarCobroId;
    private ElectroGestion.Models.Cobro? FacturaSeleccionada;
    private ElectroGestion.Models.OrdenTrabajo? OrdenSeleccionada => OrdenesCobrables.FirstOrDefault(o => o.Id == OrdenSeleccionadaId);
    private IEnumerable<ElectroGestion.Models.Cobro> Filtrados => ListaCobros.Where(c =>
        (string.IsNullOrWhiteSpace(FiltroId) || c.Id.ToString().Contains(FiltroId)) &&
        (string.IsNullOrWhiteSpace(FiltroCliente) || c.Cliente.Contains(FiltroCliente, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroFactura) || c.FacturaId.ToString().Contains(FiltroFactura)) &&
        (string.IsNullOrWhiteSpace(FiltroEstado) || c.Estado == FiltroEstado));
    protected override async Task OnInitializedAsync() => await Recargar();
    private async Task Recargar() { Cargando = true; try { ListaCobros = await CobroService.ObtenerTodosAsync(); OrdenesCobrables = await CobroService.ObtenerOrdenesCobrablesAsync(); } catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudieron cargar los cobros.")); } finally { Cargando = false; } }
    private void AbrirNuevo() { OrdenSeleccionadaId = 0; MetodoPago = "Transferencia"; ModalAbierto = true; }
    private void CerrarModal() => ModalAbierto = false;
    private async Task GuardarCobro() { if (OrdenSeleccionadaId <= 0) { ToastService.Notify(new ToastMessage(ToastType.Warning, "Seleccione una orden pendiente de cobro.")); return; } if (await CobroService.CrearAsync(OrdenSeleccionadaId, MetodoPago)) { CerrarModal(); ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro pendiente creado.")); await Recargar(); } else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo crear el cobro para esa orden.")); }
    private async Task FinalizarCobro() { if (!ConfirmarCobroId.HasValue) return; var id = ConfirmarCobroId.Value; ConfirmarCobroId = null; if (await CobroService.CambiarEstadoAsync(id, "Finalizada")) { ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro finalizado; solicitud y orden finalizadas.")); await Recargar(); } }
    private void VerFactura(ElectroGestion.Models.Cobro cobro) => FacturaSeleccionada = cobro;
    private void CerrarFactura() => FacturaSeleccionada = null;
}
</file>

<file path="Components/Pages/Tecnico/Solicitudes.razor">
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.SolicitudService SolicitudService
@inject ElectroGestion.Services.ClienteService ClienteService
@inject ElectroGestion.Services.ServicioService ServicioService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject ToastService ToastService

<PageTitle>Solicitudes de Campo | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:18px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.8px;color:#1f2430;line-height:1.15">Solicitudes</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Registro de las necesidades de los clientes.</div>
    </div>
    <button @onclick="NuevaSolicitud" style="padding:10px 16px 10px 18px;background:#1D4ED8;color:#fff;border:0;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';white-space:nowrap;display:flex;align-items:center;gap:8px">
        <span style="font-size:20px;line-height:1;transform:translateY(-1px)">+</span>
        <span>Nueva solicitud</span>
    </button>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;overflow:hidden">
    <div style="display:flex;flex-direction:column;gap:18px;padding:18px 18px 12px;border-bottom:1px solid #EFF0F6">
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px;min-width:180px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" placeholder="ID de solicitud" style="width:150px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px;min-width:260px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Cliente:</span>
                <input @bind="SearchCliente" placeholder="Nombre del cliente" style="width:210px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px;min-width:260px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Tipo de Servicio:</span>
                <select @bind="SearchTipo" style="width:220px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="">Seleccione Servicio</option>
                    @foreach (var tipo in TiposServicio)
                    {
                        <option value="@tipo">@tipo</option>
                    }
                </select>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px;min-width:230px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Fecha Solicitud:</span>
                <input type="date" @bind="SearchFecha" style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px;min-width:250px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Estado:</span>
                <select @bind="SearchEstado" style="width:180px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="Todos los estados">Todos los estados</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="En proceso">En proceso</option>
                    <option value="En Espera Administración">En Espera Administración</option>
                    <option value="Finalizada">Finalizada</option>
                    <option value="Cancelada">Cancelada</option>
                </select>
            </div>
            <div style="margin-left:auto;display:flex;justify-content:flex-end">
                <button @onclick="Filtrar" style="padding:10px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';display:flex;align-items:center;justify-content:center;gap:8px;min-width:130px">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 5 5"/></svg>
                    <span>Buscar</span>
                </button>
            </div>
        </div>
    </div>

    <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:14px;table-layout:fixed">
            <thead>
                <tr style="border-bottom:1px solid #EFF0F6;background:#FAFAFC;color:#6B7085;font-family:'Manrope';font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:0.5px">
                    <th @onclick='() => OrdenarPor("Id")' style="padding:14px 18px;text-align:left;width:12%;cursor:pointer;user-select:none" title="Ordenar por ID">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>ID</span>
                            @if (SortColumn == "Id") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Cliente")' style="padding:14px 18px;text-align:left;width:22%;cursor:pointer;user-select:none" title="Ordenar por Cliente">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Cliente</span>
                            @if (SortColumn == "Cliente") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Servicio")' style="padding:14px 18px;text-align:left;width:22%;cursor:pointer;user-select:none" title="Ordenar por Tipo de Servicio">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Tipo de Servicio</span>
                            @if (SortColumn == "Servicio") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Fecha")' style="padding:14px 18px;text-align:left;width:18%;cursor:pointer;user-select:none" title="Ordenar por Fecha Solicitud">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Fecha Solicitud</span>
                            @if (SortColumn == "Fecha") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Estado")' style="padding:14px 18px;text-align:left;width:15%;cursor:pointer;user-select:none" title="Ordenar por Estado">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Estado</span>
                            @if (SortColumn == "Estado") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th style="padding:14px 18px;text-align:right;width:11%">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredSolicitudes.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="padding:32px;text-align:center;color:#6B7085">
                            No se encontraron solicitudes con los filtros indicados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in FilteredSolicitudes)
                    {
                        <tr style="border-bottom:1px solid #EFF0F6">
                            <td style="padding:18px;vertical-align:middle">
