    <div style="position:fixed;inset:0;background:rgba(20,22,43,.55);display:flex;align-items:center;justify-content:center;z-index:10003;padding:20px" @onclick="() => CotizacionAEliminar = null">
        <div style="background:#fff;width:100%;max-width:430px;border-radius:14px;padding:24px" @onclick:stopPropagation>
            <h3 style="margin:0 0 10px">Eliminar cotización</h3>
            <p style="color:#4A4E63">¿Desea eliminar la cotización COT-@CotizacionAEliminar.Value.ToString("D5")? Esta acción no se puede deshacer.</p>
            <div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="() => CotizacionAEliminar = null" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer">Cancelar</button><button @onclick="ConfirmarEliminacion" style="padding:9px 14px;border:0;background:#C4141B;color:#fff;border-radius:8px;cursor:pointer">Eliminar cotización</button></div>
        </div>
