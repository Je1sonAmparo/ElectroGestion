            </div>
        </div>
    </div>
}

@code {
    private string SearchCodigo = "";
    private string SearchNombre = "";
    private string SearchCategoria = "";

    private void Filtrar()
    {
        StateHasChanged();
    }

    private bool IsModalOpen = false;
    private string ModalTitle = "";
    private int? EditId = null;
    private ElectroGestion.Models.ArticuloInventario? SelectedArticulo;

    private string FormCodigo = "";
    private string FormNombre = "";
    private string FormCategoria = "";
    private int FormCantidad = 0;
    private decimal FormPrecio = 0;

    private List<ElectroGestion.Models.ArticuloInventario> FilteredInventario => AppState.Inventario
        .Where(a => {
            bool matchCod = string.IsNullOrEmpty(SearchCodigo) || a.Codigo.Contains(SearchCodigo, StringComparison.OrdinalIgnoreCase);
            bool matchNombre = string.IsNullOrEmpty(SearchNombre) || a.Nombre.Contains(SearchNombre, StringComparison.OrdinalIgnoreCase);
            bool matchCat = string.IsNullOrEmpty(SearchCategoria) || a.Categoria.Contains(SearchCategoria, StringComparison.OrdinalIgnoreCase);
            return matchCod && matchNombre && matchCat;
        })
        .OrderByDescending(a => a.Id)
        .ToList();

    private void AbrirModal(int? id = null)
    {
        EditId = id;
        if (id.HasValue)
        {
            ModalTitle = "Editar Artículo";
            var item = AppState.Inventario.First(x => x.Id == id.Value);
            FormCodigo = item.Codigo;
            FormNombre = item.Nombre;
            FormCategoria = item.Categoria;
            FormCantidad = item.Cantidad;
            FormPrecio = item.PrecioUnidad;
        }
        else
        {
            ModalTitle = "Nuevo Artículo";
            FormCodigo = "";
            FormNombre = "";
            FormCategoria = "";
            FormCantidad = 0;
            FormPrecio = 0;
        }
        IsModalOpen = true;
    }

    private void CerrarModal()
    {
        IsModalOpen = false;
    }

    private void GuardarArticulo()
    {
        if (string.IsNullOrWhiteSpace(FormCodigo) || string.IsNullOrWhiteSpace(FormNombre) || FormPrecio < 0 || FormCantidad < 0)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Complete todos los campos correctamente."));
            return;
        }

        if (EditId.HasValue)
        {
            var item = AppState.Inventario.First(x => x.Id == EditId.Value);
            item.Codigo = FormCodigo;
            item.Nombre = FormNombre;
            item.Categoria = FormCategoria;
            item.Cantidad = FormCantidad;
            item.PrecioUnidad = FormPrecio;
            ToastService.Notify(new ToastMessage(ToastType.Success, "Artículo actualizado con éxito."));
        }
        else
        {
            var nuevo = new ElectroGestion.Models.ArticuloInventario
            {
                Id = AppState.NextArticuloId(),
                Codigo = FormCodigo,
                Nombre = FormNombre,
                Categoria = FormCategoria,
                Cantidad = FormCantidad,
                PrecioUnidad = FormPrecio
            };
            AppState.Inventario.Add(nuevo);
            ToastService.Notify(new ToastMessage(ToastType.Success, "Artículo creado con éxito."));
        }

        AppState.NotifyStateChanged();
        CerrarModal();
    }

    private void VerDetalle(int id)
    {
        SelectedArticulo = AppState.Inventario.FirstOrDefault(c => c.Id == id);
    }

    private void CerrarDetalle()
    {
        SelectedArticulo = null;
    }
}
</file>

<file path="Components/Pages/Gerente/Ordenes.razor">
@implements IDisposable
@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager
@inject BlazorBootstrap.ToastService ToastService

<PageTitle>Órdenes de Trabajo (Administración) | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
