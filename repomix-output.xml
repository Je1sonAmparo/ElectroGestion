        <div>
            <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Gestión de Usuarios</div>
            <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Administra los accesos al sistema.</div>
        </div>
    </div>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;overflow:hidden">
    <div style="display:grid;grid-template-columns:1fr 1.2fr 1fr .9fr 110px;padding:14px 18px;font-size:12px;font-weight:800;color:#8B90A3;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #EFF0F6"
        class="resp-table-row">
