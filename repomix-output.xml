            bool matchEst = string.IsNullOrEmpty(SearchEstado) || c.Estado.Equals(SearchEstado, StringComparison.OrdinalIgnoreCase);
            return matchId && matchSol && matchCliente && matchEst;
        })
        .OrderByDescending(c => c.Id)
        .ToList();

    private void AbrirModal(int? id = null)
    {
        EditId = id;
        if (id.HasValue)
        {
            ModalTitle = "Editar Cotización";
            var item = AppState.Cotizaciones.First(x => x.Id == id.Value);
            FormSolicitudId = item.SolicitudId;
            FormCliente = item.Cliente;
            FormMonto = item.MontoTotal;
            FormEstado = item.Estado;
        }
        else
        {
            ModalTitle = "Nueva Cotización";
            FormSolicitudId = "";
            FormCliente = "";
            FormMonto = 0;
            FormEstado = "Pendiente";
        }
        IsModalOpen = true;
    }

    private void CerrarModal()
    {
        IsModalOpen = false;
    }

    private void GuardarCotizacion()
    {
        if (string.IsNullOrWhiteSpace(FormSolicitudId) || string.IsNullOrWhiteSpace(FormCliente) || FormMonto <= 0)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Complete todos los campos correctamente."));
            return;
        }

        if (EditId.HasValue)
        {
            var item = AppState.Cotizaciones.First(x => x.Id == EditId.Value);
            item.SolicitudId = FormSolicitudId;
            item.Cliente = FormCliente;
            item.MontoTotal = FormMonto;
            item.Estado = FormEstado;
            ToastService.Notify(new ToastMessage(ToastType.Success, "Cotización actualizada con éxito."));
        }
        else
        {
            var nueva = new ElectroGestion.Models.Cotizacion
            {
                Id = AppState.NextCotizacionId(),
                SolicitudId = FormSolicitudId,
                Cliente = FormCliente,
                MontoTotal = FormMonto,
                Fecha = DateTime.Today,
                Estado = "Pendiente"
            };
            AppState.Cotizaciones.Add(nueva);
            ToastService.Notify(new ToastMessage(ToastType.Success, "Cotización creada con éxito."));
        }

        AppState.NotifyStateChanged();
        CerrarModal();
    }

    private void VerDetalle(int id)
    {
        SelectedCotizacion = AppState.Cotizaciones.FirstOrDefault(c => c.Id == id);
    }

    private void CerrarDetalle()
    {
        SelectedCotizacion = null;
    }
}
