@inherits LayoutComponentBase
@implements IDisposable
@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager
@inject BlazorBootstrap.ToastService ToastService

@if (!AppState.IsAuthenticated)
{
    <ElectroGestion.Components.Pages.Compartidas.Login />
}
else
{
    <div style="min-height:100vh;display:flex">
        <aside class="@(SidebarCollapsed ? "is-collapsed" : "is-open")"
          style="width:@(SidebarCollapsed ? "80px" : "250px");flex:0 0 @(SidebarCollapsed ? "80px" : "250px");background:#fff;border-right:1px solid #E3E5EE;display:flex;flex-direction:column;padding:24px 0;position:sticky;top:0;height:100vh;transition:width 0.3s cubic-bezier(0.4, 0, 0.2, 1)">
          <button @onclick="ToggleSidebar" class="sidebar-toggle-btn"
            style="position:absolute;top:28px;right:-14px;width:28px;height:28px;border:1px solid #E3E5EE;background:#fff;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#6B7085;z-index:10;box-shadow:0 2px 5px rgba(0,0,0,0.05)">
            @if (SidebarCollapsed)
            {
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.3"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18l6-6-6-6" />
              </svg>
            }
            else
            {
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.3"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            }
          </button>
          
          <div style="padding:32px 0 28px;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:3px;overflow:hidden;width:100%;cursor:pointer" @onclick='() => NavManager.NavigateTo("/")'>
            @if (!SidebarCollapsed)
            {
              <div style="display:flex;align-items:center;justify-content:center;width:100%;padding-left:14px;padding-right:14px">
                <svg viewBox="10 0 74 60" width="42" height="34" style="flex:0 0 auto">
                  <defs>
                    <mask id="bolt-mask-sidebar-row">
                      <rect width="100" height="60" fill="white" />
                      <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="black" stroke="black" stroke-width="2.5"
                        stroke-linejoin="round" />
                    </mask>
                  </defs>
                  <text x="10" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#1D4ED8" letter-spacing="-1.5">E</text>
                  <text x="44" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#F59E0B" mask="url(#bolt-mask-sidebar-row)" letter-spacing="-1.5">G</text>
                  <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="#F59E0B" stroke="#F59E0B" stroke-width="0" stroke-linejoin="round" />
                </svg>
                <div style="font-family:'Manrope';font-weight:900;font-size:20px;letter-spacing:-0.5px;white-space:nowrap;line-height:1;margin-top:2px;margin-left:4px">
                  <span style="color:#1D4ED8">ELECTRO</span><span style="color:#334155">GESTIÓN</span>
                </div>
              </div>
            }
            else
            {
              <div style="display:flex;align-items:center;justify-content:center;width:100%">
                <svg viewBox="10 0 74 60" width="52" height="42">
                  <defs>
                    <mask id="bolt-mask-sidebar-col">
                      <rect width="100" height="60" fill="white" />
                      <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="black" stroke="black" stroke-width="2.5" stroke-linejoin="round" />
                    </mask>
                  </defs>
                  <text x="10" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#1D4ED8" letter-spacing="-1.5">E</text>
                  <text x="44" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#F59E0B" mask="url(#bolt-mask-sidebar-col)" letter-spacing="-1.5">G</text>
                  <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="#F59E0B" stroke="#F59E0B" stroke-width="0" stroke-linejoin="round" />
                </svg>
              </div>
            }
          </div>

          <nav style="display:flex;flex-direction:column;gap:4px;padding:0 12px;overflow-y:auto">
            @foreach (var item in GetNavItems())
            {
                var isActive = IsActiveRoute(item.Href);
                <NavLink class="@($"nav-item-btn {(isActive ? "active" : "")}")" 
                         href="@item.Href" 
                         Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" 
                         style="@($"position:relative;display:flex;align-items:center;gap:12px;width:100%;text-align:left;border:0;cursor:pointer;padding:12px {(SidebarCollapsed ? "16px" : "14px")};border-radius:10px;font-size:14.5px;font-weight:{(isActive ? "800" : "600")};background:{(isActive ? "#EDEBFF" : "transparent")};color:{(isActive ? "#1D4ED8" : "#4A4E63")};transition:all 0.2s;text-decoration:none;")"
                         title="@(SidebarCollapsed ? item.Label : "")">
