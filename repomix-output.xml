            <div class="report-overview-card report-overview-disabled" aria-disabled="true">
                <span class="report-icon report-icon-green" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.3 11.2a3.3 3.3 0 1 0 0-6.6 3.3 3.3 0 0 0 0 6.6ZM3.5 20.3c0-3.3 2.6-5.7 5.8-5.7s5.8 2.4 5.8 5.7M16.2 5.3a3.1 3.1 0 0 1 0 5.9M17.2 15c1.9.7 3.3 2.7 3.3 5.3"/></svg>
                </span>
                <span class="report-card-title">Rendimiento de Técnicos</span>
                <span class="report-card-description">Productividad, servicios completados y métricas por técnico.</span>
                <span class="report-card-disabled-label">Próximamente</span>
            </div>
        </section>
    }
    else if (View == ConsumptionListView)
    {
        <nav class="report-breadcrumb" aria-label="Ruta de navegación">
            <button @onclick="GoOverview">Reportes</button>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Consumo en Servicios</span>
        </nav>

        <div class="report-section-heading">
            <h2>Reportes de Consumo en Servicios</h2>
            <p>Seleccione el reporte que desea visualizar.</p>
        </div>

        <section class="report-list" aria-label="Reportes de consumo">
            <button class="report-list-item report-list-active" @onclick="OpenAnnualReport">
                <span class="report-icon report-icon-blue" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 6.5h15v14h-15zM4.5 11h15M8.5 3.8v4M15.5 3.8v4"/></svg>
                </span>
                <span class="report-list-copy">
                    <span class="report-list-title">Reporte de Consumo en Servicios del último año</span>
                    <span class="report-list-description">Vista general de servicios y materiales utilizados durante el año.</span>
                </span>
                <svg class="report-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>

            <div class="report-list-item report-list-disabled" aria-disabled="true">
                <span class="report-icon report-icon-muted" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 6.5h15v14h-15zM4.5 11h15M8.5 3.8v4M15.5 3.8v4"/></svg>
                </span>
                <span class="report-list-copy">
                    <span class="report-list-title">Reporte de Consumo Mensual</span>
                    <span class="report-list-description">Desglose mensual de recursos consumidos. (Próximamente)</span>
                </span>
            </div>

            <div class="report-list-item report-list-disabled" aria-disabled="true">
                <span class="report-icon report-icon-muted" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg>
                </span>
                <span class="report-list-copy">
                    <span class="report-list-title">Reporte de Materiales por Técnico</span>
                    <span class="report-list-description">Consumo específico asignado a cada técnico de campo. (Próximamente)</span>
                </span>
            </div>
        </section>
    }
    else
    {
        <nav class="report-breadcrumb" aria-label="Ruta de navegación">
            <button @onclick="GoOverview">Reportes</button>
            <span aria-hidden="true">/</span>
            <button @onclick="OpenConsumptionList">Consumo en Servicios</button>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Reporte de Consumo en Servicios del último año</span>
        </nav>

        <section class="report-filter-bar" aria-label="Filtros del reporte">
            <div class="report-period">
                <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 6.5h15v14h-15zM4.5 11h15M8.5 3.8v4M15.5 3.8v4"/></svg>
                <span>Período: <strong>Último Año</strong></span>
            </div>
            <label class="report-filter-control">
                <span class="visually-hidden">Año del reporte</span>
                <select @bind="SelectedYear">
                    @foreach (var year in Years)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </label>
            <label class="report-filter-control report-category-control">
                <span>Categoría:</span>
                <select @bind="SelectedCategory">
                    <option value="Todos los Servicios">Todos los Servicios</option>
                    @foreach (var row in ReportRows)
                    {
                        <option value="@row.Servicio">@row.Servicio</option>
                    }
                </select>
            </label>
            <button class="report-update-button" @onclick="UpdateReport">Actualizar Reporte</button>
        </section>

        <section class="report-metrics-layout" aria-label="Indicadores del reporte @AppliedYear">
            <div class="report-metric-stack">
                <article class="report-metric-card">
                    <div class="report-metric-label">Total Consumo (RD$)</div>
                    <div class="report-metric-value">@FormatMoney(TotalConsumption)</div>
                </article>
                <article class="report-metric-card">
                    <div class="report-metric-label">Costo de Inventario<br />en Riesgo de Merma (RD$)</div>
                    <div class="report-metric-value">@FormatMoney(InventoryRisk)</div>
                </article>
            </div>
            <div class="report-metric-stack">
                <article class="report-metric-card">
                    <div class="report-metric-label">Costo Promedio de Consumo<br />por Instalación (RD$)</div>
                    <div class="report-metric-value">@FormatMoney(AverageConsumption)</div>
                </article>
                <article class="report-metric-card">
                    <div class="report-metric-label">Servicio con Mayor Consumo</div>
                    <div class="report-metric-service">@HighestConsumptionService</div>
                </article>
            </div>
            <article class="report-chart-card">
                <h2>Porcentaje de Consumo de Materiales por Servicio</h2>
                <div class="report-donut-layout">
                    <svg class="report-donut-svg" viewBox="0 0 220 220" role="img" aria-label="Distribución real del consumo de materiales por servicio">
                        <g transform="translate(45 0)">
                            <g transform="translate(100 110) rotate(-90) translate(-100 -110)">
                                @foreach (var segment in DonutSegments)
                                {
                                    <circle cx="100" cy="110" r="55" fill="none" stroke="@segment.Color" stroke-width="30" stroke-dasharray="@($"{FormatNumber(segment.Length)} {FormatNumber(DonutCircumference - segment.Length)}")" stroke-dashoffset="@(-segment.Offset)" />
                                }
                            </g>
                            <circle cx="100" cy="110" r="40" fill="#fff" stroke="#E3E5EE" stroke-width="1.5" />
                        </g>
                    </svg>
                    <div class="report-legend">
                        @foreach (var segment in DonutSegments)
                        {
                            <div><span class="legend-swatch" style="background:@segment.Color"></span>@segment.Servicio (@FormatPercent(segment.Porcentaje))%</div>
                        }
                        @if (DonutSegments.Count == 0)
                        {
                            <div>Sin consumo registrado en el período.</div>
                        }
                    </div>
                </div>
            </article>
        </section>

        <section class="report-data-layout" aria-label="Detalle del consumo">
            <div class="report-table-wrap">
                <table class="report-data-table">
                    <thead>
                        <tr>
                            <th>Servicio de Instalación</th>
                            <th>Materiales (RD$)</th>
                            <th>Consumibles (RD$)</th>
                            <th>Total (RD$)</th>
                            <th>Instalaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in VisibleRows)
                        {
                            <tr>
                                <th scope="row">@row.Servicio</th>
                                <td>RD$ @FormatMoney(row.Materiales)</td>
                                <td>RD$ @FormatMoney(row.Consumibles)</td>
                                <td class="report-row-total">RD$ @FormatMoney(row.Total)</td>
                                <td class="report-installations">@row.Instalaciones</td>
                            </tr>
                        }
                        @if (AppliedCategory == AllServices)
                        {
                            <tr class="report-total-row">
                                <th scope="row">TOTAL</th>
                                <td>RD$ @FormatMoney(TotalMaterials)</td>
                                <td>RD$ @FormatMoney(TotalConsumables)</td>
                                <td>RD$ @FormatMoney(TotalConsumption)</td>
                                <td class="report-installations">@InstallationCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <article class="report-monthly-card">
                <h2>Tendencia Mensual de Consumo (Costo)</h2>
                <div class="report-bar-chart" role="img" aria-label="Tendencia mensual de consumo de materiales en @AppliedYear">
                    <div class="report-y-axis">@foreach(var mark in AxisMarks){<span>@FormatAxis(mark)</span>}</div>
                    <div class="report-bars">
                        @foreach(var mes in VisibleMonths){<div class="report-bar-column"><strong>@FormatMoney(mes.Total)</strong><span class="report-bar" style="--bar-height:@BarHeight(mes.Total)%"></span><span class="report-month">@mes.Etiqueta</span></div>}
                    </div>
                </div>
                <div class="report-chart-caption"><span class="legend-swatch swatch-blue-2"></span>Consumo Total (RD$)</div>
            </article>
        </section>
        <p style="margin:10px 2px;color:#6B7085;font-size:12px">El consumo se calcula con los materiales registrados en órdenes finalizadas durante el año seleccionado. Los consumibles no se registran por separado en el sistema.</p>
    }
</div>

@code {
    private const string OverviewView = "overview";
    private const string ConsumptionListView = "consumption-list";
    private const string AnnualView = "annual-consumption";
    private const string AllServices = "Todos los Servicios";

    private string View = OverviewView;
    private string SelectedYear = DateTime.Today.Year.ToString();
    private string SelectedCategory = AllServices;
    private int AppliedYear = DateTime.Today.Year;
    private string AppliedCategory = AllServices;
    private List<string> Years = [];
    private List<ElectroGestion.Services.FilaConsumoServicio> ReportRows = [];
    private List<ElectroGestion.Services.MesConsumoServicio> MonthlyRows = [];
    private readonly string[] ChartColors = ["#1D4ED8", "#3B82F6", "#60A5FA", "#93C5FD", "#BFDBFE", "#818CF8", "#A78BFA", "#34D399"];
    private const double DonutCircumference = 345.575;

    protected override async Task OnInitializedAsync()
    {
        var currentYear = DateTime.Today.Year;
        Years = Enumerable.Range(currentYear - 4, 5).Reverse().Select(y => y.ToString()).ToList();
        SelectedYear = AppliedYear.ToString();
        await LoadReportAsync(AppliedYear);
    }

    private IEnumerable<ElectroGestion.Services.FilaConsumoServicio> VisibleRows => AppliedCategory == AllServices
        ? ReportRows
        : ReportRows.Where(row => row.Servicio == AppliedCategory);

    private IEnumerable<ElectroGestion.Services.MesConsumoServicio> VisibleMonths => MonthlyRows
        .Where(row => AppliedCategory == AllServices || row.Servicio == AppliedCategory)
        .GroupBy(row => row.NumeroMes)
        .OrderBy(group => group.Key)
        .Select(group => new ElectroGestion.Services.MesConsumoServicio(
            AppliedCategory, group.Key, group.First().Etiqueta, group.Sum(row => row.Total)));
    private decimal TotalMaterials => VisibleRows.Sum(row => row.Materiales);
    private decimal TotalConsumables => VisibleRows.Sum(row => row.Consumibles);
    private decimal TotalConsumption => TotalMaterials + TotalConsumables;
    private decimal InventoryRisk => VisibleRows.Sum(row => row.RiesgoInventario);
    private int InstallationCount => VisibleRows.Sum(row => row.Instalaciones);
    private decimal AverageConsumption => InstallationCount == 0 ? 0 : TotalConsumption / InstallationCount;
    private string HighestConsumptionService
    {
        get
        {
            var top = VisibleRows.OrderByDescending(row => row.Total).FirstOrDefault();
            return top is not null && top.Total > 0 ? top.Servicio : "—";
        }
    }
    private decimal MonthlyMax => Math.Max(1m, VisibleMonths.Select(month => month.Total).DefaultIfEmpty(0m).Max());
    private IEnumerable<decimal> AxisMarks => Enumerable.Range(0, 6).Reverse().Select(i => decimal.Round(MonthlyMax * i / 5m, 0));

    private List<DonutSegment> DonutSegments
    {
        get
        {
            var rows = VisibleRows.Where(row => row.Materiales > 0).OrderByDescending(row => row.Materiales).Take(8).ToList();
            var total = rows.Sum(row => row.Materiales);
            var offset = 0d;
            var result = new List<DonutSegment>();
            for (var i = 0; i < rows.Count; i++)
            {
                var percent = total == 0 ? 0 : (double)(rows[i].Materiales / total);
                var length = DonutCircumference * percent;
                result.Add(new DonutSegment(rows[i].Servicio, percent * 100, length, offset, ChartColors[i % ChartColors.Length]));
                offset += length;
            }
            return result;
        }
    }

    private async Task LoadReportAsync(int year)
    {
        var data = await ReporteConsumoService.ObtenerAsync(year);
        ReportRows = data.Servicios.ToList();
        MonthlyRows = data.Meses.ToList();
    }

    private void OpenConsumptionList() => View = ConsumptionListView;
    private async Task OpenAnnualReport()
    {
        View = AnnualView;
        SelectedCategory = AllServices;
        AppliedCategory = AllServices;
        SelectedYear = DateTime.Today.Year.ToString();
        AppliedYear = DateTime.Today.Year;
        await LoadReportAsync(AppliedYear);
    }
    private void GoOverview() => View = OverviewView;

    private async Task UpdateReport()
    {
        if (!int.TryParse(SelectedYear, out var year)) return;
        AppliedYear = year;
        AppliedCategory = SelectedCategory;
        await LoadReportAsync(year);
    }

    private static string FormatMoney(decimal value) => value.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture);
    private static string FormatNumber(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string FormatPercent(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    private string FormatAxis(decimal value) => value.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture);
    private string BarHeight(decimal value) => Math.Max(1, (double)(value / MonthlyMax * 100m)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    private sealed record DonutSegment(string Servicio, double Porcentaje, double Length, double Offset, string Color);
}
</file>

