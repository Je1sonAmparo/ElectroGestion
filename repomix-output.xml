@code {
    private string SearchCodigo = "";
    private string SearchNombre = "";
    private string SearchCategoria = "";
    private string SearchEstado = "";

    private string SortColumn = "Id";
    private bool SortAscending = true;

    private void OrdenarPor(string columna)
    {
        if (SortColumn == columna)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortColumn = columna;
            SortAscending = true;
        }
    }

    private void Filtrar()
    {
        StateHasChanged();
    }

    private bool IsModalOpen = false;
    private string ModalTitle = "";
    private int? EditId = null;
    private ElectroGestion.Models.Servicio? SelectedServicio;

    private List<ElectroGestion.Models.Servicio> servicios = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarServicios();
    }

    private async Task CargarServicios()
    {
        servicios = await ServicioService.GetList(s => true);
    }

    private string FormServicioId = "";
    private string FormNombre = "";
    private string FormCategoria = "";
    private decimal FormPrecio = 0;
    private string FormEstado = "Activo";

    private List<ElectroGestion.Models.Servicio> FilteredServicios
    {
        get
        {
            var q = servicios.Where(s => {
                bool matchCod = string.IsNullOrEmpty(SearchCodigo) || s.ServicioId.Contains(SearchCodigo, StringComparison.OrdinalIgnoreCase);
                bool matchNombre = string.IsNullOrEmpty(SearchNombre) || s.Nombre.Contains(SearchNombre, StringComparison.OrdinalIgnoreCase);
                bool matchCat = string.IsNullOrEmpty(SearchCategoria) || (!string.IsNullOrEmpty(s.Categoria) && s.Categoria.Contains(SearchCategoria, StringComparison.OrdinalIgnoreCase));
                bool matchEst = string.IsNullOrEmpty(SearchEstado) || (!string.IsNullOrEmpty(s.Estado) && s.Estado.Equals(SearchEstado, StringComparison.OrdinalIgnoreCase));
                return matchCod && matchNombre && matchCat && matchEst;
            });

            return (SortColumn switch
            {
                "Id" => SortAscending ? q.OrderBy(s => s.Id) : q.OrderByDescending(s => s.Id),
                "Codigo" => SortAscending ? q.OrderBy(s => s.ServicioId) : q.OrderByDescending(s => s.ServicioId),
                "Nombre" => SortAscending ? q.OrderBy(s => s.Nombre) : q.OrderByDescending(s => s.Nombre),
                "Categoria" => SortAscending ? q.OrderBy(s => s.Categoria) : q.OrderByDescending(s => s.Categoria),
                "Precio" => SortAscending ? q.OrderBy(s => s.PrecioBase) : q.OrderByDescending(s => s.PrecioBase),
                "Estado" => SortAscending ? q.OrderBy(s => s.Estado) : q.OrderByDescending(s => s.Estado),
                _ => SortAscending ? q.OrderBy(s => s.Id) : q.OrderByDescending(s => s.Id)
            }).ToList();
        }
    }

    private void AbrirModal(int? id = null)
    {
        EditId = id;
        if (id.HasValue)
        {
            ModalTitle = "Editar Servicio";
            var item = servicios.First(x => x.Id == id.Value);
            FormServicioId = item.ServicioId;
            FormNombre = item.Nombre;
            FormCategoria = item.Categoria ?? "";
            FormPrecio = item.PrecioBase;
            FormEstado = item.Estado ?? "Activo";
        }
        else
        {
            ModalTitle = "Nuevo Servicio";
            FormServicioId = "";
            FormNombre = "";
            FormCategoria = "";
            FormPrecio = 0;
            FormEstado = "Activo";
        }
        IsModalOpen = true;
    }

    private bool IsDeleteModalOpen = false;
    private int? DeleteId;

    private void ConfirmarEliminar(int id)
    {
        DeleteId = id;
        IsDeleteModalOpen = true;
    }

    private async Task EjecutarEliminar()
    {
        if (DeleteId.HasValue)
        {
            var resultado = await ServicioService.Eliminar(DeleteId.Value);
            if (resultado)
            {
                ToastService.Notify(new ToastMessage(ToastType.Success, "Servicio eliminado exitosamente."));
                await CargarServicios();
            }
            else
            {
                ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudo eliminar el servicio. Verifique si tiene solicitudes asociadas."));
            }
        }
        IsDeleteModalOpen = false;
        IsModalOpen = false;
        DeleteId = null;
    }

    private void CerrarEliminar()
    {
        IsDeleteModalOpen = false;
        DeleteId = null;
    }

    private void CerrarModal()
    {
        IsModalOpen = false;
    }

    private async Task GuardarServicio()
    {
        if (string.IsNullOrWhiteSpace(FormServicioId) || string.IsNullOrWhiteSpace(FormNombre) || FormPrecio <= 0)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Complete todos los campos correctamente."));
            return;
        }

        var servicio = new ElectroGestion.Models.Servicio
        {
            Id = EditId ?? 0,
            ServicioId = FormServicioId,
            Nombre = FormNombre,
            Categoria = FormCategoria,
            PrecioBase = FormPrecio,
            Estado = FormEstado
        };

        var resultado = await ServicioService.Guardar(servicio);
        if (resultado)
        {
            ToastService.Notify(new ToastMessage(ToastType.Success, EditId.HasValue ? "Servicio actualizado con éxito." : "Servicio creado con éxito."));
            await CargarServicios();
        }
        else
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, "Error al guardar el servicio."));
        }

        CerrarModal();
    }

    private void VerDetalle(int id)
    {
        SelectedServicio = servicios.FirstOrDefault(c => c.Id == id);
    }

    private void CerrarDetalle()
    {
        SelectedServicio = null;
    }
}
</file>

<file path="Components/Pages/Gerente/Usuarios.razor">
@page "/usuarios"
@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager

<PageTitle>Usuarios | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div style="display:flex;align-items:flex-start;">
        <div>
            <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Gestión de Usuarios</div>
            <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Administra los accesos al sistema.</div>
        </div>
    </div>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;overflow:hidden">
    <div style="display:grid;grid-template-columns:1fr 1.2fr 1fr .9fr 110px;padding:14px 18px;font-size:12px;font-weight:800;color:#8B90A3;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #EFF0F6"
        class="resp-table-row">
        <div>Usuario</div>
        <div>Nombre</div>
        <div>Cargo</div>
        <div>Rol</div>
        <div style="text-align:right">Acciones</div>
    </div>
    
    @if (!UsuariosList.Any())
    {
        <div style="padding:38px;text-align:center;color:#8B90A3;font-size:14px">
            No hay usuarios registrados.
        </div>
    }
    else
    {
        @foreach (var u in UsuariosList)
        {
            var colors = GetRolColors(u.Rol);
            <div style="display:grid;grid-template-columns:1fr 1.2fr 1fr .9fr 110px;padding:16px 18px;border-bottom:1px solid #F4F5FB;align-items:center;font-size:14px"
                class="resp-table-row">
                <div style="font-family:ui-monospace,monospace;font-weight:700">@u.UsuarioLogin</div>
                <div>@u.Nombre</div>
                <div style="color:#6B7085">@u.Cargo</div>
                <div>
                    <span style="display:inline-block;padding:5px 11px;border-radius:20px;font-size:12px;font-weight:800;background:@colors.Bg;color:@colors.Fg">
                        @u.Rol
                    </span>
                </div>
                <div style="display:flex;gap:8px;justify-content:flex-end">
                    <button class="edit-btn" title="Modificar"
                        style="width:32px;height:32px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer;color:#4A4E63">✎</button>
                    <button class="del-btn" title="Eliminar"
                        style="width:32px;height:32px;border:1px solid #F5C2C4;background:#fff;border-radius:8px;cursor:pointer;color:#C4141B">✕</button>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<ElectroGestion.Models.Usuario> UsuariosList = new();

    protected override void OnInitialized()
    {
        if (!AppState.EsGerente)
        {
            NavManager.NavigateTo("/");
            return;
        }

        UsuariosList = AppState.Usuarios.OrderBy(x => x.Nombre).ToList();
    }

    private (string Bg, string Fg) GetRolColors(string rol)
    {
        return rol switch
        {
            "Gerente" => ("#F3E8FF", "#6B21A8"),
            "Administrador" => ("#FEF2F2", "#991B1B"),
            _ => ("#F0F9FF", "#075985") // Tecnico
        };
    }
}
</file>

