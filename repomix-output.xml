                        {
                            <option value="@e">@e</option>
                        }
                    </select>
                </div>
                <div style="display:flex;gap:10px;justify-content:flex-end;margin-left:auto">
                    <button class="primary-btn" @onclick="Filtrar"
                        style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Buscar</button>
                    <button class="action-btn-guardar" @onclick="GuardarLevantamientos"
                        style="padding:9px 16px;border:1px solid #1D4ED8;background:#fff;color:#1D4ED8;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer">Guardar</button>
                </div>
            </div>
        </div>
        <div style="margin-top:18px;background:#F7F8FC;border:1px solid #EFF0F6;border-radius:12px;padding:16px">
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px" class="resp-grid-3">
                @foreach (var l in FilteredLevantamientos)
                {
                    var colors = AppStateService.GetBadgeColors(l.Estado);
                    var s = solicitudes.FirstOrDefault(x => x.Id == l.SolicitudId);
                    var clienteNombre = s?.Cliente?.Nombre ?? "Desconocido";
                    var servicioNombre = s?.Servicio?.Nombre ?? "Desconocido";
                    var fecha = s == null ? "Sin programar" : $"{AppStateService.FormatFecha(s.Fecha.ToString("yyyy-MM-dd"))} {AppStateService.FormatHora12(s.Hora)}";

                    <div style="background:#fff;border:1px solid #D9DCE9;border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:2px">
                        <div style="display:flex;justify-content:flex-end">
                            <span style="display:inline-block;padding:4px 10px;border-radius:20px;font-size:11.5px;font-weight:800;background:@colors.Bg;color:@colors.Fg">
