<file path="Components/Layout/MainLayout.razor.css">
.nav-item-btn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    text-align: left;
    border: 0;
    cursor: pointer;
    border-radius: 10px;
    font-size: 14.5px;
    font-weight: 700;
    background: transparent;
    color: #4A4E63;
    --icon-d1: #6B7085;
    --icon-d2: #A1A5B7;
    transition: all 0.2s;
}

.nav-item-btn:hover {
    background: #F4F5FB;
}

.nav-item-btn.active {
    background: #EDEBFF;
    color: #1D4ED8;
    --icon-d1: #1D4ED8;
    --icon-d2: #F59E0B;
}

.nav-item-btn svg {
    display: block;
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
}

.nav-item-btn svg .path-d1 {
    stroke: var(--icon-d1);
    fill: none;
}

.nav-item-btn svg .path-d2 {
    stroke: var(--icon-d2);
    fill: none;
}

.nav-item-btn.active svg .path-d1,
.nav-item-btn[aria-current="page"] svg .path-d1 {
    stroke: #1D4ED8 !important;
}

.nav-item-btn.active svg .path-d2,
.nav-item-btn[aria-current="page"] svg .path-d2 {
    stroke: #F59E0B !important;
}

.sidebar-toggle-btn {
    transition: all 0.2s;
}

.sidebar-toggle-btn:hover {
    color: #1D4ED8 !important;
    border-color: #1D4ED8 !important;
}

.logout-btn {
    transition: all 0.2s;
}

.logout-btn:hover {
    background: #FDE9EA !important;
    border-color: #F5C2C4 !important;
}

::deep .is-collapsed {
    /* transition is inline, this is for responsive media query logic already handled in app.css */
}

::deep aside.is-open ~ .sidebar-backdrop {
    display: block !important;
}

::deep .sidebar-backdrop.show {
