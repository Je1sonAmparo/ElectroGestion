}

.home-activity-client,
.home-activity-date {
    color: #8B90A3;
    font-size: 12px;
}

.home-activity-date {
    flex: 0 0 auto;
    white-space: nowrap;
}

.home-activity-link {
    margin-top: 16px;
}

.home-quick-section {
    margin-top: 24px;
}

.home-quick-section h2 {
