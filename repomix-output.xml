<file path="Components/Pages/Compartidas/CotizacionDocumento.razor">
@inject IJSRuntime JS

<style>
    @@media print {
        @@page { size: A4; margin: 0; }
        html, body { margin: 0 !important; padding: 0 !important; }
        body * { visibility: hidden !important; }
        .cotizacion-imprimible, .cotizacion-imprimible * { visibility: visible !important; }
        .cotizacion-imprimible { position: absolute !important; inset: 0 auto auto 0 !important; box-sizing: border-box !important; width: 100% !important; max-width: none !important; max-height: none !important; min-height: 297mm !important; margin: 0 !important; padding: 14mm !important; border: 0 !important; box-shadow: none !important; color: #172033 !important; background: #fff !important; overflow: visible !important; }
        .no-print { display: none !important; }
        .documento-fila { break-inside: avoid; }
        .cotizacion-documento thead { display: table-header-group; }
    }
    .cotizacion-documento { font-family: Arial, Helvetica, sans-serif; color: #222; line-height: 1.4; }
    .cotizacion-documento table { width: 100%; border-collapse: collapse; }
    .cotizacion-tabla { table-layout: fixed; font-size: 12px; }
    .cotizacion-tabla th { border-bottom: 1px solid #777; font-weight: 700; }
    .cotizacion-tabla th, .cotizacion-tabla td { padding: 9px 7px; vertical-align: top; overflow-wrap: anywhere; }
    .cotizacion-tabla td { border-bottom: 1px solid #ddd; }
    .cotizacion-tabla td:nth-child(3), .cotizacion-tabla td:nth-child(5) { white-space: nowrap; }
    @@media (max-width:700px) { .cotizacion-datos { grid-template-columns: 1fr !important; } .cotizacion-imprimible { padding: 18px !important; } }
</style>

@if (Cotizacion is not null)
{
    var cot = Cotizacion;
    var subtotal = cot.Detalles.Sum(d => d.Subtotal) + cot.MontoManoObra;
    var anticipo = Math.Round(cot.MontoTotal * 0.5m, 2, MidpointRounding.AwayFromZero);
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9998;padding:20px" @onclick="() => OnClose.InvokeAsync()">
        <div class="cotizacion-imprimible cotizacion-documento" style="background:#fff;border-radius:14px;width:100%;max-width:820px;padding:32px;max-height:92vh;overflow:auto;box-shadow:0 20px 40px rgba(0,0,0,.2)" @onclick:stopPropagation>
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:20px;border-bottom:1px solid #777;padding-bottom:14px">
                <img src="/images/electrogestion-logo.png" alt="ElectroGestión" style="width:260px;height:auto;object-fit:contain;object-position:left center" />
                <div style="text-align:right"><div style="font-size:20px;font-weight:700">@(EsFactura ? "Factura" : "Cotización")</div><div style="font-size:14px;margin-top:4px">N.º @(EsFactura ? NumeroFactura.ToString() : $"COT-{cot.Id:D5}")</div><div style="font-size:13px;color:#555">Fecha: @FechaDocumentoEfectiva.ToString("dd/MM/yyyy HH:mm")</div>@if (EsFactura) { <div style="font-size:13px;color:#555">Método de pago: @MetodoPago</div> }</div>
            </div>
            <div class="documento-fila cotizacion-datos" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:22px 0">
                <section style="padding:4px 0;border-bottom:1px solid #ddd"><div style="font-size:11px;font-weight:700;letter-spacing:.5px;color:#555;margin-bottom:6px">CLIENTE</div>
                    <div style="font-weight:700;font-size:16px">@(cot.Solicitud?.Cliente?.Nombre ?? cot.Cliente)</div>
                    @if (!string.IsNullOrWhiteSpace(cot.Solicitud?.Cliente?.Rnc)) { <div>RNC/Cédula: @cot.Solicitud.Cliente.Rnc</div> }
                    @if (!string.IsNullOrWhiteSpace(cot.Solicitud?.Cliente?.Correo)) { <div>Correo: @cot.Solicitud.Cliente.Correo</div> }
                    @if (!string.IsNullOrWhiteSpace(cot.Solicitud?.Cliente?.Telefono)) { <div>Teléfono: @cot.Solicitud.Cliente.Telefono</div> }
                    @if (!string.IsNullOrWhiteSpace(cot.Solicitud?.Cliente?.Direccion)) { <div>Dirección: @cot.Solicitud.Cliente.Direccion</div> }
                </section>
                <section style="padding:4px 0;border-bottom:1px solid #ddd"><div style="font-size:11px;font-weight:700;letter-spacing:.5px;color:#555;margin-bottom:6px">SERVICIO</div>
                    <div><b>Solicitud:</b> @cot.SolicitudId</div><div><b>Servicio:</b> @(cot.Solicitud?.Servicio?.Nombre ?? "—")</div>
                    @if (!string.IsNullOrWhiteSpace(cot.Solicitud?.Contacto)) { <div><b>Contacto:</b> @cot.Solicitud.Contacto</div> }
                    @if (!string.IsNullOrWhiteSpace(cot.Solicitud?.Direccion)) { <div><b>Lugar del servicio:</b> @cot.Solicitud.Direccion</div> }
                </section>
            </div>
            <div style="font-size:12px;font-weight:700;color:#444;margin:18px 0 7px">DETALLE</div>
            <table class="cotizacion-tabla"><colgroup><col style="width:15%"/><col style="width:33%"/><col style="width:20%"/><col style="width:12%"/><col style="width:20%"/></colgroup><thead><tr><th style="text-align:left">Código</th><th style="text-align:left">Descripción</th><th style="text-align:right">Precio unitario</th><th style="text-align:center">Cantidad</th><th style="text-align:right">Importe</th></tr></thead><tbody>
                @foreach (var linea in cot.Detalles) { <tr class="documento-fila"><td>@linea.CodigoArticulo</td><td>@linea.NombreArticulo</td><td style="text-align:right">RD$ @FormatoDinero(linea.PrecioUnitario)</td><td style="text-align:center">@linea.Cantidad</td><td style="text-align:right">RD$ @FormatoDinero(linea.Subtotal)</td></tr> }
            </tbody></table>
            <div style="display:flex;justify-content:flex-end;margin-top:10px"><div style="min-width:280px;border-top:1px solid #777;padding-top:8px;font-size:13px"><div style="display:flex;justify-content:space-between;gap:18px"><span>Subtotal de materiales</span><span>RD$ @FormatoDinero(cot.Detalles.Sum(d => d.Subtotal))</span></div><div style="display:flex;justify-content:space-between;gap:18px"><span>Subtotal de mano de obra</span><span>RD$ @FormatoDinero(cot.MontoManoObra)</span></div><div style="display:flex;justify-content:space-between;gap:18px"><span>Subtotal neto</span><span>RD$ @FormatoDinero(subtotal)</span></div><div style="display:flex;justify-content:space-between;gap:18px"><span>ITBIS (@cot.PorcentajeItbis.ToString("N0")%)</span><span>RD$ @FormatoDinero(ElectroGestion.Services.CotizacionService.CalcularImpuesto(subtotal, cot.PorcentajeItbis))</span></div><div style="display:flex;justify-content:space-between;gap:18px;border-top:1px solid #777;margin-top:5px;padding-top:5px;font-size:16px;font-weight:700"><span>@(EsFactura ? "Total a pagar" : "Total de la cotización")</span><span>RD$ @FormatoDinero(cot.MontoTotal)</span></div></div></div>
            @if (!EsFactura)
            {
                <div class="documento-fila" style="margin-top:14px;border:1px solid #ddd;padding:10px 12px;font-size:13px"><strong>Observaciones</strong><div style="margin-top:5px"><strong>Condición de inicio:</strong> Se requiere un anticipo del 50% del total para iniciar el servicio.</div><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:6px"><span>Anticipo (50%): <b>RD$ @FormatoDinero(anticipo)</b></span><span>Saldo restante: <b>RD$ @FormatoDinero(cot.MontoTotal - anticipo)</b></span></div></div>
            }
            @if (!EsFactura) { <div style="font-size:11px;color:#555;margin-top:14px">Documento de cotización. No constituye factura ni comprobante fiscal.</div> }
            <div class="documento-fila" style="display:grid;grid-template-columns:1fr 1fr;gap:48px;margin-top:56px;text-align:center;font-size:12px">
                <div><div style="height:45px"></div><div style="border-top:1px solid #555;padding-top:6px"><b>Firma del cliente</b></div></div>
                <div><div style="height:45px"><svg width="180" height="40" viewBox="0 0 180 40" aria-hidden="true" style="display:block;margin:0 auto"><path d="M12 30c10-14 13-17 15-13 2 4-7 15-3 15 3 0 12-14 15-14 3 0-4 13-1 14 3 1 11-9 15-10 4-1 0 8 3 10 4 2 13-8 18-8 3 0 0 7 2 9 3 2 14-8 19-9 4-1 2 7 5 9 4 2 13-5 18-7 5-2 6 3 3 6 11-3 20-3 31-2" fill="none" stroke="#222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></div><div style="border-top:1px solid #555;padding-top:6px"><b>Representante</b></div></div>
            </div>
            <div class="no-print" style="display:flex;justify-content:flex-end;gap:10px;margin-top:28px;border-top:1px solid #E2E8F0;padding-top:16px;flex-wrap:wrap">
                @if (MostrarEliminar) { <button @onclick="() => OnDelete.InvokeAsync(cot.Id)" style="padding:10px 16px;border:1px solid #F5C2C4;background:#fff;color:#C4141B;border-radius:8px;font-weight:700;cursor:pointer">Eliminar</button> }
                <button @onclick="Imprimir" style="padding:10px 16px;border:0;background:#173B75;color:#fff;border-radius:8px;font-weight:700;cursor:pointer">Imprimir / Guardar como PDF</button>
                <button @onclick="() => OnClose.InvokeAsync()" style="padding:10px 16px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private static string FormatoDinero(decimal monto) => monto.ToString("N2");
    [Parameter] public ElectroGestion.Models.Cotizacion? Cotizacion { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public bool MostrarEliminar { get; set; }
    [Parameter] public bool EsFactura { get; set; }
    [Parameter] public int NumeroFactura { get; set; }
    [Parameter] public string MetodoPago { get; set; } = "";
    [Parameter] public DateTime? FechaDocumento { get; set; }
    private DateTime FechaDocumentoEfectiva => FechaDocumento ?? Cotizacion?.Fecha ?? DateTime.Now;
    private async Task Imprimir() => await JS.InvokeVoidAsync("window.print");
}
</file>

<file path="Components/Pages/Compartidas/InicioDashboard.razor">
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.InicioDashboardService DashboardService
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Inicio | ElectroGestion</PageTitle>

<div class="home-dashboard">
    <header class="home-heading">
        <h1>¡Bienvenido, @UserName!</h1>
        <p>Resumen de la operación de hoy.</p>
    </header>

    <section class="home-metrics" aria-label="Resumen operativo">
        @foreach (var metric in Metrics)
        {
            <article class="home-metric">
                <div class="home-metric-label">@metric.Label</div>
                <div class="home-metric-value">@metric.Value</div>
                <button @onclick="() => NavManager.NavigateTo(metric.Href)" class="home-text-link">@metric.Link <span aria-hidden="true">&rarr;</span></button>
            </article>
        }
    </section>

    <section class="home-operations">
        <article class="home-panel home-next-visit">
            <h2>Próxima visita</h2>
            @if (NextVisit is { } visit)
            {
                <div class="home-visit-content">
                    <div class="home-visit-details">
                        <div class="home-visit-time">@ElectroGestion.Services.AppStateService.FormatHora12(visit.Hora)</div>
                        <div class="home-visit-client">@visit.Solicitud?.Cliente?.Nombre</div>
                        <div class="home-visit-meta">@visit.Solicitud?.Servicio?.Nombre</div>
                        <div class="home-visit-meta">@visit.Solicitud?.Direccion</div>
                        <button @onclick='() => VerMapa(visit.Solicitud?.Direccion ?? "")' class="home-outline-button">Ver ubicación</button>
                    </div>
                    <div class="home-map" role="img" aria-label="Mapa de ubicación aproximada">
                        <svg viewBox="0 0 320 172" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                            <rect width="320" height="172" fill="#EFF3EC" />
                            <path d="M26 0v172M118 0v172M212 0v172M282 0v172M0 34h320M0 96h320M0 142h320" stroke="#E2E7DC" stroke-width="9" />
                            <path d="M0 66h320M166 0v172" stroke="#fff" stroke-width="14" />
                            <path d="M0 66h320M166 0v172" stroke="#F59E0B" stroke-width="7" />
                            <g fill="#DDE4D6">
                                <rect x="36" y="8" width="70" height="18" rx="2" />
                                <rect x="36" y="76" width="52" height="14" rx="2" />
                                <rect x="96" y="106" width="58" height="26" rx="2" />
                                <rect x="224" y="8" width="48" height="18" rx="2" />
                                <rect x="224" y="106" width="50" height="26" rx="2" />
                            </g>
                            <circle cx="290" cy="120" r="22" fill="#D8E6D0" />
                            <g transform="translate(166 66)">
                                <ellipse cx="0" cy="16" rx="9" ry="3.5" fill="rgba(20,22,43,.18)" />
                                <path d="M0 14s-11-11.6-11-19a11 11 0 0 1 22 0c0 7.4-11 19-11 19Z" fill="#1D4ED8" />
                                <circle cx="0" cy="-5.4" r="4" fill="#fff" />
                            </g>
                        </svg>
                        <span class="home-map-label">Ubicación aproximada</span>
                    </div>
                </div>
            }
            else
            {
                <div class="home-empty-visit">No hay visitas programadas para hoy.</div>
            }
        </article>

        <article class="home-panel home-activity">
            <h2>Actividad reciente</h2>
            @if (RecentActivity.Any())
            {
                <div class="home-activity-list">
                    @foreach (var item in RecentActivity)
                    {
                        var icon = GetServiceIcon(item.Servicio?.Nombre);
                        <div class="home-activity-row">
                            <span class="home-activity-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="@icon.D1" stroke="#1D4ED8" />
                                    <path d="@icon.D2" stroke="#F59E0B" />
                                </svg>
                            </span>
                            <div class="home-activity-copy">
                                <div class="home-activity-service">@item.Servicio?.Nombre</div>
                                <div class="home-activity-client">@item.Cliente?.Nombre</div>
                            </div>
                            <time class="home-activity-date">@ElectroGestion.Services.AppStateService.FormatFecha(item.FechaSolicitud.ToString("yyyy-MM-dd"))</time>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="home-empty-activity">Todavía no hay actividad registrada.</div>
            }
            <button @onclick='() => NavManager.NavigateTo("/solicitudes")' class="home-text-link home-activity-link">Ver todas las actividades <span aria-hidden="true">&rarr;</span></button>
        </article>
    </section>

    <section class="home-quick-section" aria-label="Accesos rápidos">
        <h2>Accesos rápidos</h2>
        <div class="home-quick-grid">
            @foreach (var access in QuickAccesses)
            {
                <button @onclick="() => NavManager.NavigateTo(access.Href)" class="home-quick-card">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="@access.D1" stroke="#1D4ED8" />
                        <path d="@access.D2" stroke="#F59E0B" />
                    </svg>
                    <span>@access.Label</span>
                </button>
            }
        </div>
    </section>
</div>

@code {
    private string UserName => AppState.Session?.Nombre ?? "Usuario";

    private ElectroGestion.Services.InicioDashboardDatos Datos { get; set; } = new([], [], 0, 0, 0);

    private IEnumerable<ElectroGestion.Models.Visita> VisitsToday => Datos.VisitasHoy;

    private ElectroGestion.Models.Visita? NextVisit => VisitsToday.FirstOrDefault();

    private IEnumerable<ElectroGestion.Models.Solicitud> RecentActivity => Datos.ActividadReciente;

    private IEnumerable<HomeMetric> Metrics => new[]
    {
        new HomeMetric("Solicitudes pendientes", Datos.SolicitudesPendientes, "Ver solicitudes", "/solicitudes"),
        new HomeMetric("Visitas programadas", VisitsToday.Count(), "Ver agenda", "/agenda"),
        new HomeMetric("Levantamientos pendientes", Datos.LevantamientosPendientes, "Ver levantamientos", "/levantamientos"),
        new HomeMetric("Órdenes de trabajo nuevas", Datos.OrdenesPendientes, "Ver órdenes", "/ordenes")
    };

    protected override async Task OnInitializedAsync() => Datos = await DashboardService.ObtenerDatosAsync(DateTime.Today);

    private readonly HomeQuickAccess[] QuickAccesses =
    [
        new("Nueva solicitud", "/solicitudes", "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6", "M12 18v-6 M9 15h6"),
        new("Crear visita", "/agenda", "M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z M3 10h18", "M16 2v4 M8 2v4 M8 14h2 M14 14h2 M8 18h2 M14 18h2"),
        new("Nuevo levantamiento", "/levantamientos", "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 21v2", "M9.5 14.5l2-5 4-1-2 5z"),
        new("Órdenes de trabajo", "/ordenes", "M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z", "M11 11h5 M11 15h5 M11 19h5 M7 11l1.5 1.5 2-2"),
        new("Clientes", "/clientes", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M7.5 7a4 4 0 1 1 8 0 4 4 0 0 1-8 0", "M22 21v-2a4 4 0 0 0-3-3.87 M15 3.13a4 4 0 0 1 0 7.75")
    ];

    private async Task VerMapa(string direccion)
    {
        var url = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(direccion)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private static (string D1, string D2) GetServiceIcon(string? tipoServicio) => tipoServicio switch
    {
