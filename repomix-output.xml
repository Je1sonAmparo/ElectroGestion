<file path="Components/Pages/Compartidas/InicioDashboard.razor.css">
.home-dashboard {
    min-width: 0;
    max-width: 1280px;
    /* No centramos con margin: 0 auto para mantener la alineación a la izquierda si el diseño lo requiere, pero el max-width evita que se expanda al infinito */
}

.home-heading {
    margin-bottom: 24px;
}

.home-heading h1 {
    margin: 0;
    color: #14162B;
    font-family: 'Manrope', sans-serif;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.2;
}

.home-heading p {
    margin: 6px 0 0;
    color: #6B7085;
    font-size: 14px;
}

.home-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
}

.home-metric,
.home-panel {
    min-width: 0;
    border: 1px solid #E3E5EE;
    border-radius: 12px;
    background: #fff;
}

.home-metric {
    min-height: 100px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.home-metric-label {
    color: #6B7085;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
}

.home-metric-value {
    margin: 10px 0 8px;
    color: #1D4ED8;
    font-family: 'Manrope', sans-serif;
    font-size: 30px;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
}

.home-text-link {
    border: 0;
    background: transparent;
    padding: 0;
    color: #1D4ED8;
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
    text-align: left;
}

.home-text-link:hover {
    color: #F59E0B;
}

.home-operations {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 20px;
    margin-top: 20px;
}

.home-panel {
    padding: 24px;
}

.home-panel h2,
.home-quick-section h2 {
    margin: 0 0 16px;
    color: #14162B;
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    font-weight: 800;
}

.home-visit-content {
    min-height: 140px;
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 20px;
}

.home-visit-details {
    min-width: 0;
}

.home-visit-time {
    color: #1D4ED8;
    font-family: 'Manrope', sans-serif;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.1;
}

.home-visit-client {
    margin-top: 10px;
    color: #14162B;
    font-size: 14px;
    font-weight: 700;
}

.home-visit-meta {
    margin-top: 4px;
    color: #6B7085;
    font-size: 12px;
    line-height: 1.3;
    overflow-wrap: anywhere;
}

.home-outline-button {
    margin-top: 16px;
    padding: 8px 16px;
    border: 1px solid #D5D8E6;
    border-radius: 8px;
    background: #fff;
    color: #1D4ED8;
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
}

.home-outline-button:hover {
    border-color: #1D4ED8;
    background: #EFF6FF;
}

.home-map {
    position: relative;
    height: 140px;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #E3E5EE;
    border-radius: 10px;
    background: #EFF3EC;
}

.home-map svg {
    display: block;
    width: 100%;
    height: 100%;
}

.home-map-label {
    position: absolute;
    bottom: 8px;
    left: 8px;
    padding: 4px 8px;
    border: 1px solid rgba(227, 229, 238, .9);
    border-radius: 6px;
    background: rgba(255, 255, 255, .92);
    color: #4A4E63;
    font-size: 10px;
    font-weight: 700;
