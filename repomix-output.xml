                <div style="color:#6B7085">@u.Cargo</div>
                <div>
                    <span style="display:inline-block;padding:5px 11px;border-radius:20px;font-size:12px;font-weight:800;background:@colors.Bg;color:@colors.Fg">
                        @u.Rol
