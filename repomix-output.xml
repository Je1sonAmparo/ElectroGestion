                                <span style="display:inline-flex;align-items:center;justify-content:center;text-align:center;width:@(s.EstadoSolicitud?.Nombre == "En Espera Administración" ? "120px" : "auto");box-sizing:border-box;padding:@(s.EstadoSolicitud?.Nombre == "En Espera Administración" ? "5px 8px" : "5px 12px");border-radius:999px;font-size:12.5px;font-weight:700;line-height:1.2;background:@(s.EstadoSolicitud?.Nombre == "Pendiente" ? "#F7E7C9" : s.EstadoSolicitud?.Nombre == "En proceso" ? "#DDE7FF" : s.EstadoSolicitud?.Nombre == "En Espera Administración" ? "#E0E7FF" : s.EstadoSolicitud?.Nombre == "Finalizada" ? "#DDF7E8" : "#F9E6E6");color:@(s.EstadoSolicitud?.Nombre == "Pendiente" ? "#B57A00" : s.EstadoSolicitud?.Nombre == "En proceso" ? "#2B5BDB" : s.EstadoSolicitud?.Nombre == "En Espera Administración" ? "#3730A3" : s.EstadoSolicitud?.Nombre == "Finalizada" ? "#198754" : "#C0392B")">
