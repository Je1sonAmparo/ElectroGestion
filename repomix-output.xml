.home-empty-visit,
.home-empty-activity {
    min-height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8B90A3;
    font-size: 14px;
    text-align: center;
}

.home-activity {
    display: flex;
    flex-direction: column;
}

.home-activity-list {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 16px;
}

.home-activity-row {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 14px;
}

.home-activity-icon {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #EDEBFF;
}

.home-activity-icon svg {
    width: 20px;
    height: 20px;
}

.home-activity-copy {
