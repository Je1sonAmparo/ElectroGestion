@code {
    private string SearchId = "";
    private string SearchNombre = "";
    private string SearchRnc = "";
    private string SearchTelefono = "";

    private void Filtrar()
    {
        StateHasChanged();
    }

    private bool IsModalOpen = false;
    private string ModalTitle = "";
    private int? EditId = null;
    private ElectroGestion.Models.Proveedor? SelectedProveedor;

    private string FormNombre = "";
    private string FormRnc = "";
    private string FormCorreo = "";
    private string FormTelefono = "";
    private string FormDireccion = "";

    private List<ElectroGestion.Models.Proveedor> FilteredProveedores => AppState.Proveedores
        .Where(p => {
            bool matchId = string.IsNullOrEmpty(SearchId) || p.Id.ToString().Contains(SearchId);
            bool matchNombre = string.IsNullOrEmpty(SearchNombre) || p.Nombre.Contains(SearchNombre, StringComparison.OrdinalIgnoreCase);
            bool matchRnc = string.IsNullOrEmpty(SearchRnc) || p.Rnc.Contains(SearchRnc, StringComparison.OrdinalIgnoreCase);
            bool matchTel = string.IsNullOrEmpty(SearchTelefono) || p.Telefono.Contains(SearchTelefono, StringComparison.OrdinalIgnoreCase);
            return matchId && matchNombre && matchRnc && matchTel;
        })
        .OrderByDescending(p => p.Id)
        .ToList();

    private void AbrirModal(int? id = null)
    {
        EditId = id;
        if (id.HasValue)
        {
            ModalTitle = "Editar Proveedor";
            var item = AppState.Proveedores.First(x => x.Id == id.Value);
            FormNombre = item.Nombre;
            FormRnc = item.Rnc;
            FormCorreo = item.Correo;
            FormTelefono = item.Telefono;
            FormDireccion = item.Direccion;
        }
        else
        {
            ModalTitle = "Nuevo Proveedor";
            FormNombre = "";
            FormRnc = "";
            FormCorreo = "";
            FormTelefono = "";
            FormDireccion = "";
        }
        IsModalOpen = true;
    }

    private void CerrarModal()
    {
        IsModalOpen = false;
    }

    private void GuardarProveedor()
    {
        if (string.IsNullOrWhiteSpace(FormNombre) || string.IsNullOrWhiteSpace(FormRnc))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Complete todos los campos correctamente."));
            return;
        }

        if (EditId.HasValue)
        {
            var item = AppState.Proveedores.First(x => x.Id == EditId.Value);
            item.Nombre = FormNombre;
            item.Rnc = FormRnc;
            item.Correo = FormCorreo;
            item.Telefono = FormTelefono;
            item.Direccion = FormDireccion;
            ToastService.Notify(new ToastMessage(ToastType.Success, "Proveedor actualizado con éxito."));
        }
        else
        {
            var nuevo = new ElectroGestion.Models.Proveedor
            {
                Id = AppState.NextProveedorId(),
                Nombre = FormNombre,
                Rnc = FormRnc,
                Correo = FormCorreo,
                Telefono = FormTelefono,
                Direccion = FormDireccion
            };
            AppState.Proveedores.Add(nuevo);
            ToastService.Notify(new ToastMessage(ToastType.Success, "Proveedor creado con éxito."));
        }

        AppState.NotifyStateChanged();
        CerrarModal();
    }

    private void VerDetalle(int id)
    {
        SelectedProveedor = AppState.Proveedores.FirstOrDefault(c => c.Id == id);
    }

    private void CerrarDetalle()
    {
        SelectedProveedor = null;
    }
}
</file>

<file path="Components/Pages/Gerente/Reportes.razor">
