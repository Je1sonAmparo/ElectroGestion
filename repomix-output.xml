                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Fecha</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedCobro.Fecha.ToString("dd/MM/yyyy")</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Monto</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">RD$ @SelectedCobro.Monto.ToString("N2")</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Estado</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">
                    @{ var (bg, fg) = ElectroGestion.Services.AppStateService.GetBadgeColors(SelectedCobro.Estado); }
                    <span style="display:inline-block;padding:4px 10px;border-radius:20px;font-size:12.5px;font-weight:700;background:@bg;color:@fg">@SelectedCobro.Estado</span>
                </div></div>
            </div>
            <div style="margin-top:24px;display:flex;justify-content:flex-end;border-top:1px solid #EFF0F6;padding-top:17px">
                <button @onclick="CerrarDetalle" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchId = "";
    private string SearchCliente = "";
    private string SearchFactura = "";
    private string SearchEstado = "";

    private void Filtrar()
    {
        StateHasChanged();
    }

    private bool IsModalOpen = false;
    private string ModalTitle = "";
    private int? EditId = null;
    private ElectroGestion.Models.Cobro? SelectedCobro;

    private string FormCliente = "";
    private int FormFacturaId = 0;
    private string FormMetodoPago = "Transferencia";
    private decimal FormMonto = 0;
    private string FormEstado = "Pendiente";

    private List<ElectroGestion.Models.Cobro> FilteredCobros => AppState.Cobros
        .Where(c => {
            bool matchId = string.IsNullOrEmpty(SearchId) || c.Id.ToString().Contains(SearchId);
            bool matchCliente = string.IsNullOrEmpty(SearchCliente) || c.Cliente.Contains(SearchCliente, StringComparison.OrdinalIgnoreCase);
            bool matchFactura = string.IsNullOrEmpty(SearchFactura) || c.FacturaId.ToString().Contains(SearchFactura);
            bool matchEst = string.IsNullOrEmpty(SearchEstado) || c.Estado.Equals(SearchEstado, StringComparison.OrdinalIgnoreCase);
            return matchId && matchCliente && matchFactura && matchEst;
        })
        .OrderByDescending(c => c.Id)
        .ToList();

    private void AbrirModal(int? id = null)
    {
        EditId = id;
        if (id.HasValue)
        {
            ModalTitle = "Editar Cobro";
            var item = AppState.Cobros.First(x => x.Id == id.Value);
            FormCliente = item.Cliente;
            FormFacturaId = item.FacturaId;
            FormMetodoPago = item.MetodoPago;
            FormMonto = item.Monto;
            FormEstado = item.Estado;
        }
        else
        {
            ModalTitle = "Nuevo Cobro";
            FormCliente = "";
            FormFacturaId = 0;
            FormMetodoPago = "Transferencia";
            FormMonto = 0;
            FormEstado = "Pendiente";
        }
        IsModalOpen = true;
    }

    private void CerrarModal()
    {
        IsModalOpen = false;
    }

    private void GuardarCobro()
    {
        if (string.IsNullOrWhiteSpace(FormCliente) || FormFacturaId <= 0 || FormMonto <= 0)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Complete todos los campos correctamente."));
            return;
        }

        if (EditId.HasValue)
        {
            var item = AppState.Cobros.First(x => x.Id == EditId.Value);
            item.Cliente = FormCliente;
            item.FacturaId = FormFacturaId;
            item.MetodoPago = FormMetodoPago;
            item.Monto = FormMonto;
            item.Estado = FormEstado;
            ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro actualizado con éxito."));
        }
        else
        {
            var nuevo = new ElectroGestion.Models.Cobro
            {
                Id = AppState.NextCobroId(),
                Cliente = FormCliente,
                FacturaId = FormFacturaId,
                MetodoPago = FormMetodoPago,
                Monto = FormMonto,
                Fecha = DateTime.Today,
                Estado = "Pendiente"
            };
            AppState.Cobros.Add(nuevo);
            ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro creado con éxito."));
        }

        AppState.NotifyStateChanged();
        CerrarModal();
    }

    private void VerDetalle(int id)
    {
        SelectedCobro = AppState.Cobros.FirstOrDefault(c => c.Id == id);
    }

    private void CerrarDetalle()
    {
        SelectedCobro = null;
    }
}
</file>

<file path="Components/Pages/Gerente/Cotizaciones.razor">
