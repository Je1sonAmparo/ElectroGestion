                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Tipo de servicio *</label>
                        <select style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                            <option>@Detalle?.TipoServicio</option>
                        </select>
                    </div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Dirección *</label>
                        <input type="text" value="@Detalle?.Direccion" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Fecha *</label>
                        <input type="date" value="2026-08-03" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Hora *</label>
                        <input type="time" value="09:00" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                </div>

            </div>

            <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:24px">
                <button @onclick="CloseModals" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cancelar</button>
                <button @onclick="CloseModals" style="padding:10px 18px;border:none;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;cursor:pointer">Guardar cambios</button>
            </div>
        </div>
    </div>
}

@if (showCancelar)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9999">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:400px;padding:24px;box-shadow:0 10px 25px rgba(0,0,0,0.1)">
            <h2 style="margin:0 0 12px;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">Cancelar visita</h2>
            <p style="margin:0 0 24px;color:#4A4E63;font-size:14.5px;line-height:1.4">
                ¿Confirmas cancelar la visita de <strong>@Detalle?.Cliente</strong>?<br/>
                El estado del servicio pasará a Cancelada.
            </p>

            <div style="display:flex;justify-content:flex-end;gap:12px">
                <button @onclick="CloseModals" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cancelar</button>
                <button @onclick="ConfirmarCancelar" style="padding:10px 18px;border:none;background:#C4141B;color:#fff;border-radius:8px;font-weight:700;cursor:pointer">Sí, cancelar</button>
            </div>
        </div>
    </div>
}

@if (showReactivar)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9999">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:400px;padding:24px;box-shadow:0 10px 25px rgba(0,0,0,0.1)">
            <h2 style="margin:0 0 12px;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">Reactivar visita</h2>
            <p style="margin:0 0 24px;color:#4A4E63;font-size:14.5px;line-height:1.4">
                ¿Confirmas reactivar la visita de <strong>@Detalle?.Cliente</strong>?<br/>
                El estado del servicio pasará a En proceso.
            </p>

            <div style="display:flex;justify-content:flex-end;gap:12px">
                <button @onclick="CloseModals" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cancelar</button>
                <button @onclick="ConfirmarReactivar" style="padding:10px 18px;border:none;background:#17803D;color:#fff;border-radius:8px;font-weight:700;cursor:pointer">Sí, reactivar</button>
            </div>
        </div>
    </div>
}
@code {
    private string VistaActual = "Hoy";
    private string AgendaRango = "";

    private bool showNuevaVisita = false;
    private bool showEditarVisita = false;
    private bool showCancelar = false;
    private bool showReactivar = false;

    private List<string> DiasSemana = new() { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" };
    private List<string> HorasSem = new() { "08 AM", "09 AM", "10 AM", "11 AM", "12 PM", "01 PM", "02 PM", "03 PM", "04 PM", "05 PM", "06 PM" };

    public class Evento
    {
        public int Id { get; set; }
        public int Top { get; set; }
        public int H { get; set; }
        public string Bg { get; set; } = "";
        public string Line { get; set; } = "";
        public string Hora { get; set; } = "";
        public string Cliente { get; set; } = "";
        public string TipoServicio { get; set; } = "";
        public string Direccion { get; set; } = "";
        public string Estado { get; set; } = "";
        public string Fg { get; set; } = "";
        public string Fecha { get; set; } = "";
        public string Rango { get; set; } = "";
        public string Corto { get; set; } = "";
    }

    public class DiaSemana
    {
        public string Dia { get; set; } = "";
        public string Num { get; set; } = "";
        public string PillBg { get; set; } = "transparent";
        public string NumColor { get; set; } = "#4A4E63";
        public string ColBg { get; set; } = "transparent";
        public List<Evento> Eventos { get; set; } = new();
    }

    public class DiaMes
    {
        public string Num { get; set; } = "";
        public string NumColor { get; set; } = "#4A4E63";
        public string Bg { get; set; } = "#fff";
        public string Border { get; set; } = "#E3E5EE";
        public List<Evento> Eventos { get; set; } = new();
    }

    private List<DiaSemana> Semana = new();
    private List<DiaMes> Mes = new();
    private List<Evento> DiariaEventos = new();
    private Evento? Detalle;
    private List<ElectroGestion.Models.Solicitud> solicitudes = new();

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += OnStateChanged;
        await UpdateData();
        
        if (VistaActual == "Hoy")
        {
            Detalle = DiariaEventos.FirstOrDefault();
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await UpdateData();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnVistaActualChanged(ChangeEventArgs e)
    {
        VistaActual = e.Value?.ToString() ?? "Semanal";
        await UpdateData();
    }

    private async Task UpdateData()
    {
        solicitudes = await SolicitudService.GetList(s => true);
        var hoyD = DateTime.Today;
        var hoyStr = hoyD.ToString("yyyy-MM-dd");

        var MES = new[] { "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre" };

        var visibles = solicitudes.Where(x => x.Fecha != DateTime.MinValue && !string.IsNullOrEmpty(x.Hora)).ToList();

        var lunes = hoyD.AddDays(-((int)hoyD.DayOfWeek == 0 ? 6 : (int)hoyD.DayOfWeek - 1));
        var finSem = lunes.AddDays(6);

        if (VistaActual == "Semanal")
        {
            AgendaRango = $"{lunes.Day} - {finSem.Day} de {MES[finSem.Month - 1]} {finSem.Year}";
        }
        else if (VistaActual == "Mensual")
        {
            AgendaRango = char.ToUpper(MES[hoyD.Month - 1][0]) + MES[hoyD.Month - 1].Substring(1) + " " + hoyD.Year;
        }
        else
        {
            AgendaRango = AppStateService.FormatFechaLarga(hoyStr);
        }

        Semana.Clear();
        for (int i = 0; i < 7; i++)
        {
            var d = lunes.AddDays(i);
            var f = d.ToString("yyyy-MM-dd");
            var esHoy = f == hoyStr;

            var evs = visibles.Where(x => x.Fecha.ToString("yyyy-MM-dd") == f).OrderBy(x => x.Hora).Select(x => {
                var hm = x.Hora.Split(':');
                var hh = int.Parse(hm[0]);
                var mm = int.Parse(hm[1]);
                var estadoNombre = x.EstadoSolicitud?.Nombre ?? "";
                var cancel = estadoNombre == "Cancelada";
                var fin = estadoNombre == "Finalizada";
                var colors = AppStateService.GetBadgeColors(estadoNombre);
                return new Evento {
                    Id = x.Id,
                    Top = Math.Max(0, (int)((hh - 8) * 45 + (mm / 60.0) * 45 + 1)),
                    H = 58,
                    Bg = cancel ? "#FDE9EA" : (fin ? "#E4F6EA" : "#EAF3EC"),
                    Line = cancel ? "#E11B22" : (fin ? "#17803D" : "#4E9A63"),
                    Hora = AppStateService.FormatHora12(x.Hora),
                    Cliente = x.Cliente?.Nombre ?? "",
                    TipoServicio = x.Servicio?.Nombre ?? "",
                    Direccion = x.Direccion,
                    Estado = estadoNombre,
                    Fg = colors.Fg,
                    Fecha = AppStateService.FormatFechaLarga(x.Fecha.ToString("yyyy-MM-dd")),
                    Rango = AppStateService.FormatHora12(x.Hora) + " - " + AppStateService.FormatHora12(AppStateService.AddMinutes(x.Hora, 150))
                };
            }).ToList();

            Semana.Add(new DiaSemana {
                Dia = DiasSemana[i],
                Num = d.Day.ToString(),
                ColBg = esHoy ? "#FBFBFF" : "transparent",
                PillBg = esHoy ? "#EDEBFF" : "transparent",
                NumColor = esHoy ? "#1D4ED8" : "#4A4E63",
                Eventos = evs
            });
        }

        var prim = new DateTime(hoyD.Year, hoyD.Month, 1);
        var ini = prim.AddDays(-((int)prim.DayOfWeek == 0 ? 6 : (int)prim.DayOfWeek - 1));
        
        Mes.Clear();
        for (int i = 0; i < 42; i++)
        {
            var d = ini.AddDays(i);
            var f = d.ToString("yyyy-MM-dd");
            var esHoy = f == hoyStr;
            var otro = d.Month != hoyD.Month;

            var evs = visibles.Where(x => x.Fecha.ToString("yyyy-MM-dd") == f).OrderBy(x => x.Hora).Select(x => {
                var estadoNombre = x.EstadoSolicitud?.Nombre ?? "";
                var cancel = estadoNombre == "Cancelada";
                var fin = estadoNombre == "Finalizada";
                var colors = AppStateService.GetBadgeColors(estadoNombre);
                var horaFmt = AppStateService.FormatHora12(x.Hora);
                return new Evento {
                    Id = x.Id,
                    Bg = cancel ? "#FDE9EA" : (fin ? "#E4F6EA" : "#EAF3EC"),
                    Line = cancel ? "#E11B22" : (fin ? "#17803D" : "#4E9A63"),
                    Hora = horaFmt,
                    Cliente = x.Cliente?.Nombre ?? "",
                    TipoServicio = x.Servicio?.Nombre ?? "",
                    Direccion = x.Direccion,
                    Estado = estadoNombre,
                    Fg = colors.Fg,
                    Fecha = AppStateService.FormatFechaLarga(x.Fecha.ToString("yyyy-MM-dd")),
                    Rango = horaFmt + " - " + AppStateService.FormatHora12(AppStateService.AddMinutes(x.Hora, 150)),
                    Corto = (horaFmt.Length > 5 ? horaFmt.Substring(0, 5) : horaFmt) + " " + (x.Cliente?.Nombre ?? "")
                };
            }).ToList();

            Mes.Add(new DiaMes {
                Num = d.Day.ToString(),
                Bg = esHoy ? "#F5F4FF" : (otro ? "#FAFAFC" : "#fff"),
                Border = esHoy ? "#C9C3F5" : "#EFF0F6",
                NumColor = esHoy ? "#1D4ED8" : (otro ? "#C0C4D2" : "#14162B"),
                Eventos = evs
            });
        }

        DiariaEventos = visibles.Where(x => x.Fecha.ToString("yyyy-MM-dd") == hoyStr).Select(x => {
            var hm = x.Hora.Split(':');
            var hh = int.Parse(hm[0]);
            var mm = int.Parse(hm[1]);
            var estadoNombre = x.EstadoSolicitud?.Nombre ?? "";
            var cancel = estadoNombre == "Cancelada";
            var fin = estadoNombre == "Finalizada";
            var colors = AppStateService.GetBadgeColors(estadoNombre);
            return new Evento {
                Id = x.Id,
                Top = Math.Max(0, (int)((hh - 8) * 64 + (mm / 60.0) * 64 + 2)),
                H = (int)(150 / 60.0 * 64 - 6),
                Bg = cancel ? "#FDE9EA" : (fin ? "#E4F6EA" : "#EAF3EC"),
                Line = cancel ? "#E11B22" : (fin ? "#17803D" : "#4E9A63"),
                Hora = AppStateService.FormatHora12(x.Hora),
                Cliente = x.Cliente?.Nombre ?? "",
                TipoServicio = x.Servicio?.Nombre ?? "",
                Direccion = x.Direccion,
                Estado = x.EstadoSolicitud?.Nombre ?? "",
                Fg = colors.Fg,
                Fecha = AppStateService.FormatFecha(x.Fecha.ToString("yyyy-MM-dd")),
                Rango = AppStateService.FormatHora12(x.Hora) + " - " + AppStateService.FormatHora12(AppStateService.AddMinutes(x.Hora, 150))
            };
        }).ToList();
    }

    private void SelectEvent(Evento ev)
    {
        Detalle = ev;
    }

    private void ClearDetalle()
    {
        Detalle = null;
    }

    private void OpenNuevaVisitaModal() => showNuevaVisita = true;
    private void OpenEditarVisitaModal() => showEditarVisita = true;
    private void OpenCancelarModal() => showCancelar = true;
    private void OpenReactivarModal() => showReactivar = true;

    private void CloseModals()
    {
        showNuevaVisita = false;
        showEditarVisita = false;
        showCancelar = false;
        showReactivar = false;
    }

    private void ConfirmarCancelar()
    {
        if (Detalle != null)
        {
            // Solo para prototipo estático
            Detalle.Estado = "Cancelada";
            Detalle.Bg = "#FDE9EA";
            Detalle.Fg = "#E11B22";
            Detalle.Line = "#E11B22";
        }
        CloseModals();
    }

    private void ConfirmarReactivar()
    {
        if (Detalle != null)
        {
            // Solo para prototipo estático
            Detalle.Estado = "En proceso";
            Detalle.Bg = "#EAF3EC";
            Detalle.Fg = "#4E9A63";
            Detalle.Line = "#4E9A63";
        }
        CloseModals();
    }
}
</file>

