                        </div>
                    </div>
                </div>
                <div style="display:flex;flex-direction:column;gap:9px;margin-top:22px">
                    <button class="action-btn" style="padding:11px;border:1px solid #D5D8E6;background:#fff;border-radius:9px;font-size:13.5px;font-weight:700;cursor:pointer">Ver ubicación</button>
