                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Fecha Finalización</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@ElectroGestion.Services.AppStateService.FormatFecha((SelectedHistorial.FechaFin ?? SelectedHistorial.Fecha).ToString("yyyy-MM-dd"))</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Técnico Asignado</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedHistorial.TecnicoAsignado</div></div>
                <div style="grid-column:1 / -1;background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Dirección</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedHistorial.Direccion</div></div>
            </div>
            <div style="margin-top:24px;display:flex;justify-content:flex-end;border-top:1px solid #EFF0F6;padding-top:17px">
                <button @onclick="CerrarDetalle" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchId = "";
    private string SearchCliente = "";
    private string SearchTipo = "";
    private string FiltroFecha = "Todas las fechas";
    
    private bool IsModalOpen = false;
    private ElectroGestion.Models.Solicitud? SelectedHistorial;

    private void AbrirDetalle(ElectroGestion.Models.Solicitud s)
    {
        SelectedHistorial = s;
        IsModalOpen = true;
        StateHasChanged();
    }

    private void CerrarDetalle()
    {
        IsModalOpen = false;
        SelectedHistorial = null;
        StateHasChanged();
    }

    private void Filtrar()
    {
        StateHasChanged();
    }

    private IEnumerable<ElectroGestion.Models.Solicitud> HistorialFiltrado
    {
        get
        {
            var res = AppState.Solicitudes.Where(x => x.EstadoSolicitud?.Nombre == "Finalizada");

            if (!string.IsNullOrWhiteSpace(SearchId))
            {
                res = res.Where(x => x.Id.ToString().Contains(SearchId));
            }
            if (!string.IsNullOrWhiteSpace(SearchCliente))
            {
                res = res.Where(x => x.Cliente != null && x.Cliente.Nombre.Contains(SearchCliente, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(SearchTipo))
            {
                res = res.Where(x => x.Servicio != null && x.Servicio.Nombre.Contains(SearchTipo, StringComparison.OrdinalIgnoreCase));
            }

            if (FiltroFecha == "Últimos 7 días")
            {
                var lim = DateTime.Today.AddDays(-7);
                res = res.Where(x => (x.FechaFin ?? x.Fecha) >= lim);
            }
            else if (FiltroFecha == "Últimos 30 días")
            {
                var lim = DateTime.Today.AddDays(-30);
                res = res.Where(x => (x.FechaFin ?? x.Fecha) >= lim);
            }

            return res;
        }
    }
}
</file>

