    public static string FormatFecha(string? iso)
    {
        if (string.IsNullOrEmpty(iso)) return "—";
        var parts = iso.Split('-');
        if (parts.Length != 3) return iso;
        return $"{parts[2]}/{parts[1]}/{parts[0]}";
    }

    public static string FormatFechaLarga(string? iso)
    {
        if (string.IsNullOrEmpty(iso)) return "—";
        string[] meses = { "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre" };
        var parts = iso.Split('-');
        if (parts.Length != 3) return iso;
        return $"{int.Parse(parts[2])} de {meses[int.Parse(parts[1]) - 1]} de {parts[0]}";
    }

    public static string FormatHora12(string? time)
    {
        if (string.IsNullOrEmpty(time)) return "—";
        var parts = time.Split(':');
        if (parts.Length < 2) return time;
        int h = int.Parse(parts[0]);
        int m = int.Parse(parts[1]);
        string ap = h >= 12 ? "PM" : "AM";
        int hh = h % 12;
        if (hh == 0) hh = 12;
        return $"{hh:D2}:{m:D2} {ap}";
    }

    public static string AddMinutes(string? time, int addMin)
    {
        if (string.IsNullOrEmpty(time)) return "—";
        var parts = time.Split(':');
        if (parts.Length < 2) return time;
        int h = int.Parse(parts[0]);
        int m = int.Parse(parts[1]);
        m += addMin;
        h += m / 60;
        m = m % 60;
        return $"{h % 24:D2}:{m:D2}";
    }

    public static (string Bg, string Fg) GetBadgeColors(string estado) => estado switch
    {
        "Pendiente" => ("#FEF3C7", "#92400E"),
        "En proceso" => ("#DBEAFE", "#1E40AF"),
        "En Espera Administración" => ("#E0E7FF", "#3730A3"),
        "Pendiente de cobro" => ("#EDE9FE", "#6D28D9"),
        "Finalizada" => ("#D1FAE5", "#065F46"),
        "Cancelada" => ("#FEE2E2", "#991B1B"),
        "Activo" => ("#D1FAE5", "#065F46"),
        "Inactivo" => ("#FEE2E2", "#991B1B"),
        "Gerente" => ("#DBEAFE", "#1E40AF"),
        "Técnico" => ("#FEF3C7", "#92400E"),
        _ => ("#F3F4F6", "#374151")
    };
}
</file>

<file path="Components/Pages/Gerente/Ordenes.razor">
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.OrdenTrabajoService OrdenService
@inject BlazorBootstrap.ToastService ToastService

<PageTitle>Órdenes de Trabajo | ElectroGestion</PageTitle>

<style>
    .orden-filtros { display:flex; flex-direction:column; gap:18px; padding:18px; }
    .orden-filtros-fila { display:flex; align-items:center; gap:18px; flex-wrap:wrap; }
    .orden-filtro { display:flex; align-items:center; gap:9px; min-width:0; }
    .orden-filtro label { font-family:'Manrope'; font-size:14px; font-weight:800; color:#14162B; white-space:nowrap; }
    .orden-filtro input, .orden-filtro select { min-width:0; padding:9px 11px; border:1px solid #D5D8E6; border-radius:7px; background:#fff; color:#4A4E63; }
</style>

<div style="display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:24px;flex-wrap:wrap">
    <div><div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Órdenes de trabajo</div><p style="color:#6B7085;margin:5px 0 0">Materiales de la cotización y herramientas para el trabajo en campo.</p></div>
    <button @onclick="AbrirNueva" style="padding:11px 18px;background:#1D4ED8;color:white;border:0;border-radius:9px;font-weight:700;cursor:pointer">+ Nueva orden</button>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;margin-bottom:18px">
    <div class="orden-filtros">
        <div class="orden-filtros-fila">
            <div class="orden-filtro"><label for="orden-id">ID:</label><input id="orden-id" @bind="FiltroId" @bind:event="oninput" placeholder="ID" style="width:125px" /></div>
            <div class="orden-filtro"><label for="orden-cliente">Cliente:</label><input id="orden-cliente" @bind="FiltroCliente" @bind:event="oninput" placeholder="Nombre del cliente" style="width:220px" /></div>
            <div class="orden-filtro"><label for="orden-servicio">Tipo de servicio:</label><select id="orden-servicio" @bind="FiltroServicio" style="width:220px"><option value="">Todos</option>@foreach (var servicio in OrdenesRows.Select(o => o.TipoServicio).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s)) { <option value="@servicio">@servicio</option> }</select></div>
        </div>
        <div class="orden-filtros-fila">
            <div class="orden-filtro"><label for="orden-desde">Desde:</label><input id="orden-desde" type="date" @bind="FiltroDesde" /></div>
            <div class="orden-filtro"><label for="orden-hasta">Hasta:</label><input id="orden-hasta" type="date" @bind="FiltroHasta" /></div>
            <div class="orden-filtro"><label for="orden-estado">Estado:</label><select id="orden-estado" @bind="FiltroEstado" style="width:210px"><option value="">Todos</option><option>En proceso</option><option>Pendiente de cobro</option><option>Finalizada</option></select></div>
            <div style="margin-left:auto"><button @onclick="() => StateHasChanged()" style="padding:9px 20px;border:0;border-radius:7px;background:#1D4ED8;color:#fff;font-weight:700;cursor:pointer">Buscar</button></div>
        </div>
    </div>
</div>

@if (Cargando)
{ <p>Cargando órdenes...</p> }
else if (!OrdenesFiltradas.Any())
{ <div style="background:white;border:1px solid #E3E5EE;border-radius:12px;padding:28px;color:#6B7085">No hay órdenes con los filtros seleccionados.</div> }
else
{
    <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px" class="resp-grid-2">
    @foreach (var orden in OrdenesFiltradas)
    {
        <article style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:22px;display:flex;flex-direction:column">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
                <div><div style="font-family:ui-monospace,monospace;font-size:12px;color:#8B90A3;font-weight:700">ORDEN @orden.Code</div><div style="font-family:'Manrope';font-weight:800;font-size:19px;margin-top:4px">@orden.Cliente</div><div style="color:#6B7085;font-size:14px;margin-top:2px">@orden.TipoServicio</div></div>
                @{ var colors = ElectroGestion.Services.AppStateService.GetBadgeColors(orden.Estado); }
                <span style="display:inline-block;padding:5px 11px;border-radius:20px;font-size:12px;font-weight:800;background:@colors.Bg;color:@colors.Fg;white-space:nowrap">@orden.Estado</span>
            </div>
            <button @onclick="() => VerCotizacion(orden.Id)" style="align-self:flex-start;margin-top:12px;padding:0;border:0;background:none;color:#1D4ED8;font-weight:700;cursor:pointer">Ver cotización COT-@orden.CotizacionId.ToString("D5")</button>
            <div style="margin-top:18px;font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Tareas a realizar (Checklist Técnico)</div>
            <div style="display:flex;flex-direction:column;gap:8px;margin-top:10px">
                @for (var i = 0; i < orden.Trabajos.Count; i++)
                { <div style="display:flex;gap:10px;align-items:flex-start;font-size:14px"><span style="flex:0 0 22px;height:22px;border-radius:6px;background:#EDEBFF;color:#1D4ED8;font-weight:800;font-size:12px;display:flex;align-items:center;justify-content:center">@(i + 1)</span><span style="color:#4A4E63">@orden.Trabajos[i]</span></div> }
            </div>
            <div style="margin-top:18px;font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Materiales de la cotización</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
                @foreach (var material in orden.MaterialesCotizados) { <span style="padding:5px 11px;border:1px solid #E3E5EE;border-radius:20px;font-size:12.5px;background:#F7F8FC;color:#14162B">@material.Nombre × @material.Cantidad</span> }
                @if (orden.MaterialesCotizados.Count == 0) { <span style="color:#8B90A3;font-size:13px">Sin materiales cotizados.</span> }
            </div>
            <div style="margin-top:18px;font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Herramientas asignadas</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
                @foreach (var herramienta in orden.Herramientas) { <span style="padding:5px 11px;border:1px solid #E3E5EE;border-radius:20px;font-size:12.5px;background:#F7F8FC;color:#14162B">@herramienta</span> }
                @if (orden.Herramientas.Count == 0) { <span style="color:#8B90A3;font-size:13px">Sin herramientas asignadas.</span> }
            </div>
            @if (!string.IsNullOrWhiteSpace(orden.Observaciones)) { <div style="margin-top:18px;font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Instrucciones de campo</div><div style="font-size:14px;margin-top:7px;color:#4A4E63;line-height:1.55;background:#FAFAFC;padding:10px 14px;border-radius:8px;border:1px solid #EFF0F6">@orden.Observaciones</div> }
            <div style="margin-top:auto;padding-top:20px;display:flex;gap:10px">
                <button @onclick="() => Editar(orden)" style="width:33%;padding:12px;border:1px solid #E3E5EE;background:#fff;color:#4A4E63;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Editar</button>
                <button @onclick="() => OrdenAEliminar = orden.Id" style="width:33%;padding:12px;border:1px solid #F5C2C4;background:#fff;color:#C4141B;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Eliminar</button>
                @if (orden.Estado != "Finalizada") { <button @onclick="() => SolicitarCambioEstado(orden)" style="width:34%;padding:12px;border:1px solid #1D4ED8;background:#1D4ED8;color:#fff;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">@(orden.Estado == "Pendiente de cobro" ? "Reabrir orden" : "Marcar lista para cobro")</button> }
            </div>
        </article>
    }
    </div>
}

@if (ModalAbierto)
{
    <div style="position:fixed;inset:0;background:rgba(20,22,43,.48);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px" @onclick="CerrarModal">
        <div style="background:white;width:100%;max-width:650px;max-height:90vh;overflow:auto;border-radius:14px;padding:24px" @onclick:stopPropagation>
            <h2 style="font-size:21px;margin:0 0 18px">@(EditandoId.HasValue ? "Editar orden" : "Nueva orden de trabajo")</h2>
            @if (!EditandoId.HasValue)
            {
                <label for="orden-cotizacion" style="font-weight:700">Cotización aprobada</label>
                <select id="orden-cotizacion" @bind="FormCotizacionId" style="display:block;width:100%;padding:10px;border:1px solid #D5D8E6;border-radius:7px;margin:6px 0 16px"><option value="0">Seleccione una cotización</option>@foreach (var cot in CotizacionesDisponibles) { <option value="@cot.Id">COT-@cot.Id.ToString("D5") · @cot.Cliente</option> }</select>
                @if (CotizacionSeleccionada is not null)
                {
                    <div style="background:#F7F8FC;padding:14px;border-radius:8px;margin-bottom:16px"><strong>Materiales de la cotización</strong><div style="font-size:13px;color:#6B7085">Se incorporarán con las cantidades aprobadas.</div>@foreach (var d in CotizacionSeleccionada.Detalles) { <div style="margin-top:6px">@d.CodigoArticulo · @d.NombreArticulo <strong>× @d.Cantidad</strong></div> }@if (!CotizacionSeleccionada.Detalles.Any()) { <div>La cotización incluye solo mano de obra.</div> }</div>
                }
            }
            
            <label for="orden-tareas" style="font-weight:700">Tareas (una por línea)</label><textarea id="orden-tareas" @bind="FormTrabajos" rows="4" style="display:block;width:100%;padding:10px;border:1px solid #D5D8E6;border-radius:7px;margin:6px 0 16px"></textarea>
            <label for="orden-herramientas" style="font-weight:700">Herramientas asignadas (una por línea)</label><textarea id="orden-herramientas" @bind="FormHerramientas" rows="3" style="display:block;width:100%;padding:10px;border:1px solid #D5D8E6;border-radius:7px;margin:6px 0 16px" placeholder="Multímetro&#10;Escalera"></textarea>
            <label for="orden-instrucciones" style="font-weight:700">Instrucciones de campo</label><textarea id="orden-instrucciones" @bind="FormObservaciones" rows="3" maxlength="2000" style="display:block;width:100%;padding:10px;border:1px solid #D5D8E6;border-radius:7px;margin:6px 0 16px"></textarea>
            <div style="display:flex;justify-content:flex-end;gap:9px"><button @onclick="CerrarModal" style="padding:9px 14px;background:white;border:1px solid #D5D8E6;border-radius:7px;cursor:pointer">Cancelar</button><button @onclick="Guardar" style="padding:9px 16px;background:#1D4ED8;color:white;border:0;border-radius:7px;cursor:pointer">Guardar</button></div>
        </div>
    </div>
}

@if (OrdenAEliminar.HasValue)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:10000;padding:20px" @onclick="CerrarEliminar">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:400px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,.2)" @onclick:stopPropagation>
            <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B;margin-bottom:10px">Eliminar orden de trabajo</div>
            <div style="color:#4A4E63;font-size:14px;margin-bottom:24px">¿Está seguro que desea eliminar esta orden? Esta acción no se puede deshacer.</div>
            <div style="display:flex;justify-content:flex-end;gap:12px"><button @onclick="CerrarEliminar" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;color:#4A4E63">Cancelar</button><button @onclick="Eliminar" style="padding:10px 24px;border:0;background:#C0392B;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Eliminar</button></div>
        </div>
    </div>
}

@if (OrdenEstadoPendienteId.HasValue)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:10001;padding:20px" @onclick="CerrarConfirmacionEstado">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:400px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,.2)" @onclick:stopPropagation>
            <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B;margin-bottom:10px">Confirmar cambio de estado</div>
            <div style="color:#4A4E63;font-size:14px;margin-bottom:24px">¿Desea cambiar la orden a <strong>@EstadoOrdenPendiente</strong>?</div>
            <div style="display:flex;justify-content:flex-end;gap:12px"><button @onclick="CerrarConfirmacionEstado" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#4A4E63">Cancelar</button><button @onclick="ConfirmarCambioEstado" style="padding:10px 24px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;cursor:pointer">Confirmar</button></div>
        </div>
    </div>
}

@if (AppState.EsGerente && CotizacionDetalle is not null)
{ <CotizacionDocumento Cotizacion="CotizacionDetalle" OnClose="CerrarCotizacion" /> }

@code {
    private List<ElectroGestion.Models.OrdenTrabajo> OrdenesRows = [];
    private List<ElectroGestion.Models.Cotizacion> CotizacionesDisponibles = [];
    private bool Cargando;
    private string FiltroId = "", FiltroCliente = "", FiltroServicio = "", FiltroEstado = "";
    private DateTime? FiltroDesde, FiltroHasta;
    private ElectroGestion.Models.Cotizacion? CotizacionDetalle;
    private bool ModalAbierto;
    private int? EditandoId, OrdenAEliminar;
    private int? OrdenEstadoPendienteId;
    private string EstadoOrdenPendiente = "";
    private int FormCotizacionId;
    private string FormTrabajos = "", FormHerramientas = "", FormObservaciones = "";
    private ElectroGestion.Models.Cotizacion? CotizacionSeleccionada => CotizacionesDisponibles.FirstOrDefault(c => c.Id == FormCotizacionId);
    private IEnumerable<ElectroGestion.Models.OrdenTrabajo> OrdenesFiltradas => OrdenesRows.Where(o =>
        (string.IsNullOrWhiteSpace(FiltroId) || o.Id.ToString().Contains(FiltroId) || o.Code.Contains(FiltroId, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroCliente) || o.Cliente.Contains(FiltroCliente, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroServicio) || o.TipoServicio == FiltroServicio) &&
        (!FiltroDesde.HasValue || o.FechaCreacion.Date >= FiltroDesde.Value.Date) &&
        (!FiltroHasta.HasValue || o.FechaCreacion.Date <= FiltroHasta.Value.Date) &&
        (string.IsNullOrWhiteSpace(FiltroEstado) || o.Estado == FiltroEstado));

    protected override async Task OnInitializedAsync() => await Recargar();

    private async Task Recargar()
    {
        Cargando = true;
        try { OrdenesRows = await OrdenService.ObtenerTodasAsync(); CotizacionesDisponibles = await OrdenService.ObtenerCotizacionesDisponiblesAsync(); }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudieron cargar las órdenes.")); }
        finally { Cargando = false; }
    }

    private void AbrirNueva() { EditandoId = null; FormCotizacionId = 0; FormTrabajos = FormHerramientas = FormObservaciones = ""; ModalAbierto = true; }
    private void Editar(ElectroGestion.Models.OrdenTrabajo orden) { EditandoId = orden.Id; FormCotizacionId = orden.CotizacionId; FormTrabajos = string.Join("\n", orden.Trabajos); FormHerramientas = string.Join("\n", orden.Herramientas); FormObservaciones = orden.Observaciones; ModalAbierto = true; }
    private void CerrarModal() => ModalAbierto = false;
    private static List<string> Lineas(string texto) => texto.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => x.Length > 0).ToList();

    private async Task Guardar()
    {
        if (!EditandoId.HasValue && FormCotizacionId <= 0) { ToastService.Notify(new ToastMessage(ToastType.Warning, "Seleccione una cotización aprobada.")); return; }
        var guardado = EditandoId.HasValue
            ? await OrdenService.ActualizarAsync(EditandoId.Value, Lineas(FormTrabajos), Lineas(FormHerramientas), FormObservaciones)
            : await OrdenService.CrearAsync(FormCotizacionId, Lineas(FormTrabajos), Lineas(FormHerramientas), FormObservaciones);
        if (!guardado) { ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo guardar. Verifique la cotización y que no tenga otra orden.")); return; }
        CerrarModal(); ToastService.Notify(new ToastMessage(ToastType.Success, "Orden guardada.")); await Recargar();
    }

    private void SolicitarCambioEstado(ElectroGestion.Models.OrdenTrabajo orden)
    {
        OrdenEstadoPendienteId = orden.Id;
        EstadoOrdenPendiente = orden.Estado == "Pendiente de cobro" ? "En proceso" : "Pendiente de cobro";
    }

    private void CerrarConfirmacionEstado() { OrdenEstadoPendienteId = null; EstadoOrdenPendiente = ""; }
    private async Task ConfirmarCambioEstado()
    {
        if (!OrdenEstadoPendienteId.HasValue) return;
        var id = OrdenEstadoPendienteId.Value;
        var estado = EstadoOrdenPendiente;
        CerrarConfirmacionEstado();
        if (await OrdenService.CambiarEstadoAsync(id, estado)) { await Recargar(); ToastService.Notify(new ToastMessage(ToastType.Success, "Estado de la orden actualizado.")); }
    }

    private async Task Eliminar()
    {
        if (!OrdenAEliminar.HasValue) return;
        var id = OrdenAEliminar.Value; OrdenAEliminar = null;
        if (await OrdenService.EliminarAsync(id)) { await Recargar(); ToastService.Notify(new ToastMessage(ToastType.Success, "Orden eliminada.")); }
    }
    private void CerrarEliminar() => OrdenAEliminar = null;

    private async Task VerCotizacion(int ordenId)
    {
        if (!AppState.EsGerente) return;
        CotizacionDetalle = await OrdenService.ObtenerCotizacionDeOrdenAsync(ordenId);
        if (CotizacionDetalle is null)
            ToastService.Notify(new ToastMessage(ToastType.Warning, "No se encontró la cotización de esta orden."));
    }
    private void CerrarCotizacion() => CotizacionDetalle = null;
}
</file>

<file path="Components/Pages/Tecnico/Levantamientos.razor">
