<file path="Components/Pages/Compartidas/Historial.razor">
@page "/historial"
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.CobroService CobroService
@inject NavigationManager NavManager

<PageTitle>Historial de servicios | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Historial de servicios</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Servicios finalizados.</div>
    </div>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;overflow:hidden">
    <div style="padding:18px 18px 12px;border-bottom:1px solid #EFF0F6">
        <div style="display:flex;align-items:center;gap:20px;white-space:nowrap;overflow-x:auto" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" @bind:event="oninput" placeholder="ID"
                    style="width:120px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Cliente:</span>
                <input @bind="SearchCliente" @bind:event="oninput" placeholder="Nombre"
                    style="width:170px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Tipo:</span>
                <input @bind="SearchTipo" @bind:event="oninput" placeholder="Tipo"
                    style="width:150px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Fecha:</span>
                <select @bind="FiltroFecha" style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="Todas las fechas">Todas las fechas</option>
                    <option value="Últimos 7 días">Últimos 7 días</option>
                    <option value="Últimos 30 días">Últimos 30 días</option>
                </select>
            </div>
            <div style="display:flex;justify-content:flex-end;flex:1;min-width:90px">
                <button class="primary-btn" @onclick="Filtrar"
                    style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Buscar</button>
            </div>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:80px 1.2fr 1.4fr 1fr 1fr 80px;padding:14px 18px;font-size:12px;font-weight:800;color:#8B90A3;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #EFF0F6"
         class="resp-table-row">
        <div>ID</div>
        <div>Cliente</div>
        <div>Tipo de servicio</div>
        <div>Fecha finalización</div>
        <div>Estado</div>
        <div style="text-align:right">Acción</div>
    </div>

    @if (HistorialFiltrado.Any())
    {
        @foreach (var h in HistorialFiltrado)
        {
            <div style="display:grid;grid-template-columns:80px 1.2fr 1.4fr 1fr 1fr 80px;padding:16px 18px;border-bottom:1px solid #F4F5FB;align-items:center;font-size:14px"
                 class="resp-table-row">
                <div style="font-family:ui-monospace,monospace;color:#6B7085">@h.Id.ToString("D4")</div>
                <div style="font-weight:700">@h.Cliente?.Nombre</div>
                <div>@h.Servicio?.Nombre</div>
                <div style="color:#6B7085">@ElectroGestion.Services.AppStateService.FormatFecha((h.FechaFin ?? h.FechaSolicitud).ToString("yyyy-MM-dd"))</div>
                <div>
                    <span style="display:inline-block;padding:5px 11px;border-radius:20px;font-size:12px;font-weight:800;background:#E4F6EA;color:#17803D">
                        Finalizada
                    </span>
                </div>
                <div style="display:flex;justify-content:flex-end">
                    <button title="Ver detalle" @onclick="() => AbrirDetalle(h)"
                            style="width:32px;height:32px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer;color:#4A4E63;display:flex;align-items:center;justify-content:center">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div style="padding:38px;text-align:center;color:#8B90A3;font-size:14px">
            Aún no hay servicios finalizados.
        </div>
    }
</div>

<div style="margin-top:28px;margin-bottom:12px">
    <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B">Cobros finalizados</div>
    <div style="color:#6B7085;font-size:14px;margin-top:4px">Pagos recibidos y órdenes cerradas.</div>
</div>
<div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;overflow:auto">
    <table style="width:100%;border-collapse:collapse;min-width:720px;font-size:14px">
        <thead style="background:#F8F9FC"><tr><th style="padding:14px;text-align:left">Factura</th><th style="padding:14px;text-align:left">Orden</th><th style="padding:14px;text-align:left">Cliente</th><th style="padding:14px;text-align:left">Fecha</th><th style="padding:14px;text-align:left">Método</th><th style="padding:14px;text-align:right">Monto</th></tr></thead>
        <tbody>
            @if (!CobrosFinalizados.Any())
            {
                <tr><td colspan="6" style="padding:28px;text-align:center;color:#8B90A3">Aún no hay cobros finalizados.</td></tr>
            }
            else
            {
                @foreach (var cobro in CobrosFinalizados)
                {
                    <tr style="border-top:1px solid #EFF0F6"><td style="padding:14px">@cobro.FacturaId</td><td style="padding:14px">@cobro.OrdenTrabajo?.Code</td><td style="padding:14px">@cobro.Cliente</td><td style="padding:14px">@cobro.Fecha.ToString("dd/MM/yyyy")</td><td style="padding:14px">@cobro.MetodoPago</td><td style="padding:14px;text-align:right;font-weight:700">RD$ @cobro.Monto.ToString("N2")</td></tr>
                }
            }
        </tbody>
    </table>
</div>

@if (IsModalOpen && SelectedHistorial != null)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px" @onclick="CerrarDetalle">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:620px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,.2);animation:tin .2s ease-out" @onclick:stopPropagation>
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
                <div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B">Detalle de Historial</div>
                    <div style="font-size:14px;color:#6B7085;margin-top:3px">Historial @SelectedHistorial.Id.ToString("D4")</div>
                </div>
                <button @onclick="CerrarDetalle" aria-label="Cerrar" style="width:32px;height:32px;border:1px solid #E3E5EE;border-radius:8px;background:#fff;display:flex;align-items:center;justify-content:center;color:#8B90A3;cursor:pointer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px" class="resp-grid-2">
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Cliente</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedHistorial.Cliente?.Nombre</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Tipo de Servicio</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedHistorial.Servicio?.Nombre</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Fecha Finalización</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@ElectroGestion.Services.AppStateService.FormatFecha((SelectedHistorial.FechaFin ?? SelectedHistorial.FechaSolicitud).ToString("yyyy-MM-dd"))</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Técnico Asignado</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedHistorial.TecnicoAsignado</div></div>
                <div style="grid-column:1 / -1;background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Dirección</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedHistorial.Direccion</div></div>
            </div>
            <div style="margin-top:24px;display:flex;justify-content:flex-end;border-top:1px solid #EFF0F6;padding-top:17px">
                <button @onclick="CerrarDetalle" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchId = "";
    private string SearchCliente = "";
    private string SearchTipo = "";
    private string FiltroFecha = "Todas las fechas";
    
    private bool IsModalOpen = false;
    private ElectroGestion.Models.Solicitud? SelectedHistorial;
    private List<ElectroGestion.Models.Cobro> CobrosFinalizados = [];

    protected override async Task OnInitializedAsync()
    {
        try { CobrosFinalizados = (await CobroService.ObtenerTodosAsync()).Where(c => c.Estado == "Finalizada").ToList(); }
        catch { CobrosFinalizados = []; }
    }

    private void AbrirDetalle(ElectroGestion.Models.Solicitud s)
    {
        SelectedHistorial = s;
        IsModalOpen = true;
        StateHasChanged();
    }

    private void CerrarDetalle()
    {
        IsModalOpen = false;
        SelectedHistorial = null;
        StateHasChanged();
    }

    private void Filtrar()
    {
        StateHasChanged();
    }

    private IEnumerable<ElectroGestion.Models.Solicitud> HistorialFiltrado
    {
        get
        {
            var res = AppState.Solicitudes.Where(x => x.EstadoSolicitud?.Nombre == "Finalizada");

            if (!string.IsNullOrWhiteSpace(SearchId))
            {
                res = res.Where(x => x.Id.ToString().Contains(SearchId));
            }
            if (!string.IsNullOrWhiteSpace(SearchCliente))
            {
                res = res.Where(x => x.Cliente != null && x.Cliente.Nombre.Contains(SearchCliente, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(SearchTipo))
            {
                res = res.Where(x => x.Servicio != null && x.Servicio.Nombre.Contains(SearchTipo, StringComparison.OrdinalIgnoreCase));
            }

            if (FiltroFecha == "Últimos 7 días")
            {
                var lim = DateTime.Today.AddDays(-7);
                res = res.Where(x => (x.FechaFin ?? x.FechaSolicitud) >= lim);
            }
            else if (FiltroFecha == "Últimos 30 días")
            {
                var lim = DateTime.Today.AddDays(-30);
                res = res.Where(x => (x.FechaFin ?? x.FechaSolicitud) >= lim);
            }

            return res;
        }
    }
}
</file>

<file path="Components/Pages/Compartidas/InicioDashboard.razor">
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.LevantamientoService LevantamientoService
@inject ElectroGestion.Services.OrdenTrabajoService OrdenService
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Inicio | ElectroGestion</PageTitle>

<div class="home-dashboard">
    <header class="home-heading">
        <h1>¡Bienvenido, @UserName!</h1>
        <p>Resumen de la operación de hoy.</p>
    </header>

    <section class="home-metrics" aria-label="Resumen operativo">
        @foreach (var metric in Metrics)
        {
            <article class="home-metric">
                <div class="home-metric-label">@metric.Label</div>
                <div class="home-metric-value">@metric.Value</div>
                <button @onclick="() => NavManager.NavigateTo(metric.Href)" class="home-text-link">@metric.Link <span aria-hidden="true">&rarr;</span></button>
            </article>
        }
    </section>

    <section class="home-operations">
        <article class="home-panel home-next-visit">
            <h2>Próxima visita</h2>
            @if (NextVisit is { } visit)
            {
                <div class="home-visit-content">
                    <div class="home-visit-details">
                        <div class="home-visit-time">@ElectroGestion.Services.AppStateService.FormatHora12(visit.Hora)</div>
                        <div class="home-visit-client">@visit.Solicitud?.Cliente?.Nombre</div>
                        <div class="home-visit-meta">@visit.Solicitud?.Servicio?.Nombre</div>
                        <div class="home-visit-meta">@visit.Solicitud?.Direccion</div>
                        <button @onclick='() => VerMapa(visit.Solicitud?.Direccion ?? "")' class="home-outline-button">Ver ubicación</button>
                    </div>
                    <div class="home-map" role="img" aria-label="Mapa de ubicación aproximada">
                        <svg viewBox="0 0 320 172" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                            <rect width="320" height="172" fill="#EFF3EC" />
                            <path d="M26 0v172M118 0v172M212 0v172M282 0v172M0 34h320M0 96h320M0 142h320" stroke="#E2E7DC" stroke-width="9" />
                            <path d="M0 66h320M166 0v172" stroke="#fff" stroke-width="14" />
                            <path d="M0 66h320M166 0v172" stroke="#F59E0B" stroke-width="7" />
                            <g fill="#DDE4D6">
                                <rect x="36" y="8" width="70" height="18" rx="2" />
                                <rect x="36" y="76" width="52" height="14" rx="2" />
                                <rect x="96" y="106" width="58" height="26" rx="2" />
                                <rect x="224" y="8" width="48" height="18" rx="2" />
                                <rect x="224" y="106" width="50" height="26" rx="2" />
                            </g>
                            <circle cx="290" cy="120" r="22" fill="#D8E6D0" />
                            <g transform="translate(166 66)">
                                <ellipse cx="0" cy="16" rx="9" ry="3.5" fill="rgba(20,22,43,.18)" />
                                <path d="M0 14s-11-11.6-11-19a11 11 0 0 1 22 0c0 7.4-11 19-11 19Z" fill="#1D4ED8" />
                                <circle cx="0" cy="-5.4" r="4" fill="#fff" />
                            </g>
                        </svg>
                        <span class="home-map-label">Ubicación aproximada</span>
                    </div>
                </div>
            }
            else
            {
                <div class="home-empty-visit">No hay visitas programadas para hoy.</div>
            }
        </article>

        <article class="home-panel home-activity">
            <h2>Actividad reciente</h2>
            @if (RecentActivity.Any())
            {
                <div class="home-activity-list">
                    @foreach (var item in RecentActivity)
                    {
                        var icon = GetServiceIcon(item.Servicio?.Nombre);
                        <div class="home-activity-row">
                            <span class="home-activity-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="@icon.D1" stroke="#1D4ED8" />
                                    <path d="@icon.D2" stroke="#F59E0B" />
                                </svg>
                            </span>
                            <div class="home-activity-copy">
                                <div class="home-activity-service">@item.Servicio?.Nombre</div>
                                <div class="home-activity-client">@item.Cliente?.Nombre</div>
                            </div>
                            <time class="home-activity-date">@ElectroGestion.Services.AppStateService.FormatFecha(item.FechaSolicitud.ToString("yyyy-MM-dd"))</time>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="home-empty-activity">Todavía no hay actividad registrada.</div>
            }
            <button @onclick='() => NavManager.NavigateTo("/solicitudes")' class="home-text-link home-activity-link">Ver todas las actividades <span aria-hidden="true">&rarr;</span></button>
        </article>
    </section>

    <section class="home-quick-section" aria-label="Accesos rápidos">
        <h2>Accesos rápidos</h2>
        <div class="home-quick-grid">
            @foreach (var access in QuickAccesses)
            {
                <button @onclick="() => NavManager.NavigateTo(access.Href)" class="home-quick-card">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="@access.D1" stroke="#1D4ED8" />
                        <path d="@access.D2" stroke="#F59E0B" />
                    </svg>
                    <span>@access.Label</span>
                </button>
            }
        </div>
    </section>
</div>

@code {
    private string UserName => AppState.Session?.Nombre ?? "Usuario";

    private IEnumerable<ElectroGestion.Models.Visita> VisitsToday => AppState.Visitas
        .Where(v => v.Fecha.Date == DateTime.Today &&
                    v.Estado != "Cancelada" && v.Estado != "Finalizada")
        .OrderBy(v => v.Hora);

    private ElectroGestion.Models.Visita? NextVisit => VisitsToday.FirstOrDefault();

    private IEnumerable<ElectroGestion.Models.Solicitud> RecentActivity => AppState.Solicitudes
        .OrderByDescending(s => s.FechaSolicitud)
        .ThenByDescending(s => s.Id)
        .Take(3);

    private int LevantamientosPendientes { get; set; }
    private int OrdenesPendientes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        LevantamientosPendientes = await LevantamientoService.ContarPendientesAsync();
        OrdenesPendientes = (await OrdenService.ObtenerTodasAsync()).Count(o => o.Estado == "En proceso");
    }

    private IEnumerable<HomeMetric> Metrics => new[]
    {
        new HomeMetric("Solicitudes pendientes", AppState.Solicitudes.Count(s => s.EstadoSolicitud?.Nombre == "Pendiente"), "Ver solicitudes", "/solicitudes"),
        new HomeMetric("Visitas programadas", VisitsToday.Count(), "Ver agenda", "/agenda"),
        new HomeMetric("Levantamientos pendientes", LevantamientosPendientes, "Ver levantamientos", "/levantamientos"),
        new HomeMetric("Órdenes de trabajo nuevas", OrdenesPendientes, "Ver órdenes", "/ordenes")
    };

    private readonly HomeQuickAccess[] QuickAccesses =
    [
        new("Nueva solicitud", "/solicitudes", "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6", "M12 18v-6 M9 15h6"),
        new("Crear visita", "/agenda", "M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z M3 10h18", "M16 2v4 M8 2v4 M8 14h2 M14 14h2 M8 18h2 M14 18h2"),
        new("Nuevo levantamiento", "/levantamientos", "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 21v2", "M9.5 14.5l2-5 4-1-2 5z"),
        new("Órdenes de trabajo", "/ordenes", "M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z", "M11 11h5 M11 15h5 M11 19h5 M7 11l1.5 1.5 2-2"),
        new("Clientes", "/clientes", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M7.5 7a4 4 0 1 1 8 0 4 4 0 0 1-8 0", "M22 21v-2a4 4 0 0 0-3-3.87 M15 3.13a4 4 0 0 1 0 7.75")
    ];

    private async Task VerMapa(string direccion)
    {
        var url = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(direccion)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private static (string D1, string D2) GetServiceIcon(string? tipoServicio) => tipoServicio switch
    {
        "Instalación de Paneles Solares" => ("M12 4v2 M12 18v2 M4 12h2 M18 12h2 M6.3 6.3l1.4 1.4 M16.3 16.3l1.4 1.4 M6.3 17.7l1.4-1.4 M16.3 7.7l1.4-1.4", "M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0"),
        "Instalación de Sistema UPS" => ("M7 4h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z", "M12 8v5l-2 2"),
        "Cableado Estructurado" => ("M4 7h16v10H4z", "M8 7V4 M16 7V4 M12 17v3"),
        _ => ("M12 3v4 M12 17v4 M3 12h4 M17 12h4", "M8 8l8 8 M16 8l-8 8")
    };

    private sealed record HomeMetric(string Label, int Value, string Link, string Href);
    private sealed record HomeQuickAccess(string Label, string Href, string D1, string D2);
}
</file>

<file path="Components/Pages/Compartidas/Login.razor">
@page "/login"
@rendermode InteractiveServer
@using BlazorBootstrap
@using System.ComponentModel.DataAnnotations
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.AutenticacionService Autenticacion
@inject NavigationManager NavManager
@inject ToastService ToastService
@inject ILogger<Login> Logger

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#F4F5FB;padding:20px;background-image:radial-gradient(circle at top right, rgba(29,78,216,0.05), transparent 40%), radial-gradient(circle at bottom left, rgba(245,158,11,0.05), transparent 40%)">
  <div style="width:100%;max-width:440px;background:#fff;border-radius:24px;box-shadow:0 24px 48px rgba(20,22,43,0.04), 0 2px 8px rgba(20,22,43,0.02);padding:48px 44px">
    <div style="display:flex;flex-direction:column;align-items:center;margin-bottom:40px;text-align:center">
      <div style="display:flex;align-items:center;margin-bottom:12px;position:relative;margin-left:-8px">
        <svg viewBox="0 0 100 60" width="76" height="46">
          <defs>
            <mask id="bolt-mask">
              <rect width="100" height="60" fill="white" />
              <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="black" stroke="black" stroke-width="2.5" stroke-linejoin="round" />
            </mask>
          </defs>
          <text x="10" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#1D4ED8" letter-spacing="-1.5">E</text>
          <text x="44" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#F59E0B" mask="url(#bolt-mask)" letter-spacing="-1.5">G</text>
          <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="#F59E0B" stroke="#F59E0B" stroke-width="0" stroke-linejoin="round" />
        </svg>
      </div>
      <div style="font-family:'Manrope';font-weight:900;font-size:24px;letter-spacing:-0.5px;line-height:1.2;margin-bottom:8px">
        <span style="color:#1D4ED8">ELECTRO</span><span style="color:#334155">GESTIÓN</span>
      </div>
      <div style="color:#6B7085;font-size:14.5px;line-height:1.5">Sistema Informático de Servicios Eléctricos</div>
    </div>

    <div style="font-family:'Manrope';font-weight:800;font-size:22px;margin-bottom:24px;letter-spacing:-0.5px">
      Iniciar sesión
    </div>

    <EditForm Model="@credenciales" OnValidSubmit="IniciarSesionAsync">
      <DataAnnotationsValidator />
      <div style="margin-bottom:18px">
        <label for="usuario" style="display:block;margin-bottom:7px;font-size:14px;font-weight:700;color:#334155">Usuario</label>
        <InputText id="usuario" @bind-Value="credenciales.Usuario" autocomplete="username"
          class="login-input" placeholder="Escribe tu usuario" />
        <ValidationMessage For="@(() => credenciales.Usuario)" />
      </div>
      <div style="margin-bottom:18px">
        <label for="contrasena" style="display:block;margin-bottom:7px;font-size:14px;font-weight:700;color:#334155">Contraseña</label>
        <div class="password-input-container">
          <InputText id="contrasena" @bind-Value="credenciales.Password"
            type="@(mostrarContrasena ? "text" : "password")" autocomplete="current-password"
            class="login-input" placeholder="Escribe tu contraseña" />
          <button type="button" class="password-visibility-btn"
            @onclick="TogglePasswordVisibility"
            aria-label="@(mostrarContrasena ? "Ocultar contraseña" : "Mostrar contraseña")"
            aria-pressed="@mostrarContrasena"
            title="@(mostrarContrasena ? "Ocultar contraseña" : "Mostrar contraseña")">
            @if (mostrarContrasena)
            {
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 3l18 18" />
                <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c5 0 8.3 4.5 9 7-.3 1.1-1 2.1-1.8 3" />
                <path d="M6.2 6.2C4 7.5 2.5 9.7 2 12c.7 2.5 4 7 10 7 1 0 2-.2 2.9-.5" />
              </svg>
            }
            else
            {
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            }
          </button>
        </div>
        <ValidationMessage For="@(() => credenciales.Password)" />
      </div>
      @if (!string.IsNullOrWhiteSpace(error))
      {
        <div role="alert" style="margin-bottom:16px;color:#B91C1C;font-size:14px">@error</div>
      }
      <button type="submit" disabled="@cargando" class="login-btn"
        style="width:100%;padding:15px;background:#1D4ED8;color:#fff;border:0;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;font-family:'Manrope';box-shadow:0 4px 14px rgba(29,78,216,0.25);transition:all 0.2s;opacity:@(cargando ? "0.7" : "1")">
        @(cargando ? "Ingresando..." : "Iniciar sesión")
      </button>
    </EditForm>
  </div>
</div>

<style>
  .login-btn:hover {
    background: #1E40AF !important;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(29,78,216,0.3) !important;
  }

  .login-input {
    display: block;
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #D7DCE5;
    border-radius: 10px;
    font: inherit;
    box-sizing: border-box;
  }

  .password-input-container {
    position: relative;
  }

  .password-input-container .login-input {
    padding-right: 48px;
  }

  .password-visibility-btn {
    position: absolute;
    top: 50%;
    right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border: 0;
    background: transparent;
    color: #6B7085;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .password-visibility-btn:hover {
    color: #1D4ED8;
  }

  .password-visibility-btn:focus-visible {
    border-radius: 4px;
    outline: 2px solid #1D4ED8;
    outline-offset: 2px;
  }
</style>

@code {
    private Credenciales credenciales = new();
    private string? error;
    private bool cargando;
    private bool mostrarContrasena;

    private void TogglePasswordVisibility() => mostrarContrasena = !mostrarContrasena;

    private async Task IniciarSesionAsync()
    {
        cargando = true;
        error = null;

        try
        {
            var usuario = await Autenticacion.AutenticarAsync(credenciales.Usuario.Trim(), credenciales.Password);
            if (usuario is null)
            {
                error = "El usuario o la contraseña son incorrectos.";
                return;
            }

            AppState.Login(usuario);
            ToastService.Notify(new ToastMessage(ToastType.Primary, $"Bienvenido, {usuario.Nombre.Split(' ')[0]}."));
            NavManager.NavigateTo(AppState.EsAdministrador ? "/recuperacion" : "/");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible autenticar al usuario {UsuarioLogin}.", credenciales.Usuario);
            error = "No se pudo conectar con el servicio de autenticación. Inténtalo de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }

    private sealed class Credenciales
    {
        [Required(ErrorMessage = "Escribe tu usuario.")]
        public string Usuario { get; set; } = "";

        [Required(ErrorMessage = "Escribe tu contraseña.")]
        public string Password { get; set; } = "";
    }
}
</file>

<file path="Components/Pages/Gerente/Clientes.razor">
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.ClienteService ClienteService
@inject NavigationManager NavManager
@inject ToastService ToastService
<PageTitle>Clientes (Gestión Comercial) | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:18px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.8px;color:#1f2430;line-height:1.15">Clientes</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Clientes registrados en el sistema.</div>
