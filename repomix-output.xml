    @if (HistorialFiltrado.Any())
    {
        @foreach (var h in HistorialFiltrado)
        {
            <div style="display:grid;grid-template-columns:80px 1.2fr 1.4fr 1fr 1fr 80px;padding:16px 18px;border-bottom:1px solid #F4F5FB;align-items:center;font-size:14px"
