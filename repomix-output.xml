    }
</div>

@code {
    private const string OverviewView = "overview";
    private const string ConsumptionListView = "consumption-list";
    private const string AnnualView = "annual-consumption";
    private const string AllServices = "Todos los Servicios";

    private string View = OverviewView;
    private string SelectedYear = "Año 2025";
    private string SelectedCategory = AllServices;
    private string AppliedYear = "Año 2025";
    private string AppliedCategory = AllServices;
    private readonly string[] Years = ["Año 2025", "Año 2024", "Año 2023", "Año 2022", "Año 2021"];

    private readonly List<ReportRow> ReportRows =
    [
        new("Solar", "Instalación Paneles Solares", 250000m, 120000m, 30, 12000m),
        new("AC (Industrial)", "Instalación de Sistema UPS", 180000m, 75000m, 25, 15000m),
        new("AC (Residencial)", "Instalación de Sistema UPS", 150000m, 65000m, 16, 10000m),
        new("Cableado Red", "Cableado Estructurado", 160000m, 70000m, 22, 9000m),
        new("Seguridad", "Mantenimiento Eléctrico", 83000m, 23000m, 12, 8000m),
        new("Automatización", "Instalación de Planta Eléctrica", 110000m, 110000m, 3, 21000m)
    ];

    private IEnumerable<ReportRow> VisibleRows => AppliedCategory == AllServices
        ? ReportRows
        : ReportRows.Where(row => row.Name == AppliedCategory);

    private bool IsAllServices => AppliedCategory == AllServices;
    private decimal TotalConsumption => IsAllServices ? 1625000m : VisibleRows.Sum(row => row.TotalCost);
    private decimal InventoryRisk => IsAllServices ? 75000m : VisibleRows.Sum(row => row.InventoryRisk);
    private int InstallationCount => IsAllServices ? 108 : VisibleRows.Sum(row => row.Installations);
    private decimal AverageConsumption => IsAllServices
        ? 1696.24m
        : InstallationCount == 0 ? 0 : TotalConsumption / InstallationCount;
    private string HighestConsumptionService => IsAllServices
        ? "Instalación Paneles Solares"
        : VisibleRows.FirstOrDefault()?.ServiceLabel ?? "—";

    private void OpenConsumptionList() => View = ConsumptionListView;
    private void OpenAnnualReport() => View = AnnualView;
    private void GoOverview() => View = OverviewView;

    private void UpdateReport()
    {
        AppliedYear = SelectedYear;
        AppliedCategory = SelectedCategory;
    }

    private static string FormatMoney(decimal value) => value.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture);

    private sealed record ReportRow(string Name, string ServiceLabel, decimal MaterialCost, decimal ConsumableCost, int Installations, decimal InventoryRisk)
    {
        public decimal TotalCost => MaterialCost + ConsumableCost;
    }
}
</file>

