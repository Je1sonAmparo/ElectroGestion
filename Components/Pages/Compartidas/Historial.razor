@page "/historial"
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.SolicitudService SolicitudService
@inject ElectroGestion.Services.SolicitudEventoService SolicitudEventoService
@inject NavigationManager NavManager

<PageTitle>Historial | ElectroGestion</PageTitle>
<style>
    .historial-filtros { display:flex; flex-direction:column; gap:16px; padding:18px; border-bottom:1px solid #EFF0F6; }
    .historial-filtros .resp-search-block { min-width:0; }
</style>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Historial</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Solicitudes finalizadas.</div>
    </div>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;overflow:hidden">
    <div class="historial-filtros">
        <div style="display:flex;align-items:center;gap:20px;white-space:nowrap;overflow-x:auto" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" @bind:event="oninput" placeholder="ID"
                    style="width:120px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Cliente:</span>
                <input @bind="SearchCliente" @bind:event="oninput" placeholder="Nombre"
                    style="width:170px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Tipo:</span>
                <input @bind="SearchTipo" @bind:event="oninput" placeholder="Tipo"
                    style="width:150px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Técnico:</span>
                <input @bind="SearchTecnico" @bind:event="oninput" placeholder="Técnico asignado"
                    style="width:170px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Desde:</span>
                <input type="date" @bind="SearchDesde" style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Hasta:</span>
                <input type="date" @bind="SearchHasta" style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63" />
            </div>
            <div style="display:flex;justify-content:flex-end;flex:1;min-width:90px">
                <button class="primary-btn" @onclick="Filtrar"
                    style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Buscar</button>
            </div>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:80px 1.2fr 1.4fr 1fr 1fr 80px;padding:14px 18px;font-size:12px;font-weight:800;color:#8B90A3;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #EFF0F6"
         class="resp-table-row">
        <div>ID</div>
        <div>Cliente</div>
        <div>Tipo de servicio</div>
        <div>Fecha finalización</div>
        <div>Estado</div>
        <div style="text-align:right">Acción</div>
    </div>

    @if (HistorialFiltrado.Any())
    {
        @foreach (var h in HistorialFiltrado)
        {
            <div style="display:grid;grid-template-columns:80px 1.2fr 1.4fr 1fr 1fr 80px;padding:16px 18px;border-bottom:1px solid #F4F5FB;align-items:center;font-size:14px"
                 class="resp-table-row">
                <div style="font-family:ui-monospace,monospace;color:#6B7085">@h.Id.ToString("D4")</div>
                <div style="font-weight:700">@h.Cliente?.Nombre</div>
                <div>@h.Servicio?.Nombre</div>
                <div style="color:#6B7085">@ElectroGestion.Services.AppStateService.FormatFecha((h.FechaFin ?? h.FechaSolicitud).ToString("yyyy-MM-dd"))</div>
                <div>
                    <span style="display:inline-block;padding:5px 11px;border-radius:20px;font-size:12px;font-weight:800;background:#E4F6EA;color:#17803D">
                        Finalizada
                    </span>
                </div>
                <div style="display:flex;justify-content:flex-end">
                    <button title="Ver detalle" @onclick="() => AbrirDetalle(h)"
                            style="width:32px;height:32px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer;color:#4A4E63;display:flex;align-items:center;justify-content:center">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div style="padding:38px;text-align:center;color:#8B90A3;font-size:14px">
            Aún no hay servicios finalizados.
        </div>
    }
</div>

@if (IsModalOpen && SelectedHistorial != null)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px;overflow-y:auto" @onclick="CerrarDetalle">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:620px;max-height:calc(100vh - 40px);max-height:calc(100dvh - 40px);overflow-y:auto;overscroll-behavior:contain;box-sizing:border-box;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,.2);animation:tin .2s ease-out" @onclick:stopPropagation>
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
                <div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B">Detalle de Historial</div>
                    <div style="font-size:14px;color:#6B7085;margin-top:3px">Historial @SelectedHistorial.Id.ToString("D4")</div>
                </div>
                <button @onclick="CerrarDetalle" aria-label="Cerrar" style="width:32px;height:32px;border:1px solid #E3E5EE;border-radius:8px;background:#fff;display:flex;align-items:center;justify-content:center;color:#8B90A3;cursor:pointer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px" class="resp-grid-2">
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Cliente</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedHistorial.Cliente?.Nombre</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Tipo de Servicio</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedHistorial.Servicio?.Nombre</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Fecha Finalización</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@ElectroGestion.Services.AppStateService.FormatFecha((SelectedHistorial.FechaFin ?? SelectedHistorial.FechaSolicitud).ToString("yyyy-MM-dd"))</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Técnico Asignado</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedHistorial.TecnicoAsignado</div></div>
                <div style="grid-column:1 / -1;background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Dirección</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedHistorial.Direccion</div></div>
            </div>
            <SolicitudTimeline SolicitudId="SelectedHistorial.Id" />
            <div style="margin-top:24px;display:flex;justify-content:flex-end;border-top:1px solid #EFF0F6;padding-top:17px">
                <button @onclick="CerrarDetalle" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchId = "";
    private string SearchCliente = "";
    private string SearchTipo = "";
    private string SearchTecnico = "";
    private DateTime? SearchDesde;
    private DateTime? SearchHasta;
    private (string Id, string Cliente, string Tipo, string Tecnico, DateTime? Desde, DateTime? Hasta) FiltrosAplicados = ("", "", "", "", null, null);
    
    private bool IsModalOpen = false;
    private ElectroGestion.Models.Solicitud? SelectedHistorial;
    private List<ElectroGestion.Models.Solicitud> SolicitudesHistoricas = [];
    private Dictionary<int, DateTime> UltimasActividades = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            SolicitudesHistoricas = await SolicitudService.GetList(s => s.EstadoSolicitud != null && s.EstadoSolicitud.Nombre == "Finalizada");
            UltimasActividades = await SolicitudEventoService.ObtenerUltimasFechasActividadAsync(SolicitudesHistoricas.Select(s => s.Id));
        }
        catch { SolicitudesHistoricas = []; UltimasActividades = []; }
    }

    private void AbrirDetalle(ElectroGestion.Models.Solicitud s)
    {
        SelectedHistorial = s;
        IsModalOpen = true;
        StateHasChanged();
    }

    private void CerrarDetalle()
    {
        IsModalOpen = false;
        SelectedHistorial = null;
        StateHasChanged();
    }

    private void Filtrar()
    {
        FiltrosAplicados = (SearchId.Trim(), SearchCliente.Trim(), SearchTipo.Trim(), SearchTecnico.Trim(), SearchDesde, SearchHasta);
        StateHasChanged();
    }

    private IEnumerable<ElectroGestion.Models.Solicitud> HistorialFiltrado
    {
        get
        {
            var filtros = FiltrosAplicados;
            var res = SolicitudesHistoricas.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtros.Id))
            {
                res = res.Where(x => x.Id.ToString().Contains(filtros.Id));
            }
            if (!string.IsNullOrWhiteSpace(filtros.Cliente))
            {
                res = res.Where(x => x.Cliente != null && x.Cliente.Nombre.Contains(filtros.Cliente, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(filtros.Tipo))
            {
                res = res.Where(x => x.Servicio != null && x.Servicio.Nombre.Contains(filtros.Tipo, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(filtros.Tecnico))
                res = res.Where(x => (x.TecnicoAsignado ?? "").Contains(filtros.Tecnico, StringComparison.OrdinalIgnoreCase));
            if (filtros.Desde.HasValue)
                res = res.Where(x => (x.FechaFin ?? x.FechaSolicitud).Date >= filtros.Desde.Value.Date);
            if (filtros.Hasta.HasValue)
                res = res.Where(x => (x.FechaFin ?? x.FechaSolicitud).Date <= filtros.Hasta.Value.Date);

            return res
                .OrderByDescending(s => UltimasActividades.TryGetValue(s.Id, out var actividad) ? actividad : s.FechaFin ?? s.FechaSolicitud)
                .ThenByDescending(s => s.Id);
        }
    }
}
