@page "/solicitudes"
@inject ElectroGestion.Services.AppStateService AppState

@if (AppState.EsGerente)
{
    <ElectroGestion.Components.Pages.Gerente.Solicitudes AbrirNuevaSolicitud="@Nueva" />
}
else
{
    <ElectroGestion.Components.Pages.Tecnico.Solicitudes AbrirNuevaSolicitud="@Nueva" />
}

@code {
    [SupplyParameterFromQuery(Name = "nueva")]
    public bool Nueva { get; set; }
}
