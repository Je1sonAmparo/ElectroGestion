@page "/login"
@rendermode InteractiveServer
@using BlazorBootstrap
@using System.ComponentModel.DataAnnotations
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.AutenticacionService Autenticacion
@inject NavigationManager NavManager
@inject ToastService ToastService
@inject ILogger<Login> Logger

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#F4F5FB;padding:20px;background-image:radial-gradient(circle at top right, rgba(29,78,216,0.05), transparent 40%), radial-gradient(circle at bottom left, rgba(245,158,11,0.05), transparent 40%)">
  <div style="width:100%;max-width:440px;background:#fff;border-radius:24px;box-shadow:0 24px 48px rgba(20,22,43,0.04), 0 2px 8px rgba(20,22,43,0.02);padding:48px 44px">
    <div style="display:flex;flex-direction:column;align-items:center;margin-bottom:40px;text-align:center">
      <div style="display:flex;align-items:center;margin-bottom:12px;position:relative;margin-left:-8px">
        <svg viewBox="0 0 100 60" width="76" height="46">
          <defs>
            <mask id="bolt-mask">
              <rect width="100" height="60" fill="white" />
              <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="black" stroke="black" stroke-width="2.5" stroke-linejoin="round" />
            </mask>
          </defs>
          <text x="10" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#1D4ED8" letter-spacing="-1.5">E</text>
          <text x="44" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#F59E0B" mask="url(#bolt-mask)" letter-spacing="-1.5">G</text>
          <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="#F59E0B" stroke="#F59E0B" stroke-width="0" stroke-linejoin="round" />
        </svg>
      </div>
      <div style="font-family:'Manrope';font-weight:900;font-size:24px;letter-spacing:-0.5px;line-height:1.2;margin-bottom:8px">
        <span style="color:#1D4ED8">ELECTRO</span><span style="color:#334155">GESTIÓN</span>
      </div>
      <div style="color:#6B7085;font-size:14.5px;line-height:1.5">Sistema Informático de Servicios Eléctricos</div>
    </div>

    <div style="font-family:'Manrope';font-weight:800;font-size:22px;margin-bottom:24px;letter-spacing:-0.5px">
      Iniciar sesión
    </div>

    <EditForm Model="@credenciales" OnValidSubmit="IniciarSesionAsync">
      <DataAnnotationsValidator />
      <div style="margin-bottom:18px">
        <label for="usuario" style="display:block;margin-bottom:7px;font-size:14px;font-weight:700;color:#334155">Usuario</label>
        <InputText id="usuario" @bind-Value="credenciales.Usuario" autocomplete="username"
          class="login-input" placeholder="Escribe tu usuario" />
        <ValidationMessage For="@(() => credenciales.Usuario)" />
      </div>
      <div style="margin-bottom:18px">
        <label for="contrasena" style="display:block;margin-bottom:7px;font-size:14px;font-weight:700;color:#334155">Contraseña</label>
        <div class="password-input-container">
          <InputText id="contrasena" @bind-Value="credenciales.Password"
            type="@(mostrarContrasena ? "text" : "password")" autocomplete="current-password"
            class="login-input" placeholder="Escribe tu contraseña" />
          <button type="button" class="password-visibility-btn"
            @onclick="TogglePasswordVisibility"
            aria-label="@(mostrarContrasena ? "Ocultar contraseña" : "Mostrar contraseña")"
            aria-pressed="@mostrarContrasena"
            title="@(mostrarContrasena ? "Ocultar contraseña" : "Mostrar contraseña")">
            @if (mostrarContrasena)
            {
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 3l18 18" />
                <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c5 0 8.3 4.5 9 7-.3 1.1-1 2.1-1.8 3" />
                <path d="M6.2 6.2C4 7.5 2.5 9.7 2 12c.7 2.5 4 7 10 7 1 0 2-.2 2.9-.5" />
              </svg>
            }
            else
            {
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            }
          </button>
        </div>
        <ValidationMessage For="@(() => credenciales.Password)" />
      </div>
      @if (!string.IsNullOrWhiteSpace(error))
      {
        <div role="alert" style="margin-bottom:16px;color:#B91C1C;font-size:14px">@error</div>
      }
      <button type="submit" disabled="@cargando" class="login-btn"
        style="width:100%;padding:15px;background:#1D4ED8;color:#fff;border:0;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;font-family:'Manrope';box-shadow:0 4px 14px rgba(29,78,216,0.25);transition:all 0.2s;opacity:@(cargando ? "0.7" : "1")">
        @(cargando ? "Ingresando..." : "Iniciar sesión")
      </button>
    </EditForm>
  </div>
</div>

<style>
  .login-btn:hover {
    background: #1E40AF !important;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(29,78,216,0.3) !important;
  }

  .login-input {
    display: block;
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #D7DCE5;
    border-radius: 10px;
    font: inherit;
    box-sizing: border-box;
  }

  .password-input-container {
    position: relative;
  }

  .password-input-container .login-input {
    padding-right: 48px;
  }

  .password-visibility-btn {
    position: absolute;
    top: 50%;
    right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border: 0;
    background: transparent;
    color: #6B7085;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .password-visibility-btn:hover {
    color: #1D4ED8;
  }

  .password-visibility-btn:focus-visible {
    border-radius: 4px;
    outline: 2px solid #1D4ED8;
    outline-offset: 2px;
  }
</style>

@code {
    private Credenciales credenciales = new();
    private string? error;
    private bool cargando;
    private bool mostrarContrasena;

    private void TogglePasswordVisibility() => mostrarContrasena = !mostrarContrasena;

    private async Task IniciarSesionAsync()
    {
        cargando = true;
        error = null;

        try
        {
            var usuario = await Autenticacion.AutenticarAsync(credenciales.Usuario.Trim(), credenciales.Password);
            if (usuario is null)
            {
                error = "El usuario o la contraseña son incorrectos.";
                return;
            }

            AppState.Login(usuario);
            ToastService.Notify(new ToastMessage(ToastType.Primary, $"Bienvenido, {usuario.Nombre.Split(' ')[0]}."));
            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible autenticar al usuario {UsuarioLogin}.", credenciales.Usuario);
            error = "No se pudo conectar con el servicio de autenticación. Inténtalo de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }

    private sealed class Credenciales
    {
        [Required(ErrorMessage = "Escribe tu usuario.")]
        public string Usuario { get; set; } = "";

        [Required(ErrorMessage = "Escribe tu contraseña.")]
        public string Password { get; set; } = "";
    }
}
