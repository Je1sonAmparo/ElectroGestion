@page "/cobros"
@inject ElectroGestion.Services.CobroService CobroService
@inject BlazorBootstrap.ToastService ToastService

<PageTitle>Cobros | ElectroGestion</PageTitle>
<style>
    .cobros-filtros{display:flex;flex-direction:column;gap:18px;padding:18px;border-bottom:1px solid #EFF0F6}.cobros-fila{display:flex;align-items:center;gap:18px;flex-wrap:wrap}.cobro-filtro{display:flex;align-items:center;gap:9px}.cobro-filtro label{font-family:'Manrope';font-size:14px;font-weight:800;color:#14162B;white-space:nowrap}.cobro-filtro input,.cobro-filtro select{padding:9px 11px;border:1px solid #D5D8E6;border-radius:7px;background:#fff;color:#4A4E63}
    .modal-scroll{max-height:90vh;overflow:auto}.cobro-tabla th,.cobro-tabla td{padding:12px;text-align:left;border-bottom:1px solid #EFF0F6;white-space:nowrap}.cobro-tabla th{background:#F8F9FC}.cobro-tabla .num{text-align:right}
    .abono-accion{width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #D5D8E6;border-radius:7px;background:#fff;color:#4A4E63;cursor:pointer}.abono-accion:hover{background:#F7F8FC}.abono-accion.eliminar{color:#C4141B;border-color:#F5C2C4}
</style>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap"><div><div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Cobros</div><div style="color:#6B7085;font-size:14.5px;margin-top:5px">Registra abonos de cotizaciones aprobadas y consulta sus saldos.</div></div><button @onclick="AbrirNuevo" style="padding:11px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:9px;font-weight:700;cursor:pointer">+ Nuevo cobro</button></div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;overflow:hidden;margin-bottom:18px"><div class="cobros-filtros"><div class="cobros-fila">
    <div class="cobro-filtro"><label for="cobro-id">ID:</label><input id="cobro-id" @bind="FiltroId" @bind:event="oninput" placeholder="ID" style="width:120px" /></div>
    <div class="cobro-filtro"><label for="cobro-cliente">Cliente:</label><input id="cobro-cliente" @bind="FiltroCliente" @bind:event="oninput" placeholder="Nombre del cliente" style="width:220px" /></div>
    <div class="cobro-filtro"><label for="cobro-factura">Factura:</label><input id="cobro-factura" @bind="FiltroFactura" @bind:event="oninput" placeholder="Número" style="width:140px" /></div>
    <div class="cobro-filtro"><label for="cobro-estado">Estado:</label><select id="cobro-estado" @bind="FiltroEstado" style="width:170px"><option value="">Todos</option><option value="Pendiente de cobro">Pendiente de cobro</option><option>Finalizada</option></select></div>
    <button @onclick="() => StateHasChanged()" style="margin-left:auto;padding:9px 20px;border:0;border-radius:7px;background:#1D4ED8;color:#fff;font-weight:700;cursor:pointer">Buscar</button>
</div></div>
<div style="overflow-x:auto"><table class="cobro-tabla" style="width:100%;border-collapse:collapse;font-size:14px"><thead><tr><th>ID</th><th>Solicitud</th><th>Cliente</th><th>Factura</th><th>Fecha</th><th>Método reciente</th><th class="num">Total</th><th class="num">Pagado</th><th class="num">Saldo</th><th>Estado</th><th style="text-align:center">Acciones</th></tr></thead><tbody>
@if (Cargando) { <tr><td colspan="11" style="padding:25px;text-align:center">Cargando cobros...</td></tr> }
else if (!Filtrados.Any()) { <tr><td colspan="11" style="padding:25px;text-align:center;color:#6B7085">No hay cobros para los filtros seleccionados.</td></tr> }
else { @foreach (var cobro in Filtrados) { var (bg, fg) = ElectroGestion.Services.AppStateService.GetBadgeColors(cobro.Estado); <tr><td>@cobro.Id</td><td>@(cobro.Cotizacion?.SolicitudId ?? "—")</td><td>@cobro.Cliente</td><td>@cobro.FacturaId</td><td>@cobro.Fecha.ToString("dd/MM/yyyy")</td><td>@(string.IsNullOrWhiteSpace(cobro.MetodoPago) ? "—" : cobro.MetodoPago)</td><td class="num">RD$ @cobro.Monto.ToString("N2")</td><td class="num">RD$ @cobro.MontoPagado.ToString("N2")</td><td class="num">RD$ @cobro.SaldoPendiente.ToString("N2")</td><td><span style="padding:4px 10px;border-radius:20px;font-size:12px;font-weight:700;background:@bg;color:@fg">@cobro.Estado</span></td><td><div style="display:flex;justify-content:center;gap:7px;flex-wrap:wrap"><button @onclick="() => VerDetalleCobro(cobro.Id)" style="padding:7px 9px;background:#fff;border:1px solid #D5D8E6;border-radius:7px;cursor:pointer">Detalle</button><button @onclick="() => VerFactura(cobro)" style="padding:7px 9px;background:#fff;border:1px solid #D5D8E6;border-radius:7px;cursor:pointer">Factura</button><button @onclick="() => ConfirmarEliminarId = cobro.Id" style="padding:7px 9px;background:#fff;border:1px solid #F5C2C4;color:#C4141B;border-radius:7px;cursor:pointer">Eliminar</button></div></td></tr> } }
</tbody></table></div></div>

@if (ModalAbierto)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px" @onclick="CerrarModal"><div class="modal-scroll" style="background:#fff;border-radius:16px;width:100%;max-width:560px;padding:28px;box-shadow:0 20px 40px rgba(0,0,0,.2)" @onclick:stopPropagation>
    <h2 style="margin:0 0 18px;font-family:'Manrope'">Nuevo cobro</h2>
    <label style="font-weight:700">Cotización aprobada</label><select @bind="CotizacionSeleccionadaId" @bind:after="AlSeleccionarCotizacion" style="display:block;width:100%;padding:10px;margin:6px 0 15px;border:1px solid #D5D8E6;border-radius:8px"><option value="0">@(CotizacionesAprobadas.Any() ? "Seleccione una cotización" : "No hay cotizaciones aprobadas con cobro pendiente")</option>@foreach(var q in CotizacionesAprobadas){<option value="@q.Id">COT-@q.Id.ToString("D5") · @q.Cliente · Solicitud @q.SolicitudId</option>}</select>
    @if (CotizacionSeleccionada is not null){<div style="background:#F7F8FC;padding:12px;border-radius:9px;margin-bottom:15px"><b>Cliente:</b> @CotizacionSeleccionada.Cliente<br/><b>Solicitud:</b> @CotizacionSeleccionada.SolicitudId<br/><b>Total:</b> RD$ @CotizacionSeleccionada.MontoTotal.ToString("N2")</div>}
    <label style="font-weight:700">Monto recibido ahora (abono inicial)</label><input type="number" min="0" max="@(CotizacionSeleccionada?.MontoTotal ?? 0)" step="0.01" @bind="AbonoInicial" style="display:block;width:100%;padding:10px;margin:6px 0 15px;border:1px solid #D5D8E6;border-radius:8px" />
    <label style="font-weight:700">Método de pago del abono</label><select @bind="MetodoPago" style="display:block;width:100%;padding:10px;margin:6px 0 20px;border:1px solid #D5D8E6;border-radius:8px"><option>Efectivo</option><option>Transferencia</option><option>Cheque</option><option>Tarjeta de Crédito</option></select>
    @if(CotizacionSeleccionada is not null && AbonoInicial > 0){<div style="margin:-8px 0 18px;color:#4A4E63">Saldo inicial: <b>RD$ @Math.Max(0, CotizacionSeleccionada.MontoTotal - AbonoInicial).ToString("N2")</b></div>}
    <div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="CerrarModal" style="padding:10px 16px;border:1px solid #D5D8E6;background:white;border-radius:8px">Cancelar</button><button @onclick="GuardarCobro" disabled="@(CotizacionSeleccionadaId <= 0 || AbonoInicial < 0 || (CotizacionSeleccionada is not null && AbonoInicial > CotizacionSeleccionada.MontoTotal))" style="padding:10px 18px;border:0;background:#1D4ED8;color:white;border-radius:8px">Crear cobro</button></div>
</div></div> }

@if (CobroDetalle is not null)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9998;padding:20px" @onclick="CerrarDetalleCobro"><div class="modal-scroll" style="background:#fff;border-radius:16px;width:100%;max-width:700px;padding:28px;box-shadow:0 20px 40px rgba(0,0,0,.2)" @onclick:stopPropagation>
    <div style="display:flex;justify-content:space-between;gap:14px;align-items:flex-start"><div><h2 style="margin:0 0 6px;font-family:'Manrope'">Detalle del cobro</h2><div style="color:#6B7085">Factura @CobroDetalle.FacturaId · Cotización COT-@CobroDetalle.CotizacionId.ToString("D5")</div></div><span style="padding:5px 11px;border-radius:20px;background:@(CobroDetalle.Estado == "Finalizada" ? "#D1FAE5" : "#FEF3C7");color:@(CobroDetalle.Estado == "Finalizada" ? "#047857" : "#92400E");font-weight:700">@CobroDetalle.Estado</span></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:20px 0" class="resp-grid-2"><div><b>Solicitud:</b> @(CobroDetalle.Cotizacion?.SolicitudId ?? "—")</div><div><b>Orden:</b> @(CobroDetalle.OrdenTrabajo?.Code ?? "Aún no creada")</div><div><b>Cliente:</b> @CobroDetalle.Cliente</div><div><b>Servicio:</b> @(CobroDetalle.Cotizacion?.Solicitud?.Servicio?.Nombre ?? "—")</div><div><b>Fecha de apertura:</b> @CobroDetalle.Fecha.ToString("dd/MM/yyyy HH:mm")</div><div><b>Método reciente:</b> @(string.IsNullOrWhiteSpace(CobroDetalle.MetodoPago) ? "—" : CobroDetalle.MetodoPago)</div></div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;background:#F7F8FC;padding:14px;border-radius:10px"><div>Total<br/><b>RD$ @CobroDetalle.Monto.ToString("N2")</b></div><div>Pagado<br/><b>RD$ @CobroDetalle.MontoPagado.ToString("N2")</b></div><div>Saldo<br/><b>RD$ @CobroDetalle.SaldoPendiente.ToString("N2")</b></div></div>
    <h3 style="margin:22px 0 10px">Abonos registrados</h3>
    <div style="overflow-x:auto"><table class="cobro-tabla" style="width:100%;border-collapse:collapse;font-size:14px"><thead><tr><th>Fecha</th><th>Método</th><th class="num">Monto</th><th>Estado</th><th style="text-align:center">Acciones</th></tr></thead><tbody>@if(!CobroDetalle.Abonos.Any()){<tr><td colspan="5" style="padding:12px;color:#6B7085">Aún no hay abonos registrados.</td></tr>}else{@foreach(var abono in CobroDetalle.Abonos.OrderBy(a => a.Fecha)){<tr><td>@abono.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@abono.MetodoPago</td><td class="num">RD$ @abono.Monto.ToString("N2")</td><td>@(abono.Anulado ? "Revertido" : "Recibido")</td><td style="text-align:center">@if(!abono.Anulado && CobroDetalle.Estado == "Pendiente de cobro") { <div style="display:flex;justify-content:center;gap:6px"><button class="abono-accion" title="Editar abono" aria-label="Editar abono" @onclick="() => AbrirEditarAbono(abono)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></button><button class="abono-accion eliminar" title="Eliminar abono" aria-label="Eliminar abono" @onclick="() => ConfirmarEliminarAbonoId = abono.Id"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m19 6-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg></button></div> } else { <span style="color:#98A0B3">—</span> }</td></tr>}}</tbody></table></div>
    @if(CobroDetalle.Estado == "Pendiente de cobro" && CobroDetalle.SaldoPendiente > 0) { <div style="border:1px solid #E3E5EE;border-radius:10px;padding:16px;margin-top:18px"><h3 style="margin:0 0 8px">Saldo pendiente</h3><p style="margin:0 0 12px;color:#6B7085">Registra el próximo pago para continuar saldando esta cuenta.</p><button @onclick="AbrirModalAbono" style="padding:9px 15px;background:#1D4ED8;color:#fff;border:0;border-radius:8px;font-weight:700">Registrar abono</button></div> }
    @if(CobroDetalle.Estado == "Pendiente de cobro" && CobroDetalle.SaldoPendiente <= 0) { <div style="border:1px solid #A7F3D0;background:#ECFDF5;color:#065F46;border-radius:10px;padding:14px;margin-top:18px">El saldo está cubierto. Confirma para finalizar el cobro.</div> }
    <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:22px;flex-wrap:wrap"><button @onclick="CerrarDetalleCobro" style="padding:10px 16px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Cerrar</button><button @onclick="() => VerFactura(CobroDetalle)" style="padding:10px 16px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Ver factura</button>@if (CobroDetalle.Estado == "Pendiente de cobro" && CobroDetalle.SaldoPendiente <= 0) { <button @onclick="() => ConfirmarFinalizacionId = CobroDetalle.Id" style="padding:10px 16px;border:0;background:#059669;color:#fff;border-radius:8px;font-weight:700">Finalizar</button> }@if (CobroDetalle.Estado == "Finalizada") { <button @onclick="() => ConfirmarReaperturaId = CobroDetalle.Id" style="padding:10px 16px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700">Revertir</button> }</div>
</div></div> }

@if (ModalAbonoAbierto && CobroDetalle is not null)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.55);display:flex;align-items:center;justify-content:center;z-index:10000;padding:20px" @onclick="CerrarModalAbono"><div style="background:#fff;border-radius:16px;width:100%;max-width:480px;padding:26px;box-shadow:0 20px 40px rgba(0,0,0,.2)" @onclick:stopPropagation><h3 style="margin:0 0 8px">Registrar abono</h3><p style="margin:0 0 18px;color:#6B7085">Saldo pendiente: <b>RD$ @CobroDetalle.SaldoPendiente.ToString("N2")</b></p><label style="font-weight:700">Monto recibido</label><input type="number" min="0.01" max="@CobroDetalle.SaldoPendiente" step="0.01" @bind="MontoAbono" style="display:block;width:100%;padding:10px;margin:6px 0 14px;border:1px solid #D5D8E6;border-radius:8px" /><label style="font-weight:700">Método de pago</label><select @bind="MetodoAbono" style="display:block;width:100%;padding:10px;margin:6px 0 20px;border:1px solid #D5D8E6;border-radius:8px"><option>Efectivo</option><option>Transferencia</option><option>Cheque</option><option>Tarjeta de Crédito</option></select><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="CerrarModalAbono" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Cancelar</button><button @onclick="RegistrarAbono" disabled="@(MontoAbono <= 0 || MontoAbono > CobroDetalle.SaldoPendiente)" style="padding:9px 15px;background:#1D4ED8;color:#fff;border:0;border-radius:8px;font-weight:700">Guardar abono</button></div></div></div> }

@if (ModalEditarAbonoAbierto)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.55);display:flex;align-items:center;justify-content:center;z-index:10001;padding:20px" @onclick="CerrarEditarAbono"><div style="background:#fff;border-radius:16px;width:100%;max-width:480px;padding:26px;box-shadow:0 20px 40px rgba(0,0,0,.2)" @onclick:stopPropagation><h3 style="margin:0 0 16px">Editar abono</h3><label style="font-weight:700">Monto recibido</label><input type="number" min="0.01" max="@(CobroDetalle?.Monto ?? 0)" step="0.01" @bind="MontoAbonoEditar" style="display:block;width:100%;padding:10px;margin:6px 0 14px;border:1px solid #D5D8E6;border-radius:8px" /><label style="font-weight:700">Método de pago</label><select @bind="MetodoAbonoEditar" style="display:block;width:100%;padding:10px;margin:6px 0 20px;border:1px solid #D5D8E6;border-radius:8px"><option>Efectivo</option><option>Transferencia</option><option>Cheque</option><option>Tarjeta de Crédito</option></select><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="CerrarEditarAbono" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Cancelar</button><button @onclick="GuardarEdicionAbono" disabled="@(MontoAbonoEditar <= 0)" style="padding:9px 15px;background:#1D4ED8;color:#fff;border:0;border-radius:8px;font-weight:700">Guardar cambios</button></div></div></div> }

@if (ConfirmarFinalizacionId.HasValue)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:10001;padding:20px"><div style="background:#fff;border-radius:16px;max-width:430px;padding:28px"><h3>Finalizar cobro</h3><p>El cobro quedará finalizado. Si la orden está pendiente de cobro, también se finalizarán la orden y la solicitud.</p><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="() => ConfirmarFinalizacionId = null" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Cancelar</button><button @onclick="FinalizarCobro" style="padding:9px 16px;background:#059669;color:#fff;border:0;border-radius:8px">Confirmar</button></div></div></div> }

@if (ConfirmarReaperturaId.HasValue)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:10001;padding:20px"><div style="background:#fff;border-radius:16px;max-width:430px;padding:28px"><h3>Revertir cobro</h3><p>Se anulará el pago más reciente y se recalculará el saldo. Si la orden ya estaba terminada, volverá a Pendiente de cobro.</p><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="() => ConfirmarReaperturaId = null" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Cancelar</button><button @onclick="ReabrirCobro" style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:8px">Revertir</button></div></div></div> }

@if (ConfirmarEliminarId.HasValue)
{ var cobroAEliminar = ListaCobros.FirstOrDefault(c => c.Id == ConfirmarEliminarId.Value); <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:10002;padding:20px"><div style="background:#fff;border-radius:16px;max-width:440px;padding:28px"><h3>Eliminar cobro</h3><p>¿Está seguro de eliminar esta cuenta y sus abonos registrados?@if (cobroAEliminar?.Estado == "Finalizada" && cobroAEliminar.OrdenTrabajo is not null) { <span> La orden volverá a Pendiente de cobro.</span> }</p><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="() => ConfirmarEliminarId = null" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Cancelar</button><button @onclick="EliminarCobro" style="padding:9px 16px;background:#C4141B;color:#fff;border:0;border-radius:8px">Sí, eliminar</button></div></div></div> }

@if (ConfirmarEliminarAbonoId.HasValue)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:10002;padding:20px"><div style="background:#fff;border-radius:16px;max-width:440px;padding:28px"><h3>Eliminar abono</h3><p>El monto se descontará de lo pagado y el saldo pendiente se recalculará. ¿Desea continuar?</p><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="() => ConfirmarEliminarAbonoId = null" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Cancelar</button><button @onclick="EliminarAbono" style="padding:9px 16px;background:#C4141B;color:#fff;border:0;border-radius:8px">Sí, eliminar</button></div></div></div> }

@if (FacturaSeleccionada?.Cotizacion is not null)
{ <CotizacionDocumento Cotizacion="FacturaSeleccionada.Cotizacion" OnClose="CerrarFactura" EsFactura="true" NumeroFactura="FacturaSeleccionada.FacturaId" MetodoPago="@FacturaSeleccionada.MetodoPago" FechaDocumento="@FacturaSeleccionada.Fecha" /> }

@code {
    private List<ElectroGestion.Models.Cobro> ListaCobros = [];
    private List<ElectroGestion.Models.Cotizacion> CotizacionesAprobadas = [];
    private bool Cargando, ModalAbierto, ModalAbonoAbierto, ModalEditarAbonoAbierto;
    private string FiltroId = "", FiltroCliente = "", FiltroFactura = "", FiltroEstado = "", MetodoPago = "Transferencia", MetodoAbono = "Transferencia", MetodoAbonoEditar = "Transferencia";
    private int CotizacionSeleccionadaId;
    private decimal AbonoInicial, MontoAbono, MontoAbonoEditar;
    private int? ConfirmarFinalizacionId, ConfirmarReaperturaId, ConfirmarEliminarId, ConfirmarEliminarAbonoId, AbonoEditarId;
    private ElectroGestion.Models.Cotizacion? CotizacionSeleccionada => CotizacionesAprobadas.FirstOrDefault(q => q.Id == CotizacionSeleccionadaId);
    private ElectroGestion.Models.Cobro? FacturaSeleccionada;
    private ElectroGestion.Models.Cobro? CobroDetalle;
    private IEnumerable<ElectroGestion.Models.Cobro> Filtrados => ListaCobros.Where(c =>
        (string.IsNullOrWhiteSpace(FiltroId) || c.Id.ToString().Contains(FiltroId)) &&
        (string.IsNullOrWhiteSpace(FiltroCliente) || c.Cliente.Contains(FiltroCliente, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroFactura) || c.FacturaId.ToString().Contains(FiltroFactura)) &&
        (string.IsNullOrWhiteSpace(FiltroEstado) || c.Estado == FiltroEstado));
    protected override async Task OnInitializedAsync() => await Recargar();
    private async Task Recargar()
    {
        Cargando = true;
        try { ListaCobros = await CobroService.ObtenerTodosAsync(); CotizacionesAprobadas = await CobroService.ObtenerCotizacionesAprobadasAsync(); }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudieron cargar los cobros.")); }
        finally { Cargando = false; }
    }
    private async Task AbrirNuevo() { await Recargar(); CotizacionSeleccionadaId = 0; AbonoInicial = 0; MetodoPago = "Transferencia"; ModalAbierto = true; }
    private void AlSeleccionarCotizacion() { AbonoInicial = CotizacionSeleccionada is null ? 0 : Math.Min(Math.Round(CotizacionSeleccionada.MontoTotal * .5m, 2), CotizacionSeleccionada.MontoTotal); }
    private void CerrarModal() => ModalAbierto = false;
    private async Task GuardarCobro()
    {
        if (CotizacionSeleccionadaId <= 0) { ToastService.Notify(new ToastMessage(ToastType.Warning, "Seleccione una cotización aprobada.")); return; }
        if (await CobroService.CrearAsync(CotizacionSeleccionadaId, AbonoInicial, MetodoPago)) { CerrarModal(); ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro creado y abono inicial registrado.")); await Recargar(); }
        else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo crear el cobro. Verifique el estado y el monto del abono."));
    }
    private async Task RegistrarAbono()
    {
        if (CobroDetalle is null) return;
        if (await CobroService.RegistrarAbonoAsync(CobroDetalle.Id, MontoAbono, MetodoAbono)) { var id = CobroDetalle.Id; MontoAbono = 0; ModalAbonoAbierto = false; await Recargar(); CobroDetalle = ListaCobros.FirstOrDefault(c => c.Id == id); ToastService.Notify(new ToastMessage(ToastType.Success, CobroDetalle?.SaldoPendiente <= 0 ? "Abono registrado. Ya puede finalizar el cobro." : "Abono registrado correctamente.")); }
        else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo registrar el abono. Verifique el saldo disponible."));
    }
    private async Task FinalizarCobro()
    {
        if (!ConfirmarFinalizacionId.HasValue) return;
        var id = ConfirmarFinalizacionId.Value;
        ConfirmarFinalizacionId = null;
        if (await CobroService.CambiarEstadoAsync(id, "Finalizada")) { await Recargar(); CobroDetalle = ListaCobros.FirstOrDefault(c => c.Id == id); ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro finalizado.")); }
        else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo finalizar: confirme que el saldo esté completamente pagado."));
    }
    private async Task ReabrirCobro() { if (!ConfirmarReaperturaId.HasValue) return; var id = ConfirmarReaperturaId.Value; ConfirmarReaperturaId = null; if (await CobroService.ReabrirAsync(id)) { await Recargar(); CobroDetalle = ListaCobros.FirstOrDefault(c => c.Id == id); var aviso = CobroDetalle?.SaldoPendiente <= 0 ? "El saldo sigue cubierto; puedes finalizar el cobro nuevamente." : $"Abono revertido. Falta RD$ {CobroDetalle?.SaldoPendiente.ToString("N2")} por pagar."; ToastService.Notify(new ToastMessage(ToastType.Success, aviso)); } else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo reabrir el cobro.")); }
    private async Task EliminarCobro() { if (!ConfirmarEliminarId.HasValue) return; var id = ConfirmarEliminarId.Value; ConfirmarEliminarId = null; if (await CobroService.EliminarAsync(id)) { if (CobroDetalle?.Id == id) CobroDetalle = null; ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro eliminado.")); await Recargar(); } else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo eliminar el cobro.")); }
    private void VerDetalleCobro(int id) { CobroDetalle = ListaCobros.FirstOrDefault(c => c.Id == id); MontoAbono = 0; }
    private void CerrarDetalleCobro() => CobroDetalle = null;
    private void AbrirModalAbono() { if (CobroDetalle is null || CobroDetalle.SaldoPendiente <= 0) return; MontoAbono = CobroDetalle.SaldoPendiente; MetodoAbono = string.IsNullOrWhiteSpace(CobroDetalle.MetodoPago) ? "Transferencia" : CobroDetalle.MetodoPago; ModalAbonoAbierto = true; }
    private void CerrarModalAbono() => ModalAbonoAbierto = false;
    private void AbrirEditarAbono(ElectroGestion.Models.AbonoCobro abono) { if (CobroDetalle is null || CobroDetalle.Estado != "Pendiente de cobro") return; AbonoEditarId = abono.Id; MontoAbonoEditar = abono.Monto; MetodoAbonoEditar = abono.MetodoPago; ModalEditarAbonoAbierto = true; }
    private void CerrarEditarAbono() { ModalEditarAbonoAbierto = false; AbonoEditarId = null; }
    private async Task GuardarEdicionAbono() { if (CobroDetalle is null || !AbonoEditarId.HasValue) return; var id = CobroDetalle.Id; if (await CobroService.EditarAbonoAsync(id, AbonoEditarId.Value, MontoAbonoEditar, MetodoAbonoEditar)) { CerrarEditarAbono(); await Recargar(); CobroDetalle = ListaCobros.FirstOrDefault(c => c.Id == id); ToastService.Notify(new ToastMessage(ToastType.Success, "Abono actualizado; saldo recalculado.")); } else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo actualizar. Verifica que el total de abonos no exceda el cobro.")); }
    private async Task EliminarAbono() { if (CobroDetalle is null || !ConfirmarEliminarAbonoId.HasValue) return; var id = CobroDetalle.Id; var abonoId = ConfirmarEliminarAbonoId.Value; ConfirmarEliminarAbonoId = null; if (await CobroService.EliminarAbonoAsync(id, abonoId)) { await Recargar(); CobroDetalle = ListaCobros.FirstOrDefault(c => c.Id == id); ToastService.Notify(new ToastMessage(ToastType.Success, "Abono eliminado y saldo recalculado.")); } else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo eliminar el abono.")); }
    private void VerFactura(ElectroGestion.Models.Cobro cobro) { CobroDetalle = null; FacturaSeleccionada = cobro; }
    private void CerrarFactura() => FacturaSeleccionada = null;
}
