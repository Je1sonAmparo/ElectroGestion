@page "/cobros"
@inject ElectroGestion.Services.CobroService CobroService
@inject ElectroGestion.Services.AppStateService AppState
@inject BlazorBootstrap.ToastService ToastService

<PageTitle>Cobros | ElectroGestion</PageTitle>
<style>
    .cobros-filtros{display:flex;flex-direction:column;gap:18px;padding:18px;border-bottom:1px solid #EFF0F6}.cobros-fila{display:flex;align-items:center;gap:18px;flex-wrap:wrap}.cobro-filtro{display:flex;align-items:center;gap:9px}.cobro-filtro label{font-family:'Manrope';font-size:14px;font-weight:800;color:#14162B;white-space:nowrap}.cobro-filtro input,.cobro-filtro select{padding:9px 11px;border:1px solid #D5D8E6;border-radius:7px;background:#fff;color:#4A4E63}
</style>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap"><div><div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Cobros</div><div style="color:#6B7085;font-size:14.5px;margin-top:5px">Registra pagos de órdenes listas para cobro y emite su factura.</div></div><button @onclick="AbrirNuevo" style="padding:11px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:9px;font-weight:700;cursor:pointer">+ Nuevo cobro</button></div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;overflow:hidden;margin-bottom:18px"><div class="cobros-filtros"><div class="cobros-fila">
    <div class="cobro-filtro"><label for="cobro-id">ID:</label><input id="cobro-id" @bind="FiltroId" @bind:event="oninput" placeholder="ID" style="width:120px" /></div>
    <div class="cobro-filtro"><label for="cobro-cliente">Cliente:</label><input id="cobro-cliente" @bind="FiltroCliente" @bind:event="oninput" placeholder="Nombre del cliente" style="width:220px" /></div>
    <div class="cobro-filtro"><label for="cobro-factura">Factura:</label><input id="cobro-factura" @bind="FiltroFactura" @bind:event="oninput" placeholder="Número" style="width:140px" /></div>
    <div class="cobro-filtro"><label for="cobro-estado">Estado:</label><select id="cobro-estado" @bind="FiltroEstado" style="width:170px"><option value="">Todos</option><option value="Pendiente de cobro">Pendiente de cobro</option><option>Finalizada</option></select></div>
    <button @onclick="() => StateHasChanged()" style="margin-left:auto;padding:9px 20px;border:0;border-radius:7px;background:#1D4ED8;color:#fff;font-weight:700;cursor:pointer">Buscar</button>
</div></div>
<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:14px"><thead style="background:#F8F9FC"><tr><th style="padding:14px 12px;text-align:left">ID</th><th style="padding:14px 12px;text-align:left">Orden</th><th style="padding:14px 12px;text-align:left">Cliente</th><th style="padding:14px 12px;text-align:left">Factura</th><th style="padding:14px 12px;text-align:left">Fecha</th><th style="padding:14px 12px;text-align:left">Método</th><th style="padding:14px 12px;text-align:right">Monto</th><th style="padding:14px 12px;text-align:left">Estado</th><th style="padding:14px 12px;text-align:center">Acciones</th></tr></thead><tbody>
@if (Cargando) { <tr><td colspan="9" style="padding:25px;text-align:center">Cargando cobros...</td></tr> }
else if (!Filtrados.Any()) { <tr><td colspan="9" style="padding:25px;text-align:center;color:#6B7085">No hay cobros para los filtros seleccionados.</td></tr> }
else { @foreach (var cobro in Filtrados) { var (bg, fg) = ElectroGestion.Services.AppStateService.GetBadgeColors(cobro.Estado); <tr style="border-top:1px solid #EFF0F6"><td style="padding:13px 12px">@cobro.Id</td><td style="padding:13px 12px">@cobro.OrdenTrabajo?.Code</td><td style="padding:13px 12px">@cobro.Cliente</td><td style="padding:13px 12px">@cobro.FacturaId</td><td style="padding:13px 12px">@cobro.Fecha.ToString("dd/MM/yyyy")</td><td style="padding:13px 12px">@cobro.MetodoPago</td><td style="padding:13px 12px;text-align:right;font-weight:700">RD$ @cobro.Monto.ToString("N2")</td><td style="padding:13px 12px"><span style="padding:4px 10px;border-radius:20px;font-size:12px;font-weight:700;background:@bg;color:@fg">@cobro.Estado</span></td><td style="padding:13px 12px"><div style="display:flex;justify-content:center;gap:7px;flex-wrap:wrap"><button @onclick="() => VerDetalleCobro(cobro)" style="padding:7px 9px;background:#fff;border:1px solid #D5D8E6;border-radius:7px;cursor:pointer">Detalle</button><button @onclick="() => VerFactura(cobro)" style="padding:7px 9px;background:#fff;border:1px solid #D5D8E6;border-radius:7px;cursor:pointer">Factura</button>@if (cobro.Estado == "Pendiente de cobro") { <button @onclick="() => ConfirmarCobroId = cobro.Id" style="padding:7px 9px;background:#059669;color:white;border:0;border-radius:7px;cursor:pointer">Finalizar</button> }<button @onclick="() => ConfirmarEliminarId = cobro.Id" style="padding:7px 9px;background:#fff;border:1px solid #F5C2C4;color:#C4141B;border-radius:7px;cursor:pointer">Eliminar</button></div></td></tr> } }
</tbody></table></div></div>

@if (ModalAbierto)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px" @onclick="CerrarModal"><div style="background:#fff;border-radius:16px;width:100%;max-width:540px;padding:28px;box-shadow:0 20px 40px rgba(0,0,0,.2)" @onclick:stopPropagation><h2 style="margin:0 0 18px;font-family:'Manrope'">Nuevo cobro</h2><label style="font-weight:700">Orden pendiente de cobro</label><select @bind="OrdenSeleccionadaId" style="display:block;width:100%;padding:10px;margin:6px 0 15px;border:1px solid #D5D8E6;border-radius:8px"><option value="0">@(OrdenesCobrables.Any() ? "Seleccione una orden" : "No hay órdenes listas para cobro")</option>@foreach(var orden in OrdenesCobrables){<option value="@orden.Id">@orden.Code · @orden.Cliente</option>}</select>@if (OrdenSeleccionada is not null){<div style="background:#F7F8FC;padding:12px;border-radius:9px;margin-bottom:15px"><b>Cliente:</b> @OrdenSeleccionada.Cliente<br/><b>Total de orden:</b> RD$ @(OrdenSeleccionada.Cotizacion?.MontoTotal.ToString("N2") ?? "0.00")</div>}<label style="font-weight:700">Método de pago</label><select @bind="MetodoPago" style="display:block;width:100%;padding:10px;margin:6px 0 20px;border:1px solid #D5D8E6;border-radius:8px"><option>Efectivo</option><option>Transferencia</option><option>Cheque</option><option>Tarjeta de Crédito</option></select><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="CerrarModal" style="padding:10px 16px;border:1px solid #D5D8E6;background:white;border-radius:8px">Cancelar</button><button @onclick="GuardarCobro" disabled="@(OrdenSeleccionadaId <= 0)" style="padding:10px 18px;border:0;background:#1D4ED8;color:white;border-radius:8px;opacity:@(OrdenSeleccionadaId <= 0 ? ".55" : "1")">Crear cobro</button></div></div></div> }

@if (CobroDetalle is not null)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9998;padding:20px" @onclick="CerrarDetalleCobro"><div style="background:#fff;border-radius:16px;width:100%;max-width:620px;padding:28px;box-shadow:0 20px 40px rgba(0,0,0,.2)" @onclick:stopPropagation><h2 style="margin:0 0 20px;font-family:'Manrope'">Detalle del cobro</h2><div style="display:grid;grid-template-columns:1fr 1fr;gap:12px" class="resp-grid-2"><div><b>Factura:</b> @CobroDetalle.FacturaId</div><div><b>Estado:</b> @CobroDetalle.Estado</div><div><b>Orden:</b> @CobroDetalle.OrdenTrabajo?.Code</div><div><b>Solicitud:</b> @CobroDetalle.OrdenTrabajo?.Cotizacion?.SolicitudId</div><div><b>Cliente:</b> @CobroDetalle.Cliente</div><div><b>Servicio:</b> @CobroDetalle.OrdenTrabajo?.Cotizacion?.Solicitud?.Servicio?.Nombre</div><div><b>Fecha:</b> @CobroDetalle.Fecha.ToString("dd/MM/yyyy HH:mm")</div><div><b>Método de pago:</b> @CobroDetalle.MetodoPago</div><div style="grid-column:1/-1;font-size:18px"><b>Monto:</b> RD$ @CobroDetalle.Monto.ToString("N2")</div></div><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:24px;flex-wrap:wrap"><button @onclick="CerrarDetalleCobro" style="padding:10px 16px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Cerrar</button><button @onclick="() => VerFactura(CobroDetalle)" style="padding:10px 16px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Ver factura</button>@if (CobroDetalle.Estado == "Finalizada") { <button @onclick="() => ConfirmarReaperturaId = CobroDetalle.Id" style="padding:10px 16px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700">Reabrir cobro</button> }</div></div></div> }

@if (ConfirmarCobroId.HasValue)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:10000;padding:20px"><div style="background:#fff;border-radius:16px;max-width:400px;padding:28px"><h3>Finalizar cobro</h3><p>¿Confirma que el pago fue recibido? La orden y la solicitud pasarán a finalizadas.</p><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="() => ConfirmarCobroId = null">Cancelar</button><button @onclick="FinalizarCobro" style="padding:9px 16px;background:#059669;color:white;border:0;border-radius:8px">Confirmar pago</button></div></div></div> }

@if (ConfirmarReaperturaId.HasValue)
{ <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:10001;padding:20px"><div style="background:#fff;border-radius:16px;max-width:430px;padding:28px"><h3>Reabrir cobro</h3><p>El cobro, la orden y la solicitud volverán al estado Pendiente de cobro.</p><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="() => ConfirmarReaperturaId = null" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Cancelar</button><button @onclick="ReabrirCobro" style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:8px">Confirmar reapertura</button></div></div></div> }

@if (ConfirmarEliminarId.HasValue)
{ var cobroAEliminar = ListaCobros.FirstOrDefault(c => c.Id == ConfirmarEliminarId.Value); <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:10002;padding:20px"><div style="background:#fff;border-radius:16px;max-width:440px;padding:28px"><h3>Eliminar cobro</h3><p>¿Está completamente seguro de eliminar este cobro?@if (cobroAEliminar?.Estado == "Finalizada") { <span> La orden y la solicitud volverán a Pendiente de cobro y dejarán de aparecer como finalizadas en el historial.</span> }</p><div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="() => ConfirmarEliminarId = null" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Cancelar</button><button @onclick="EliminarCobro" style="padding:9px 16px;background:#C4141B;color:#fff;border:0;border-radius:8px">Sí, eliminar</button></div></div></div> }

@if (FacturaSeleccionada?.OrdenTrabajo?.Cotizacion is not null)
{ <CotizacionDocumento Cotizacion="FacturaSeleccionada.OrdenTrabajo.Cotizacion" OnClose="CerrarFactura" EsFactura="true" NumeroFactura="FacturaSeleccionada.FacturaId" MetodoPago="@FacturaSeleccionada.MetodoPago" FechaDocumento="@FacturaSeleccionada.Fecha" /> }

@code {
    private List<ElectroGestion.Models.Cobro> ListaCobros = [];
    private List<ElectroGestion.Models.OrdenTrabajo> OrdenesCobrables = [];
    private bool Cargando, ModalAbierto;
    private string FiltroId = "", FiltroCliente = "", FiltroFactura = "", FiltroEstado = "", MetodoPago = "Transferencia";
    private int OrdenSeleccionadaId;
    private int? ConfirmarCobroId;
    private int? ConfirmarReaperturaId;
    private int? ConfirmarEliminarId;
    private ElectroGestion.Models.Cobro? FacturaSeleccionada;
    private ElectroGestion.Models.Cobro? CobroDetalle;
    private ElectroGestion.Models.OrdenTrabajo? OrdenSeleccionada => OrdenesCobrables.FirstOrDefault(o => o.Id == OrdenSeleccionadaId);
    private IEnumerable<ElectroGestion.Models.Cobro> Filtrados => ListaCobros.Where(c =>
        (string.IsNullOrWhiteSpace(FiltroId) || c.Id.ToString().Contains(FiltroId)) &&
        (string.IsNullOrWhiteSpace(FiltroCliente) || c.Cliente.Contains(FiltroCliente, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroFactura) || c.FacturaId.ToString().Contains(FiltroFactura)) &&
        (string.IsNullOrWhiteSpace(FiltroEstado) || c.Estado == FiltroEstado));
    protected override async Task OnInitializedAsync() => await Recargar();
    private async Task Recargar() { Cargando = true; try { ListaCobros = await CobroService.ObtenerTodosAsync(); OrdenesCobrables = await CobroService.ObtenerOrdenesCobrablesAsync(); } catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudieron cargar los cobros.")); } finally { Cargando = false; } }
    private void AbrirNuevo() { OrdenSeleccionadaId = 0; MetodoPago = "Transferencia"; ModalAbierto = true; }
    private void CerrarModal() => ModalAbierto = false;
    private async Task GuardarCobro() { if (OrdenSeleccionadaId <= 0) { ToastService.Notify(new ToastMessage(ToastType.Warning, "Seleccione una orden pendiente de cobro.")); return; } if (await CobroService.CrearAsync(OrdenSeleccionadaId, MetodoPago)) { CerrarModal(); ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro pendiente creado.")); await Recargar(); } else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo crear el cobro para esa orden.")); }
    private async Task FinalizarCobro() { if (!ConfirmarCobroId.HasValue) return; var id = ConfirmarCobroId.Value; ConfirmarCobroId = null; if (await CobroService.CambiarEstadoAsync(id, "Finalizada")) { ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro finalizado; solicitud y orden finalizadas.")); await Recargar(); } }
    private async Task ReabrirCobro() { if (!ConfirmarReaperturaId.HasValue) return; var id = ConfirmarReaperturaId.Value; ConfirmarReaperturaId = null; if (await CobroService.ReabrirAsync(id)) { CobroDetalle = null; ToastService.Notify(new ToastMessage(ToastType.Success, "El cobro y sus elementos relacionados fueron reabiertos.")); await Recargar(); } else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo reabrir el cobro.")); }
    private async Task EliminarCobro() { if (!ConfirmarEliminarId.HasValue) return; var id = ConfirmarEliminarId.Value; ConfirmarEliminarId = null; if (await CobroService.EliminarAsync(id)) { if (CobroDetalle?.Id == id) CobroDetalle = null; ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro eliminado.")); await Recargar(); } else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo eliminar el cobro.")); }
    private void VerDetalleCobro(ElectroGestion.Models.Cobro cobro) => CobroDetalle = cobro;
    private void CerrarDetalleCobro() => CobroDetalle = null;
    private void VerFactura(ElectroGestion.Models.Cobro cobro) { CobroDetalle = null; FacturaSeleccionada = cobro; }
    private void CerrarFactura() => FacturaSeleccionada = null;
}


