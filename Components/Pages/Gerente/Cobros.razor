@page "/cobros"
@inject ElectroGestion.Services.AppStateService AppState
@inject BlazorBootstrap.ToastService ToastService

<PageTitle>Cobros | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Cobros</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Control de pagos y facturación.</div>
    </div>
    <button class="primary-btn" @onclick="() => AbrirModal()"
        style="padding:11px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:9px;font-weight:700;font-size:14.5px;cursor:pointer;font-family:'Manrope';display:flex;align-items:center;gap:8px;box-shadow:0 4px 12px rgba(29,78,216,0.25)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Nuevo Cobro
    </button>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;overflow:hidden">
    <div style="display:flex;flex-direction:column;gap:18px;padding:18px 18px 12px;border-bottom:1px solid #EFF0F6">
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" @bind:event="oninput" placeholder="ID"
                    style="width:140px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Cliente:</span>
                <input @bind="SearchCliente" @bind:event="oninput" placeholder="Nombre cliente"
                    style="width:200px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Factura ID:</span>
                <input @bind="SearchFactura" @bind:event="oninput" placeholder="No. Factura"
                    style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Estado:</span>
                <select @bind="SearchEstado"
                    style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="">Todos</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Completado">Completado</option>
                    <option value="Cancelado">Cancelado</option>
                </select>
            </div>
            <div style="display:flex;justify-content:flex-end;margin-left:auto">
                <button class="primary-btn" @onclick="Filtrar"
                    style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Buscar</button>
            </div>
        </div>
    </div>

    <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:14px">
            <thead style="background:#F8F9FC;border-bottom:1px solid #E3E5EE">
                <tr>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">ID</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Cliente</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Factura</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Fecha</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Método</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Monto</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Estado</th>
                    <th style="padding:14px 18px;text-align:center;color:#4A4E63;font-weight:700">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredCobros.Any())
                {
                    <tr>
                        <td colspan="8" style="padding:24px;text-align:center;color:#6B7085">No se encontraron cobros.</td>
                    </tr>
                }
                else
                {
                    @foreach (var cobro in FilteredCobros)
                    {
                        var (bg, fg) = ElectroGestion.Services.AppStateService.GetBadgeColors(cobro.Estado);
                        <tr style="border-bottom:1px solid #EFF0F6;background:#fff">
                            <td style="padding:14px 18px;color:#14162B;font-weight:600">@cobro.Id</td>
                            <td style="padding:14px 18px;color:#4A4E63">@cobro.Cliente</td>
                            <td style="padding:14px 18px;color:#4A4E63">@cobro.FacturaId</td>
                            <td style="padding:14px 18px;color:#4A4E63">@cobro.Fecha.ToString("dd/MM/yyyy")</td>
                            <td style="padding:14px 18px;color:#4A4E63">@cobro.MetodoPago</td>
                            <td style="padding:14px 18px;color:#4A4E63;font-weight:700">RD$ @cobro.Monto.ToString("N2")</td>
                            <td style="padding:14px 18px">
                                <span style="display:inline-block;padding:4px 10px;border-radius:20px;font-size:12.5px;font-weight:700;background:@bg;color:@fg">
                                    @cobro.Estado
                                </span>
                            </td>
                            <td style="padding:14px 18px;text-align:center">
                                <div style="display:flex;gap:8px;justify-content:center">
                                    <button @onclick="() => VerDetalle(cobro.Id)" title="Ver detalle" aria-label="Ver detalle" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    <button @onclick="() => AbrirModal(cobro.Id)" title="Editar" aria-label="Editar" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (IsModalOpen)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(20,22,43,0.4);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px" @onclick="CerrarModal">
        <div style="background:#fff;width:100%;max-width:550px;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,0.1);display:flex;flex-direction:column;max-height:90vh" @onclick:stopPropagation>
            <div style="padding:24px;border-bottom:1px solid #E3E5EE;display:flex;align-items:center;justify-content:space-between">
                <h3 style="margin:0;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">@ModalTitle</h3>
                <button @onclick="CerrarModal" style="background:none;border:0;color:#6B7085;cursor:pointer;padding:4px">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            
            <div style="padding:24px;overflow-y:auto;display:flex;flex-direction:column;gap:16px">
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Cliente</label>
                    <select @bind="FormCliente" disabled="@EditId.HasValue" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;background:@(EditId.HasValue ? "#F7F8FC" : "#fff");color:@(EditId.HasValue ? "#6B7085" : "#14162B");cursor:@(EditId.HasValue ? "not-allowed" : "pointer");opacity:1">
                        <option value="">Seleccione un cliente registrado</option>
                        @if (EditId.HasValue && !AppState.Clientes.Any(c => string.Equals(c.Nombre, FormCliente, StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@FormCliente">@FormCliente</option>
                        }
                        @foreach (var cliente in AppState.Clientes.OrderBy(c => c.Nombre))
                        {
                            <option value="@cliente.Nombre">@cliente.Nombre</option>
                        }
                    </select>
                </div>
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Factura ID</label>
                    <input @bind="FormFacturaId" type="number" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="Ej: 1001" />
                </div>
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Método de Pago</label>
                    <select @bind="FormMetodoPago" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                        <option value="Efectivo">Efectivo</option>
                        <option value="Transferencia">Transferencia</option>
                        <option value="Cheque">Cheque</option>
                        <option value="Tarjeta de Crédito">Tarjeta de Crédito</option>
                    </select>
                </div>
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Monto</label>
                    <input @bind="FormMonto" type="number" step="0.01" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="0.00" />
                </div>
                @if (EditId.HasValue)
                {
                    <div>
                        <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Estado</label>
                        <select @bind="FormEstado" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Completado">Completado</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>
                }
            </div>

            <div style="padding:20px 24px;border-top:1px solid #E3E5EE;display:flex;justify-content:flex-end;gap:12px;background:#F8F9FC;border-radius:0 0 16px 16px">
                <button @onclick="CerrarModal" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;color:#4A4E63;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Cancelar</button>
                <button @onclick="GuardarCobro" style="padding:10px 22px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Guardar</button>
            </div>
        </div>
    </div>
}

@if (SelectedCobro != null)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:620px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,.2);animation:tin .2s ease-out">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
                <div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B">Detalle de Cobro</div>
                    <div style="font-size:14px;color:#6B7085;margin-top:3px">Cobro @SelectedCobro.Id.ToString("D4")</div>
                </div>
                <button @onclick="CerrarDetalle" aria-label="Cerrar" style="width:32px;height:32px;border:1px solid #E3E5EE;border-radius:8px;background:#fff;display:flex;align-items:center;justify-content:center;color:#8B90A3;cursor:pointer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px" class="resp-grid-2">
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Cliente</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedCobro.Cliente</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Factura ID</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedCobro.FacturaId</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Método</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedCobro.MetodoPago</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Fecha</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedCobro.Fecha.ToString("dd/MM/yyyy")</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Monto</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">RD$ @SelectedCobro.Monto.ToString("N2")</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Estado</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">
                    @{ var (bg, fg) = ElectroGestion.Services.AppStateService.GetBadgeColors(SelectedCobro.Estado); }
                    <span style="display:inline-block;padding:4px 10px;border-radius:20px;font-size:12.5px;font-weight:700;background:@bg;color:@fg">@SelectedCobro.Estado</span>
                </div></div>
            </div>
            <div style="margin-top:24px;display:flex;justify-content:flex-end;border-top:1px solid #EFF0F6;padding-top:17px">
                <button @onclick="CerrarDetalle" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchId = "";
    private string SearchCliente = "";
    private string SearchFactura = "";
    private string SearchEstado = "";

    private void Filtrar()
    {
        StateHasChanged();
    }

    private bool IsModalOpen = false;
    private string ModalTitle = "";
    private int? EditId = null;
    private ElectroGestion.Models.Cobro? SelectedCobro;

    private string FormCliente = "";
    private int FormFacturaId = 0;
    private string FormMetodoPago = "Transferencia";
    private decimal FormMonto = 0;
    private string FormEstado = "Pendiente";

    private List<ElectroGestion.Models.Cobro> FilteredCobros => AppState.Cobros
        .Where(c => {
            bool matchId = string.IsNullOrEmpty(SearchId) || c.Id.ToString().Contains(SearchId);
            bool matchCliente = string.IsNullOrEmpty(SearchCliente) || c.Cliente.Contains(SearchCliente, StringComparison.OrdinalIgnoreCase);
            bool matchFactura = string.IsNullOrEmpty(SearchFactura) || c.FacturaId.ToString().Contains(SearchFactura);
            bool matchEst = string.IsNullOrEmpty(SearchEstado) || c.Estado.Equals(SearchEstado, StringComparison.OrdinalIgnoreCase);
            return matchId && matchCliente && matchFactura && matchEst;
        })
        .OrderByDescending(c => c.Id)
        .ToList();

    private void AbrirModal(int? id = null)
    {
        EditId = id;
        if (id.HasValue)
        {
            ModalTitle = "Editar Cobro";
            var item = AppState.Cobros.First(x => x.Id == id.Value);
            FormCliente = item.Cliente;
            FormFacturaId = item.FacturaId;
            FormMetodoPago = item.MetodoPago;
            FormMonto = item.Monto;
            FormEstado = item.Estado;
        }
        else
        {
            ModalTitle = "Nuevo Cobro";
            FormCliente = "";
            FormFacturaId = 0;
            FormMetodoPago = "Transferencia";
            FormMonto = 0;
            FormEstado = "Pendiente";
        }
        IsModalOpen = true;
    }

    private void CerrarModal()
    {
        IsModalOpen = false;
    }

    private void GuardarCobro()
    {
        if (string.IsNullOrWhiteSpace(FormCliente) || FormFacturaId <= 0 || FormMonto <= 0)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Complete todos los campos correctamente."));
            return;
        }

        if (!EditId.HasValue && !AppState.Clientes.Any(c => string.Equals(c.Nombre, FormCliente, StringComparison.OrdinalIgnoreCase)))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Seleccione un cliente registrado."));
            return;
        }

        if (EditId.HasValue)
        {
            var item = AppState.Cobros.First(x => x.Id == EditId.Value);
            item.FacturaId = FormFacturaId;
            item.MetodoPago = FormMetodoPago;
            item.Monto = FormMonto;
            item.Estado = FormEstado;
            ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro actualizado con éxito."));
        }
        else
        {
            var nuevo = new ElectroGestion.Models.Cobro
            {
                Id = AppState.NextCobroId(),
                Cliente = FormCliente,
                FacturaId = FormFacturaId,
                MetodoPago = FormMetodoPago,
                Monto = FormMonto,
                Fecha = DateTime.Today,
                Estado = "Pendiente"
            };
            AppState.Cobros.Add(nuevo);
            ToastService.Notify(new ToastMessage(ToastType.Success, "Cobro creado con éxito."));
        }

        AppState.NotifyStateChanged();
        CerrarModal();
    }

    private void VerDetalle(int id)
    {
        SelectedCobro = AppState.Cobros.FirstOrDefault(c => c.Id == id);
    }

    private void CerrarDetalle()
    {
        SelectedCobro = null;
    }
}
