@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.OrdenTrabajoService OrdenService
@inject BlazorBootstrap.ToastService ToastService

<PageTitle>Órdenes de Trabajo | ElectroGestion</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:24px;flex-wrap:wrap">
    <div><h1 class="page-title" style="font-family:'Manrope';font-size:31px;margin:0">Órdenes de trabajo</h1><p style="color:#6B7085;margin:5px 0 0">Materiales de la cotización y herramientas para el trabajo en campo.</p></div>
    <button @onclick="AbrirNueva" style="padding:11px 18px;background:#1D4ED8;color:white;border:0;border-radius:9px;font-weight:700;cursor:pointer">+ Nueva orden</button>
</div>

<div style="background:white;border:1px solid #E3E5EE;border-radius:12px;padding:18px;margin-bottom:18px;display:flex;align-items:end;gap:14px;flex-wrap:wrap">
    <div><label for="orden-id">ID</label><input id="orden-id" @bind="FiltroId" @bind:event="oninput" placeholder="ID de orden" style="display:block;padding:9px;border:1px solid #D5D8E6;border-radius:7px;width:130px" /></div>
    <div><label for="orden-cliente">Cliente</label><input id="orden-cliente" @bind="FiltroCliente" @bind:event="oninput" placeholder="Nombre del cliente" style="display:block;padding:9px;border:1px solid #D5D8E6;border-radius:7px" /></div>
    <div><label for="orden-estado">Estado</label><select id="orden-estado" @bind="FiltroEstado" style="display:block;padding:9px;border:1px solid #D5D8E6;border-radius:7px"><option value="">Todos</option><option>En proceso</option><option>Finalizada</option></select></div>
</div>

@if (Cargando)
{ <p>Cargando órdenes...</p> }
else if (!OrdenesFiltradas.Any())
{ <div style="background:white;border:1px solid #E3E5EE;border-radius:12px;padding:28px;color:#6B7085">No hay órdenes con los filtros seleccionados.</div> }
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:16px">
    @foreach (var orden in OrdenesFiltradas)
    {
        <article style="background:white;border:1px solid #E3E5EE;border-radius:12px;padding:22px;display:flex;flex-direction:column;gap:16px">
            <div style="display:flex;justify-content:space-between;gap:12px;align-items:start"><div><div style="font-size:12px;color:#8B90A3;font-weight:700">@orden.Code · @orden.FechaCreacion.ToString("dd/MM/yyyy")</div><h2 style="font-size:20px;margin:5px 0">@orden.Cliente</h2><div style="color:#6B7085">@orden.TipoServicio</div></div><span style="white-space:nowrap;border-radius:20px;padding:5px 10px;background:@(orden.Estado == "Finalizada" ? "#D1FAE5" : "#DBEAFE");color:@(orden.Estado == "Finalizada" ? "#047857" : "#1D4ED8");font-size:12px;font-weight:700">@orden.Estado</span></div>
            <div><h3 style="font-size:13px;text-transform:uppercase;color:#6B7085;margin:0 0 8px">Tareas</h3>@foreach (var tarea in orden.Trabajos) { <div style="padding:3px 0">• @tarea</div> }</div>
            <div><h3 style="font-size:13px;text-transform:uppercase;color:#6B7085;margin:0 0 8px">Materiales de la cotización</h3>
                @if (orden.MaterialesCotizados.Count == 0) { <div style="color:#8B90A3">Sin materiales cotizados.</div> }
                else { <div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:14px"><thead><tr style="background:#F7F8FC"><th style="text-align:left;padding:8px">Material</th><th style="text-align:right;padding:8px">Cantidad</th></tr></thead><tbody>@foreach (var material in orden.MaterialesCotizados) { <tr style="border-top:1px solid #EFF0F6"><td style="padding:8px">@material.Codigo · @material.Nombre</td><td style="text-align:right;padding:8px">@material.Cantidad</td></tr> }</tbody></table></div> }
            </div>
            <div><h3 style="font-size:13px;text-transform:uppercase;color:#6B7085;margin:0 0 8px">Herramientas asignadas</h3>@if (orden.Herramientas.Count == 0) { <span style="color:#8B90A3">Sin herramientas asignadas.</span> } else { <div style="display:flex;flex-wrap:wrap;gap:6px">@foreach (var herramienta in orden.Herramientas) { <span style="padding:5px 9px;background:#F7F8FC;border:1px solid #E3E5EE;border-radius:15px;font-size:13px">@herramienta</span> }</div> }</div>
            @if (!string.IsNullOrWhiteSpace(orden.Observaciones)) { <div><h3 style="font-size:13px;text-transform:uppercase;color:#6B7085;margin:0 0 8px">Instrucciones de campo</h3><div>@orden.Observaciones</div></div> }
            <div style="margin-top:auto;padding-top:10px;border-top:1px solid #EFF0F6;display:flex;gap:7px;flex-wrap:wrap">
                <button @onclick="() => VerCotizacion(orden.Id)" style="padding:8px 10px;border:1px solid #D5D8E6;background:white;border-radius:7px;cursor:pointer">Ver cotización</button>
                <button @onclick="() => Editar(orden)" style="padding:8px 10px;border:1px solid #D5D8E6;background:white;border-radius:7px;cursor:pointer">Editar</button>
                <button @onclick="() => CambiarEstado(orden)" style="padding:8px 10px;border:1px solid #1D4ED8;background:#1D4ED8;color:white;border-radius:7px;cursor:pointer">@(orden.Estado == "Finalizada" ? "Reabrir" : "Finalizar")</button>
                <button @onclick="() => OrdenAEliminar = orden.Id" style="padding:8px 10px;border:1px solid #F5C2C4;background:white;color:#C4141B;border-radius:7px;cursor:pointer">Eliminar</button>
            </div>
        </article>
    }
    </div>
}

@if (ModalAbierto)
{
    <div style="position:fixed;inset:0;background:rgba(20,22,43,.48);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px" @onclick="CerrarModal">
        <div style="background:white;width:100%;max-width:650px;max-height:90vh;overflow:auto;border-radius:14px;padding:24px" @onclick:stopPropagation>
            <h2 style="font-size:21px;margin:0 0 18px">@(EditandoId.HasValue ? "Editar orden" : "Nueva orden de trabajo")</h2>
            @if (!EditandoId.HasValue)
            {
                <label for="orden-cotizacion" style="font-weight:700">Cotización aprobada</label>
                <select id="orden-cotizacion" @bind="FormCotizacionId" style="display:block;width:100%;padding:10px;border:1px solid #D5D8E6;border-radius:7px;margin:6px 0 16px"><option value="0">Seleccione una cotización</option>@foreach (var cot in CotizacionesDisponibles) { <option value="@cot.Id">COT-@cot.Id.ToString("D5") · @cot.Cliente</option> }</select>
                @if (CotizacionSeleccionada is not null)
                {
                    <div style="background:#F7F8FC;padding:14px;border-radius:8px;margin-bottom:16px"><strong>Materiales de la cotización</strong><div style="font-size:13px;color:#6B7085">Se incorporarán con las cantidades aprobadas.</div>@foreach (var d in CotizacionSeleccionada.Detalles) { <div style="margin-top:6px">@d.CodigoArticulo · @d.NombreArticulo <strong>× @d.Cantidad</strong></div> }@if (!CotizacionSeleccionada.Detalles.Any()) { <div>La cotización incluye solo mano de obra.</div> }</div>
                }
            }
            else { <div style="background:#F7F8FC;padding:12px;border-radius:8px;margin-bottom:16px">Los materiales se mantienen iguales a la cotización vinculada.</div> }
            <label for="orden-tareas" style="font-weight:700">Tareas (una por línea)</label><textarea id="orden-tareas" @bind="FormTrabajos" rows="4" style="display:block;width:100%;padding:10px;border:1px solid #D5D8E6;border-radius:7px;margin:6px 0 16px"></textarea>
            <label for="orden-herramientas" style="font-weight:700">Herramientas asignadas (una por línea)</label><textarea id="orden-herramientas" @bind="FormHerramientas" rows="3" style="display:block;width:100%;padding:10px;border:1px solid #D5D8E6;border-radius:7px;margin:6px 0 16px" placeholder="Multímetro&#10;Escalera"></textarea>
            <label for="orden-instrucciones" style="font-weight:700">Instrucciones de campo</label><textarea id="orden-instrucciones" @bind="FormObservaciones" rows="3" maxlength="2000" style="display:block;width:100%;padding:10px;border:1px solid #D5D8E6;border-radius:7px;margin:6px 0 16px"></textarea>
            <div style="display:flex;justify-content:flex-end;gap:9px"><button @onclick="CerrarModal" style="padding:9px 14px;background:white;border:1px solid #D5D8E6;border-radius:7px;cursor:pointer">Cancelar</button><button @onclick="Guardar" style="padding:9px 16px;background:#1D4ED8;color:white;border:0;border-radius:7px;cursor:pointer">Guardar</button></div>
        </div>
    </div>
}

@if (OrdenAEliminar.HasValue)
{ <div style="position:fixed;inset:0;background:rgba(20,22,43,.48);z-index:10000;display:flex;align-items:center;justify-content:center;padding:20px"><div style="background:white;padding:24px;border-radius:14px;max-width:420px"><h2 style="font-size:20px">Eliminar orden</h2><p>¿Desea eliminar esta orden de trabajo?</p><div style="display:flex;justify-content:end;gap:9px"><button @onclick="() => OrdenAEliminar = null">Cancelar</button><button @onclick="Eliminar" style="background:#C4141B;color:white;border:0;border-radius:7px;padding:8px 14px">Eliminar</button></div></div></div> }

@if (AppState.EsGerente && CotizacionDetalle is not null)
{
    var cot = CotizacionDetalle;
    <div style="position:fixed;inset:0;background:rgba(20,22,43,.48);z-index:10001;display:flex;align-items:center;justify-content:center;padding:20px" @onclick="() => CotizacionDetalle = null">
        <div style="background:white;width:100%;max-width:700px;max-height:90vh;overflow:auto;border-radius:14px;padding:26px" @onclick:stopPropagation>
            <div style="display:flex;justify-content:space-between;gap:12px;align-items:start"><div><h2 style="margin:0">Cotización COT-@cot.Id.ToString("D5")</h2><div style="color:#6B7085">@cot.Fecha.ToString("dd/MM/yyyy HH:mm") · @cot.Estado</div></div><button @onclick="() => CotizacionDetalle = null" aria-label="Cerrar">×</button></div>
            <div style="margin:20px 0"><strong>Cliente:</strong> @(cot.Solicitud?.Cliente?.Nombre ?? cot.Cliente)<br /><strong>Servicio:</strong> @(cot.Solicitud?.Servicio?.Nombre ?? "—")<br /><strong>Dirección:</strong> @(cot.Solicitud?.Direccion ?? "—")</div>
            <div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse"><thead><tr style="background:#F7F8FC"><th style="text-align:left;padding:8px">Código</th><th style="text-align:left;padding:8px">Material</th><th style="text-align:right;padding:8px">Cantidad</th><th style="text-align:right;padding:8px">Precio</th><th style="text-align:right;padding:8px">Importe</th></tr></thead><tbody>@foreach (var d in cot.Detalles) { <tr style="border-top:1px solid #EFF0F6"><td style="padding:8px">@d.CodigoArticulo</td><td style="padding:8px">@d.NombreArticulo</td><td style="padding:8px;text-align:right">@d.Cantidad</td><td style="padding:8px;text-align:right">RD$ @d.PrecioUnitario.ToString("N2")</td><td style="padding:8px;text-align:right">RD$ @d.Subtotal.ToString("N2")</td></tr> }</tbody></table></div>
            <div style="margin-top:16px;text-align:right;line-height:1.8"><div>Subtotal de materiales: RD$ @cot.Detalles.Sum(d => d.Subtotal).ToString("N2")</div><div>Mano de obra: RD$ @cot.MontoManoObra.ToString("N2")</div><div>ITBIS (@cot.PorcentajeItbis.ToString("N0")%): RD$ @ElectroGestion.Services.CotizacionService.CalcularImpuesto(cot.Detalles.Sum(d => d.Subtotal) + cot.MontoManoObra, cot.PorcentajeItbis).ToString("N2")</div><strong>Total: RD$ @cot.MontoTotal.ToString("N2")</strong></div>
            <div style="text-align:right;margin-top:18px"><button @onclick="() => CotizacionDetalle = null" style="padding:9px 14px;border:1px solid #D5D8E6;background:white;border-radius:7px">Cerrar</button></div>
        </div>
    </div>
}

@code {
    private List<ElectroGestion.Models.OrdenTrabajo> OrdenesRows = [];
    private List<ElectroGestion.Models.Cotizacion> CotizacionesDisponibles = [];
    private ElectroGestion.Models.Cotizacion? CotizacionDetalle;
    private bool Cargando;
    private string FiltroId = "", FiltroCliente = "", FiltroEstado = "";
    private bool ModalAbierto;
    private int? EditandoId, OrdenAEliminar;
    private int FormCotizacionId;
    private string FormTrabajos = "", FormHerramientas = "", FormObservaciones = "";
    private ElectroGestion.Models.Cotizacion? CotizacionSeleccionada => CotizacionesDisponibles.FirstOrDefault(c => c.Id == FormCotizacionId);
    private IEnumerable<ElectroGestion.Models.OrdenTrabajo> OrdenesFiltradas => OrdenesRows.Where(o =>
        (string.IsNullOrWhiteSpace(FiltroId) || o.Id.ToString().Contains(FiltroId) || o.Code.Contains(FiltroId, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroCliente) || o.Cliente.Contains(FiltroCliente, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroEstado) || o.Estado == FiltroEstado));

    protected override async Task OnInitializedAsync() => await Recargar();

    private async Task Recargar()
    {
        Cargando = true;
        try { OrdenesRows = await OrdenService.ObtenerTodasAsync(); CotizacionesDisponibles = await OrdenService.ObtenerCotizacionesDisponiblesAsync(); }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudieron cargar las órdenes.")); }
        finally { Cargando = false; }
    }

    private void AbrirNueva() { EditandoId = null; FormCotizacionId = 0; FormTrabajos = FormHerramientas = FormObservaciones = ""; ModalAbierto = true; }
    private void Editar(ElectroGestion.Models.OrdenTrabajo orden) { EditandoId = orden.Id; FormCotizacionId = orden.CotizacionId; FormTrabajos = string.Join("\n", orden.Trabajos); FormHerramientas = string.Join("\n", orden.Herramientas); FormObservaciones = orden.Observaciones; ModalAbierto = true; }
    private void CerrarModal() => ModalAbierto = false;
    private static List<string> Lineas(string texto) => texto.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => x.Length > 0).ToList();

    private async Task Guardar()
    {
        if (!EditandoId.HasValue && FormCotizacionId <= 0) { ToastService.Notify(new ToastMessage(ToastType.Warning, "Seleccione una cotización aprobada.")); return; }
        var guardado = EditandoId.HasValue
            ? await OrdenService.ActualizarAsync(EditandoId.Value, Lineas(FormTrabajos), Lineas(FormHerramientas), FormObservaciones)
            : await OrdenService.CrearAsync(FormCotizacionId, Lineas(FormTrabajos), Lineas(FormHerramientas), FormObservaciones);
        if (!guardado) { ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo guardar. Verifique la cotización y que no tenga otra orden.")); return; }
        CerrarModal(); ToastService.Notify(new ToastMessage(ToastType.Success, "Orden guardada.")); await Recargar();
    }

    private async Task CambiarEstado(ElectroGestion.Models.OrdenTrabajo orden)
    {
        if (await OrdenService.CambiarEstadoAsync(orden.Id, orden.Estado == "Finalizada" ? "En proceso" : "Finalizada")) { await Recargar(); ToastService.Notify(new ToastMessage(ToastType.Success, "Estado de la orden actualizado.")); }
    }

    private async Task Eliminar()
    {
        if (!OrdenAEliminar.HasValue) return;
        var id = OrdenAEliminar.Value; OrdenAEliminar = null;
        if (await OrdenService.EliminarAsync(id)) { await Recargar(); ToastService.Notify(new ToastMessage(ToastType.Success, "Orden eliminada.")); }
    }

    private async Task VerCotizacion(int ordenId)
    {
        if (!AppState.EsGerente) return;
        CotizacionDetalle = await OrdenService.ObtenerCotizacionDeOrdenAsync(ordenId);
        if (CotizacionDetalle is null) ToastService.Notify(new ToastMessage(ToastType.Warning, "No se encontró la cotización de esta orden."));
    }
}
