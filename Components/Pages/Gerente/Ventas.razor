@page "/ventas"
@inject AppStateService AppState
@inject VentaService VentaService
@inject InventarioService InventarioService
@inject ClienteService ClienteService
@inject ToastService ToastService
@inject IJSRuntime JS

<PageTitle>Ventas | ElectroGestión</PageTitle>

@if (!AppState.EsGerente)
{
    <p>Esta página está disponible para el gerente.</p>
}
else
{
    <header class="ventas-header">
        <div><h1 class="page-title">Ventas</h1><p>Venta directa de equipos y materiales a clientes.</p></div>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end">
            <button @onclick="AlternarModoSeleccion" title="Seleccionar varias ventas para eliminar"
                style="padding:10px 16px 10px 14px;background:#fff;border:1px solid @(ModoSeleccion ? "#B42318" : "#D5D8E6");color:@(ModoSeleccion ? "#B42318" : "#4A4E63");border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';white-space:nowrap;display:flex;align-items:center;gap:8px;transition:all .15s">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8.5 12.5 2.5 2.5 5-5.5"/></svg>
                <span>@(ModoSeleccion ? "Salir de selección" : "Seleccionar")</span>
            </button>
            <button class="ventas-primary" @onclick="() => Abrir(null)">+ Nueva venta</button>
        </div>
    </header>

    <div class="ventas-panel">
        <div class="ventas-filtros">
            <label>ID <input @bind="FiltroId" @bind:event="oninput" placeholder="ID de venta" /></label>
            <label>Cliente <input @bind="Busqueda" @bind:event="oninput" placeholder="Nombre del cliente" /></label>
            <label>RNC/Cédula <input @bind="FiltroDocumento" @bind:event="oninput" placeholder="Documento" /></label>
            <label>Producto <input @bind="FiltroProducto" @bind:event="oninput" placeholder="Nombre o código" /></label>
            <label>NCF <input @bind="FiltroNcf" @bind:event="oninput" placeholder="Número de comprobante" /></label>
            <label>Comprobante <select @bind="Tipo"><option value="">Todos</option><option>@Venta.Consumo</option><option>@Venta.CreditoFiscal</option></select></label>
            <label>Estado <select @bind="Estado"><option value="">Todos</option><option>@Venta.Borrador</option><option>@Venta.Registrada</option><option>@Venta.Anulada</option></select></label>
            <label>Desde <input type="date" @bind="FechaDesde" /></label>
            <label>Hasta <input type="date" @bind="FechaHasta" /></label>
            <button class="ventas-primary" @onclick="AplicarFiltros">Buscar</button>
        </div>
        @if (ModoSeleccion)
        {
            <div style="margin:14px 14px 0;padding:10px 14px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;background:#EFF6FF;border:1px solid #B6C8F5;border-radius:10px">
                <div style="display:flex;align-items:center;gap:9px;font-size:13.5px;color:#1D4ED8;font-weight:700;flex-wrap:wrap">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8.5 12.5 2.5 2.5 5-5.5"/></svg>
                    <span>@(Seleccionadas.Count == 1 ? "1 venta seleccionada" : $"{Seleccionadas.Count} ventas seleccionadas")</span>
                    <span style="color:#6B7085;font-weight:500">· Haz clic en una fila para marcarla o desmarcarla</span>
                </div>
                <div style="display:flex;align-items:center;gap:10px">
                    <button @onclick="AlternarTodas" style="padding:8px 14px;border:1px solid #B6C8F5;background:#fff;color:#1D4ED8;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer;font-family:'Manrope'">
                        @(TodasMarcadas ? "Desmarcar todas" : "Marcar todas")
                    </button>
                    <button disabled="@(Seleccionadas.Count == 0)" @onclick="ConfirmarSeleccionadas" style="padding:8px 16px;border:0;background:@(Seleccionadas.Count == 0 ? "#F1A4A7" : "#C0392B");color:#fff;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer;font-family:'Manrope';display:flex;align-items:center;gap:7px">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                        <span>Eliminar @(Seleccionadas.Count == 1 ? "(1)" : $"({Seleccionadas.Count})")</span>
                    </button>
                </div>
            </div>
        }
        <div class="ventas-tabla">
            <table>
                <thead><tr><th><div style="display:inline-flex;align-items:center;gap:6px">@if (ModoSeleccion) { <input type="checkbox" aria-label="Seleccionar todas las ventas visibles que se pueden eliminar" checked="@TodasMarcadas" @onchange="e => SeleccionarTodas((bool)(e.Value ?? false))" @onclick:stopPropagation /> }<span>ID</span></div></th><th>Fecha</th><th>Cliente</th><th>Producto</th><th>Comprobante</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead>
                <tbody>
                    @foreach (var venta in Filtradas)
                    {
                        <tr @key="venta.Id" @onclick="@(() => FilaClicked(venta.Id))" style="transition:background 0.15s;background:@(ModoSeleccion && Seleccionadas.Contains(venta.Id) ? "#EFF6FF" : "transparent");cursor:@(ModoSeleccion ? "pointer" : "default")">
                            <td>
                                @if (ModoSeleccion)
                                {
                                    <input type="checkbox" aria-label="Seleccionar venta @venta.Id" checked="@Seleccionadas.Contains(venta.Id)" disabled="@(!PuedeEliminarVenta(venta.Id))" @onchange="e => CambiarSeleccion(venta.Id, (bool)(e.Value ?? false))" @onclick:stopPropagation style="margin-right:8px" />
                                }
                                @venta.Id
                            </td><td>@((venta.FechaVenta ?? venta.FechaCreacion).ToString("dd/MM/yyyy"))</td>
                            <td>@Comprador(venta)</td><td>@(venta.Detalles.Count == 1 ? venta.Detalles[0].NombreArticulo : $"{venta.Detalles.Count} productos")</td>
                            <td>@venta.TipoComprobante <small>@venta.Ncf</small></td>
                            <td>@Moneda(venta.Total)</td><td><span class="ventas-estado" data-estado="@venta.Estado">@venta.Estado</span></td>
                            <td><div class="ventas-acciones">
                                <button class="table-action-icon ventas-icono" title="Ver detalle" aria-label="Ver detalle" @onclick="() => Detalle = venta" @onclick:stopPropagation><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                                @if (venta.Estado == Venta.Borrador)
                                {
                                    <button class="table-action-icon ventas-icono" title="Editar" aria-label="Editar" @onclick="() => Abrir(venta)" @onclick:stopPropagation><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg></button>
                                    <button class="table-action-icon ventas-icono" title="Eliminar borrador" aria-label="Eliminar borrador" @onclick="() => ConfirmarEliminarBorrador(venta.Id)" @onclick:stopPropagation><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg></button>
                                }
                                else if (venta.Estado == Venta.Registrada)
                                {
                                    <button class="table-action-icon ventas-icono" title="Anular venta" aria-label="Anular venta" @onclick="() => Confirmacion = venta" @onclick:stopPropagation><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6 18.4 18.4"/></svg></button>
                                }
                            </div></td>
                        </tr>
                    }
                    @if (!Filtradas.Any())
                    {
                        <tr><td colspan="8">No se encontraron ventas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Formulario is { } form)
    {
        <div class="ventas-overlay" @onclick="CerrarFormulario">
            <section class="ventas-modal" role="dialog" aria-modal="true" aria-labelledby="titulo-venta" @onclick:stopPropagation>
                <h2 id="titulo-venta">@(form.Id == 0 ? "Nueva venta" : "Editar borrador")</h2>
                <div class="ventas-formulario">
                    <label class="ventas-producto">Producto
                        <select @bind="ArticuloSeleccionadoId">
                            <option value="0">Seleccione un producto</option>
                            @foreach (var articulo in Articulos)
                            {
                                <option value="@articulo.Id">@articulo.Codigo · @articulo.Nombre</option>
                            }
                        </select>
                    </label>
                    <label>Cantidad <input type="number" min="1" step="1" @bind="CantidadNueva" />
                        @if (ArticuloSeleccionado is { } productoDisponible)
                        {
                            <small class="ventas-disponibilidad">Hay @productoDisponible.Cantidad unidades en stock.</small>
                        }
                    </label>
                    <div class="ventas-agregar"><button type="button" class="ventas-primary" @onclick="AgregarProducto">Agregar producto</button></div>
                    <label>Tipo de comprobante <select @bind="form.TipoComprobante" @bind:after="CambiarTipoComprobante"><option value="@Venta.Consumo">Factura de consumo (B02 / E32)</option><option value="@Venta.CreditoFiscal">Comprobante de Crédito Fiscal (B01 / E31)</option></select></label>
                    @if (form.TipoComprobante == Venta.CreditoFiscal)
                    {
                        <label>Cliente del catálogo (opcional)
                            <select @bind="form.ClienteId" @bind:after="SeleccionarCliente">
                                <option value="">Ingresar datos manualmente</option>
                                @foreach (var cliente in Clientes) { <option value="@cliente.Id">@cliente.Nombre</option> }
                            </select>
                        </label>
                        <label>Nombre o razón social <input maxlength="200" @bind="form.NombreCliente" /></label>
                        <label>RNC o cédula <input maxlength="30" @bind="form.DocumentoCliente" /></label>
                    }
                    else if (form.Detalles.Sum(d => d.Subtotal) * 1.18m >= 250_000m)
                    {
                        <label>RNC o cédula del comprador (requerido desde RD$ 250,000) <input maxlength="30" @bind="form.DocumentoCliente" /></label>
                    }
                </div>
                @if (form.Detalles.Count > 0)
                {
                    var subtotal = form.Detalles.Sum(d => d.Subtotal);
                    var impuesto = CotizacionService.CalcularImpuesto(subtotal, 18m);
                    <div class="ventas-tabla ventas-lineas"><table><thead><tr><th>Código</th><th>Producto</th><th>Cantidad / stock</th><th>Precio unitario</th><th>Subtotal</th><th>Acción</th></tr></thead><tbody>
                        @foreach (var linea in form.Detalles) { <tr><td>@linea.CodigoArticulo</td><td>@linea.NombreArticulo</td><td><input class="ventas-cantidad-linea" type="number" min="1" max="@(Articulos.FirstOrDefault(a => a.Id == linea.ArticuloInventarioId)?.Cantidad ?? 0)" step="1" @bind="linea.Cantidad" @bind:event="oninput" /><small class="ventas-disponibilidad">Stock: @(Articulos.FirstOrDefault(a => a.Id == linea.ArticuloInventarioId)?.Cantidad ?? 0)</small></td><td>@Moneda(linea.PrecioUnitario)</td><td>@Moneda(linea.Subtotal)</td><td><button type="button" class="ventas-quitar" @onclick="() => QuitarProducto(linea.ArticuloInventarioId)">Quitar</button></td></tr> }
                    </tbody></table></div>
                    <div class="ventas-resumen"><div class="ventas-resumen-filas"><span>Subtotal</span><strong>@Moneda(subtotal)</strong><span>ITBIS (18%)</span><strong>@Moneda(impuesto)</strong><span class="ventas-total-label">Total</span><strong class="ventas-total">@Moneda(subtotal + impuesto)</strong></div></div>
                }
                <div class="ventas-pie">
                    <button disabled="@Ocupado" @onclick="CerrarFormulario">Cancelar</button>
                    <button disabled="@Ocupado" @onclick="() => Guardar(false)">Guardar borrador</button>
                    <button class="ventas-primary" disabled="@Ocupado" @onclick="() => Guardar(true)">Registrar venta</button>
                </div>
            </section>
        </div>
    }

    @if (Detalle is { } detalle)
    {
        <style>
            @@media print {
                @@page { size:A4; margin:0; }
                html, body { margin:0 !important; padding:0 !important; }
                body * { visibility:hidden !important; }
                .venta-documento, .venta-documento * { visibility:visible !important; }
                .ventas-overlay { position:absolute !important; top:0 !important; left:0 !important; right:auto !important; bottom:auto !important; display:block !important; box-sizing:border-box !important; width:210mm !important; padding:0 !important; margin:0 !important; background:white !important; }
                .venta-documento { position:relative !important; box-sizing:border-box !important; width:210mm !important; max-width:none !important; min-height:297mm !important; max-height:none !important; overflow:visible !important; border:0 !important; border-radius:0 !important; box-shadow:none !important; padding:14mm !important; }
                .venta-documento .ventas-pie { display:none; }
                .venta-documento .ventas-tabla { overflow:visible; }
                .venta-documento table { width:100%; table-layout:fixed; font-size:12px; }
                .venta-documento th, .venta-documento td { white-space:normal; }
                .venta-documento th:nth-child(3), .venta-documento td:nth-child(3), .venta-documento th:nth-child(5), .venta-documento td:nth-child(5) { text-align:right; }
                .venta-documento th:nth-child(4), .venta-documento td:nth-child(4) { text-align:center; }
                .venta-documento thead { display:table-header-group; }
            }
        </style>
        <div class="ventas-overlay" @onclick="() => Detalle = null">
            <section class="ventas-modal venta-documento" role="dialog" aria-modal="true" aria-labelledby="detalle-venta" @onclick:stopPropagation>
                <div class="factura-encabezado"><img src="/images/electrogestion-logo.png" alt="ElectroGestión" /><div><h2 id="detalle-venta">@(detalle.TipoComprobante == Venta.CreditoFiscal ? "Factura de Crédito Fiscal" : "Factura de consumo")</h2><p>N.º @detalle.Id</p><p>Fecha: @((detalle.FechaVenta ?? detalle.FechaCreacion).ToString("dd/MM/yyyy HH:mm"))</p><p>NCF: @(detalle.Ncf ?? "Pendiente de asignar")</p></div></div>
                <div class="factura-cliente"><strong>Cliente</strong><span>@Comprador(detalle)</span>@if (!string.IsNullOrWhiteSpace(detalle.DocumentoCliente)){<span>RNC/Cédula: @detalle.DocumentoCliente</span>}</div>
                <div class="ventas-tabla">
                    <table><colgroup><col style="width:15%" /><col style="width:33%" /><col style="width:20%" /><col style="width:12%" /><col style="width:20%" /></colgroup><thead><tr><th>Código</th><th>Descripción</th><th>Precio unitario</th><th>Cantidad</th><th>Importe</th></tr></thead>
                        <tbody>@foreach (var linea in detalle.Detalles) { <tr><td>@linea.CodigoArticulo</td><td>@linea.NombreArticulo</td><td>@Moneda(linea.PrecioUnitario)</td><td>@linea.Cantidad</td><td>@Moneda(linea.Subtotal)</td></tr> }</tbody>
                    </table>
                </div>
                <div class="factura-totales"><div><span>Subtotal</span><strong>@Moneda(detalle.Subtotal)</strong><span>ITBIS (@detalle.TasaItbis.ToString("0.##") %)</span><strong>@Moneda(detalle.Itbis)</strong><span class="factura-total-label">Total</span><strong class="factura-total">@Moneda(detalle.Total)</strong></div></div>
                <div class="ventas-pie">
                    <button @onclick="() => Detalle = null">Cerrar</button>
                    <button class="ventas-primary" @onclick="Imprimir">Imprimir / Guardar como PDF</button>
                </div>
            </section>
        </div>
    }

    @if (Confirmacion is { } confirmar)
    {
        <div class="ventas-overlay">
            <section class="ventas-modal" role="dialog" aria-modal="true" aria-labelledby="confirmar-venta">
                <h2 id="confirmar-venta">@(confirmar.Estado == Venta.Borrador ? "Eliminar borrador" : "Anular venta")</h2>
                <p>@(confirmar.Estado == Venta.Borrador ? "El borrador se conservará en Recuperación y el administrador podrá restaurarlo." : "Confirme que el comprobante ya fue corregido en su sistema de facturación y que las unidades regresaron al inventario.")</p>
                <div class="ventas-pie">
                    <button disabled="@Ocupado" @onclick="() => Confirmacion = null">Cancelar</button>
                    <button class="ventas-danger" disabled="@Ocupado" @onclick="ConfirmarAccion">Confirmar</button>
                </div>
            </section>
        </div>
    }

    @if (IsDeleteModalOpen)
    {
        <div class="ventas-overlay">
            <section class="ventas-modal" role="dialog" aria-modal="true" aria-labelledby="eliminar-ventas">
                <div style="font-family:'Manrope';font-weight:800;font-size:23px;color:#14162B;margin-bottom:12px">Eliminar @(DeleteIds.Count == 1 ? "venta" : "ventas")</div>
                <div style="color:#4A4E63;font-size:14.5px;line-height:1.55">¿Está seguro que desea eliminar @(DeleteIds.Count == 1 ? "esta venta" : $"estas {DeleteIds.Count} ventas")? Los borradores se conservarán en Recuperación y el administrador podrá restaurarlos.</div>
                @if (DeleteIds.Count > 1)
                {
                    <div style="background:#F9FAFB;border:1px solid #EFF0F6;border-radius:10px;max-height:200px;overflow:auto;margin-top:16px" class="resp-lista-eliminar">
                        @foreach (var venta in VentasAEliminar)
                        {
                            <div style="display:flex;align-items:center;gap:12px;padding:9px 14px;border-bottom:1px solid #EFF0F6">
                                <span style="font-family:ui-monospace,'SFMono-Regular',Consolas,monospace;font-size:12.5px;font-weight:700;letter-spacing:.05em;color:#C0392B;background:#FDECEC;border-radius:6px;padding:2px 8px;flex-shrink:0">@venta.Id</span>
                                <div style="min-width:0">
                                    <div style="font-size:13.5px;font-weight:700;color:#14162B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@Comprador(venta)</div>
                                    <div style="font-size:12px;color:#6B7085;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@(venta.Detalles.Count == 1 ? venta.Detalles[0].NombreArticulo : $"{venta.Detalles.Count} productos") · @Moneda(venta.Total)</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (Seleccionadas.Count > DeleteIds.Count)
                {
                    <div style="background:#FFF7E6;border:1px solid #F5E2B8;border-radius:8px;padding:9px 12px;font-size:12.5px;color:#8A6100;margin-top:12px">
                        Nota: se omitieron @(Seleccionadas.Count - DeleteIds.Count) venta(s) porque solo las ventas en estado Borrador se pueden eliminar.
                    </div>
                }
                <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:28px">
                    <button @onclick="CerrarEliminar" style="padding:11px 24px;border:1px solid #E3E5EE;background:#fff;border-radius:10px;font-weight:600;font-size:15px;cursor:pointer;color:#14162B;font-family:'Manrope'">
                        Cancelar
                    </button>
                    <button @onclick="EjecutarEliminar" style="padding:11px 26px;border:0;background:#C0392B;color:#fff;border-radius:10px;font-weight:700;font-size:15px;cursor:pointer;font-family:'Manrope'">
                        Eliminar
                    </button>
                </div>
            </section>
        </div>
    }
}

@code {
    private List<Venta> Lista = [];
    private List<ArticuloInventario> Articulos = [];
    private List<Cliente> Clientes = [];
    private Venta? Formulario, Detalle, Confirmacion;
    private bool Ocupado;
    private string Busqueda = "", FiltroId = "", FiltroDocumento = "", FiltroProducto = "", FiltroNcf = "", Tipo = "", Estado = "";
    private DateTime? FechaDesde, FechaHasta;
    private (string Id, string Cliente, string Documento, string Producto, string Ncf, string Tipo, string Estado, DateTime? Desde, DateTime? Hasta) Filtros = ("", "", "", "", "", "", "", null, null);

    // Modo selección + eliminación múltiple
    private bool ModoSeleccion;
    private HashSet<int> Seleccionadas = [];
    private HashSet<int> DeleteIds = [];
    private bool IsDeleteModalOpen;
    private List<int> ElegiblesVisibles => Filtradas.Where(v => PuedeEliminarVenta(v.Id)).Select(v => v.Id).ToList();
    private bool TodasMarcadas => ElegiblesVisibles.Count > 0 && ElegiblesVisibles.All(id => Seleccionadas.Contains(id));
    private List<Venta> VentasAEliminar => DeleteIds
        .Select(id => Lista.FirstOrDefault(v => v.Id == id))
        .Where(v => v != null)
        .Cast<Venta>()
        .ToList();

    private bool PuedeEliminarVenta(int id) => Lista.FirstOrDefault(v => v.Id == id)?.Estado == Venta.Borrador;

    private void AlternarModoSeleccion()
    {
        ModoSeleccion = !ModoSeleccion;
        if (!ModoSeleccion) Seleccionadas.Clear();
    }

    private void FilaClicked(int id)
    {
        if (!ModoSeleccion) return;
        if (!PuedeEliminarVenta(id))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Solo se puede eliminar una venta en estado Borrador (las ventas registradas o anuladas no se pueden eliminar)."));
            return;
        }
        CambiarSeleccion(id, !Seleccionadas.Contains(id));
    }

    private void CambiarSeleccion(int id, bool marcado) { if (marcado && PuedeEliminarVenta(id)) Seleccionadas.Add(id); else Seleccionadas.Remove(id); }
    private void SeleccionarTodas(bool marcado) { foreach (var id in ElegiblesVisibles) { if (marcado) Seleccionadas.Add(id); else Seleccionadas.Remove(id); } }
    private void AlternarTodas() => SeleccionarTodas(!TodasMarcadas);
    private void ConfirmarSeleccionadas() { DeleteIds = Seleccionadas.Where(PuedeEliminarVenta).ToHashSet(); IsDeleteModalOpen = DeleteIds.Count > 0; }

    private void ConfirmarEliminarBorrador(int id)
    {
        if (!PuedeEliminarVenta(id))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Solo se puede eliminar una venta en estado Borrador."));
            return;
        }
        DeleteIds = [id];
        IsDeleteModalOpen = true;
    }

    private void CerrarEliminar()
    {
        IsDeleteModalOpen = false;
        DeleteIds.Clear();
    }

    private async Task EjecutarEliminar()
    {
        if (DeleteIds.Count > 0 && !Ocupado)
        {
            Ocupado = true;
            try
            {
                var eliminadas = await VentaService.EliminarBorradoresAsync(DeleteIds);
                if (eliminadas > 0)
                {
                    await Recargar();
                    ToastService.Notify(new ToastMessage(ToastType.Success, eliminadas == 1 ? "Venta eliminada correctamente." : $"{eliminadas} ventas eliminadas correctamente."));
                    Seleccionadas.Clear();
                    ModoSeleccion = false;
                }
                else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo eliminar las ventas seleccionadas. Solo las ventas en estado Borrador se pueden eliminar."));
            }
            catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudo completar la operación.")); }
            finally { Ocupado = false; }
        }
        IsDeleteModalOpen = false;
        DeleteIds.Clear();
    }

    private IEnumerable<Venta> Filtradas => Lista.Where(v =>
        (Filtros.Id.Length == 0 || v.Id.ToString().Contains(Filtros.Id)) &&
        (Filtros.Cliente.Length == 0 || Comprador(v).Contains(Filtros.Cliente, StringComparison.OrdinalIgnoreCase)) &&
        (Filtros.Documento.Length == 0 || v.DocumentoCliente.Contains(Filtros.Documento, StringComparison.OrdinalIgnoreCase)) &&
        (Filtros.Producto.Length == 0 ||
            v.Detalles.Any(d => d.NombreArticulo.Contains(Filtros.Producto, StringComparison.OrdinalIgnoreCase) || d.CodigoArticulo.Contains(Filtros.Producto, StringComparison.OrdinalIgnoreCase)) ||
            (v.Detalles.Count == 0 && (v.NombreArticulo.Contains(Filtros.Producto, StringComparison.OrdinalIgnoreCase) || v.CodigoArticulo.Contains(Filtros.Producto, StringComparison.OrdinalIgnoreCase)))) &&
        (Filtros.Ncf.Length == 0 || (v.Ncf ?? "").Contains(Filtros.Ncf, StringComparison.OrdinalIgnoreCase)) &&
        (Filtros.Tipo.Length == 0 || v.TipoComprobante == Filtros.Tipo) &&
        (Filtros.Estado.Length == 0 || v.Estado == Filtros.Estado) &&
        (!Filtros.Desde.HasValue || (v.FechaVenta ?? v.FechaCreacion).Date >= Filtros.Desde.Value.Date) &&
        (!Filtros.Hasta.HasValue || (v.FechaVenta ?? v.FechaCreacion).Date <= Filtros.Hasta.Value.Date));

    private int ArticuloSeleccionadoId;
    private int CantidadNueva = 1;
    private ArticuloInventario? ArticuloSeleccionado => Articulos.FirstOrDefault(a => a.Id == ArticuloSeleccionadoId);
    private static string Comprador(Venta v) => string.IsNullOrWhiteSpace(v.NombreCliente) ? "Consumidor final" : v.NombreCliente;
    private static string Moneda(decimal importe) => $"RD$ {importe:N2}";
    private void AplicarFiltros() => Filtros = (FiltroId.Trim(), Busqueda.Trim(), FiltroDocumento.Trim(), FiltroProducto.Trim(), FiltroNcf.Trim(), Tipo, Estado, FechaDesde, FechaHasta);
    private void CerrarFormulario() { if (!Ocupado) Formulario = null; }
    private async Task Imprimir() => await JS.InvokeVoidAsync("window.print");

    protected override async Task OnInitializedAsync()
    {
        if (AppState.EsGerente) await Recargar();
    }

    private async Task Recargar()
    {
        try { Lista = await VentaService.ListarAsync(); }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudieron cargar las ventas.")); }
    }

    private async Task Abrir(Venta? venta)
    {
        try
        {
            Articulos = await InventarioService.ObtenerTodosAsync();
            Clientes = (await ClienteService.GetList(c => true)).OrderBy(c => c.Nombre).ToList();
            Formulario = venta is null ? new Venta() : new Venta
            {
                Id = venta.Id, ClienteId = venta.ClienteId,
                NombreCliente = venta.NombreCliente, DocumentoCliente = venta.DocumentoCliente,
                TipoComprobante = venta.TipoComprobante, TasaItbis = venta.TasaItbis,
                Detalles = venta.Detalles.Select(d => new DetalleVenta { ArticuloInventarioId = d.ArticuloInventarioId, CodigoArticulo = d.CodigoArticulo, NombreArticulo = d.NombreArticulo, Cantidad = d.Cantidad, PrecioUnitario = d.PrecioUnitario }).ToList()
            };
            ArticuloSeleccionadoId = 0;
            CantidadNueva = 1;
        }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudieron cargar los productos o clientes.")); }
    }

    private void AgregarProducto()
    {
        if (Formulario is not { } form || ArticuloSeleccionado is not { } articulo || CantidadNueva <= 0) return;
        var actual = form.Detalles.FirstOrDefault(d => d.ArticuloInventarioId == articulo.Id);
        var total = (actual?.Cantidad ?? 0) + CantidadNueva;
        if (total > articulo.Cantidad) { ToastService.Notify(new ToastMessage(ToastType.Warning, $"Stock disponible: {articulo.Cantidad} unidades.")); return; }
        if (actual is null) form.Detalles.Add(new DetalleVenta { ArticuloInventarioId = articulo.Id, CodigoArticulo = articulo.Codigo, NombreArticulo = articulo.Nombre, PrecioUnitario = articulo.PrecioUnidad, Cantidad = CantidadNueva });
        else actual.Cantidad = total;
        ArticuloSeleccionadoId = 0;
        CantidadNueva = 1;
    }

    private void QuitarProducto(int articuloId) => Formulario?.Detalles.RemoveAll(d => d.ArticuloInventarioId == articuloId);

    private void SeleccionarCliente()
    {
        if (Formulario is not { } form) return;
        var cliente = Clientes.FirstOrDefault(c => c.Id == form.ClienteId);
        form.NombreCliente = cliente?.Nombre ?? "";
        form.DocumentoCliente = cliente?.Rnc ?? "";
    }

    private void CambiarTipoComprobante()
    {
        if (Formulario is not { } form) return;
        form.ClienteId = null;
        if (form.TipoComprobante == Venta.Consumo)
        {
            form.NombreCliente = "";
            form.DocumentoCliente = "";
        }
    }

    private async Task Guardar(bool registrar)
    {
        if (Ocupado || Formulario is not { } form) return;
        Ocupado = true;
        try
        {
            var error = await VentaService.GuardarAsync(form, registrar);
            if (error is not null)
            {
                ToastService.Notify(new ToastMessage(ToastType.Warning, error));
                return;
            }
            Formulario = null;
            await Recargar();
            ToastService.Notify(new ToastMessage(ToastType.Success, registrar ? "Venta registrada." : "Borrador guardado."));
        }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudo guardar la venta.")); }
        finally { Ocupado = false; }
    }

    private async Task ConfirmarAccion()
    {
        if (Ocupado || Confirmacion is not { } venta) return;
        Ocupado = true;
        try
        {
            var hecho = venta.Estado == Venta.Borrador
                ? await VentaService.EliminarBorradorAsync(venta.Id)
                : await VentaService.AnularAsync(venta.Id);
            Confirmacion = null;
            await Recargar();
            ToastService.Notify(hecho
                ? new ToastMessage(ToastType.Success, "Operación realizada.")
                : new ToastMessage(ToastType.Warning, "No se pudo completar la operación."));
        }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudo completar la operación.")); }
        finally { Ocupado = false; }
    }
}
