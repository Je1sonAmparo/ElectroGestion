@page "/ventas"
@inject AppStateService AppState
@inject VentaService VentaService
@inject InventarioService InventarioService
@inject ClienteService ClienteService
@inject ToastService ToastService
@inject IJSRuntime JS

<PageTitle>Ventas | ElectroGestión</PageTitle>

@if (!AppState.EsGerente)
{
    <p>Esta página está disponible para el gerente.</p>
}
else
{
    <header class="ventas-header">
        <div><h1 class="page-title">Ventas</h1><p>Venta directa de equipos y materiales a clientes.</p></div>
        <button class="ventas-primary" @onclick="() => Abrir(null)">+ Nueva venta</button>
    </header>

    <div class="ventas-panel">
        <div class="ventas-filtros">
            <label>Buscar <input @bind="Busqueda" placeholder="Cliente, producto o NCF" /></label>
            <label>Comprobante <select @bind="Tipo"><option value="">Todos</option><option>@Venta.Consumo</option><option>@Venta.CreditoFiscal</option></select></label>
            <label>Estado <select @bind="Estado"><option value="">Todos</option><option>@Venta.Borrador</option><option>@Venta.Registrada</option><option>@Venta.Anulada</option></select></label>
            <button class="ventas-primary" @onclick="AplicarFiltros">Buscar</button>
        </div>
        <div class="ventas-tabla">
            <table>
                <thead><tr><th>ID</th><th>Fecha</th><th>Cliente</th><th>Producto</th><th>Comprobante</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead>
                <tbody>
                    @foreach (var venta in Filtradas)
                    {
                        <tr @key="venta.Id">
                            <td>@venta.Id</td><td>@((venta.FechaVenta ?? venta.FechaCreacion).ToString("dd/MM/yyyy"))</td>
                            <td>@Comprador(venta)</td><td>@(venta.Detalles.Count == 1 ? venta.Detalles[0].NombreArticulo : $"{venta.Detalles.Count} productos")</td>
                            <td>@venta.TipoComprobante <small>@venta.Ncf</small></td>
                            <td>@Moneda(venta.Total)</td><td><span class="ventas-estado" data-estado="@venta.Estado">@venta.Estado</span></td>
                            <td><div class="ventas-acciones">
                                <button class="table-action-icon ventas-icono" title="Ver detalle" aria-label="Ver detalle" @onclick="() => Detalle = venta"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                                @if (venta.Estado == Venta.Borrador)
                                {
                                    <button class="table-action-icon ventas-icono" title="Editar" aria-label="Editar" @onclick="() => Abrir(venta)"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg></button>
                                    <button class="table-action-icon ventas-icono" title="Eliminar borrador" aria-label="Eliminar borrador" @onclick="() => Confirmacion = venta"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg></button>
                                }
                                else if (venta.Estado == Venta.Registrada)
                                {
                                    <button class="table-action-icon ventas-icono" title="Anular venta" aria-label="Anular venta" @onclick="() => Confirmacion = venta"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6 18.4 18.4"/></svg></button>
                                }
                            </div></td>
                        </tr>
                    }
                    @if (!Filtradas.Any())
                    {
                        <tr><td colspan="8">No se encontraron ventas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Formulario is { } form)
    {
        <div class="ventas-overlay" @onclick="CerrarFormulario">
            <section class="ventas-modal" role="dialog" aria-modal="true" aria-labelledby="titulo-venta" @onclick:stopPropagation>
                <h2 id="titulo-venta">@(form.Id == 0 ? "Nueva venta" : "Editar borrador")</h2>
                <div class="ventas-formulario">
                    <label class="ventas-producto">Producto
                        <select @bind="ArticuloSeleccionadoId">
                            <option value="0">Seleccione un producto</option>
                            @foreach (var articulo in Articulos)
                            {
                                <option value="@articulo.Id">@articulo.Codigo · @articulo.Nombre</option>
                            }
                        </select>
                    </label>
                    <label>Cantidad <input type="number" min="1" step="1" @bind="CantidadNueva" />
                        @if (ArticuloSeleccionado is { } productoDisponible)
                        {
                            <small class="ventas-disponibilidad">Hay @productoDisponible.Cantidad unidades en stock.</small>
                        }
                    </label>
                    <div class="ventas-agregar"><button type="button" class="ventas-primary" @onclick="AgregarProducto">Agregar producto</button></div>
                    <label>Tipo de comprobante <select @bind="form.TipoComprobante" @bind:after="CambiarTipoComprobante"><option value="@Venta.Consumo">Factura de consumo (B02 / E32)</option><option value="@Venta.CreditoFiscal">Comprobante de Crédito Fiscal (B01 / E31)</option></select></label>
                    @if (form.TipoComprobante == Venta.CreditoFiscal)
                    {
                        <label>Cliente del catálogo (opcional)
                            <select @bind="form.ClienteId" @bind:after="SeleccionarCliente">
                                <option value="">Ingresar datos manualmente</option>
                                @foreach (var cliente in Clientes) { <option value="@cliente.Id">@cliente.Nombre</option> }
                            </select>
                        </label>
                        <label>Nombre o razón social <input maxlength="200" @bind="form.NombreCliente" /></label>
                        <label>RNC o cédula <input maxlength="30" @bind="form.DocumentoCliente" /></label>
                    }
                    else if (form.Detalles.Sum(d => d.Subtotal) * 1.18m >= 250_000m)
                    {
                        <label>RNC o cédula del comprador (requerido desde RD$ 250,000) <input maxlength="30" @bind="form.DocumentoCliente" /></label>
                    }
                </div>
                @if (form.Detalles.Count > 0)
                {
                    var subtotal = form.Detalles.Sum(d => d.Subtotal);
                    var impuesto = CotizacionService.CalcularImpuesto(subtotal, 18m);
                    <div class="ventas-tabla ventas-lineas"><table><thead><tr><th>Código</th><th>Producto</th><th>Cantidad / stock</th><th>Precio unitario</th><th>Subtotal</th><th>Acción</th></tr></thead><tbody>
                        @foreach (var linea in form.Detalles) { <tr><td>@linea.CodigoArticulo</td><td>@linea.NombreArticulo</td><td><input class="ventas-cantidad-linea" type="number" min="1" max="@(Articulos.FirstOrDefault(a => a.Id == linea.ArticuloInventarioId)?.Cantidad ?? 0)" step="1" @bind="linea.Cantidad" @bind:event="oninput" /><small class="ventas-disponibilidad">Stock: @(Articulos.FirstOrDefault(a => a.Id == linea.ArticuloInventarioId)?.Cantidad ?? 0)</small></td><td>@Moneda(linea.PrecioUnitario)</td><td>@Moneda(linea.Subtotal)</td><td><button type="button" class="ventas-quitar" @onclick="() => QuitarProducto(linea.ArticuloInventarioId)">Quitar</button></td></tr> }
                    </tbody></table></div>
                    <div class="ventas-resumen"><div class="ventas-resumen-filas"><span>Subtotal</span><strong>@Moneda(subtotal)</strong><span>ITBIS (18%)</span><strong>@Moneda(impuesto)</strong><span class="ventas-total-label">Total</span><strong class="ventas-total">@Moneda(subtotal + impuesto)</strong></div></div>
                }
                <div class="ventas-pie">
                    <button disabled="@Ocupado" @onclick="CerrarFormulario">Cancelar</button>
                    <button disabled="@Ocupado" @onclick="() => Guardar(false)">Guardar borrador</button>
                    <button class="ventas-primary" disabled="@Ocupado" @onclick="() => Guardar(true)">Registrar venta</button>
                </div>
            </section>
        </div>
    }

    @if (Detalle is { } detalle)
    {
        <style>
            @@media print {
                @@page { size:A4; margin:0; }
                html, body { margin:0 !important; padding:0 !important; }
                body * { visibility:hidden !important; }
                .venta-documento, .venta-documento * { visibility:visible !important; }
                .ventas-overlay { position:absolute !important; top:0 !important; left:0 !important; right:auto !important; bottom:auto !important; display:block !important; box-sizing:border-box !important; width:210mm !important; padding:0 !important; margin:0 !important; background:white !important; }
                .venta-documento { position:relative !important; box-sizing:border-box !important; width:210mm !important; max-width:none !important; min-height:297mm !important; max-height:none !important; overflow:visible !important; border:0 !important; border-radius:0 !important; box-shadow:none !important; padding:14mm !important; }
                .venta-documento .ventas-pie { display:none; }
                .venta-documento .ventas-tabla { overflow:visible; }
                .venta-documento table { width:100%; table-layout:fixed; font-size:12px; }
                .venta-documento th, .venta-documento td { white-space:normal; }
                .venta-documento th:nth-child(3), .venta-documento td:nth-child(3), .venta-documento th:nth-child(5), .venta-documento td:nth-child(5) { text-align:right; }
                .venta-documento th:nth-child(4), .venta-documento td:nth-child(4) { text-align:center; }
                .venta-documento thead { display:table-header-group; }
            }
        </style>
        <div class="ventas-overlay" @onclick="() => Detalle = null">
            <section class="ventas-modal venta-documento" role="dialog" aria-modal="true" aria-labelledby="detalle-venta" @onclick:stopPropagation>
                <div class="factura-encabezado"><img src="/images/electrogestion-logo.png" alt="ElectroGestión" /><div><h2 id="detalle-venta">@(detalle.TipoComprobante == Venta.CreditoFiscal ? "Factura de Crédito Fiscal" : "Factura de consumo")</h2><p>N.º @detalle.Id</p><p>Fecha: @((detalle.FechaVenta ?? detalle.FechaCreacion).ToString("dd/MM/yyyy HH:mm"))</p><p>NCF: @(detalle.Ncf ?? "Pendiente de asignar")</p></div></div>
                <div class="factura-cliente"><strong>Cliente</strong><span>@Comprador(detalle)</span>@if (!string.IsNullOrWhiteSpace(detalle.DocumentoCliente)){<span>RNC/Cédula: @detalle.DocumentoCliente</span>}</div>
                <div class="ventas-tabla">
                    <table><colgroup><col style="width:15%" /><col style="width:33%" /><col style="width:20%" /><col style="width:12%" /><col style="width:20%" /></colgroup><thead><tr><th>Código</th><th>Descripción</th><th>Precio unitario</th><th>Cantidad</th><th>Importe</th></tr></thead>
                        <tbody>@foreach (var linea in detalle.Detalles) { <tr><td>@linea.CodigoArticulo</td><td>@linea.NombreArticulo</td><td>@Moneda(linea.PrecioUnitario)</td><td>@linea.Cantidad</td><td>@Moneda(linea.Subtotal)</td></tr> }</tbody>
                    </table>
                </div>
                <div class="factura-totales"><div><span>Subtotal</span><strong>@Moneda(detalle.Subtotal)</strong><span>ITBIS (@detalle.TasaItbis.ToString("0.##") %)</span><strong>@Moneda(detalle.Itbis)</strong><span class="factura-total-label">Total</span><strong class="factura-total">@Moneda(detalle.Total)</strong></div></div>
                <div class="ventas-pie">
                    <button @onclick="() => Detalle = null">Cerrar</button>
                    <button class="ventas-primary" @onclick="Imprimir">Imprimir / Guardar como PDF</button>
                </div>
            </section>
        </div>
    }

    @if (Confirmacion is { } confirmar)
    {
        <div class="ventas-overlay">
            <section class="ventas-modal" role="dialog" aria-modal="true" aria-labelledby="confirmar-venta">
                <h2 id="confirmar-venta">@(confirmar.Estado == Venta.Borrador ? "Eliminar borrador" : "Anular venta")</h2>
                <p>@(confirmar.Estado == Venta.Borrador ? "Se eliminará el borrador seleccionado." : "Confirme que el comprobante ya fue corregido en su sistema de facturación y que las unidades regresaron al inventario.")</p>
                <div class="ventas-pie">
                    <button disabled="@Ocupado" @onclick="() => Confirmacion = null">Cancelar</button>
                    <button class="ventas-danger" disabled="@Ocupado" @onclick="ConfirmarAccion">Confirmar</button>
                </div>
            </section>
        </div>
    }
}

@code {
    private List<Venta> Lista = [];
    private List<ArticuloInventario> Articulos = [];
    private List<Cliente> Clientes = [];
    private Venta? Formulario, Detalle, Confirmacion;
    private bool Ocupado;
    private string Busqueda = "", Tipo = "", Estado = "";
    private (string Texto, string Tipo, string Estado) Filtros = ("", "", "");

    private IEnumerable<Venta> Filtradas => Lista.Where(v =>
        (Filtros.Tipo.Length == 0 || v.TipoComprobante == Filtros.Tipo) &&
        (Filtros.Estado.Length == 0 || v.Estado == Filtros.Estado) &&
        (Comprador(v).Contains(Filtros.Texto, StringComparison.OrdinalIgnoreCase) ||
            v.Detalles.Any(d => d.NombreArticulo.Contains(Filtros.Texto, StringComparison.OrdinalIgnoreCase)) ||
            (v.Ncf ?? "").Contains(Filtros.Texto, StringComparison.OrdinalIgnoreCase)));

    private int ArticuloSeleccionadoId;
    private int CantidadNueva = 1;
    private ArticuloInventario? ArticuloSeleccionado => Articulos.FirstOrDefault(a => a.Id == ArticuloSeleccionadoId);
    private static string Comprador(Venta v) => string.IsNullOrWhiteSpace(v.NombreCliente) ? "Consumidor final" : v.NombreCliente;
    private static string Moneda(decimal importe) => $"RD$ {importe:N2}";
    private void AplicarFiltros() => Filtros = (Busqueda.Trim(), Tipo, Estado);
    private void CerrarFormulario() { if (!Ocupado) Formulario = null; }
    private async Task Imprimir() => await JS.InvokeVoidAsync("window.print");

    protected override async Task OnInitializedAsync()
    {
        if (AppState.EsGerente) await Recargar();
    }

    private async Task Recargar()
    {
        try { Lista = await VentaService.ListarAsync(); }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudieron cargar las ventas.")); }
    }

    private async Task Abrir(Venta? venta)
    {
        try
        {
            Articulos = await InventarioService.ObtenerTodosAsync();
            Clientes = (await ClienteService.GetList(c => true)).OrderBy(c => c.Nombre).ToList();
            Formulario = venta is null ? new Venta() : new Venta
            {
                Id = venta.Id, ClienteId = venta.ClienteId,
                NombreCliente = venta.NombreCliente, DocumentoCliente = venta.DocumentoCliente,
                TipoComprobante = venta.TipoComprobante, TasaItbis = venta.TasaItbis,
                Detalles = venta.Detalles.Select(d => new DetalleVenta { ArticuloInventarioId = d.ArticuloInventarioId, CodigoArticulo = d.CodigoArticulo, NombreArticulo = d.NombreArticulo, Cantidad = d.Cantidad, PrecioUnitario = d.PrecioUnitario }).ToList()
            };
            ArticuloSeleccionadoId = 0;
            CantidadNueva = 1;
        }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudieron cargar los productos o clientes.")); }
    }

    private void AgregarProducto()
    {
        if (Formulario is not { } form || ArticuloSeleccionado is not { } articulo || CantidadNueva <= 0) return;
        var actual = form.Detalles.FirstOrDefault(d => d.ArticuloInventarioId == articulo.Id);
        var total = (actual?.Cantidad ?? 0) + CantidadNueva;
        if (total > articulo.Cantidad) { ToastService.Notify(new ToastMessage(ToastType.Warning, $"Stock disponible: {articulo.Cantidad} unidades.")); return; }
        if (actual is null) form.Detalles.Add(new DetalleVenta { ArticuloInventarioId = articulo.Id, CodigoArticulo = articulo.Codigo, NombreArticulo = articulo.Nombre, PrecioUnitario = articulo.PrecioUnidad, Cantidad = CantidadNueva });
        else actual.Cantidad = total;
        ArticuloSeleccionadoId = 0;
        CantidadNueva = 1;
    }

    private void QuitarProducto(int articuloId) => Formulario?.Detalles.RemoveAll(d => d.ArticuloInventarioId == articuloId);

    private void SeleccionarCliente()
    {
        if (Formulario is not { } form) return;
        var cliente = Clientes.FirstOrDefault(c => c.Id == form.ClienteId);
        form.NombreCliente = cliente?.Nombre ?? "";
        form.DocumentoCliente = cliente?.Rnc ?? "";
    }

    private void CambiarTipoComprobante()
    {
        if (Formulario is not { } form) return;
        form.ClienteId = null;
        if (form.TipoComprobante == Venta.Consumo)
        {
            form.NombreCliente = "";
            form.DocumentoCliente = "";
        }
    }

    private async Task Guardar(bool registrar)
    {
        if (Ocupado || Formulario is not { } form) return;
        Ocupado = true;
        try
        {
            var error = await VentaService.GuardarAsync(form, registrar);
            if (error is not null)
            {
                ToastService.Notify(new ToastMessage(ToastType.Warning, error));
                return;
            }
            Formulario = null;
            await Recargar();
            ToastService.Notify(new ToastMessage(ToastType.Success, registrar ? "Venta registrada." : "Borrador guardado."));
        }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudo guardar la venta.")); }
        finally { Ocupado = false; }
    }

    private async Task ConfirmarAccion()
    {
        if (Ocupado || Confirmacion is not { } venta) return;
        Ocupado = true;
        try
        {
            var hecho = venta.Estado == Venta.Borrador
                ? await VentaService.EliminarBorradorAsync(venta.Id)
                : await VentaService.AnularAsync(venta.Id);
            Confirmacion = null;
            await Recargar();
            ToastService.Notify(hecho
                ? new ToastMessage(ToastType.Success, "Operación realizada.")
                : new ToastMessage(ToastType.Warning, "No se pudo completar la operación."));
        }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudo completar la operación.")); }
        finally { Ocupado = false; }
    }
}
