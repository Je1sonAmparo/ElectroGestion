@page "/inventario"
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.InventarioService InventarioService
@inject BlazorBootstrap.ToastService ToastService

<PageTitle>Inventario | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Inventario</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Control de artículos y stock.</div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end">
        <button @onclick="AlternarModoSeleccion" title="Seleccionar varios artículos para eliminar"
            style="padding:10px 16px 10px 14px;background:#fff;border:1px solid @(ModoSeleccion ? "#B42318" : "#D5D8E6");color:@(ModoSeleccion ? "#B42318" : "#4A4E63");border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';white-space:nowrap;display:flex;align-items:center;gap:8px;transition:all .15s">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8.5 12.5 2.5 2.5 5-5.5"/></svg>
            <span>@(ModoSeleccion ? "Salir de selección" : "Seleccionar")</span>
        </button>
        <button class="primary-btn" @onclick="() => AbrirModal()"
            style="padding:11px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:9px;font-weight:700;font-size:14.5px;cursor:pointer;font-family:'Manrope';display:flex;align-items:center;gap:8px;box-shadow:0 4px 12px rgba(29,78,216,0.25)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Nuevo Artículo
        </button>
    </div>
</div>

@if (ModoSeleccion)
{
    <div style="padding:10px 18px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;background:#EFF6FF;border:1px solid #B6C8F5;border-radius:10px;margin-bottom:18px">
        <div style="display:flex;align-items:center;gap:9px;font-size:13.5px;color:#1D4ED8;font-weight:700;flex-wrap:wrap">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8.5 12.5 2.5 2.5 5-5.5"/></svg>
            <span>@(Seleccionadas.Count == 1 ? "1 artículo seleccionado" : $"{Seleccionadas.Count} artículos seleccionados")</span>
            <span style="color:#6B7085;font-weight:500">· Haz clic en una fila para marcarla o desmarcarla</span>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
            <button @onclick="AlternarTodas" style="padding:8px 14px;border:1px solid #B6C8F5;background:#fff;color:#1D4ED8;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer;font-family:'Manrope'">
                @(TodasMarcadas ? "Desmarcar todas" : "Marcar todas")
            </button>
            <button disabled="@(Seleccionadas.Count == 0)" @onclick="ConfirmarSeleccionadas" style="padding:8px 16px;border:0;background:@(Seleccionadas.Count == 0 ? "#F1A4A7" : "#C0392B");color:#fff;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer;font-family:'Manrope';display:flex;align-items:center;gap:7px">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                <span>Eliminar @(Seleccionadas.Count == 1 ? "(1)" : $"({Seleccionadas.Count})")</span>
            </button>
        </div>
    </div>
}

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;overflow:hidden">
    <div style="display:flex;flex-direction:column;gap:18px;padding:18px 18px 12px;border-bottom:1px solid #EFF0F6">
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" @bind:event="oninput" placeholder="ID" style="width:90px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Código:</span>
                <input @bind="SearchCodigo" @bind:event="oninput" placeholder="Ej: ART-001"
                    style="width:140px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Nombre:</span>
                <input @bind="SearchNombre" @bind:event="oninput" placeholder="Nombre del artículo"
                    style="width:200px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Categoría:</span>
                <input @bind="SearchCategoria" @bind:event="oninput" placeholder="Categoría"
                    style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Estado:</span>
                <select @bind="SearchEstado" style="padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff"><option value="">Todos</option><option>Con stock</option><option>Sin stock</option></select>
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Precio desde:</span>
                <input @bind="SearchPrecioDesde" type="number" min="0" step="0.01" style="width:110px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Hasta:</span>
                <input @bind="SearchPrecioHasta" type="number" min="0" step="0.01" style="width:110px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px" />
            </div>
            <div style="display:flex;justify-content:flex-end;margin-left:auto">
                <button class="primary-btn" @onclick="Filtrar"
                    style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Buscar</button>
            </div>
        </div>
    </div>

    <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:14px">
            <thead style="background:#F8F9FC;border-bottom:1px solid #E3E5EE">
                <tr>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            @if (ModoSeleccion)
                            {
                                <input type="checkbox" aria-label="Seleccionar todos los artículos visibles que se pueden eliminar" checked="@TodasMarcadas" @onchange="e => SeleccionarTodas((bool)(e.Value ?? false))" @onclick:stopPropagation />
                            }
                            <span>ID</span>
                        </div>
                    </th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Código</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Nombre</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Categoría</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Cantidad</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Estado</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Precio Unitario</th>
                    <th style="padding:14px 18px;text-align:center;color:#4A4E63;font-weight:700">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredInventario.Any())
                {
                    <tr>
                        <td colspan="8" style="padding:24px;text-align:center;color:#6B7085">No se encontraron artículos.</td>
                    </tr>
                }
                else
                {
                    @foreach (var art in FilteredInventario)
                    {
                        <tr @onclick="@(() => FilaClicked(art.Id))" style="border-bottom:1px solid #EFF0F6;transition:background 0.15s;background:@(ModoSeleccion && Seleccionadas.Contains(art.Id) ? "#EFF6FF" : "#fff");cursor:@(ModoSeleccion ? "pointer" : "default")">
                            <td style="padding:14px 18px;color:#14162B;font-weight:600">
                                @if (ModoSeleccion)
                                {
                                    <input type="checkbox" aria-label="Seleccionar artículo @art.Id" checked="@Seleccionadas.Contains(art.Id)" disabled="@(!PuedeEliminarArticulo(art.Id))" @onchange="e => CambiarSeleccion(art.Id, (bool)(e.Value ?? false))" @onclick:stopPropagation style="margin-right:8px" />
                                }
                                @art.Id
                            </td>
                            <td style="padding:14px 18px;color:#4A4E63">@art.Codigo</td>
                            <td style="padding:14px 18px;color:#4A4E63">@art.Nombre</td>
                            <td style="padding:14px 18px;color:#4A4E63">@art.Categoria</td>
                            <td style="padding:14px 18px;color:#4A4E63;font-weight:700">
                                @if (art.Cantidad < 20)
                                {
                                    <span style="color:#C4141B">@art.Cantidad</span>
                                }
                                else
                                {
                                    <span style="color:#065F46">@art.Cantidad</span>
                                }
                            </td>
                            <td style="padding:14px 18px"><span style="padding:4px 10px;border-radius:20px;font-size:12px;font-weight:700;background:@(art.Cantidad > 0 ? "#D1FAE5" : "#FEE2E2");color:@(art.Cantidad > 0 ? "#065F46" : "#991B1B")">@art.Estado</span></td>
                            <td style="padding:14px 18px;color:#4A4E63;font-weight:700">RD$ @art.PrecioUnidad.ToString("N2")</td>
                            <td style="padding:14px 18px;text-align:center">
                                <div style="display:flex;gap:8px;justify-content:center">
                                    <button @onclick="() => VerDetalle(art.Id)" @onclick:stopPropagation title="Ver detalle" aria-label="Ver detalle" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    <button @onclick="() => AbrirModal(art.Id)" @onclick:stopPropagation title="Editar" aria-label="Editar" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg>
                                    </button>
                                    <button @onclick="() => AbrirStock(art.Id)" @onclick:stopPropagation title="Agregar stock" aria-label="Agregar stock" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (IsModalOpen)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(20,22,43,0.4);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px" @onclick="CerrarModal">
        <div style="background:#fff;width:100%;max-width:550px;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,0.1);display:flex;flex-direction:column;max-height:90vh" @onclick:stopPropagation>
            <div style="padding:24px;border-bottom:1px solid #E3E5EE;display:flex;align-items:center;justify-content:space-between">
                <h3 style="margin:0;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">@ModalTitle</h3>
                <button @onclick="CerrarModal" style="background:none;border:0;color:#6B7085;cursor:pointer;padding:4px">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            
            <div style="padding:24px;overflow-y:auto;display:flex;flex-direction:column;gap:16px">
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Código</label>
                    <input @bind="FormCodigo" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="Ej: ART-001" />
                </div>
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Código de barras (opcional)</label>
                    <input @bind="FormCodigoBarra" maxlength="80" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="Escanee o escriba el código" />
                </div>
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Nombre</label>
                    <input @bind="FormNombre" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="Nombre del artículo" />
                </div>
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Categoría</label>
                    <input @bind="FormCategoria" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="Categoría" />
                </div>
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Cantidad en Stock</label>
                    <input @bind="FormCantidad" type="number" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="0" />
                </div>
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Precio Unitario</label>
                    <input @bind="FormPrecio" type="number" step="0.01" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="0.00" />
                </div>
            </div>

            <div style="padding:20px 24px;border-top:1px solid #E3E5EE;display:flex;justify-content:flex-end;gap:12px;background:#F8F9FC;border-radius:0 0 16px 16px">
                @if (EditId.HasValue)
                {
                    <button @onclick="() => ConfirmarEliminar(EditId.Value)" style="padding:10px 18px;border:0;background:#DC2626;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';display:flex;align-items:center;gap:6px">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                        <span>Eliminar</span>
                    </button>
                }
                <button @onclick="CerrarModal" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;color:#4A4E63;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Cancelar</button>
                <button @onclick="GuardarArticulo" style="padding:10px 22px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Guardar</button>
            </div>
        </div>
    </div>
}

@if (SelectedArticulo != null)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px" @onclick="CerrarDetalle">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:620px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,.2);animation:tin .2s ease-out">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
                <div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B">Detalle de Artículo</div>
                    <div style="font-size:14px;color:#6B7085;margin-top:3px">Artículo @SelectedArticulo.Id.ToString("D4")</div>
                </div>
                <button @onclick="CerrarDetalle" aria-label="Cerrar" style="width:32px;height:32px;border:1px solid #E3E5EE;border-radius:8px;background:#fff;display:flex;align-items:center;justify-content:center;color:#8B90A3;cursor:pointer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px" class="resp-grid-2">
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Código</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedArticulo.Codigo</div></div>
                @if (!string.IsNullOrWhiteSpace(SelectedArticulo.CodigoBarra))
                {
                    <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Código de barras</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedArticulo.CodigoBarra</div></div>
                }
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Nombre</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedArticulo.Nombre</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Categoría</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedArticulo.Categoria</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Stock Actual</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedArticulo.Cantidad unid.</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Estado</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedArticulo.Estado</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Precio Unitario</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">RD$ @SelectedArticulo.PrecioUnidad.ToString("N2")</div></div>
            </div>
            <div style="margin-top:24px;display:flex;justify-content:flex-end;border-top:1px solid #EFF0F6;padding-top:17px">
                <button @onclick="CerrarDetalle" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (StockArticuloId.HasValue)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:10000;padding:20px" @onclick="CerrarStock">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:420px;padding:26px" @onclick:stopPropagation>
            <h3 style="margin:0 0 8px">Agregar stock</h3>
            <p style="color:#6B7085">@StockArticulo?.Nombre · Existencia actual: @StockArticulo?.Cantidad</p>
            <label for="cantidad-stock" style="font-weight:700">Unidades a agregar</label>
            <input id="cantidad-stock" @bind="CantidadAgregar" type="number" min="1" step="1" style="display:block;width:100%;padding:10px;margin:7px 0 18px;border:1px solid #D5D8E6;border-radius:8px" />
            <div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="CerrarStock" style="padding:9px 14px;background:#fff;border:1px solid #D5D8E6;border-radius:8px">Cancelar</button><button @onclick="GuardarStock" style="padding:9px 14px;background:#1D4ED8;color:#fff;border:0;border-radius:8px;font-weight:700">Agregar</button></div>
        </div>
    </div>
}

@if (IsDeleteModalOpen)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,0.5);display:flex;align-items:center;justify-content:center;z-index:10001;padding:20px">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:430px;padding:30px;box-shadow:0 20px 40px rgba(0,0,0,0.2);animation:tin 0.2s ease-out">
            <div style="font-family:'Manrope';font-weight:800;font-size:23px;color:#14162B;margin-bottom:12px">Eliminar @(DeleteIds.Count == 1 ? "artículo" : "artículos")</div>
            <div style="color:#4A4E63;font-size:14.5px;line-height:1.55">¿Está seguro que desea eliminar @(DeleteIds.Count == 1 ? "este artículo" : $"estos {DeleteIds.Count} artículos")? El administrador podrá recuperarlos desde el módulo de Recuperación.</div>
            @if (DeleteIds.Count > 1)
            {
                <div style="background:#F9FAFB;border:1px solid #EFF0F6;border-radius:10px;max-height:200px;overflow:auto;margin-top:16px" class="resp-lista-eliminar">
                    @foreach (var art in ArticulosAEliminar)
                    {
                        <div style="display:flex;align-items:center;gap:12px;padding:9px 14px;border-bottom:1px solid #EFF0F6">
                            <span style="font-family:ui-monospace,'SFMono-Regular',Consolas,monospace;font-size:12.5px;font-weight:700;letter-spacing:.05em;color:#C0392B;background:#FDECEC;border-radius:6px;padding:2px 8px;flex-shrink:0">@art.Id</span>
                            <div style="min-width:0">
                                <div style="font-size:13.5px;font-weight:700;color:#14162B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@art.Nombre</div>
                                <div style="font-size:12px;color:#6B7085;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@art.Codigo · @art.Cantidad en stock</div>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (Seleccionadas.Count > DeleteIds.Count)
            {
                <div style="background:#FFF7E6;border:1px solid #F5E2B8;border-radius:8px;padding:9px 12px;font-size:12.5px;color:#8A6100;margin-top:12px">
                    Nota: se omitieron @(Seleccionadas.Count - DeleteIds.Count) artículo(s) protegidos (referenciados por ventas o cotizaciones); no se pueden eliminar.
                </div>
            }
            <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:28px">
                <button @onclick="CerrarEliminar" style="padding:11px 24px;border:1px solid #E3E5EE;background:#fff;border-radius:10px;font-weight:600;font-size:15px;cursor:pointer;color:#14162B;font-family:'Manrope'">
                    Cancelar
                </button>
                <button @onclick="EjecutarEliminar" style="padding:11px 26px;border:0;background:#C0392B;color:#fff;border-radius:10px;font-weight:700;font-size:15px;cursor:pointer;font-family:'Manrope'">
                    Eliminar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchCodigo = "";
    private string SearchNombre = "";
    private string SearchCategoria = "";
    private string SearchId = "";
    private string SearchEstado = "";
    private decimal? SearchPrecioDesde;
    private decimal? SearchPrecioHasta;
    private (string Id, string Codigo, string Nombre, string Categoria, string Estado, decimal? PrecioDesde, decimal? PrecioHasta) FiltrosAplicados = ("", "", "", "", "", null, null);

    protected override async Task OnInitializedAsync() => await CargarInventario();

    private async Task CargarInventario()
    {
        AppState.Inventario = await InventarioService.ObtenerTodosAsync();
        ElegiblesArticulos = await InventarioService.ObtenerElegiblesAsync(AppState.Inventario.Select(a => a.Id));
        AppState.NotifyStateChanged();
    }

    // Modo selección + eliminación múltiple
    private bool ModoSeleccion;
    private HashSet<int> Seleccionadas = [];
    private HashSet<int> DeleteIds = [];
    private bool IsDeleteModalOpen;
    private HashSet<int> ElegiblesArticulos = [];
    private List<int> ElegiblesVisibles => FilteredInventario.Where(a => PuedeEliminarArticulo(a.Id)).Select(a => a.Id).ToList();
    private bool TodasMarcadas => ElegiblesVisibles.Count > 0 && ElegiblesVisibles.All(id => Seleccionadas.Contains(id));
    private List<ElectroGestion.Models.ArticuloInventario> ArticulosAEliminar => DeleteIds
        .Select(id => AppState.Inventario.FirstOrDefault(a => a.Id == id))
        .Where(a => a != null)
        .Cast<ElectroGestion.Models.ArticuloInventario>()
        .ToList();

    private bool PuedeEliminarArticulo(int id) => ElegiblesArticulos.Contains(id);

    private void AlternarModoSeleccion()
    {
        ModoSeleccion = !ModoSeleccion;
        if (!ModoSeleccion) Seleccionadas.Clear();
    }

    private void FilaClicked(int id)
    {
        if (!ModoSeleccion) return;
        if (!PuedeEliminarArticulo(id))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Este artículo está protegido: está referenciado por ventas o cotizaciones, por lo que no se puede eliminar."));
            return;
        }
        CambiarSeleccion(id, !Seleccionadas.Contains(id));
    }

    private void CambiarSeleccion(int id, bool marcado) { if (marcado && PuedeEliminarArticulo(id)) Seleccionadas.Add(id); else Seleccionadas.Remove(id); }
    private void SeleccionarTodas(bool marcado) { foreach (var id in ElegiblesVisibles) { if (marcado) Seleccionadas.Add(id); else Seleccionadas.Remove(id); } }
    private void AlternarTodas() => SeleccionarTodas(!TodasMarcadas);
    private void ConfirmarSeleccionadas() { DeleteIds = Seleccionadas.Where(PuedeEliminarArticulo).ToHashSet(); IsDeleteModalOpen = DeleteIds.Count > 0; }

    private void ConfirmarEliminar(int id)
    {
        if (!PuedeEliminarArticulo(id))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "No se puede eliminar un artículo referenciado por ventas o cotizaciones."));
            return;
        }
        CerrarModal();
        DeleteIds = [id];
        IsDeleteModalOpen = true;
    }

    private void CerrarEliminar()
    {
        IsDeleteModalOpen = false;
        DeleteIds.Clear();
    }

    private async Task EjecutarEliminar()
    {
        if (DeleteIds.Count > 0)
        {
            var (eliminados, omitidos) = await InventarioService.EliminarVariosAsync(DeleteIds);
            await CargarInventario();
            if (eliminados > 0)
            {
                ToastService.Notify(new ToastMessage(ToastType.Success, eliminados == 1 ? "Artículo eliminado correctamente." : $"{eliminados} artículos eliminados correctamente."));
                Seleccionadas.Clear();
                ModoSeleccion = false;
                if (omitidos > 0)
                    ToastService.Notify(new ToastMessage(ToastType.Warning, $"Se omitieron {omitidos} artículo(s) referenciados por ventas o cotizaciones; no se pueden eliminar."));
            }
            else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo eliminar los artículos seleccionados. Los artículos referenciados por ventas o cotizaciones están protegidos."));
        }
        IsDeleteModalOpen = false;
        DeleteIds.Clear();
    }

    private void Filtrar()
    {
        FiltrosAplicados = (SearchId.Trim(), SearchCodigo.Trim(), SearchNombre.Trim(), SearchCategoria.Trim(), SearchEstado, SearchPrecioDesde, SearchPrecioHasta);
    }

    private bool IsModalOpen = false;
    private string ModalTitle = "";
    private int? EditId = null;
    private ElectroGestion.Models.ArticuloInventario? SelectedArticulo;
    private int? StockArticuloId;
    private int CantidadAgregar = 1;
    private ElectroGestion.Models.ArticuloInventario? StockArticulo => AppState.Inventario.FirstOrDefault(a => a.Id == StockArticuloId);

    private string FormCodigo = "";
    private string FormCodigoBarra = "";
    private string FormNombre = "";
    private string FormCategoria = "";
    private int FormCantidad = 0;
    private int? CantidadOriginal;
    private decimal FormPrecio = 0;

    private List<ElectroGestion.Models.ArticuloInventario> FilteredInventario => AppState.Inventario
        .Where(a => (FiltrosAplicados.Id.Length == 0 || a.Id.ToString().Contains(FiltrosAplicados.Id)) &&
            a.Codigo.Contains(FiltrosAplicados.Codigo, StringComparison.OrdinalIgnoreCase) &&
            a.Nombre.Contains(FiltrosAplicados.Nombre, StringComparison.OrdinalIgnoreCase) &&
            a.Categoria.Contains(FiltrosAplicados.Categoria, StringComparison.OrdinalIgnoreCase) &&
            (FiltrosAplicados.Estado.Length == 0 || a.Estado == FiltrosAplicados.Estado) &&
            (!FiltrosAplicados.PrecioDesde.HasValue || a.PrecioUnidad >= FiltrosAplicados.PrecioDesde.Value) &&
            (!FiltrosAplicados.PrecioHasta.HasValue || a.PrecioUnidad <= FiltrosAplicados.PrecioHasta.Value))
        .OrderByDescending(a => a.Id)
        .ToList();

    private void AbrirModal(int? id = null)
    {
        EditId = id;
        if (id.HasValue)
        {
            ModalTitle = "Editar Artículo";
            var item = AppState.Inventario.First(x => x.Id == id.Value);
            FormCodigo = item.Codigo;
            FormCodigoBarra = item.CodigoBarra ?? "";
            FormNombre = item.Nombre;
            FormCategoria = item.Categoria;
            FormCantidad = item.Cantidad;
            CantidadOriginal = item.Cantidad;
            FormPrecio = item.PrecioUnidad;
        }
        else
        {
            ModalTitle = "Nuevo Artículo";
            FormCodigo = "";
            FormCodigoBarra = "";
            FormNombre = "";
            FormCategoria = "";
            FormCantidad = 0;
            CantidadOriginal = null;
            FormPrecio = 0;
        }
        IsModalOpen = true;
    }

    private void CerrarModal()
    {
        IsModalOpen = false;
    }

    private async Task GuardarArticulo()
    {
        if (string.IsNullOrWhiteSpace(FormCodigo) || string.IsNullOrWhiteSpace(FormNombre) || FormPrecio < 0 || FormCantidad < 0)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Complete todos los campos correctamente."));
            return;
        }

        var articulo = new ElectroGestion.Models.ArticuloInventario
        {
            Id = EditId ?? 0,
            Codigo = FormCodigo,
            CodigoBarra = FormCodigoBarra,
            Nombre = FormNombre,
            Categoria = FormCategoria,
            Cantidad = FormCantidad,
            PrecioUnidad = FormPrecio
        };
        if (!await InventarioService.GuardarAsync(articulo, CantidadOriginal))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo guardar. Verifique los datos, el código y el stock actual."));
            await CargarInventario();
            return;
        }
        await CargarInventario();
        ToastService.Notify(new ToastMessage(ToastType.Success, EditId.HasValue ? "Artículo actualizado con éxito." : "Artículo creado con éxito."));
        CerrarModal();
    }

    private void AbrirStock(int id) { StockArticuloId = id; CantidadAgregar = 1; }
    private void CerrarStock() => StockArticuloId = null;
    private async Task GuardarStock()
    {
        if (!StockArticuloId.HasValue || !await InventarioService.AgregarStockAsync(StockArticuloId.Value, CantidadAgregar))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Ingrese una cantidad válida para agregar stock."));
            return;
        }
        await CargarInventario();
        CerrarStock();
        ToastService.Notify(new ToastMessage(ToastType.Success, "Stock agregado correctamente."));
    }

    private void VerDetalle(int id)
    {
        SelectedArticulo = AppState.Inventario.FirstOrDefault(c => c.Id == id);
    }

    private void CerrarDetalle()
    {
        SelectedArticulo = null;
    }
}
