@page "/cotizaciones"
@inject ElectroGestion.Services.CotizacionService CotizacionService
@inject ElectroGestion.Services.AppStateService AppState
@inject BlazorBootstrap.ToastService ToastService
@inject NavigationManager Nav

<style>
    .cotizacion-filtros { display:flex; flex-direction:column; gap:18px; padding:18px; border-bottom:1px solid #EFF0F6; }
    .cotizacion-filtros-fila { display:flex; align-items:center; gap:18px; flex-wrap:wrap; }
    .cotizacion-filtro { display:flex; align-items:center; gap:9px; min-width:0; }
    .cotizacion-filtro label { font-family:'Manrope'; font-size:14px; font-weight:800; color:#14162B; white-space:nowrap; }
    .cotizacion-filtro input, .cotizacion-filtro select { min-width:0; padding:9px 11px; border:1px solid #D5D8E6; border-radius:7px; background:#fff; color:#4A4E63; }
</style>

<PageTitle>Cotizaciones | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Cotizaciones</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Cotizaciones creadas a partir de levantamientos enviados a administración.</div>
    </div>
    <button class="primary-btn" @onclick="AbrirNueva" style="padding:11px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:9px;font-weight:700;font-size:14.5px;cursor:pointer;font-family:'Manrope'">Nueva Cotización</button>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;overflow:hidden">
    <div class="cotizacion-filtros">
        <div class="cotizacion-filtros-fila">
            <div class="cotizacion-filtro"><label for="filtro-cot-id">ID:</label><input id="filtro-cot-id" @bind="FiltroId" @bind:event="oninput" placeholder="ID" style="width:125px" /></div>
            <div class="cotizacion-filtro"><label for="filtro-cot-sol">Solicitud:</label><input id="filtro-cot-sol" @bind="FiltroSolicitud" @bind:event="oninput" placeholder="ID de solicitud" style="width:170px" /></div>
            <div class="cotizacion-filtro"><label for="filtro-cot-cliente">Cliente:</label><input id="filtro-cot-cliente" @bind="FiltroCliente" @bind:event="oninput" placeholder="Nombre del cliente" style="width:220px" /></div>
            <div class="cotizacion-filtro"><label for="filtro-cot-servicio">Tipo de servicio:</label><select id="filtro-cot-servicio" @bind="FiltroServicio" style="width:220px"><option value="">Todos</option>@foreach (var servicio in CotizacionRows.Select(c => c.Solicitud?.Servicio?.Nombre).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().OrderBy(n => n)) { <option value="@servicio">@servicio</option> }</select></div>
        </div>
        <div class="cotizacion-filtros-fila">
            <div class="cotizacion-filtro"><label for="filtro-cot-desde">Desde:</label><input id="filtro-cot-desde" type="date" @bind="FiltroDesde" /></div>
            <div class="cotizacion-filtro"><label for="filtro-cot-hasta">Hasta:</label><input id="filtro-cot-hasta" type="date" @bind="FiltroHasta" /></div>
            <div class="cotizacion-filtro"><label for="filtro-cot-estado">Estado:</label><select id="filtro-cot-estado" @bind="EstadoFiltro" style="width:210px"><option value="">Todos</option>@foreach (var estado in ElectroGestion.Services.CotizacionService.Estados) { <option value="@estado">@estado</option> }</select></div>
            <div style="margin-left:auto"><button @onclick="() => StateHasChanged()" style="padding:9px 20px;border:0;border-radius:7px;background:#1D4ED8;color:#fff;font-weight:700;cursor:pointer">Buscar</button></div>
        </div>
    </div>
    @if (Cargando)
    {
        <div style="padding:28px;text-align:center;color:#6B7085">Cargando cotizaciones...</div>
    }
    else if (!CotizacionesFiltradas.Any())
    {
        <div style="padding:28px;text-align:center;color:#6B7085">No se encontraron cotizaciones.</div>
    }
    else
    {
        <div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:14px">
            <thead style="background:#F8F9FC"><tr>
                <th style="padding:14px 18px;text-align:left">ID</th><th style="padding:14px 18px;text-align:left">Solicitud</th><th style="padding:14px 18px;text-align:left">Cliente</th><th style="padding:14px 18px;text-align:left">Servicio</th><th style="padding:14px 18px;text-align:left">Fecha</th><th style="padding:14px 18px;text-align:left">Monto</th><th style="padding:14px 18px;text-align:left">Estado</th><th style="padding:14px 18px;text-align:left">Seguimiento</th><th style="padding:14px 18px;text-align:center">Acciones</th>
            </tr></thead><tbody>
                @foreach (var cot in CotizacionesFiltradas)
                {
                    var colores = Colores(cot.Estado);
                    <tr style="border-top:1px solid #EFF0F6">
                        <td style="padding:14px 18px">@cot.Id</td><td style="padding:14px 18px">@(cot.SolicitudId)</td><td style="padding:14px 18px">@cot.Cliente</td><td style="padding:14px 18px">@(cot.Solicitud?.Servicio?.Nombre ?? "—")</td><td style="padding:14px 18px">@cot.Fecha.ToString("dd/MM/yyyy")</td><td style="padding:14px 18px;font-weight:700">RD$ @cot.MontoTotal.ToString("N2")</td>
                        <td style="padding:14px 18px;min-width:155px"><span style="display:inline-block;white-space:nowrap;padding:4px 10px;border-radius:20px;font-size:12.5px;font-weight:700;background:@colores.Bg;color:@colores.Fg">@cot.Estado</span></td>
                        <td style="padding:14px 18px;font-size:12px;color:#6B7085">@if (cot.FechaEnvio.HasValue) { <div>Enviada: @cot.FechaEnvio.Value.ToString("dd/MM/yyyy HH:mm")</div> } @if (cot.FechaRespuesta.HasValue) { <div>Respuesta: @cot.FechaRespuesta.Value.ToString("dd/MM/yyyy HH:mm")</div> } @if (!string.IsNullOrWhiteSpace(cot.MotivoRechazo)) { <div title="@cot.MotivoRechazo">Motivo: @cot.MotivoRechazo</div> }</td>
                        <td style="padding:14px 18px;text-align:center"><div style="display:flex;gap:6px;justify-content:center;flex-wrap:wrap">
                            @if (cot.Estado == ElectroGestion.Services.CotizacionService.EnRevision)
                            {
                                <button @onclick="() => Editar(cot)" style="padding:7px 11px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer">Editar detalle</button>
                                <button @onclick='() => AbrirConfirmacion(cot.Id, "Enviada al cliente")' style="padding:7px 11px;border:0;background:#1D4ED8;color:#fff;border-radius:7px;cursor:pointer">Marcar enviada</button>
                            }
                            else if (cot.Estado == "Enviada al cliente")
                            {
                                <button @onclick='() => AbrirConfirmacion(cot.Id, "Aprobada")' style="padding:7px 11px;border:0;background:#059669;color:#fff;border-radius:7px;cursor:pointer">Aprobar</button>
                                <button @onclick="() => AbrirRechazo(cot.Id)" style="padding:7px 11px;border:1px solid #F5C2C4;background:#fff;color:#C4141B;border-radius:7px;cursor:pointer">Rechazar</button>
                            }
                            @if (cot.Estado == "Enviada al cliente")
                            { <button @onclick='() => Transicionar(cot.Id, "En revisión")' style="padding:7px 11px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer">Volver a revisión</button> }
                            else if (cot.Estado is "Aprobada" or "Rechazada")
                            { <button @onclick='() => Transicionar(cot.Id, "Enviada al cliente")' style="padding:7px 11px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer">Volver a enviada</button> }
                            @if (cot.Solicitud?.Levantamiento is not null) { <button @onclick="() => VerLevantamiento(cot.Solicitud)" style="padding:7px 11px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer">Levantamiento</button> }
                            <button @onclick="() => VerCotizacion(cot)" style="padding:7px 11px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer">Detalle</button>
                        </div>
                        </td>
                    </tr>
                }
            </tbody></table></div>
    }
</div>

@if (ModalAbierto)
{
    <div style="position:fixed;inset:0;background:rgba(20,22,43,.45);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px" @onclick="CerrarModal">
        <div style="background:#fff;width:100%;max-width:650px;border-radius:14px;padding:24px;max-height:90vh;overflow:auto" @onclick:stopPropagation>
            <h3 style="margin:0 0 18px;font-family:'Manrope';font-weight:800">@(EditandoId.HasValue ? "Editar cotización" : "Nueva cotización")</h3>
            @if (!EditandoId.HasValue)
            {
                <label style="display:block;margin-bottom:6px;font-weight:700">Levantamiento en espera de administración</label>
                <select @bind="SolicitudSeleccionada" style="width:100%;padding:10px;border:1px solid #D5D8E6;border-radius:8px;margin-bottom:16px;background:#fff">
                    <option value="0">Seleccione una solicitud</option>
                    @foreach (var solicitud in LevantamientosPendientes)
                    { <option value="@solicitud.Id">Solicitud #@solicitud.Id · @(solicitud.Cliente?.Nombre) · @(solicitud.Servicio?.Nombre)</option> }
                </select>
                @if (SolicitudActual is not null)
                {
                    <div style="background:#F7F8FC;border-radius:9px;padding:14px;margin-bottom:16px;font-size:13px;color:#4A4E63">
                        <strong>Datos del levantamiento</strong>
                        <p><b>Espacios:</b> @SolicitudActual.Levantamiento?.DisponibilidadEspacios</p><p><b>Cargas:</b> @SolicitudActual.Levantamiento?.CargasElectricas</p><p><b>Estabilidad de tensión:</b> @SolicitudActual.Levantamiento?.EstabilidadTension</p><p><b>Tuberías:</b> @SolicitudActual.Levantamiento?.RecorridoTuberias</p><p><b>Cableado:</b> @SolicitudActual.Levantamiento?.RecorridoCableado</p><p><b>Observaciones:</b> @SolicitudActual.Levantamiento?.Observaciones</p>
                    </div>
                }
                else if (!LevantamientosPendientes.Any())
                { <p style="color:#6B7085">No hay levantamientos pendientes de cotización.</p> }
            }
            <h4 style="margin:18px 0 8px">Productos de inventario</h4>
            @if (!AppState.Inventario.Any())
            {
                <p style="color:#B45309">No hay productos en el inventario para cotizar.</p>
            }
            else
            {
                <div style="display:grid;grid-template-columns:minmax(0,1fr) 100px auto;gap:8px;align-items:end">
                    <div><label style="display:block;margin-bottom:5px;font-size:13px;font-weight:700">Producto</label><select @bind="ArticuloSeleccionadoId" style="width:100%;padding:9px;border:1px solid #D5D8E6;border-radius:7px;background:#fff"><option value="0">Seleccione producto</option>@foreach (var art in AppState.Inventario.OrderBy(a => a.Nombre)) { <option value="@art.Id">@art.Codigo · @art.Nombre (Stock: @art.Cantidad) — RD$ @art.PrecioUnidad.ToString("N2")</option> }</select></div>
                    <div><label style="display:block;margin-bottom:5px;font-size:13px;font-weight:700">Cantidad</label><input @bind="CantidadArticulo" type="number" min="1" style="width:100%;padding:9px;border:1px solid #D5D8E6;border-radius:7px" /></div>
                    <button @onclick="AgregarArticulo" style="padding:9px 12px;border:0;background:#1D4ED8;color:#fff;border-radius:7px;font-weight:700;cursor:pointer">Agregar</button>
                </div>
            }
            @if (FormDetalles.Count == 0)
            {
                <div style="margin-top:12px;padding:16px;text-align:center;background:#F8F9FC;color:#6B7085;border-radius:8px">Sin materiales. Puede cotizar solo la mano de obra.</div>
            }
            else
            {
                <div style="overflow-x:auto;margin-top:12px"><table style="width:100%;border-collapse:collapse;font-size:13px"><thead><tr style="background:#F8F9FC"><th style="padding:9px;text-align:left">Producto</th><th style="padding:9px;text-align:right">Precio unitario</th><th style="padding:9px;text-align:center">Cantidad</th><th style="padding:9px;text-align:right">Subtotal</th><th></th></tr></thead><tbody>
                    @foreach (var linea in FormDetalles)
                    {
                        <tr style="border-top:1px solid #EFF0F6"><td style="padding:9px">@linea.CodigoArticulo · @linea.NombreArticulo</td><td style="padding:9px;text-align:right">RD$ @linea.PrecioUnitario.ToString("N2")</td><td style="padding:9px;text-align:center"><input @bind="linea.Cantidad" type="number" min="1" style="width:70px;padding:5px;border:1px solid #D5D8E6;border-radius:5px;text-align:center" /></td><td style="padding:9px;text-align:right;font-weight:700">RD$ @linea.Subtotal.ToString("N2")</td><td style="padding:9px"><button @onclick="() => QuitarArticulo(linea)" title="Quitar" style="border:0;background:transparent;color:#C0392B;cursor:pointer">Quitar</button></td></tr>
                    }
                </tbody></table></div>
            }
            <div style="margin-top:12px"><label style="font-weight:700">Mano de obra / instalación (RD$)</label><input @bind="MontoManoObra" type="number" min="0" step="0.01" style="width:100%;padding:8px;border:1px solid #D5D8E6;border-radius:7px" /></div>
            <div style="margin-top:12px;text-align:right;line-height:1.8"><div>Subtotal de materiales: RD$ @SubtotalMateriales.ToString("N2")</div><div>Subtotal de mano de obra: RD$ @MontoManoObra.ToString("N2")</div><div>Subtotal neto: RD$ @SubtotalNeto.ToString("N2")</div><div>ITBIS (18%): RD$ @MontoItbis.ToString("N2")</div><strong>Total de la cotización: RD$ @TotalCotizacion.ToString("N2")</strong><div>Anticipo para iniciar (50%): RD$ @CalcularAnticipo(TotalCotizacion).ToString("N2")</div><div>Saldo restante: RD$ @((TotalCotizacion - CalcularAnticipo(TotalCotizacion)).ToString("N2"))</div></div>
            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:22px"><button @onclick="CerrarModal" style="padding:10px 16px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer">Cancelar</button><button @onclick="Guardar" style="padding:10px 18px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;cursor:pointer">Guardar</button></div>
        </div>
    </div>
}

<CotizacionDocumento Cotizacion="CotizacionDetalleSeleccionada" OnClose="CerrarDetalle" OnDelete="SolicitarEliminacion" MostrarEliminar="true" />

@if (CotizacionAEliminar.HasValue)
{
    <div style="position:fixed;inset:0;background:rgba(20,22,43,.55);display:flex;align-items:center;justify-content:center;z-index:10003;padding:20px" @onclick="() => CotizacionAEliminar = null">
        <div style="background:#fff;width:100%;max-width:430px;border-radius:14px;padding:24px" @onclick:stopPropagation>
            <h3 style="margin:0 0 10px">Eliminar cotización</h3>
            <p style="color:#4A4E63">¿Desea eliminar la cotización COT-@CotizacionAEliminar.Value.ToString("D5")? Esta acción no se puede deshacer.</p>
            <div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="() => CotizacionAEliminar = null" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer">Cancelar</button><button @onclick="ConfirmarEliminacion" style="padding:9px 14px;border:0;background:#C4141B;color:#fff;border-radius:8px;cursor:pointer">Eliminar cotización</button></div>
        </div>
    </div>
}

@if (ModalRechazoAbierto)
{
    <div style="position:fixed;inset:0;background:rgba(20,22,43,.45);display:flex;align-items:center;justify-content:center;z-index:10001;padding:20px" @onclick="CerrarRechazo">
        <div style="background:#fff;width:100%;max-width:480px;border-radius:14px;padding:24px" @onclick:stopPropagation>
            <h3>Rechazar cotización</h3>
            <label style="display:block;margin:12px 0 6px;font-weight:700">Motivo (opcional)</label>
            <textarea @bind="MotivoRechazo" maxlength="1000" rows="4" style="width:100%;padding:10px;border:1px solid #D5D8E6;border-radius:8px;resize:vertical" placeholder="Indique el motivo comunicado por el cliente"></textarea>
            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:18px"><button @onclick="CerrarRechazo" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px">Cancelar</button><button @onclick="ConfirmarRechazo" style="padding:9px 14px;border:0;background:#C0392B;color:#fff;border-radius:8px">Confirmar rechazo</button></div>
        </div>
    </div>
}

@if (CambioPendienteId.HasValue)
{
    <div style="position:fixed;inset:0;background:rgba(20,22,43,.45);display:flex;align-items:center;justify-content:center;z-index:10001;padding:20px" @onclick="CerrarConfirmacion">
        <div style="background:#fff;width:100%;max-width:420px;border-radius:14px;padding:24px" @onclick:stopPropagation>
            <h3 style="margin:0 0 10px">Confirmar cambio de estado</h3>
            <p style="color:#4A4E63">¿Desea marcar la cotización #@CambioPendienteId como <strong>@EstadoPendiente</strong>?</p>
            <div style="display:flex;justify-content:flex-end;gap:10px"><button @onclick="CerrarConfirmacion" style="padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer">Cancelar</button><button @onclick="ConfirmarCambio" style="padding:9px 14px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;cursor:pointer">Confirmar</button></div>
        </div>
    </div>
}

@if (LevantamientoSeleccionado is not null)
{
    var lev = LevantamientoSeleccionado.Levantamiento!;
    <div style="position:fixed;inset:0;background:rgba(20,22,43,.45);display:flex;align-items:center;justify-content:center;z-index:10000;padding:20px" @onclick="() => LevantamientoSeleccionado = null">
        <div style="background:#fff;width:100%;max-width:650px;border-radius:14px;padding:24px;max-height:90vh;overflow:auto" @onclick:stopPropagation>
            <h3>Levantamiento · Solicitud #@LevantamientoSeleccionado.Id</h3><p><b>Cliente:</b> @LevantamientoSeleccionado.Cliente?.Nombre</p><p><b>Servicio:</b> @LevantamientoSeleccionado.Servicio?.Nombre</p>
            <p><b>Disponibilidad de espacios:</b> @lev.DisponibilidadEspacios</p><p><b>Cargas eléctricas:</b> @lev.CargasElectricas</p><p><b>Estabilidad de tensión:</b> @lev.EstabilidadTension</p><p><b>Recorrido de tuberías:</b> @lev.RecorridoTuberias</p><p><b>Recorrido del cableado:</b> @lev.RecorridoCableado</p><p><b>Observaciones:</b> @lev.Observaciones</p>
            @if (FotosLevantamiento.Count > 0)
            { <h4>Fotografías</h4><div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px">@foreach (var foto in FotosLevantamiento) { <button @onclick="() => FotoAmpliada = foto" title="Ampliar fotografía" style="padding:0;border:1px solid #D5D8E6;border-radius:8px;overflow:hidden;background:#fff;cursor:zoom-in"><img src="@foto" alt="Fotografía del levantamiento" style="display:block;width:100%;height:110px;object-fit:cover" /></button> }</div> }
            <button @onclick="() => LevantamientoSeleccionado = null" style="float:right;padding:9px 16px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;cursor:pointer">Cerrar</button>
        </div>
    </div>
}
@if (FotoAmpliada is not null)
{ <div style="position:fixed;inset:0;z-index:10002;background:rgba(0,0,0,.85);display:flex;align-items:center;justify-content:center;padding:24px" @onclick="() => FotoAmpliada = null"><img src="@FotoAmpliada" alt="Fotografía ampliada del levantamiento" style="max-width:100%;max-height:90vh;object-fit:contain" /></div> }

@code {
    [Parameter, SupplyParameterFromQuery(Name = "detalle")]
    public int? DetalleId { get; set; }

    private List<Cotizacion> CotizacionRows = [];
    private List<Solicitud> LevantamientosPendientes = [];
    private bool Cargando = true;
    private string FiltroId = "";
    private string FiltroSolicitud = "";
    private string FiltroCliente = "";
    private string FiltroServicio = "";
    private DateTime? FiltroDesde;
    private DateTime? FiltroHasta;
    private string EstadoFiltro = "";
    private bool ModalAbierto;
    private int? EditandoId;
    private int SolicitudSeleccionada;
    private int ArticuloSeleccionadoId;
    private int CantidadArticulo = 1;
    private List<DetalleCotizacion> FormDetalles = [];
    private decimal MontoManoObra;
    private decimal SubtotalMateriales => FormDetalles.Sum(d => d.Subtotal);
    private decimal SubtotalNeto => SubtotalMateriales + MontoManoObra;
    private decimal MontoItbis => CotizacionService.CalcularImpuesto(SubtotalNeto, ElectroGestion.Services.CotizacionService.TasaItbis);
    private decimal TotalCotizacion => SubtotalNeto + MontoItbis;
    private static decimal CalcularAnticipo(decimal total) => Math.Round(total * 0.5m, 2, MidpointRounding.AwayFromZero);
    private int? CotizacionARechazar;
    private string MotivoRechazo = "";
    private bool ModalRechazoAbierto;
    private Solicitud? LevantamientoSeleccionado;
    private string? FotoAmpliada;
    private List<string> FotosLevantamiento = [];
    private int? CambioPendienteId;
    private string EstadoPendiente = "";
    private Cotizacion? CotizacionDetalleSeleccionada;
    private int? CotizacionAEliminar;
    private Solicitud? SolicitudActual => LevantamientosPendientes.FirstOrDefault(s => s.Id == SolicitudSeleccionada);
    private IEnumerable<Cotizacion> CotizacionesFiltradas => CotizacionRows.Where(c =>
        (string.IsNullOrWhiteSpace(FiltroId) || c.Id.ToString().Contains(FiltroId.Trim(), StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroSolicitud) || c.SolicitudId.Contains(FiltroSolicitud.Trim(), StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroCliente) || c.Cliente.Contains(FiltroCliente.Trim(), StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroServicio) || c.Solicitud?.Servicio?.Nombre == FiltroServicio) &&
        (!FiltroDesde.HasValue || c.Fecha.Date >= FiltroDesde.Value.Date) &&
        (!FiltroHasta.HasValue || c.Fecha.Date <= FiltroHasta.Value.Date) &&
        (string.IsNullOrWhiteSpace(EstadoFiltro) || c.Estado == EstadoFiltro));

    protected override async Task OnInitializedAsync()
    {
        await Recargar();
        if (DetalleId is > 0)
            CotizacionDetalleSeleccionada = CotizacionRows.FirstOrDefault(c => c.Id == DetalleId);
    }

    private async Task Recargar()
    {
        Cargando = true;
        try
        {
            CotizacionRows = await CotizacionService.ObtenerTodasAsync();
            LevantamientosPendientes = await CotizacionService.ObtenerLevantamientosPendientesAsync();
        }
        catch (Exception)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudieron cargar las cotizaciones. Verifique la conexión con la base de datos."));
        }
        finally { Cargando = false; }
    }

    private void AbrirNueva()
    {
        EditandoId = null; SolicitudSeleccionada = 0; FormDetalles = []; ArticuloSeleccionadoId = 0; CantidadArticulo = 1; MontoManoObra = 0m; ModalAbierto = true;
    }

    private void Editar(Cotizacion cot)
    {
        EditandoId = cot.Id; FormDetalles = cot.Detalles.Select(CopiarLinea).ToList(); ArticuloSeleccionadoId = 0; CantidadArticulo = 1; MontoManoObra = cot.MontoManoObra; ModalAbierto = true;
    }

    private void AgregarArticulo()
    {
        var articulo = AppState.Inventario.FirstOrDefault(a => a.Id == ArticuloSeleccionadoId);
        if (articulo is null || CantidadArticulo < 1)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Seleccione un producto y una cantidad válida.")); return;
        }
        var cantidadActual = FormDetalles.Where(d => d.ArticuloInventarioId == articulo.Id).Sum(d => d.Cantidad);
        if (cantidadActual + CantidadArticulo > articulo.Cantidad)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, $"Stock insuficiente. Disponible: {articulo.Cantidad - cantidadActual}.")); return;
        }
        var linea = FormDetalles.FirstOrDefault(d => d.ArticuloInventarioId == articulo.Id);
        if (linea is null)
        {
            FormDetalles.Add(new DetalleCotizacion { ArticuloInventarioId = articulo.Id, CodigoArticulo = articulo.Codigo, NombreArticulo = articulo.Nombre, PrecioUnitario = articulo.PrecioUnidad, Cantidad = CantidadArticulo });
        }
        else linea.Cantidad += CantidadArticulo;
        CantidadArticulo = 1;
    }

    private void QuitarArticulo(DetalleCotizacion linea) => FormDetalles.Remove(linea);

    private async Task Guardar()
    {
        if (MontoManoObra < 0)
        { ToastService.Notify(new ToastMessage(ToastType.Warning, "La mano de obra no puede tener un monto negativo.")); return; }
        if (SubtotalNeto <= 0 || FormDetalles.Any(d => d.Cantidad <= 0 || d.Cantidad > (AppState.Inventario.FirstOrDefault(a => a.Id == d.ArticuloInventarioId)?.Cantidad ?? 0)))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Ingrese materiales o mano de obra y verifique el stock disponible.")); return;
        }
        var editando = EditandoId.HasValue;
        var guardado = editando
            ? await CotizacionService.ActualizarDetallesAsync(EditandoId!.Value, FormDetalles, MontoManoObra)
            : SolicitudSeleccionada > 0 && await CotizacionService.CrearAsync(SolicitudSeleccionada, FormDetalles, MontoManoObra);
        if (!guardado)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo guardar. Confirme que la solicitud siga en espera de administración y no tenga otra cotización.")); return;
        }
        ModalAbierto = false;
        ToastService.Notify(new ToastMessage(ToastType.Success, editando ? "Detalle de cotización actualizado." : "Cotización creada en estado En revisión."));
        await Recargar();
    }

    private async Task Transicionar(int id, string nuevoEstado)
    {
        var actualizado = await CotizacionService.CambiarEstadoAsync(id, nuevoEstado);
        ToastService.Notify(new ToastMessage(actualizado ? ToastType.Success : ToastType.Warning,
            actualizado ? $"Cotización marcada como {nuevoEstado}." : "La cotización ya no se encuentra en una etapa válida para ese cambio."));
        if (actualizado) await Recargar();
    }

    private void AbrirConfirmacion(int id, string estado) { CambioPendienteId = id; EstadoPendiente = estado; }
    private void CerrarConfirmacion() { CambioPendienteId = null; EstadoPendiente = ""; }
    private async Task ConfirmarCambio()
    {
        if (!CambioPendienteId.HasValue) return;
        var id = CambioPendienteId.Value;
        var estado = EstadoPendiente;
        CerrarConfirmacion();
        await Transicionar(id, estado);
    }

    private void AbrirRechazo(int id) { CotizacionARechazar = id; MotivoRechazo = ""; ModalRechazoAbierto = true; }
    private void CerrarRechazo() { ModalRechazoAbierto = false; CotizacionARechazar = null; }
    private async Task ConfirmarRechazo()
    {
        if (CotizacionARechazar.HasValue && await CotizacionService.CambiarEstadoAsync(CotizacionARechazar.Value, "Rechazada", MotivoRechazo))
        {
            CerrarRechazo();
            ToastService.Notify(new ToastMessage(ToastType.Success, "Cotización rechazada y respuesta registrada."));
            await Recargar();
        }
        else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo registrar el rechazo. Verifique el estado actual."));
    }

    private void VerLevantamiento(Solicitud solicitud)
    {
        LevantamientoSeleccionado = solicitud;
        FotoAmpliada = null;
        try { FotosLevantamiento = System.Text.Json.JsonSerializer.Deserialize<List<string>>(solicitud.Levantamiento?.FotografiasJson ?? "[]")?.Where(f => f.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase)).ToList() ?? []; }
        catch (System.Text.Json.JsonException) { FotosLevantamiento = []; }
    }
    private void VerCotizacion(Cotizacion cotizacion) => CotizacionDetalleSeleccionada = cotizacion;
    private void CerrarDetalle() => CotizacionDetalleSeleccionada = null;
    private void SolicitarEliminacion(int id) => CotizacionAEliminar = id;
    private async Task ConfirmarEliminacion()
    {
        if (!CotizacionAEliminar.HasValue) return;
        var id = CotizacionAEliminar.Value;
        CotizacionAEliminar = null;
        var resultado = await CotizacionService.EliminarAsync(id);
        if (resultado == ElectroGestion.Services.ResultadoEliminarCotizacion.VinculadaAOrden)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "No se puede eliminar: la cotización tiene una orden de trabajo vinculada."));
            return;
        }
        if (resultado != ElectroGestion.Services.ResultadoEliminarCotizacion.Eliminada)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "La cotización ya no existe."));
            return;
        }
        CotizacionDetalleSeleccionada = null;
        ToastService.Notify(new ToastMessage(ToastType.Success, "Cotización eliminada."));
        await Recargar();
        if (DetalleId == id) Nav.NavigateTo("/cotizaciones", replace: true);
    }
    private static DetalleCotizacion CopiarLinea(DetalleCotizacion d) => new() { ArticuloInventarioId = d.ArticuloInventarioId, CodigoArticulo = d.CodigoArticulo, NombreArticulo = d.NombreArticulo, Cantidad = d.Cantidad, PrecioUnitario = d.PrecioUnitario };
    private void CerrarModal() => ModalAbierto = false;
    private static (string Bg, string Fg) Colores(string estado) => estado switch
    {
        "En revisión" => ("#FEF3C7", "#92400E"), "Enviada al cliente" => ("#DBEAFE", "#1E40AF"),
        "Aprobada" => ("#D1FAE5", "#065F46"), "Rechazada" => ("#FEE2E2", "#991B1B"), _ => ("#F3F4F6", "#374151")
    };
}
