@page "/cotizaciones"
@inject ElectroGestion.Services.AppStateService AppState
@inject BlazorBootstrap.ToastService ToastService

<PageTitle>Cotizaciones | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Cotizaciones</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Gestión de cotizaciones para clientes.</div>
    </div>
    <button class="primary-btn" @onclick="() => AbrirModal()"
        style="padding:11px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:9px;font-weight:700;font-size:14.5px;cursor:pointer;font-family:'Manrope';display:flex;align-items:center;gap:8px;box-shadow:0 4px 12px rgba(29,78,216,0.25)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Nueva Cotización
    </button>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:12px;overflow:hidden">
    <div style="display:flex;flex-direction:column;gap:18px;padding:18px 18px 12px;border-bottom:1px solid #EFF0F6">
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" @bind:event="oninput" placeholder="ID"
                    style="width:140px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Solicitud:</span>
                <input @bind="SearchSolicitud" @bind:event="oninput" placeholder="ID Solicitud"
                    style="width:200px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Cliente:</span>
                <input @bind="SearchCliente" @bind:event="oninput" placeholder="Nombre cliente"
                    style="width:200px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Estado:</span>
                <select @bind="SearchEstado"
                    style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="">Todos</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Aprobada">Aprobada</option>
                    <option value="Rechazada">Rechazada</option>
                </select>
            </div>
            <div style="display:flex;justify-content:flex-end;margin-left:auto">
                <button class="primary-btn" @onclick="Filtrar"
                    style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Buscar</button>
            </div>
        </div>
    </div>

    <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:14px">
            <thead style="background:#F8F9FC;border-bottom:1px solid #E3E5EE">
                <tr>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">ID</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Solicitud</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Cliente</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Fecha</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Monto</th>
                    <th style="padding:14px 18px;text-align:left;color:#4A4E63;font-weight:700">Estado</th>
                    <th style="padding:14px 18px;text-align:center;color:#4A4E63;font-weight:700">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredCotizaciones.Any())
                {
                    <tr>
                        <td colspan="7" style="padding:24px;text-align:center;color:#6B7085">No se encontraron cotizaciones.</td>
                    </tr>
                }
                else
                {
                    @foreach (var cot in FilteredCotizaciones)
                    {
                        var (bg, fg) = ElectroGestion.Services.AppStateService.GetBadgeColors(cot.Estado);
                        <tr style="border-bottom:1px solid #EFF0F6;background:#fff">
                            <td style="padding:14px 18px;color:#14162B;font-weight:600">@cot.Id</td>
                            <td style="padding:14px 18px;color:#4A4E63">@cot.SolicitudId</td>
                            <td style="padding:14px 18px;color:#4A4E63">@cot.Cliente</td>
                            <td style="padding:14px 18px;color:#4A4E63">@cot.Fecha.ToString("dd/MM/yyyy")</td>
                            <td style="padding:14px 18px;color:#4A4E63;font-weight:700">RD$ @cot.MontoTotal.ToString("N2")</td>
                            <td style="padding:14px 18px">
                                <span style="display:inline-block;padding:4px 10px;border-radius:20px;font-size:12.5px;font-weight:700;background:@bg;color:@fg">
                                    @cot.Estado
                                </span>
                            </td>
                            <td style="padding:14px 18px;text-align:center">
                                <div style="display:flex;gap:8px;justify-content:center">
                                    <button @onclick="() => VerDetalle(cot.Id)" title="Ver detalle" aria-label="Ver detalle" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    <button @onclick="() => AbrirModal(cot.Id)" title="Editar" aria-label="Editar" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (IsModalOpen)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(20,22,43,0.4);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px" @onclick="CerrarModal">
        <div style="background:#fff;width:100%;max-width:550px;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,0.1);display:flex;flex-direction:column;max-height:90vh" @onclick:stopPropagation>
            <div style="padding:24px;border-bottom:1px solid #E3E5EE;display:flex;align-items:center;justify-content:space-between">
                <h3 style="margin:0;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">@ModalTitle</h3>
                <button @onclick="CerrarModal" style="background:none;border:0;color:#6B7085;cursor:pointer;padding:4px">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            
            <div style="padding:24px;overflow-y:auto;display:flex;flex-direction:column;gap:16px">
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">ID Solicitud</label>
                    <input @bind="FormSolicitudId" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="Ej: REQ-001" />
                </div>
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Cliente</label>
                    <input @bind="FormCliente" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="Nombre del cliente" />
                </div>
                <div>
                    <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Monto Total</label>
                    <input @bind="FormMonto" type="number" step="0.01" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" placeholder="0.00" />
                </div>
                @if (EditId.HasValue)
                {
                    <div>
                        <label style="display:block;font-family:'Manrope';font-weight:700;font-size:14px;color:#4A4E63;margin-bottom:6px">Estado</label>
                        <select @bind="FormEstado" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Aprobada">Aprobada</option>
                            <option value="Rechazada">Rechazada</option>
                        </select>
                    </div>
                }
            </div>

            <div style="padding:20px 24px;border-top:1px solid #E3E5EE;display:flex;justify-content:flex-end;gap:12px;background:#F8F9FC;border-radius:0 0 16px 16px">
                <button @onclick="CerrarModal" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;color:#4A4E63;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Cancelar</button>
                <button @onclick="GuardarCotizacion" style="padding:10px 22px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Guardar</button>
            </div>
        </div>
    </div>
}

@if (SelectedCotizacion != null)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:620px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,.2);animation:tin .2s ease-out">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
                <div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B">Detalle de Cotización</div>
                    <div style="font-size:14px;color:#6B7085;margin-top:3px">Cotización @SelectedCotizacion.Id.ToString("D4")</div>
                </div>
                <button @onclick="CerrarDetalle" aria-label="Cerrar" style="width:32px;height:32px;border:1px solid #E3E5EE;border-radius:8px;background:#fff;display:flex;align-items:center;justify-content:center;color:#8B90A3;cursor:pointer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px" class="resp-grid-2">
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Solicitud</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedCotizacion.SolicitudId</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Cliente</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedCotizacion.Cliente</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Fecha</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedCotizacion.Fecha.ToString("dd/MM/yyyy")</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Monto Total</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">RD$ @SelectedCotizacion.MontoTotal.ToString("N2")</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Estado</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">
                    @{ var (bg, fg) = ElectroGestion.Services.AppStateService.GetBadgeColors(SelectedCotizacion.Estado); }
                    <span style="display:inline-block;padding:4px 10px;border-radius:20px;font-size:12.5px;font-weight:700;background:@bg;color:@fg">@SelectedCotizacion.Estado</span>
                </div></div>
            </div>
            <div style="margin-top:24px;display:flex;justify-content:flex-end;border-top:1px solid #EFF0F6;padding-top:17px">
                <button @onclick="CerrarDetalle" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchId = "";
    private string SearchSolicitud = "";
    private string SearchCliente = "";
    private string SearchEstado = "";

    private void Filtrar()
    {
        StateHasChanged();
    }

    private bool IsModalOpen = false;
    private string ModalTitle = "";
    private int? EditId = null;
    private ElectroGestion.Models.Cotizacion? SelectedCotizacion;

    private string FormSolicitudId = "";
    private string FormCliente = "";
    private decimal FormMonto = 0;
    private string FormEstado = "Pendiente";

    private List<ElectroGestion.Models.Cotizacion> FilteredCotizaciones => AppState.Cotizaciones
        .Where(c => {
            bool matchId = string.IsNullOrEmpty(SearchId) || c.Id.ToString().Contains(SearchId);
            bool matchSol = string.IsNullOrEmpty(SearchSolicitud) || c.SolicitudId.Contains(SearchSolicitud, StringComparison.OrdinalIgnoreCase);
            bool matchCliente = string.IsNullOrEmpty(SearchCliente) || c.Cliente.Contains(SearchCliente, StringComparison.OrdinalIgnoreCase);
            bool matchEst = string.IsNullOrEmpty(SearchEstado) || c.Estado.Equals(SearchEstado, StringComparison.OrdinalIgnoreCase);
            return matchId && matchSol && matchCliente && matchEst;
        })
        .OrderByDescending(c => c.Id)
        .ToList();

    private void AbrirModal(int? id = null)
    {
        EditId = id;
        if (id.HasValue)
        {
            ModalTitle = "Editar Cotización";
            var item = AppState.Cotizaciones.First(x => x.Id == id.Value);
            FormSolicitudId = item.SolicitudId;
            FormCliente = item.Cliente;
            FormMonto = item.MontoTotal;
            FormEstado = item.Estado;
        }
        else
        {
            ModalTitle = "Nueva Cotización";
            FormSolicitudId = "";
            FormCliente = "";
            FormMonto = 0;
            FormEstado = "Pendiente";
        }
        IsModalOpen = true;
    }

    private void CerrarModal()
    {
        IsModalOpen = false;
    }

    private void GuardarCotizacion()
    {
        if (string.IsNullOrWhiteSpace(FormSolicitudId) || string.IsNullOrWhiteSpace(FormCliente) || FormMonto <= 0)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Complete todos los campos correctamente."));
            return;
        }

        if (EditId.HasValue)
        {
            var item = AppState.Cotizaciones.First(x => x.Id == EditId.Value);
            item.SolicitudId = FormSolicitudId;
            item.Cliente = FormCliente;
            item.MontoTotal = FormMonto;
            item.Estado = FormEstado;
            ToastService.Notify(new ToastMessage(ToastType.Success, "Cotización actualizada con éxito."));
        }
        else
        {
            var nueva = new ElectroGestion.Models.Cotizacion
            {
                Id = AppState.NextCotizacionId(),
                SolicitudId = FormSolicitudId,
                Cliente = FormCliente,
                MontoTotal = FormMonto,
                Fecha = DateTime.Today,
                Estado = "Pendiente"
            };
            AppState.Cotizaciones.Add(nueva);
            ToastService.Notify(new ToastMessage(ToastType.Success, "Cotización creada con éxito."));
        }

        AppState.NotifyStateChanged();
        CerrarModal();
    }

    private void VerDetalle(int id)
    {
        SelectedCotizacion = AppState.Cotizaciones.FirstOrDefault(c => c.Id == id);
    }

    private void CerrarDetalle()
    {
        SelectedCotizacion = null;
    }
}
