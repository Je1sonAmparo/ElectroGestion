
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.SolicitudService SolicitudService
@inject ElectroGestion.Services.ClienteService ClienteService
@inject ElectroGestion.Services.ServicioService ServicioService
@inject NavigationManager NavManager
@inject ToastService ToastService
<PageTitle>Solicitudes (Administración) | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:18px">
    <div>
        <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.8px;color:#1f2430;line-height:1.15">Solicitudes</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Registro de las necesidades de los clientes.</div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end">
        <button @onclick="AlternarModoSeleccion" title="Seleccionar varias solicitudes para eliminar"
            style="padding:10px 16px 10px 14px;background:#fff;border:1px solid @(ModoSeleccion ? "#B42318" : "#D5D8E6");color:@(ModoSeleccion ? "#B42318" : "#4A4E63");border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';white-space:nowrap;display:flex;align-items:center;gap:8px;transition:all .15s">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8.5 12.5 2.5 2.5 5-5.5"/></svg>
            <span>@(ModoSeleccion ? "Salir de selección" : "Seleccionar")</span>
        </button>
        <button class="primary-btn" @onclick="NuevaSolicitud"
            style="padding:10px 16px 10px 18px;background:#1D4ED8;color:#fff;border:0;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';white-space:nowrap;display:flex;align-items:center;gap:8px">
            <span style="font-size:20px;line-height:1;transform:translateY(-1px)">+</span>
            <span>Nueva solicitud</span>
        </button>
    </div>
</div>

<div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;overflow:hidden">
    <div style="display:flex;flex-direction:column;gap:18px;padding:18px 18px 12px;border-bottom:1px solid #EFF0F6">
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                <input @bind="SearchId" @bind:event="oninput" placeholder="ID de solicitud"
                    style="width:140px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Cliente:</span>
                <input @bind="SearchCliente" @bind:event="oninput" placeholder="Nombre del cliente"
                    style="width:200px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Tipo de Servicio:</span>
                <select @bind="SearchTipo" style="width:190px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="">Seleccione Servicio</option>
                    @foreach (var t in TiposServicio)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Fecha Solicitud:</span>
                <input type="date" @bind="SearchFecha"
                    style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63" />
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Estado:</span>
                <select @bind="SearchEstado" style="width:170px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                    <option value="Todos los estados">Todos los estados</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="En proceso">En proceso</option>
                    <option value="En Espera Administración">En Espera Administración</option>
                    <option value="En revisión">En revisión</option>
                    <option value="Enviada al cliente">Enviada al cliente</option>
                    <option value="Aprobada">Aprobada</option>
                    <option value="Rechazada">Rechazada</option>
                    <option value="Pendiente de cobro">Pendiente de cobro</option>
                    <option value="Finalizada">Finalizada</option>
                    <option value="Cancelada">Cancelada</option>
                </select>
            </div>
            <div style="width:190px;display:flex;justify-content:flex-end;margin-left:auto">
                <button class="primary-btn" @onclick="Filtrar"
                    style="padding:9px 20px;background:#1D4ED8;color:#fff;border:0;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">
                    Buscar
                </button>
            </div>
        </div>
    </div>

@if (ModoSeleccion)
{
    <div style="padding:10px 18px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;background:#EFF6FF">
        <div style="display:flex;align-items:center;gap:9px;font-size:13.5px;color:#1D4ED8;font-weight:700;flex-wrap:wrap">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8.5 12.5 2.5 2.5 5-5.5"/></svg>
            <span>@(Seleccionadas.Count == 1 ? "1 solicitud seleccionada" : $"{Seleccionadas.Count} solicitudes seleccionadas")</span>
            <span style="color:#6B7085;font-weight:500">· Haz clic en una fila para marcarla o desmarcarla</span>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
            <button @onclick="AlternarTodas" style="padding:8px 14px;border:1px solid #B6C8F5;background:#fff;color:#1D4ED8;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer;font-family:'Manrope'">
                @(TodasMarcadas ? "Desmarcar todas" : "Marcar todas")
            </button>
            <button disabled="@(Seleccionadas.Count == 0)" @onclick="ConfirmarSeleccionadas" style="padding:8px 16px;border:0;background:@(Seleccionadas.Count == 0 ? "#F1A4A7" : "#C0392B");color:#fff;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer;font-family:'Manrope';display:flex;align-items:center;gap:7px">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                <span>Eliminar @(Seleccionadas.Count == 1 ? "(1)" : $"({Seleccionadas.Count})")</span>
            </button>
        </div>
    </div>
}
<div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:14px;table-layout:fixed">
            <thead>
                <tr style="border-bottom:1px solid #EFF0F6;background:#FAFAFC;color:#6B7085;font-family:'Manrope';font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:0.5px">
                    <th @onclick='() => OrdenarPor("Id")' style="padding:14px 18px;text-align:left;width:12%;cursor:pointer;user-select:none" title="Ordenar por ID">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            @if (ModoSeleccion)
                            {
                                <input type="checkbox" aria-label="Seleccionar todas las solicitudes visibles que se pueden eliminar" checked="@TodasMarcadas" @onchange="e => SeleccionarTodas((bool)(e.Value ?? false))" @onclick:stopPropagation style="margin-right:5px" />
                            }
                            <span>ID</span>
                            @if (SortColumn == "Id") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Cliente")' style="padding:14px 18px;text-align:left;width:22%;cursor:pointer;user-select:none" title="Ordenar por Cliente">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Cliente</span>
                            @if (SortColumn == "Cliente") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Servicio")' style="padding:14px 18px;text-align:left;width:22%;cursor:pointer;user-select:none" title="Ordenar por Tipo de Servicio">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Tipo de Servicio</span>
                            @if (SortColumn == "Servicio") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Fecha")' style="padding:14px 18px;text-align:left;width:18%;cursor:pointer;user-select:none" title="Ordenar por Fecha Solicitud">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Fecha Solicitud</span>
                            @if (SortColumn == "Fecha") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th @onclick='() => OrdenarPor("Estado")' style="padding:14px 18px;text-align:left;width:15%;cursor:pointer;user-select:none" title="Ordenar por Estado">
                        <div style="display:inline-flex;align-items:center;gap:6px">
                            <span>Estado</span>
                            @if (SortColumn == "Estado") { <span style="font-size:11px">@(SortAscending ? "▲" : "▼")</span> }
                        </div>
                    </th>
                    <th style="padding:14px 18px;text-align:right;width:11%">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredSolicitudes.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="padding:32px;text-align:center;color:#6B7085">
                            No se encontraron solicitudes con los filtros indicados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in FilteredSolicitudes)
                    {
                        <tr @onclick="@(() => FilaClicked(s.Id))" style="border-bottom:1px solid #EFF0F6;transition:background 0.15s;background:@(ModoSeleccion && Seleccionadas.Contains(s.Id) ? "#EFF6FF" : "transparent");cursor:@(ModoSeleccion ? "pointer" : "default")">
                            <td style="padding:18px;vertical-align:middle">
                                @if (ModoSeleccion)
                                {
                                    <input type="checkbox" aria-label="Seleccionar solicitud @s.Id" checked="@Seleccionadas.Contains(s.Id)" disabled="@(!PuedeEliminarSolicitud(s.Id))" @onchange="e => CambiarSeleccion(s.Id, (bool)(e.Value ?? false))" @onclick:stopPropagation style="margin-right:8px" />
                                }
                                <span style="font-family:ui-monospace,'SFMono-Regular',Consolas,monospace;font-size:14px;font-weight:700;letter-spacing:.05em;color:@(ModoSeleccion && Seleccionadas.Contains(s.Id) ? "#1D4ED8" : "#5B6173")">@s.Id.ToString("D4")</span>
                            </td>
                            <td style="padding:18px;vertical-align:middle;font-weight:700;color:#14162B">
                                @s.Cliente?.Nombre
                            </td>
                            <td style="padding:18px;vertical-align:middle;color:#4A4E63">
                                @s.Servicio?.Nombre
                            </td>
                            <td style="padding:18px;vertical-align:middle;color:#6B7085">
                                @AppStateService.FormatFecha(s.FechaSolicitud.ToString("yyyy-MM-dd"))
                            </td>
                            <td style="padding:18px;vertical-align:middle;text-align:center">
                                <span style="display:inline-flex;align-items:center;justify-content:center;text-align:center;width:@(s.EstadoSolicitud?.Nombre == "En Espera Administración" ? "120px" : "auto");box-sizing:border-box;padding:@(s.EstadoSolicitud?.Nombre == "En Espera Administración" ? "5px 8px" : "5px 12px");border-radius:999px;font-size:12.5px;font-weight:700;line-height:1.2;background:@(s.EstadoSolicitud?.Nombre == "Pendiente" ? "#F7E7C9" : s.EstadoSolicitud?.Nombre == "En proceso" ? "#DDE7FF" : s.EstadoSolicitud?.Nombre == "En Espera Administración" ? "#E0E7FF" : s.EstadoSolicitud?.Nombre == "Finalizada" ? "#DDF7E8" : "#F9E6E6");color:@(s.EstadoSolicitud?.Nombre == "Pendiente" ? "#B57A00" : s.EstadoSolicitud?.Nombre == "En proceso" ? "#2B5BDB" : s.EstadoSolicitud?.Nombre == "En Espera Administración" ? "#3730A3" : s.EstadoSolicitud?.Nombre == "Finalizada" ? "#198754" : "#C0392B")">
                                    @s.EstadoSolicitud?.Nombre
                                </span>
                            </td>
                            <td style="padding:18px;text-align:right;vertical-align:middle">
                                <div style="display:flex;gap:8px;justify-content:flex-end">
                                    <button @onclick="() => VerDetalle(s.Id)" @onclick:stopPropagation title="Ver detalle" aria-label="Ver detalle" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    <button @onclick="() => Editar(s.Id)" @onclick:stopPropagation title="Editar" aria-label="Editar" class="table-action-icon" style="width:30px;height:30px;border:1px solid #D5D8E6;background:#fff;border-radius:7px;cursor:pointer;color:#5F6479;display:flex;align-items:center;justify-content:center;padding:0">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (IsDetalleModalOpen && SelectedSolicitud != null)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:620px;max-height:90vh;overflow:auto;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,.2);animation:tin .2s ease-out">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
                <div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B">Detalle de la solicitud</div>
                    <div style="font-size:14px;color:#6B7085;margin-top:3px">Solicitud @SelectedSolicitud.Id.ToString("D4")</div>
                </div>
                <button @onclick="CerrarDetalle" aria-label="Cerrar" style="width:32px;height:32px;border:1px solid #E3E5EE;border-radius:8px;background:#fff;display:flex;align-items:center;justify-content:center;color:#8B90A3;cursor:pointer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px" class="resp-grid-2">
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Cliente</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedSolicitud.Cliente?.Nombre</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Contacto</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedSolicitud.Contacto</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Tipo de servicio</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedSolicitud.Servicio?.Nombre</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Dirección</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedSolicitud.Direccion</div></div>
                <div style="background:#F7F8FC;border:1px solid #EFF0F6;border-radius:10px;padding:12px 14px"><div style="font-size:11.5px;color:#8B90A3;font-weight:800;text-transform:uppercase">Estado</div><div style="font-size:14px;margin-top:4px;font-weight:700;color:#14162B">@SelectedSolicitud.EstadoSolicitud?.Nombre</div></div>
            </div>
            <SolicitudTimeline SolicitudId="SelectedSolicitud.Id" />
            <div style="margin-top:24px;display:flex;justify-content:flex-end;border-top:1px solid #EFF0F6;padding-top:17px">
                <button @onclick="CerrarDetalle" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cerrar</button>
            </div>
        </div>
    </div>
}

@* Modal de Formulario de Solicitud *@
@if (IsFormModalOpen)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:540px;padding:32px;box-shadow:0 20px 40px rgba(0,0,0,0.2);animation:tin 0.2s ease-out">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
                <div>
                    <div style="font-family:'Manrope';font-weight:800;font-size:22px;color:#14162B">@ModalTitle</div>
                    <div style="color:#6B7085;font-size:13.5px;margin-top:4px">@ModalSub</div>
                </div>
                <button @onclick="CloseModal" style="background:none;border:0;font-size:22px;color:#A1A5B7;cursor:pointer">&times;</button>
            </div>

            <div style="display:flex;flex-direction:column;gap:16px">
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Cliente *</label>
                    <select @bind="FormCliente" disabled="@FormId.HasValue" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;background:@(FormId.HasValue ? "#F7F8FC" : "#fff");color:@(FormId.HasValue ? "#6B7085" : "#14162B");cursor:@(FormId.HasValue ? "not-allowed" : "pointer");opacity:1">
                        <option value="">Seleccione un cliente registrado</option>
                        @foreach (var c in clientes)
                        {
                            <option value="@c.Nombre">@c.Nombre</option>
                        }
                    </select>
                </div>

                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Tipo de Servicio *</label>
                    <select @bind="FormServicioId" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;background:#fff">
                        <option value="0">Seleccione el tipo de servicio</option>
                        @foreach (var servicio in ServiciosDelFormulario)
                        {
                            <option value="@servicio.Id">@servicio.Nombre@(servicio.Estado == "Inactivo" ? " (inactivo)" : "")</option>
                        }
                    </select>
                </div>

                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Dirección del Servicio *</label>
                    <input @bind="FormDireccion" placeholder="ej. Calle Principal #12, Santiago" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px" />
                </div>

            </div>

            <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:28px">
                @if (FormId.HasValue && PuedeEliminarSolicitud(FormId.Value))
                {
                    <button @onclick="() => ConfirmarEliminar(FormId.Value)" style="padding:10px 18px;border:0;background:#DC2626;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope';display:flex;align-items:center;gap:6px">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                        <span>Eliminar</span>
                    </button>
                }
                else if (FormId.HasValue)
                {
                    <span style="align-self:center;color:#B42318;font-size:12px;font-weight:700">No se puede eliminar mientras esté En proceso o En Espera Administración.</span>
                }
                <button @onclick="CloseModal" style="padding:10px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;color:#4A4E63">
                    Cancelar
                </button>
                <button @onclick="SaveModal" style="padding:10px 24px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">
                    Guardar
                </button>
            </div>
        </div>
    </div>
}

@if (IsDeleteModalOpen)
{
    <div style="position:fixed;inset:0;background:rgba(14,16,40,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:430px;padding:30px;box-shadow:0 20px 40px rgba(0,0,0,0.2);animation:tin 0.2s ease-out">
            <div style="font-family:'Manrope';font-weight:800;font-size:23px;color:#14162B;margin-bottom:12px">Eliminar @(DeleteIds.Count == 1 ? "solicitud" : "solicitudes")</div>
            <div style="color:#4A4E63;font-size:14.5px;line-height:1.55">¿Está seguro que desea eliminar @(DeleteIds.Count == 1 ? "esta solicitud" : $"estas {DeleteIds.Count} solicitudes")? Esta acción no se puede deshacer.</div>
            @if (DeleteIds.Count > 1)
            {
                <div style="background:#F9FAFB;border:1px solid #EFF0F6;border-radius:10px;max-height:200px;overflow:auto;margin-top:16px" class="resp-lista-eliminar">
                    @foreach (var s in SolicitudesAEliminar)
                    {
                        <div style="display:flex;align-items:center;gap:12px;padding:9px 14px;border-bottom:1px solid #EFF0F6">
                            <span style="font-family:ui-monospace,'SFMono-Regular',Consolas,monospace;font-size:12.5px;font-weight:700;letter-spacing:.05em;color:#C0392B;background:#FDECEC;border-radius:6px;padding:2px 8px;flex-shrink:0">@s.Id.ToString("D4")</span>
                            <div style="min-width:0">
                                <div style="font-size:13.5px;font-weight:700;color:#14162B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@s.Cliente?.Nombre</div>
                                <div style="font-size:12px;color:#6B7085;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@s.Servicio?.Nombre · @AppStateService.FormatFecha(s.FechaSolicitud.ToString("yyyy-MM-dd"))</div>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (Seleccionadas.Count > DeleteIds.Count)
            {
                <div style="background:#FFF7E6;border:1px solid #F5E2B8;border-radius:8px;padding:9px 12px;font-size:12.5px;color:#8A6100;margin-top:12px">
                    Nota: se omitieron @(Seleccionadas.Count - DeleteIds.Count) solicitud(es) protegidas (En proceso, En Espera Administración o Finalizadas); no se pueden eliminar.
                </div>
            }
            <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:28px">
                <button @onclick="CerrarEliminar" style="padding:11px 24px;border:1px solid #E3E5EE;background:#fff;border-radius:10px;font-weight:600;font-size:15px;cursor:pointer;color:#14162B;font-family:'Manrope'">
                    Cancelar
                </button>
                <button @onclick="EjecutarEliminar" style="padding:11px 26px;border:0;background:#C0392B;color:#fff;border-radius:10px;font-weight:700;font-size:15px;cursor:pointer;font-family:'Manrope'">
                    Eliminar
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool AbrirNuevaSolicitud { get; set; }

    private bool SolicitudRapidaAbierta;

    private string SearchId { get; set; } = "";
    private string SearchCliente { get; set; } = "";
    private string SearchTipo { get; set; } = "";
    private DateTime? SearchFecha { get; set; } = null;
    private string SearchEstado { get; set; } = "Todos los estados";
    private bool IsDetalleModalOpen;
    private ElectroGestion.Models.Solicitud? SelectedSolicitud;

    private string SortColumn = "Id";
    private bool SortAscending = false;

    private List<ElectroGestion.Models.Solicitud> FilteredSolicitudes = new();

    private bool IsFormModalOpen = false;
    private bool IsDeleteModalOpen = false;
    private int? DeleteId;
    private HashSet<int> Seleccionadas = [];
    private HashSet<int> DeleteIds = [];
    private bool ModoSeleccion;
    private List<int> ElegiblesVisibles => FilteredSolicitudes.Where(s => PuedeEliminarSolicitud(s.Id)).Select(s => s.Id).ToList();
    private bool TodasMarcadas => ElegiblesVisibles.Count > 0 && ElegiblesVisibles.All(id => Seleccionadas.Contains(id));
    private List<ElectroGestion.Models.Solicitud> SolicitudesAEliminar => DeleteIds
        .Select(id => solicitudes.FirstOrDefault(s => s.Id == id))
        .Where(s => s != null)
        .Cast<ElectroGestion.Models.Solicitud>()
        .ToList();

    private void AlternarModoSeleccion()
    {
        ModoSeleccion = !ModoSeleccion;
        if (!ModoSeleccion) Seleccionadas.Clear();
    }

    private void FilaClicked(int id)
    {
        if (!ModoSeleccion) return;
        if (!PuedeEliminarSolicitud(id))
        {
            ToastService.ShowWarning("Esta solicitud está protegida (En proceso, En Espera Administración o Finalizada) y no se puede eliminar.", "Atención");
            return;
        }
        CambiarSeleccion(id, !Seleccionadas.Contains(id));
    }

    private void AlternarTodas() => SeleccionarTodas(!TodasMarcadas);

    private void CambiarSeleccion(int id, bool marcado) { if (marcado && PuedeEliminarSolicitud(id)) Seleccionadas.Add(id); else Seleccionadas.Remove(id); }
    private void SeleccionarTodas(bool marcado) { foreach (var id in ElegiblesVisibles) { if (marcado) Seleccionadas.Add(id); else Seleccionadas.Remove(id); } }
    private void ConfirmarSeleccionadas() { DeleteIds = Seleccionadas.Where(PuedeEliminarSolicitud).ToHashSet(); IsDeleteModalOpen = DeleteIds.Count > 0; }
    private string ModalTitle = "";
    private string ModalSub = "";
    private int? FormId;
    private string FormCliente = "";
    private int FormServicioId;
    private string FormDireccion = "";
    private List<string> TiposServicio = new() {
        "Instalación Solar", "Instalación de Sistema UPS", "Mantenimiento Eléctrico",
        "Instalación de Planta Eléctrica", "Cableado Estructurado"
    };
    private List<ElectroGestion.Models.Solicitud> solicitudes = new();
    private List<ElectroGestion.Models.Cliente> clientes = new();
    private List<ElectroGestion.Models.Servicio> servicios = new();
    private IEnumerable<ElectroGestion.Models.Servicio> ServiciosDelFormulario => servicios.Where(s =>
        s.Estado == "Activo" || solicitudes.Any(sol => sol.Id == FormId && sol.ServicioId == s.Id));

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!AbrirNuevaSolicitud)
        {
            SolicitudRapidaAbierta = false;
            return;
        }

        if (SolicitudRapidaAbierta) return;
        SolicitudRapidaAbierta = true;
        await NuevaSolicitud();
    }

    private void OrdenarPor(string columna)
    {
        if (SortColumn == columna)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortColumn = columna;
            SortAscending = true;
        }
        Filtrar();
    }

    private async Task CargarDatos()
    {
        solicitudes = await SolicitudService.GetList(s => true);
        clientes = await ClienteService.GetList(c => true);
        servicios = await ServicioService.GetList(s => true);
        
        TiposServicio = servicios.Select(s => s.Nombre).ToList();
        Filtrar();
    }

    private void Filtrar()
    {
        var q = solicitudes.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchId))
        {
            q = q.Where(x => x.Id.ToString("D4").Contains(SearchId, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(SearchCliente))
        {
            q = q.Where(x => x.Cliente != null && x.Cliente.Nombre.Contains(SearchCliente, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(SearchTipo))
        {
            q = q.Where(x => x.Servicio != null && x.Servicio.Nombre == SearchTipo);
        }

        if (SearchFecha.HasValue)
        {
            var dateStr = SearchFecha.Value.ToString("yyyy-MM-dd");
            q = q.Where(x => x.FechaSolicitud.ToString("yyyy-MM-dd").StartsWith(dateStr));
        }

        if (SearchEstado != "Todos los estados")
        {
            q = q.Where(x => x.EstadoSolicitud != null && x.EstadoSolicitud.Nombre == SearchEstado);
        }

        FilteredSolicitudes = (SortColumn switch
        {
            "Id" => SortAscending ? q.OrderBy(x => x.Id) : q.OrderByDescending(x => x.Id),
            "Cliente" => SortAscending ? q.OrderBy(x => x.Cliente != null ? x.Cliente.Nombre : "") : q.OrderByDescending(x => x.Cliente != null ? x.Cliente.Nombre : ""),
            "Servicio" => SortAscending ? q.OrderBy(x => x.Servicio != null ? x.Servicio.Nombre : "") : q.OrderByDescending(x => x.Servicio != null ? x.Servicio.Nombre : ""),
            "Fecha" => SortAscending ? q.OrderBy(x => x.FechaSolicitud) : q.OrderByDescending(x => x.FechaSolicitud),
            "Estado" => SortAscending ? q.OrderBy(x => x.EstadoSolicitud != null ? x.EstadoSolicitud.Nombre : "") : q.OrderByDescending(x => x.EstadoSolicitud != null ? x.EstadoSolicitud.Nombre : ""),
            _ => SortAscending ? q.OrderBy(x => x.Id) : q.OrderByDescending(x => x.Id)
        }).ToList();
        Seleccionadas.IntersectWith(FilteredSolicitudes.Select(s => s.Id));
    }

    private async Task NuevaSolicitud()
    {
        await CargarDatos();
        IsFormModalOpen = true;
        ModalTitle = "Nueva Solicitud";
        ModalSub = "Complete los datos para registrar una nueva solicitud de servicio.";
        FormCliente = "";
        FormServicioId = 0;
        FormDireccion = "";
        FormId = null;
    }

    private async Task Editar(int id)
    {
        await CargarDatos();
        var s = solicitudes.FirstOrDefault(x => x.Id == id);
        if (s != null)
        {
            if (s.EstadoSolicitud?.Nombre == "Finalizada")
            {
                ToastService.ShowWarning("No se puede editar una solicitud finalizada. Reábrala desde el detalle de su cobro.", "Solicitud finalizada");
                return;
            }
            IsFormModalOpen = true;
            ModalTitle = "Editar Solicitud";
            ModalSub = "Modifique los datos de la solicitud.";
            FormCliente = s.Cliente?.Nombre ?? "";
            FormServicioId = s.ServicioId;
            FormDireccion = s.Direccion;
            FormId = s.Id;
        }
    }

    private void ConfirmarEliminar(int id)
    {
        if (!PuedeEliminarSolicitud(id))
        {
            ToastService.ShowWarning("No se puede eliminar una solicitud en proceso, en espera de administración o finalizada.", "Atención");
            return;
        }

        DeleteId = id;
        DeleteIds = [id];
        IsDeleteModalOpen = true;
    }

    private bool PuedeEliminarSolicitud(int id) =>
        solicitudes.FirstOrDefault(s => s.Id == id)?.EstadoSolicitud?.Nombre is not ("En proceso" or "En Espera Administración" or "Finalizada");

    private async Task EjecutarEliminar()
    {
        if (DeleteIds.Count > 0)
        {
            var resultado = await SolicitudService.EliminarVarios(DeleteIds);
            if (resultado)
            {
                AppState.NotifyStateChanged();
                ToastService.ShowSuccess(DeleteIds.Count == 1 ? "Solicitud eliminada correctamente." : $"{DeleteIds.Count} solicitudes eliminadas correctamente.");
                await CargarDatos();
                Seleccionadas.Clear();
                ModoSeleccion = false;
            }
            else
            {
                ToastService.ShowWarning("No se pudo eliminar. Las solicitudes En proceso o En Espera Administración están protegidas.", "Atención");
            }
        }
        IsDeleteModalOpen = false;
        IsFormModalOpen = false;
        DeleteId = null;
        DeleteIds.Clear();
    }

    private void CerrarEliminar()
    {
        IsDeleteModalOpen = false;
        DeleteId = null;
        DeleteIds.Clear();
    }

    private void VerDetalle(int id)
    {
        SelectedSolicitud = solicitudes.FirstOrDefault(s => s.Id == id);
        IsDetalleModalOpen = SelectedSolicitud != null;
    }

    private void CerrarDetalle()
    {
        IsDetalleModalOpen = false;
        SelectedSolicitud = null;
    }

    private void CloseModal()
    {
        IsFormModalOpen = false;
    }

    private async Task SaveModal()
    {
        if (string.IsNullOrWhiteSpace(FormCliente) || FormServicioId <= 0 || string.IsNullOrWhiteSpace(FormDireccion))
        {
            ToastService.ShowWarning("Por favor complete los campos requeridos.", "Atención");
            return;
        }

        var clienteEntity = clientes.FirstOrDefault(c => c.Nombre == FormCliente);
        var servicioEntity = ServiciosDelFormulario.FirstOrDefault(serv => serv.Id == FormServicioId);

        if (clienteEntity == null || servicioEntity == null)
        {
            ToastService.ShowWarning("Por favor seleccione un cliente y tipo de servicio válidos.", "Atención");
            return;
        }

        if (FormId.HasValue)
        {
            var s = solicitudes.FirstOrDefault(x => x.Id == FormId.Value);
            if (s != null)
            {
                s.ClienteId = clienteEntity.Id;
                s.Contacto = clienteEntity.Nombre;
                s.ServicioId = servicioEntity.Id;
                s.Direccion = FormDireccion;
                var resultado = await SolicitudService.Guardar(s);
                if (resultado) ToastService.ShowSuccess("Solicitud actualizada correctamente.");
                else ToastService.ShowError("Error al actualizar la solicitud.");
            }
        }
        else
        {
            var s = new ElectroGestion.Models.Solicitud
            {
                ClienteId = clienteEntity.Id,
                ServicioId = servicioEntity.Id,
                Contacto = clienteEntity.Nombre,
                Direccion = FormDireccion,
                FechaSolicitud = DateTime.Today,
                EstadoSolicitudId = 1
            };
            
            var resultado = await SolicitudService.Guardar(s);
            if (resultado)
            {
                clienteEntity.Servicios++;
                clienteEntity.Ultimo = servicioEntity.Nombre;
                await ClienteService.Guardar(clienteEntity);
                ToastService.ShowSuccess("Solicitud registrada correctamente.");
            }
            else
            {
                ToastService.ShowError("Error al registrar la solicitud.");
            }
        }
        
        IsFormModalOpen = false;
        await CargarDatos();
    }
}
