    </div>
}

@if (showReactivar)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9999">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:400px;padding:24px;box-shadow:0 10px 25px rgba(0,0,0,0.1)">
            <h2 style="margin:0 0 12px;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">Reactivar visita</h2>
            <p style="margin:0 0 24px;color:#4A4E63;font-size:14.5px;line-height:1.4">
                ¿Confirmas reactivar la visita de <strong>@Detalle?.Cliente</strong>?<br/>
                El estado del servicio pasará a En proceso.
            </p>

            <div style="display:flex;justify-content:flex-end;gap:12px">
                <button @onclick="CloseModals" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cancelar</button>
                <button @onclick="ConfirmarReactivar" style="padding:10px 18px;border:none;background:#17803D;color:#fff;border-radius:8px;font-weight:700;cursor:pointer">Sí, reactivar</button>
            </div>
        </div>
    </div>
}
@code {
    private string VistaActual = "Hoy";
    private string AgendaRango = "";

    private bool showNuevaVisita = false;
    private bool showEditarVisita = false;
    private bool showCancelar = false;
    private bool showReactivar = false;
    private bool showEliminar = false;
    private bool showDatePicker = false;
    private int? FormVisitaId;
    private int? FormSolicitudId;
    private int? FormTecnicoId;
    private int? TecnicoFiltroId;
    private DateTime FormFecha = DateTime.Today;
    private DateTime MesCalendario = DateTime.Today;
    private TimeOnly? FormHora;
    private TimeOnly? FormHoraFin;

    private List<string> DiasSemana = new() { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb" };
    private List<string> HorasSem = new() { "08 AM", "09 AM", "10 AM", "11 AM", "12 PM", "01 PM", "02 PM", "03 PM", "04 PM", "05 PM", "06 PM" };

    public class Evento
    {
        public int Id { get; set; }
        public int SolicitudId { get; set; }
        public int Top { get; set; }
        public int H { get; set; }
        public string Bg { get; set; } = "";
        public string Line { get; set; } = "";
        public string Hora { get; set; } = "";
        public string Cliente { get; set; } = "";
        public string TipoServicio { get; set; } = "";
        public string Tecnico { get; set; } = "Sin asignar";
        public string Direccion { get; set; } = "";
        public string Estado { get; set; } = "";
        public string Fg { get; set; } = "";
        public string Fecha { get; set; } = "";
        public string Rango { get; set; } = "";
        public string Corto { get; set; } = "";
    }

    public class DiaSemana
    {
        public string Dia { get; set; } = "";
        public string Num { get; set; } = "";
        public string PillBg { get; set; } = "transparent";
        public string NumColor { get; set; } = "#4A4E63";
        public string ColBg { get; set; } = "transparent";
        public List<Evento> Eventos { get; set; } = new();
    }

    public class DiaMes
    {
        public string Num { get; set; } = "";
        public string NumColor { get; set; } = "#4A4E63";
        public string Bg { get; set; } = "#fff";
        public string Border { get; set; } = "#E3E5EE";
        public List<Evento> Eventos { get; set; } = new();
    }

    private List<DiaSemana> Semana = new();
    private List<DiaMes> Mes = new();
    private List<Evento> DiariaEventos = new();
    private Evento? Detalle;
    private List<ElectroGestion.Models.Solicitud> solicitudes = new();
    private List<ElectroGestion.Models.Visita> visitas = new();
    private List<ElectroGestion.Models.Usuario> tecnicos = new();

    private IEnumerable<ElectroGestion.Models.Solicitud> SolicitudesDisponibles =>
        solicitudes.Where(s => s.Id == FormSolicitudId ||
            !visitas.Any(v => v.SolicitudId == s.Id));

    private string TecnicoActualNombre => AppState.Session?.Nombre ?? "Sin asignar";

    private string TecnicoFormularioNombre =>
        tecnicos.FirstOrDefault(t => t.Id == FormTecnicoId)?.Nombre ?? "Sin asignar";

    private bool EsDomingoSeleccionado => FormFecha.DayOfWeek == DayOfWeek.Sunday;

    private string ErrorHorario
    {
        get
        {
            if (FormHora is { } inicio &&
                (inicio < new TimeOnly(8, 0) || inicio > new TimeOnly(18, 0)))
            {
                return "La hora de inicio debe estar entre las 08:00 a. m. y las 06:00 p. m.";
            }

            if (FormHoraFin is { } fin &&
                (fin < new TimeOnly(8, 0) || fin > new TimeOnly(18, 0)))
            {
                return "La hora de fin debe estar entre las 08:00 a. m. y las 06:00 p. m.";
            }

            if (FormHora is { } horaInicio && FormHoraFin is { } horaFin && horaFin <= horaInicio)
            {
                return "La hora de fin debe ser posterior a la hora de inicio.";
            }

            return "";
        }
    }

    private IEnumerable<DateTime> DiasCalendario
    {
        get
        {
            var primerDia = new DateTime(MesCalendario.Year, MesCalendario.Month, 1);
            var inicio = primerDia.AddDays(-((int)primerDia.DayOfWeek + 6) % 7);
            return Enumerable.Range(0, 36)
                .Select(i => inicio.AddDays((i / 6 * 7) + i % 6));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += OnStateChanged;
        await UpdateData();
        
        if (VistaActual == "Hoy")
        {
            Detalle = DiariaEventos.FirstOrDefault();
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await UpdateData();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnVistaActualChanged(ChangeEventArgs e)
    {
        VistaActual = e.Value?.ToString() ?? "Semanal";
        await UpdateData();
    }

    private async Task OnTecnicoFiltroChanged(ChangeEventArgs e)
    {
        TecnicoFiltroId = int.TryParse(e.Value?.ToString(), out var tecnicoId)
            ? tecnicoId
            : null;
        await UpdateData();
    }

    private async Task UpdateData()
    {
        solicitudes = await SolicitudService.GetList(s => true);
        visitas = await VisitaService.ObtenerTodasAsync();
        tecnicos = await VisitaService.ObtenerTecnicosAsync();
        var hoyD = DateTime.Today;
        var hoyStr = hoyD.ToString("yyyy-MM-dd");

        var MES = new[] { "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre" };

        var visibles = visitas
            .Where(v => !TecnicoFiltroId.HasValue || v.TecnicoId == TecnicoFiltroId.Value)
            .Where(v => v.Fecha.DayOfWeek != DayOfWeek.Sunday)
            .Where(v => v.Fecha != DateTime.MinValue && TimeOnly.TryParse(v.Hora, out _))
            .ToList();

        var lunes = hoyD.AddDays(-((int)hoyD.DayOfWeek == 0 ? 6 : (int)hoyD.DayOfWeek - 1));
        var finSem = lunes.AddDays(5);

        if (VistaActual == "Semanal")
        {
            AgendaRango = $"{lunes.Day} - {finSem.Day} de {MES[finSem.Month - 1]} {finSem.Year}";
        }
        else if (VistaActual == "Mensual")
        {
            AgendaRango = char.ToUpper(MES[hoyD.Month - 1][0]) + MES[hoyD.Month - 1].Substring(1) + " " + hoyD.Year;
        }
        else
        {
            AgendaRango = AppStateService.FormatFechaLarga(hoyStr);
        }

        Semana.Clear();
        for (int i = 0; i < 6; i++)
        {
            var d = lunes.AddDays(i);
            var f = d.ToString("yyyy-MM-dd");
            var esHoy = f == hoyStr;

            var evs = visibles
                .Where(v => v.Fecha.ToString("yyyy-MM-dd") == f)
                .OrderBy(v => v.Hora)
                .Select(v =>
                {
                    var hora = TimeOnly.Parse(v.Hora);
                    var top = Math.Max(0, (int)((hora.Hour - 8) * 45 + (hora.Minute / 60.0) * 45 + 1));
                    return CrearEvento(v, top, 58);
                })
                .ToList();

            Semana.Add(new DiaSemana {
                Dia = DiasSemana[i],
                Num = d.Day.ToString(),
                ColBg = esHoy ? "#FBFBFF" : "transparent",
                PillBg = esHoy ? "#EDEBFF" : "transparent",
                NumColor = esHoy ? "#1D4ED8" : "#4A4E63",
                Eventos = evs
            });
        }

        var prim = new DateTime(hoyD.Year, hoyD.Month, 1);
        var ini = prim.AddDays(-((int)prim.DayOfWeek == 0 ? 6 : (int)prim.DayOfWeek - 1));
        
        Mes.Clear();
        for (int i = 0; i < 36; i++)
        {
            var d = ini.AddDays((i / 6 * 7) + i % 6);
            var f = d.ToString("yyyy-MM-dd");
            var esHoy = f == hoyStr;
            var otro = d.Month != hoyD.Month;

            var evs = visibles
                .Where(v => v.Fecha.ToString("yyyy-MM-dd") == f)
                .OrderBy(v => v.Hora)
                .Select(v => CrearEvento(v))
                .ToList();

            Mes.Add(new DiaMes {
                Num = d.Day.ToString(),
                Bg = esHoy ? "#F5F4FF" : (otro ? "#FAFAFC" : "#fff"),
                Border = esHoy ? "#C9C3F5" : "#EFF0F6",
                NumColor = esHoy ? "#1D4ED8" : (otro ? "#C0C4D2" : "#14162B"),
                Eventos = evs
            });
        }

        DiariaEventos = hoyD.DayOfWeek == DayOfWeek.Sunday
            ? new List<Evento>()
            : visibles
                .Where(v => v.Fecha.ToString("yyyy-MM-dd") == hoyStr)
                .Select(v =>
            {
                var hora = TimeOnly.Parse(v.Hora);
                var top = Math.Max(0, (int)((hora.Hour - 8) * 64 + (hora.Minute / 60.0) * 64 + 2));
                return CrearEvento(v, top, (int)(150 / 60.0 * 64 - 6), larga: false);
            })
            .ToList();
    }

    private Evento CrearEvento(ElectroGestion.Models.Visita visita, int top = 0, int alto = 58, bool larga = true)
    {
        var hora = TimeOnly.Parse(visita.Hora);
        var estado = visita.Estado;
        var cancelada = estado == "Cancelada";
        var finalizada = estado == "Finalizada";
        var colores = AppStateService.GetBadgeColors(estado);
        var horaFormato = AppStateService.FormatHora12(visita.Hora);

        return new Evento
        {
            Id = visita.Id,
            SolicitudId = visita.SolicitudId,
            Top = top,
            H = alto,
            Bg = cancelada ? "#FDE9EA" : (finalizada ? "#E4F6EA" : "#EAF3EC"),
            Line = cancelada ? "#E11B22" : (finalizada ? "#17803D" : "#4E9A63"),
            Hora = horaFormato,
            Cliente = visita.Solicitud?.Cliente?.Nombre ?? "",
            TipoServicio = visita.Solicitud?.Servicio?.Nombre ?? "",
            Tecnico = visita.Tecnico?.Nombre ?? "Sin asignar",
            Direccion = visita.Solicitud?.Direccion ?? "",
            Estado = estado,
            Fg = colores.Fg,
            Fecha = larga
                ? AppStateService.FormatFechaLarga(visita.Fecha.ToString("yyyy-MM-dd"))
                : AppStateService.FormatFecha(visita.Fecha.ToString("yyyy-MM-dd")),
            Rango = horaFormato + " - " + AppStateService.FormatHora12(visita.HoraFin),
            Corto = (horaFormato.Length > 5 ? horaFormato[..5] : horaFormato) + " " + (visita.Solicitud?.Cliente?.Nombre ?? "")
        };
    }

    private string DireccionSeleccionada =>
        solicitudes.FirstOrDefault(s => s.Id == FormSolicitudId)?.Direccion ?? "";

    private static string TextoSolicitud(ElectroGestion.Models.Solicitud solicitud) =>
        $"#{solicitud.Id:D4} - {solicitud.Cliente?.Nombre} - {solicitud.Servicio?.Nombre}";

    private void OnSolicitudChanged(ChangeEventArgs args)
    {
        FormSolicitudId = int.TryParse(args.Value?.ToString(), out var solicitudId)
            ? solicitudId
            : null;
    }

    private void SelectEvent(Evento ev) => Detalle = ev;

    private void ClearDetalle() => Detalle = null;

    private async Task OpenNuevaVisitaModal()
    {
        await UpdateData();
        FormVisitaId = null;
        FormSolicitudId = null;
        FormTecnicoId = AppState.EsGerente ? null : AppState.Session?.Id;
        FormFecha = DateTime.Today;
        MesCalendario = new DateTime(FormFecha.Year, FormFecha.Month, 1);
        FormHora = null;
        FormHoraFin = null;
        showDatePicker = false;
        showNuevaVisita = true;
    }

    private async Task OpenEditarVisitaModal()
    {
        if (Detalle is null)
        {
            return;
        }

        await UpdateData();
        var visita = visitas.FirstOrDefault(v => v.Id == Detalle.Id);
        if (visita is null)
        {
            ToastService.ShowError("No se encontró la visita que deseas editar.");
            return;
        }

        FormVisitaId = visita.Id;
        FormSolicitudId = visita.SolicitudId;
        FormTecnicoId = visita.TecnicoId;
        FormFecha = visita.Fecha;
        MesCalendario = new DateTime(FormFecha.Year, FormFecha.Month, 1);
        FormHora = TimeOnly.TryParse(visita.Hora, out var hora) ? hora : null;
        FormHoraFin = TimeOnly.TryParse(visita.HoraFin, out var horaFin) ? horaFin : null;
        showDatePicker = false;
        showEditarVisita = true;
    }

    private void ToggleDatePicker() => showDatePicker = !showDatePicker;

    private void CambiarMesCalendario(int diferencia)
    {
        MesCalendario = MesCalendario.AddMonths(diferencia);
    }

    private void SeleccionarFecha(DateTime fecha)
    {
        FormFecha = fecha.Date;
        showDatePicker = false;
    }

    private void OpenCancelarModal() => showCancelar = true;
    private void OpenReactivarModal() => showReactivar = true;
    private void OpenEliminarModal() => showEliminar = true;

    private void CloseModals()
    {
        showNuevaVisita = false;
        showEditarVisita = false;
        showCancelar = false;
        showReactivar = false;
        showEliminar = false;
        FormVisitaId = null;
    }

    private async Task GuardarVisitaAsync()
    {
        var solicitud = solicitudes.FirstOrDefault(s => s.Id == FormSolicitudId);
        if (solicitud is null || FormFecha == DateTime.MinValue ||
            !FormHora.HasValue || !FormHoraFin.HasValue || !string.IsNullOrEmpty(ErrorHorario))
        {
            ToastService.ShowWarning("Seleccione una solicitud e indique una fecha y hora válidas.", "Atención");
            return;
        }

        if (EsDomingoSeleccionado)
        {
            ToastService.ShowWarning("No se pueden programar visitas los domingos.", "Atención");
            return;
        }

        var existente = FormVisitaId.HasValue
            ? visitas.FirstOrDefault(v => v.Id == FormVisitaId.Value)
            : null;
        if ((existente is null || existente.SolicitudId != solicitud.Id) &&
            !await VisitaService.SolicitudDisponibleAsync(solicitud.Id, FormVisitaId))
        {
            ToastService.ShowWarning("La solicitud seleccionada ya tiene una visita asignada.", "Atención");
            return;
        }

        if (!await VisitaService.HorarioDisponibleAsync(
                FormFecha,
                FormHora.Value.ToString("HH:mm"),
                FormHoraFin.Value.ToString("HH:mm"),
                FormVisitaId))
        {
            ToastService.ShowWarning("Ya existe una visita programada en esa fecha y hora.", "Atención");
            return;
        }

        var visita = new ElectroGestion.Models.Visita
        {
            Id = FormVisitaId ?? 0,
            SolicitudId = solicitud.Id,
            TecnicoId = AppState.EsGerente
                ? FormTecnicoId
                : existente is null ? AppState.Session?.Id : existente.TecnicoId,
            Fecha = FormFecha.Date,
            Hora = FormHora.Value.ToString("HH:mm"),
            HoraFin = FormHoraFin.Value.ToString("HH:mm"),
            Estado = existente is not null && existente.SolicitudId == solicitud.Id
                ? existente.Estado
                : solicitud.EstadoSolicitud?.Nombre ?? "Pendiente"
        };

        try
        {
            if (!await VisitaService.GuardarAsync(visita))
            {
                ToastService.ShowWarning("No se pudo guardar: revise la solicitud, el técnico y que el horario esté libre.", "Atención");
                return;
            }

            await UpdateData();
            var guardada = visitas.First(v => v.Id == visita.Id);
            Detalle = CrearEvento(guardada);
            ToastService.ShowSuccess(FormVisitaId.HasValue
                ? "Visita actualizada correctamente."
                : "Visita programada correctamente.");
            CloseModals();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo guardar la visita de la solicitud {SolicitudId}.", solicitud.Id);
            ToastService.ShowError("Ocurrió un error al guardar la visita.");
        }
    }

    private async Task ConfirmarCancelar()
    {
        await CambiarEstadoVisitaAsync("Cancelada", "cancelar");
    }

    private async Task ConfirmarReactivar()
    {
        await CambiarEstadoVisitaAsync("En proceso", "reactivar");
    }

    private async Task CambiarEstadoVisitaAsync(string estado, string accion)
    {
        if (Detalle is null)
        {
            return;
        }

        try
        {
            if (!await VisitaService.CambiarEstadoAsync(Detalle.Id, estado))
            {
                ToastService.ShowError("No se encontró la visita para actualizar su estado.");
                return;
            }

            await UpdateData();
            Detalle = CrearEvento(visitas.First(v => v.Id == Detalle.Id));
            ToastService.ShowSuccess(accion == "cancelar"
                ? "Visita cancelada correctamente."
                : "Visita reactivada correctamente.");
            CloseModals();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo {Accion} la visita {VisitaId}.", accion, Detalle.Id);
            ToastService.ShowError("Ocurrió un error al actualizar la visita.");
        }
    }

    private async Task ConfirmarEliminarAsync()
    {
        if (Detalle is null)
        {
            return;
        }

        var visitaId = Detalle.Id;
        try
        {
            if (!await VisitaService.EliminarAsync(visitaId))
            {
                ToastService.ShowError("No se encontró la visita para eliminarla.");
                return;
            }

            await UpdateData();
            Detalle = null;
            ToastService.ShowSuccess("Visita eliminada correctamente.");
            CloseModals();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo eliminar la visita {VisitaId}.", visitaId);
            ToastService.ShowError("Ocurrió un error al eliminar la visita.");
        }
    }
}
