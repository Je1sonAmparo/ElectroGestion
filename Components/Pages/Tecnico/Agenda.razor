@page "/agenda"
@using System.Globalization
@implements IDisposable
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.SolicitudService SolicitudService
@inject ElectroGestion.Services.VisitaService VisitaService
@inject BlazorBootstrap.ToastService ToastService
@inject ILogger<Agenda> Logger
@inject NavigationManager NavManager

<PageTitle>Agenda | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div style="display:flex;align-items:flex-start;">
        <div>
            <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Agenda</div>
            <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Visitas programadas y su ubicación.</div>
        </div>
    </div>
    <button @onclick="OpenNuevaVisitaModal" style="background:#1D4ED8;color:#fff;border:none;padding:10px 18px;border-radius:8px;font-size:13.5px;font-weight:700;cursor:pointer">+ Nueva visita</button>
</div>

<div style="display:grid;grid-template-columns:1.55fr 1fr;gap:16px;align-items:start">
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:20px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:16px">
            <div style="display:flex;align-items:center;gap:8px">
                <select value="@VistaActual" @onchange="OnVistaActualChanged" style="padding:9px 14px;border:1px solid #D5D8E6;border-radius:9px;font-weight:700;font-size:13.5px;background:#fff;color:#14162B;cursor:pointer">
                    <option value="Hoy">Hoy</option>
                    <option value="Semanal">Semanal</option>
                    <option value="Mensual">Mensual</option>
                </select>
                <select value="@TecnicoFiltroId" @onchange="OnTecnicoFiltroChanged" aria-label="Filtrar agenda por técnico" style="padding:9px 14px;border:1px solid #D5D8E6;border-radius:9px;font-weight:700;font-size:13.5px;background:#fff;color:#14162B;cursor:pointer">
                    <option value="">Todos los técnicos</option>
                    @foreach (var tecnico in tecnicos)
                    {
                        <option value="@tecnico.Id">@tecnico.Nombre</option>
                    }
                </select>
            </div>
            <div style="color:#6B7085;font-size:13.5px">@AgendaRango</div>
        </div>

        @if (VistaActual == "Semanal")
        {
            <div>
                <div style="display:grid;grid-template-columns:56px repeat(6,1fr);border-bottom:1px solid #E3E5EE">
                    <div></div>
                    @foreach (var d in Semana)
                    {
                        <div style="text-align:center;padding:6px 0 12px;min-width:0">
                            <div style="font-size:11px;font-weight:800;color:#8B90A3;text-transform:uppercase;letter-spacing:.07em">@d.Dia</div>
                            <div style="margin:7px auto 0;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Manrope';font-weight:800;font-size:15px;background:@d.PillBg;color:@d.NumColor">@d.Num</div>
                        </div>
                    }
                </div>
                <div style="display:grid;grid-template-columns:56px repeat(6,1fr);position:relative">
                    <div>
                        @foreach (var h in HorasSem)
                        {
                            <div style="height:45px;font-size:11px;font-weight:700;color:#8B90A3;text-align:right;padding-right:9px;transform:translateY(-6px)">@h</div>
                        }
                    </div>
                    @foreach (var d in Semana)
                    {
                        <div style="position:relative;border-left:1px solid #EFF0F6;background:@d.ColBg;min-width:0">
                            @foreach (var h in HorasSem)
                            {
                                <div style="height:45px;border-bottom:1px solid #F4F5FB"></div>
                            }
                            @foreach (var ev in d.Eventos)
                            {
                                <div @onclick="() => SelectEvent(ev)" style="position:absolute;left:3px;right:3px;top:@(ev.Top)px;height:@(ev.H)px;background:@ev.Bg;border-left:3px solid @ev.Line;border-radius:6px;padding:4px 5px;cursor:pointer;overflow:hidden;min-width:0">
                                    <div style="font-size:10px;font-weight:800;color:#4A4E63;line-height:1.2">@ev.Hora</div>
                                    <div style="font-size:10.5px;font-weight:700;line-height:1.22;margin-top:1px;overflow-wrap:anywhere">@ev.Cliente</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (VistaActual == "Mensual")
        {
            <div>
                <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:6px;margin-bottom:6px">
                    @foreach (var ds in DiasSemana)
                    {
                        <div style="text-align:center;font-size:11px;font-weight:800;color:#8B90A3;text-transform:uppercase;letter-spacing:.06em;padding:4px 0">@ds</div>
                    }
                </div>
                <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:6px">
                    @foreach (var d in Mes)
                    {
                        <div style="background:@d.Bg;border:1px solid @d.Border;border-radius:9px;min-height:92px;min-width:0;padding:7px 8px;display:flex;flex-direction:column;gap:4px">
                            <div style="font-size:12.5px;font-weight:800;color:@d.NumColor">@d.Num</div>
                            @foreach (var ev in d.Eventos)
                            {
                                <div @onclick="() => SelectEvent(ev)" style="background:@ev.Bg;border-left:3px solid @ev.Line;border-radius:5px;padding:3px 5px;cursor:pointer;font-size:10.5px;font-weight:700;white-space:nowrap;min-width:0;overflow:hidden;text-overflow:ellipsis">@ev.Corto</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (VistaActual == "Hoy")
        {
            @if (DateTime.Today.DayOfWeek == DayOfWeek.Sunday)
            {
                <div style="color:#8B90A3;font-size:14px;text-align:center;padding:40px 10px">La agenda no está disponible los domingos.</div>
            }
            else
            {
                <div style="position:relative">
                    @foreach (var h in HorasSem)
                    {
                        <div style="display:flex;gap:12px;height:64px;border-top:1px solid #F0F1F7">
                            <div style="width:66px;flex:0 0 66px;font-size:12px;color:#8B90A3;font-weight:700;padding-top:4px">@h</div>
                        </div>
                    }
                    @foreach (var ev in DiariaEventos)
                    {
                        <div @onclick="() => SelectEvent(ev)" style="position:absolute;left:78px;right:6px;top:@(ev.Top)px;height:@(ev.H)px;background:@ev.Bg;border-left:4px solid @ev.Line;border-radius:9px;padding:11px 13px;cursor:pointer;overflow:hidden">
                            <div style="font-weight:700;font-size:14px">@ev.Cliente</div>
                            <div style="font-size:12.5px;color:#4A4E63;margin-top:3px">@ev.TipoServicio</div>
                            <div style="font-size:12px;color:#6B7085;margin-top:2px">@ev.Rango</div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:20px">
        @if (Detalle != null)
        {
            <div>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
                    <div style="font-family:'Manrope';font-weight:800;font-size:18px">Detalle</div>
                    <button class="clear-btn" @onclick="ClearDetalle" style="width:28px;height:28px;border:1px solid #E3E5EE;background:#fff;border-radius:7px;cursor:pointer;color:#6B7085">✕</button>
                </div>
                <div style="display:flex;flex-direction:column;gap:15px;font-size:14.5px">
                    <div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Cliente</div>
                        <div style="font-weight:700;margin-top:3px">@Detalle.Cliente</div>
                    </div>
                    <div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Tipo de servicio</div>
                        <div style="margin-top:3px">@Detalle.TipoServicio</div>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px" class="resp-grid-2">
                        <div>
                            <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Fecha</div>
                            <div style="margin-top:3px">@Detalle.Fecha</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Hora</div>
                            <div style="margin-top:3px">@Detalle.Hora</div>
                        </div>
                    </div>
                    <div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Dirección</div>
                        <div style="margin-top:3px">@Detalle.Direccion</div>
                    </div>
                    <div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Técnico asignado</div>
                        <div style="margin-top:3px">@Detalle.Tecnico</div>
                    </div>
                    <div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:800;text-transform:uppercase;letter-spacing:.06em">Estado</div>
                        <div style="margin-top:5px">
                            <span style="display:inline-block;padding:5px 11px;border-radius:20px;font-size:12px;font-weight:800;background:@Detalle.Bg;color:@Detalle.Fg">@Detalle.Estado</span>
                        </div>
                    </div>
                </div>
                <div style="display:flex;flex-direction:column;gap:9px;margin-top:22px">
                    <button class="action-btn" style="padding:11px;border:1px solid #D5D8E6;background:#fff;border-radius:9px;font-size:13.5px;font-weight:700;cursor:pointer">Ver ubicación</button>
                    <button class="action-btn" @onclick="OpenEditarVisitaModal" style="padding:11px;border:1px solid #D5D8E6;background:#fff;border-radius:9px;font-size:13.5px;font-weight:700;cursor:pointer">Editar visita</button>
                    @if (Detalle.Estado == "Cancelada")
                    {
                        <button class="reactivate-btn" @onclick="OpenReactivarModal" style="padding:11px;border:1px solid #4E9A63;background:#fff;border-radius:9px;font-size:13.5px;font-weight:700;cursor:pointer;color:#17803D">Reactivar visita</button>
                    }
                    else
                    {
                        <button class="cancel-btn" @onclick="OpenCancelarModal" style="padding:11px;border:1px solid #F5C2C4;background:#fff;border-radius:9px;font-size:13.5px;font-weight:700;cursor:pointer;color:#C4141B">Cancelar visita</button>
                    }
                </div>
            </div>
        }
        else
        {
            <div style="color:#8B90A3;font-size:14px;text-align:center;padding:40px 10px">Selecciona una visita del calendario para ver su detalle.</div>
        }
    </div>
</div>

@if (showNuevaVisita)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9999">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:540px;padding:24px;box-shadow:0 10px 25px rgba(0,0,0,0.1)">
            <h2 style="margin:0 0 4px;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">Nueva visita</h2>
            <p style="margin:0 0 20px;color:#6B7085;font-size:14px">Asigna fecha y hora para la visita.</p>

            <div style="display:flex;flex-direction:column;gap:16px">
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Solicitud *</label>
                    <select value="@FormSolicitudId" @onchange="OnSolicitudChanged" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                        <option value="">Seleccionar solicitud...</option>
                        @foreach (var solicitud in SolicitudesDisponibles.OrderBy(s => s.Id))
                        {
                            <option value="@solicitud.Id">@TextoSolicitud(solicitud)</option>
                        }
                    </select>
                </div>
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Técnico asignado</label>
                    @if (AppState.EsGerente)
                    {
                        <select @bind="FormTecnicoId" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                            <option value="">Sin asignar</option>
                            @foreach (var tecnico in tecnicos)
                            {
                                <option value="@tecnico.Id">@tecnico.Nombre</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input value="@TecnicoActualNombre" readonly disabled style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#6B7085;background:#F7F8FC;opacity:1" />
                    }
                </div>
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Dirección</label>
                    <input value="@DireccionSeleccionada" readonly disabled style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#6B7085;background:#F7F8FC;opacity:1" />
                </div>
                <div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Fecha *</label>
                        <div style="position:relative">
                            <button type="button" @onclick="ToggleDatePicker" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff;text-align:left;cursor:pointer">
                                @FormFecha.ToString("yyyy-MM-dd") <span style="float:right">▾</span>
                            </button>
                            @if (showDatePicker)
                            {
                                <div style="position:absolute;top:calc(100% + 4px);left:0;width:280px;padding:14px;background:#fff;border:1px solid #D5D8E6;border-radius:10px;box-shadow:0 8px 24px rgba(20,22,43,.16);z-index:10000">
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
                                        <button type="button" @onclick="() => CambiarMesCalendario(-1)" aria-label="Mes anterior" style="border:0;background:#fff;font-size:18px;cursor:pointer">‹</button>
                                        <strong>@MesCalendario.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("es"))</strong>
                                        <button type="button" @onclick="() => CambiarMesCalendario(1)" aria-label="Mes siguiente" style="border:0;background:#fff;font-size:18px;cursor:pointer">›</button>
                                    </div>
                                    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:4px;text-align:center;font-size:11px;font-weight:700;color:#6B7085;margin-bottom:5px">
                                        @foreach (var dia in DiasSemana)
                                        {
                                            <span>@dia</span>
                                        }
                                    </div>
                                    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:4px;text-align:center">
                                        @foreach (var dia in DiasCalendario)
                                        {
                                            @if (dia.Month == MesCalendario.Month)
                                            {
                                                <button type="button" @onclick="() => SeleccionarFecha(dia)" style="height:32px;border:0;border-radius:50%;background:@(dia.Date == FormFecha.Date ? "#1D4ED8" : "transparent");color:@(dia.Date == FormFecha.Date ? "#fff" : "#14162B");cursor:pointer">@dia.Day</button>
                                            }
                                            else
                                            {
                                                <span style="height:32px"></span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Hora de inicio *</label>
                        <input type="time" @bind="FormHora" min="08:00" max="18:00" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Hora de fin *</label>
                        <input type="time" @bind="FormHoraFin" min="08:00" max="18:00" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(ErrorHorario))
                {
                    <div style="color:#C4141B;font-size:13px;font-weight:700">@ErrorHorario</div>
                }
                @if (EsDomingoSeleccionado)
                {
                    <div style="color:#C4141B;font-size:13px;font-weight:700">No se pueden programar visitas los domingos.</div>
                }

            </div>

            <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:24px">
                <button @onclick="CloseModals" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cancelar</button>
                <button @onclick="GuardarVisitaAsync" disabled="@EsDomingoSeleccionado" style="padding:10px 18px;border:none;background:@(EsDomingoSeleccionado ? "#9CA3AF" : "#1D4ED8");color:#fff;border-radius:8px;font-weight:700;cursor:@(EsDomingoSeleccionado ? "not-allowed" : "pointer")">Guardar visita</button>
            </div>
        </div>
    </div>
}

@if (showEditarVisita)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9999">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:540px;padding:24px;box-shadow:0 10px 25px rgba(0,0,0,0.1)">
            <h2 style="margin:0 0 4px;font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">Editar visita</h2>
            <p style="margin:0 0 20px;color:#6B7085;font-size:14px">Modifica los detalles de la visita seleccionada.</p>

            <div style="display:flex;flex-direction:column;gap:16px">
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Solicitud *</label>
                    <select value="@FormSolicitudId" @onchange="OnSolicitudChanged" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                        @foreach (var solicitud in SolicitudesDisponibles.OrderBy(s => s.Id))
                        {
                            <option value="@solicitud.Id">@TextoSolicitud(solicitud)</option>
                        }
                    </select>
                </div>
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Técnico asignado</label>
                    @if (AppState.EsGerente)
                    {
                        <select @bind="FormTecnicoId" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff">
                            <option value="">Sin asignar</option>
                            @foreach (var tecnico in tecnicos)
                            {
                                <option value="@tecnico.Id">@tecnico.Nombre</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input value="@TecnicoFormularioNombre" readonly disabled style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#6B7085;background:#F7F8FC;opacity:1" />
                    }
                </div>
                <div>
                    <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Dirección</label>
                    <input value="@DireccionSeleccionada" readonly disabled style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#6B7085;background:#F7F8FC;opacity:1" />
                </div>
                <div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Fecha *</label>
                        <div style="position:relative">
                            <button type="button" @onclick="ToggleDatePicker" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B;background:#fff;text-align:left;cursor:pointer">
                                @FormFecha.ToString("yyyy-MM-dd") <span style="float:right">▾</span>
                            </button>
                            @if (showDatePicker)
                            {
                                <div style="position:absolute;top:calc(100% + 4px);left:0;width:280px;padding:14px;background:#fff;border:1px solid #D5D8E6;border-radius:10px;box-shadow:0 8px 24px rgba(20,22,43,.16);z-index:10000">
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
                                        <button type="button" @onclick="() => CambiarMesCalendario(-1)" aria-label="Mes anterior" style="border:0;background:#fff;font-size:18px;cursor:pointer">‹</button>
                                        <strong>@MesCalendario.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("es"))</strong>
                                        <button type="button" @onclick="() => CambiarMesCalendario(1)" aria-label="Mes siguiente" style="border:0;background:#fff;font-size:18px;cursor:pointer">›</button>
                                    </div>
                                    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:4px;text-align:center;font-size:11px;font-weight:700;color:#6B7085;margin-bottom:5px">
                                        @foreach (var dia in DiasSemana)
                                        {
                                            <span>@dia</span>
                                        }
                                    </div>
                                    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:4px;text-align:center">
                                        @foreach (var dia in DiasCalendario)
                                        {
                                            @if (dia.Month == MesCalendario.Month)
                                            {
                                                <button type="button" @onclick="() => SeleccionarFecha(dia)" style="height:32px;border:0;border-radius:50%;background:@(dia.Date == FormFecha.Date ? "#1D4ED8" : "transparent");color:@(dia.Date == FormFecha.Date ? "#fff" : "#14162B");cursor:pointer">@dia.Day</button>
                                            }
                                            else
                                            {
                                                <span style="height:32px"></span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Hora de inicio *</label>
                        <input type="time" @bind="FormHora" min="08:00" max="18:00" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Hora de fin *</label>
                        <input type="time" @bind="FormHoraFin" min="08:00" max="18:00" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(ErrorHorario))
                {
                    <div style="color:#C4141B;font-size:13px;font-weight:700">@ErrorHorario</div>
                }
                @if (EsDomingoSeleccionado)
                {
                    <div style="color:#C4141B;font-size:13px;font-weight:700">No se pueden programar visitas los domingos.</div>
                }

            </div>

            <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:24px">
                <button @onclick="OpenEliminarModal" style="padding:10px 18px;border:1px solid #F5C2C4;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#C4141B">Eliminar visita</button>
                <button @onclick="CloseModals" style="padding:10px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer;color:#14162B">Cancelar</button>
                <button @onclick="GuardarVisitaAsync" disabled="@EsDomingoSeleccionado" style="padding:10px 18px;border:none;background:@(EsDomingoSeleccionado ? "#9CA3AF" : "#1D4ED8");color:#fff;border-radius:8px;font-weight:700;cursor:@(EsDomingoSeleccionado ? "not-allowed" : "pointer")">Guardar cambios</button>
            </div>
        </div>
    </div>
}

@if (showEliminar)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9999">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:400px;padding:24px;box-shadow:0 10px 25px rgba(0,0,0,0.1)">
