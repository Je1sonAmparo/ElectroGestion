                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#14162B;margin-bottom:6px">Hora de inicio *</label>
                        <input type="time" @bind="FormHora" min="08:00" max="18:00" style="width:100%;padding:10px 14px;border:1px solid #D5D8E6;border-radius:8px;font-size:14px;color:#14162B" />
