@code {
    private string VistaActual = "Hoy";
    private string AgendaRango = "";
    private DateTime FechaCalendario = DateTime.Today;

    private bool showNuevaVisita = false;
    private bool showEditarVisita = false;
    private bool showCancelar = false;
    private bool showReactivar = false;
    private bool showEliminar = false;
    private int? FormVisitaId;
    private int? FormSolicitudId;
    private int? FormTecnicoId;
    private int? TecnicoFiltroId;
    private string SolicitudIdFiltro = "";
    private DateTime FormFecha = DateTime.Today;
    private TimeOnly? FormHora;
    private TimeOnly? FormHoraFin;

    private List<string> DiasSemana = new() { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb" };
    private List<string> HorasSem = new() { "08 AM", "09 AM", "10 AM", "11 AM", "12 PM", "01 PM", "02 PM", "03 PM", "04 PM", "05 PM", "06 PM" };

    public class Evento
    {
        public int Id { get; set; }
        public int SolicitudId { get; set; }
        public int Top { get; set; }
        public int H { get; set; }
        public string Bg { get; set; } = "";
        public string Line { get; set; } = "";
        public string Border { get; set; } = "#E3E5EE";
        public string BadgeBg { get; set; } = "#EDEBFF";
        public string BadgeFg { get; set; } = "#1D4ED8";
        public string Hora { get; set; } = "";
        public string Cliente { get; set; } = "";
        public string TipoServicio { get; set; } = "";
        public string HoraInicio { get; set; } = "";
        public string HoraFin { get; set; } = "";
        public string Tecnico { get; set; } = "Sin asignar";
        public string Direccion { get; set; } = "";
        public string Estado { get; set; } = "";
        public string Fg { get; set; } = "";
        public string Fecha { get; set; } = "";
        public string Rango { get; set; } = "";
        public string Corto { get; set; } = "";
        public double LeftPct { get; set; } = 0;
        public double WidthPct { get; set; } = 100;
        public int ColIndex { get; set; } = 0;
        public TimeOnly StartTime { get; set; }
        public TimeOnly EndTime { get; set; }
    }

    public class DiaSemana
    {
        public string Dia { get; set; } = "";
        public string Num { get; set; } = "";
        public string PillBg { get; set; } = "transparent";
        public string NumColor { get; set; } = "#4A4E63";
        public string ColBg { get; set; } = "transparent";
        public List<Evento> Eventos { get; set; } = new();
    }

    public class DiaMes
    {
        public string Num { get; set; } = "";
        public string NumColor { get; set; } = "#4A4E63";
        public string Bg { get; set; } = "#fff";
        public string Border { get; set; } = "#E3E5EE";
        public List<Evento> Eventos { get; set; } = new();
    }

    private List<DiaSemana> Semana = new();
    private List<DiaMes> Mes = new();
    private List<Evento> DiariaEventos = new();
    private Evento? Detalle;
    private List<ElectroGestion.Models.Solicitud> solicitudes = new();
    private List<ElectroGestion.Models.Visita> visitas = new();
    private List<ElectroGestion.Models.Usuario> tecnicos = new();

    private IEnumerable<ElectroGestion.Models.Solicitud> SolicitudesDisponibles =>
        solicitudes.Where(s => s.Id == FormSolicitudId ||
            !visitas.Any(v => v.SolicitudId == s.Id));

    private string TecnicoActualNombre => AppState.Session?.Nombre ?? "Sin asignar";

    private string TecnicoFormularioNombre =>
        tecnicos.FirstOrDefault(t => t.Id == FormTecnicoId)?.Nombre ?? "Sin asignar";

    private bool EsDomingoSeleccionado => FormFecha.DayOfWeek == DayOfWeek.Sunday;

    private string ErrorHorario
    {
        get
        {
            if (FormHora is { } inicio &&
                (inicio < new TimeOnly(8, 0) || inicio > new TimeOnly(18, 0)))
            {
                return "La hora de inicio debe estar entre las 08:00 a. m. y las 06:00 p. m.";
            }

            if (FormHoraFin is { } fin &&
                (fin < new TimeOnly(8, 0) || fin > new TimeOnly(18, 0)))
            {
                return "La hora de fin debe estar entre las 08:00 a. m. y las 06:00 p. m.";
            }

            if (FormHora is { } horaInicio && FormHoraFin is { } horaFin && horaFin <= horaInicio)
            {
                return "La hora de fin debe ser posterior a la hora de inicio.";
            }

            return "";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += OnStateChanged;
        await UpdateData();
        
        if (VistaActual == "Hoy")
        {
            Detalle = DiariaEventos.FirstOrDefault();
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await UpdateData();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnVistaActualChanged(ChangeEventArgs e)
    {
        VistaActual = e.Value?.ToString() ?? "Semanal";
        await UpdateData();
    }

    private async Task CambiarPeriodo(int direccion)
    {
        FechaCalendario = VistaActual switch
        {
            "Semanal" => FechaCalendario.AddDays(7 * direccion),
            "Mensual" => FechaCalendario.AddMonths(direccion),
            _ => CambiarDiaHabil(FechaCalendario, direccion)
        };

        await UpdateData();
    }

    private static DateTime CambiarDiaHabil(DateTime fecha, int direccion)
    {
        var siguiente = fecha.AddDays(direccion);
        while (siguiente.DayOfWeek == DayOfWeek.Sunday)
        {
            siguiente = siguiente.AddDays(direccion);
        }

        return siguiente;
    }

    private async Task OnTecnicoFiltroChanged(ChangeEventArgs e)
    {
        TecnicoFiltroId = int.TryParse(e.Value?.ToString(), out var tecnicoId)
            ? tecnicoId
            : null;
        await UpdateData();
    }

    private Task OnSolicitudIdFiltroChanged(ChangeEventArgs e)
    {
        SolicitudIdFiltro = e.Value?.ToString() ?? "";
        ConstruirAgenda();
        return Task.CompletedTask;
    }

    private async Task UpdateData()
    {
        solicitudes = await SolicitudService.GetList(s => true);
        visitas = await VisitaService.ObtenerTodasAsync();
        tecnicos = await VisitaService.ObtenerTecnicosAsync();
        ConstruirAgenda();
    }

    private void ConstruirAgenda()
    {
        var MES = new[] { "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre" };

        var visibles = visitas
            .Where(v => !TecnicoFiltroId.HasValue || v.TecnicoId == TecnicoFiltroId.Value)
            .Where(v => string.IsNullOrWhiteSpace(SolicitudIdFiltro) ||
                (int.TryParse(SolicitudIdFiltro.Trim(), out var solicitudId) && v.SolicitudId == solicitudId))
            .Where(v => v.Fecha.DayOfWeek != DayOfWeek.Sunday)
            .Where(v => v.Fecha != DateTime.MinValue && TimeOnly.TryParse(v.Hora, out _))
            .ToList();

        if (string.IsNullOrWhiteSpace(SolicitudIdFiltro))
        {
            if (Detalle is not null && !visibles.Any(v => v.Id == Detalle.Id))
            {
                Detalle = null;
            }
        }
        else if (int.TryParse(SolicitudIdFiltro.Trim(), out var solicitudId))
        {
            var visitaEncontrada = visibles
                .Where(v => v.SolicitudId == solicitudId)
                .OrderBy(v => v.Estado == "Cancelada")
                .ThenBy(v => v.Fecha)
                .ThenBy(v => v.Hora)
                .FirstOrDefault();

            if (visitaEncontrada is not null)
            {
                FechaCalendario = visitaEncontrada.Fecha.Date;
                Detalle = CrearEvento(visitaEncontrada);
            }
            else
            {
                Detalle = null;
            }
        }
        else
        {
            Detalle = null;
        }

        var fechaActual = FechaCalendario.Date;
        var fechaActualStr = fechaActual.ToString("yyyy-MM-dd");
        var lunes = fechaActual.AddDays(-((int)fechaActual.DayOfWeek == 0 ? 6 : (int)fechaActual.DayOfWeek - 1));
        var finSem = lunes.AddDays(5);

        if (VistaActual == "Semanal")
        {
            AgendaRango = $"{lunes.Day} - {finSem.Day} de {MES[finSem.Month - 1]} {finSem.Year}";
        }
        else if (VistaActual == "Mensual")
        {
            AgendaRango = char.ToUpper(MES[fechaActual.Month - 1][0]) + MES[fechaActual.Month - 1].Substring(1) + " " + fechaActual.Year;
        }
        else
        {
            AgendaRango = $"{ObtenerNombreDia(fechaActual.DayOfWeek)}, {AppStateService.FormatFechaLarga(fechaActualStr)}";
        }

        Semana.Clear();
        for (int i = 0; i < 6; i++)
        {
            var d = lunes.AddDays(i);
            var f = d.ToString("yyyy-MM-dd");
            var esHoy = f == fechaActualStr;

            var evs = visibles
                .Where(v => v.Fecha.ToString("yyyy-MM-dd") == f)
                .OrderBy(v => v.Hora)
                .Select(v =>
                {
                    var hora = TimeOnly.Parse(v.Hora);
                    var horaFin = TimeOnly.TryParse(v.HoraFin, out var hFin) ? hFin : hora.AddHours(1);
                    var duracionMin = Math.Max(30, (int)(horaFin - hora).TotalMinutes);
                    var top = Math.Max(0, (int)((hora.Hour - 8) * 45 + (hora.Minute / 60.0) * 45 + 1));
                    var alto = Math.Max(28, (int)(duracionMin / 60.0 * 45 - 2));
                    return CrearEvento(v, top, alto);
                })
                .ToList();

            CalcularDistribucionEventos(evs);

            Semana.Add(new DiaSemana {
                Dia = DiasSemana[i],
                Num = d.Day.ToString(),
                ColBg = esHoy ? "#FBFBFF" : "transparent",
                PillBg = esHoy ? "#EDEBFF" : "transparent",
                NumColor = esHoy ? "#1D4ED8" : "#4A4E63",
                Eventos = evs
            });
        }

        var prim = new DateTime(fechaActual.Year, fechaActual.Month, 1);
        var ini = prim.AddDays(-((int)prim.DayOfWeek == 0 ? 6 : (int)prim.DayOfWeek - 1));
        
        Mes.Clear();
        for (int i = 0; i < 36; i++)
        {
            var d = ini.AddDays((i / 6 * 7) + i % 6);
            var f = d.ToString("yyyy-MM-dd");
            var esHoy = f == fechaActualStr;
            var otro = d.Month != fechaActual.Month;

            var evs = visibles
                .Where(v => v.Fecha.ToString("yyyy-MM-dd") == f)
                .OrderBy(v => v.Hora)
                .Select(v => CrearEvento(v))
                .ToList();

            Mes.Add(new DiaMes {
                Num = d.Day.ToString(),
                Bg = esHoy ? "#F5F4FF" : (otro ? "#FAFAFC" : "#fff"),
                Border = esHoy ? "#C9C3F5" : "#EFF0F6",
                NumColor = esHoy ? "#1D4ED8" : (otro ? "#C0C4D2" : "#14162B"),
                Eventos = evs
            });
        }

        DiariaEventos = fechaActual.DayOfWeek == DayOfWeek.Sunday
            ? new List<Evento>()
            : visibles
                .Where(v => v.Fecha.ToString("yyyy-MM-dd") == fechaActualStr)
                .Select(v =>
            {
                var hora = TimeOnly.Parse(v.Hora);
                var horaFin = TimeOnly.TryParse(v.HoraFin, out var hFin) ? hFin : hora.AddHours(1);
                var duracionMin = Math.Max(30, (int)(horaFin - hora).TotalMinutes);
                var top = Math.Max(0, (int)((hora.Hour - 8) * 64 + (hora.Minute / 60.0) * 64 + 2));
                var alto = Math.Max(38, (int)(duracionMin / 60.0 * 64 - 4));
                return CrearEvento(v, top, alto, larga: false);
            })
            .ToList();

        CalcularDistribucionEventos(DiariaEventos);
    }

    private static void CalcularDistribucionEventos(List<Evento> eventos)
    {
        if (eventos.Count == 0) return;

        var ordenados = eventos.OrderBy(e => e.StartTime).ThenByDescending(e => e.EndTime).ToList();
        var clusters = new List<List<Evento>>();
        List<Evento>? clusterActual = null;
        TimeOnly clusterMaxEnd = TimeOnly.MinValue;

        foreach (var ev in ordenados)
        {
            if (clusterActual == null || ev.StartTime >= clusterMaxEnd)
            {
                clusterActual = new List<Evento> { ev };
                clusters.Add(clusterActual);
                clusterMaxEnd = ev.EndTime;
            }
            else
            {
                clusterActual.Add(ev);
                if (ev.EndTime > clusterMaxEnd)
                {
                    clusterMaxEnd = ev.EndTime;
                }
            }
        }

        foreach (var cluster in clusters)
        {
            var colEndTimes = new List<TimeOnly>();
            foreach (var ev in cluster)
            {
                int assignedCol = -1;
                for (int c = 0; c < colEndTimes.Count; c++)
                {
                    if (colEndTimes[c] <= ev.StartTime)
                    {
                        assignedCol = c;
                        colEndTimes[c] = ev.EndTime;
                        break;
                    }
                }

                if (assignedCol == -1)
                {
                    assignedCol = colEndTimes.Count;
                    colEndTimes.Add(ev.EndTime);
                }

                ev.ColIndex = assignedCol;
            }

            int totalCols = Math.Max(1, colEndTimes.Count);
            double widthPct = 100.0 / totalCols;
            foreach (var ev in cluster)
            {
                ev.WidthPct = widthPct;
                ev.LeftPct = ev.ColIndex * widthPct;
            }
        }
    }

    private static string ObtenerNombreDia(DayOfWeek dia) => dia switch
    {
        DayOfWeek.Monday => "Lunes",
        DayOfWeek.Tuesday => "Martes",
        DayOfWeek.Wednesday => "Miércoles",
        DayOfWeek.Thursday => "Jueves",
        DayOfWeek.Friday => "Viernes",
        DayOfWeek.Saturday => "Sábado",
        DayOfWeek.Sunday => "Domingo",
        _ => throw new ArgumentOutOfRangeException(nameof(dia))
    };

    private record ColorScheme(string Bg, string Line, string Border, string BadgeBg, string BadgeFg);

    private static readonly ColorScheme[] TechnicianPalettes = new[]
    {
        new ColorScheme("#EFF6FF", "#2563EB", "#BFDBFE", "#DBEAFE", "#1D4ED8"), // Blueberry
        new ColorScheme("#ECFDF5", "#059669", "#A7F3D0", "#D1FAE5", "#047857"), // Basil
        new ColorScheme("#F5F3FF", "#7C3AED", "#DDD6FE", "#EDE9FE", "#6D28D9"), // Grape
        new ColorScheme("#FFFBEB", "#D97706", "#FDE68A", "#FEF3C7", "#B45309"), // Tangerine
        new ColorScheme("#FFF1F2", "#E11D48", "#FECDD3", "#FFE4E6", "#BE123C"), // Flamingo
        new ColorScheme("#ECFEFF", "#0891B2", "#A5F3FC", "#CFFAFE", "#0E7490"), // Peacock
        new ColorScheme("#EEF2FF", "#4F46E5", "#C7D2FE", "#E0E7FF", "#3730A3")  // Indigo
    };

    private static ColorScheme GetEventColorScheme(string estado, int? tecnicoId, string? tecnicoNombre)
    {
        if (estado == "Pendiente")
        {
            return new ColorScheme("#FFFBEB", "#D97706", "#FDE68A", "#F7E7C9", "#B57A00");
        }
        if (estado == "Cancelada")
        {
            return new ColorScheme("#FEF2F2", "#EF4444", "#FCA5A5", "#FEE2E2", "#991B1B");
        }
        if (estado == "Finalizada")
        {
            return new ColorScheme("#F0FDF4", "#16A34A", "#86EFAC", "#DCFCE7", "#166534");
        }

        var nombre = (tecnicoNombre ?? "").ToLowerInvariant();
        if (nombre.Contains("carlos") || tecnicoId == 2)
        {
            return TechnicianPalettes[0];
        }
        if (nombre.Contains("luis") || tecnicoId == 3)
        {
            return TechnicianPalettes[1];
        }
        if (tecnicoId.HasValue)
        {
            var idx = Math.Abs(tecnicoId.Value) % TechnicianPalettes.Length;
            return TechnicianPalettes[idx];
        }

        return TechnicianPalettes[3];
    }

    private Evento CrearEvento(ElectroGestion.Models.Visita visita, int top = 0, int alto = 58, bool larga = true)
    {
        var hIni = TimeOnly.TryParse(visita.Hora, out var hi) ? hi : new TimeOnly(8, 0);
        var hFin = TimeOnly.TryParse(visita.HoraFin, out var hf) ? hf : hIni.AddHours(1);
        var estado = visita.Estado;
        var horaFormato = AppStateService.FormatHora12(visita.Hora);
        var tecNombre = visita.Tecnico?.Nombre ?? "Sin asignar";
        var scheme = GetEventColorScheme(estado, visita.TecnicoId, tecNombre);

        return new Evento
        {
            Id = visita.Id,
            SolicitudId = visita.SolicitudId,
            Top = top,
            H = alto,
            Bg = scheme.Bg,
            Line = scheme.Line,
            Border = scheme.Border,
            BadgeBg = scheme.BadgeBg,
            BadgeFg = scheme.BadgeFg,
            Hora = horaFormato,
            Cliente = visita.Solicitud?.Cliente?.Nombre ?? "",
            TipoServicio = visita.Solicitud?.Servicio?.Nombre ?? "",
            HoraInicio = AppStateService.FormatHora12(visita.Hora),
            HoraFin = AppStateService.FormatHora12(visita.HoraFin),
            Tecnico = tecNombre,
            Direccion = visita.Solicitud?.Direccion ?? "",
            Estado = estado,
            Fg = scheme.BadgeFg,
            Fecha = larga
                ? AppStateService.FormatFechaLarga(visita.Fecha.ToString("yyyy-MM-dd"))
                : AppStateService.FormatFecha(visita.Fecha.ToString("yyyy-MM-dd")),
            Rango = horaFormato + " - " + AppStateService.FormatHora12(visita.HoraFin),
            Corto = (horaFormato.Length > 5 ? horaFormato[..5] : horaFormato) + " " + (visita.Solicitud?.Cliente?.Nombre ?? "") + (visita.Tecnico != null ? $" ({visita.Tecnico.Nombre})" : ""),
            StartTime = hIni,
            EndTime = hFin
        };
    }

