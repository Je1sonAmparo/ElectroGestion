            ? solicitudId
            : null;
    }

    private void SelectEvent(Evento ev) => Detalle = ev;

    private void ClearDetalle() => Detalle = null;

    private async Task OpenNuevaVisitaModal()
    {
        await UpdateData();
        FormVisitaId = null;
        FormSolicitudId = null;
        FormTecnicoId = AppState.EsGerente ? null : AppState.Session?.Id;
        FormFecha = DateTime.Today;
        FormHora = null;
        FormHoraFin = null;
        showNuevaVisita = true;
    }

    private async Task OpenEditarVisitaModal()
    {
        if (Detalle is null)
        {
            return;
        }

        await UpdateData();
        var visita = visitas.FirstOrDefault(v => v.Id == Detalle.Id);
        if (visita is null)
        {
            ToastService.ShowError("No se encontró la visita que deseas editar.");
            return;
        }

        FormVisitaId = visita.Id;
        FormSolicitudId = visita.SolicitudId;
        FormTecnicoId = visita.TecnicoId;
        FormFecha = visita.Fecha;
        FormHora = TimeOnly.TryParse(visita.Hora, out var hora) ? hora : null;
        FormHoraFin = TimeOnly.TryParse(visita.HoraFin, out var horaFin) ? horaFin : null;
        showEditarVisita = true;
    }

    private void OpenCancelarModal()
    {
        if (Detalle?.Estado != "Pendiente")
        {
            return;
        }

        showCancelar = true;
    }

    private void OpenReactivarModal()
    {
        if (Detalle?.Estado != "Cancelada")
        {
            return;
        }

        showReactivar = true;
    }

    private void OpenEliminarModal()
    {
        if (Detalle is null)
        {
            return;
        }

        var motivo = ObtenerMotivoBloqueoEliminacion(Detalle.Id);
        if (motivo is not null)
        {
            ToastService.ShowWarning($"No se puede eliminar esta visita porque {motivo}.", "Atención");
            return;
        }

        showEliminar = true;
    }

    private string? ObtenerMotivoBloqueoEliminacion(int visitaId)
    {
        var visita = visitas.FirstOrDefault(v => v.Id == visitaId);
        if (visita is null)
        {
            return null;
        }

        if (visita.Estado == "En proceso")
        {
            return "se encuentra en proceso";
        }

        if (visita.Estado == "En Espera Administración")
        {
            return "está en espera de administración";
        }

        return visita.Solicitud?.EstadoSolicitudId switch
        {
            2 => "la solicitud asociada se encuentra en proceso",
            5 => "la solicitud asociada está en espera de administración",
            _ => null
        };
    }

    private void CloseModals()
    {
        showNuevaVisita = false;
        showEditarVisita = false;
        showCancelar = false;
        showReactivar = false;
        showEliminar = false;
        FormVisitaId = null;
    }

    private async Task GuardarVisitaAsync()
    {
        var solicitud = solicitudes.FirstOrDefault(s => s.Id == FormSolicitudId);
        if (solicitud is null || FormFecha == DateTime.MinValue ||
            !FormHora.HasValue || !FormHoraFin.HasValue || !string.IsNullOrEmpty(ErrorHorario))
        {
            ToastService.ShowWarning("Seleccione una solicitud e indique una fecha y hora válidas.", "Atención");
            return;
        }

        if (EsDomingoSeleccionado)
        {
            ToastService.ShowWarning("No se pueden programar visitas los domingos.", "Atención");
            return;
        }

        var existente = FormVisitaId.HasValue
            ? visitas.FirstOrDefault(v => v.Id == FormVisitaId.Value)
            : null;
        if ((existente is null || existente.SolicitudId != solicitud.Id) &&
            !await VisitaService.SolicitudDisponibleAsync(solicitud.Id, FormVisitaId))
        {
            ToastService.ShowWarning("La solicitud seleccionada ya tiene una visita asignada.", "Atención");
            return;
        }

        var tecnicoId = AppState.EsGerente
            ? FormTecnicoId
            : (existente is null ? AppState.Session?.Id : existente.TecnicoId);

        if (!await VisitaService.HorarioDisponibleAsync(
                FormFecha,
                FormHora.Value.ToString("HH:mm"),
                FormHoraFin.Value.ToString("HH:mm"),
                FormVisitaId,
                tecnicoId))
        {
            var nombreTec = tecnicos.FirstOrDefault(t => t.Id == tecnicoId)?.Nombre;
            var mensaje = !string.IsNullOrEmpty(nombreTec)
                ? $"El técnico {nombreTec} ya tiene una visita programada en esa fecha y horario."
                : "Ya existe una visita programada para este técnico en esa fecha y horario.";
            ToastService.ShowWarning(mensaje, "Conflicto de horario");
            return;
        }

        var visita = new ElectroGestion.Models.Visita
        {
            Id = FormVisitaId ?? 0,
            SolicitudId = solicitud.Id,
            TecnicoId = tecnicoId,
            Fecha = FormFecha.Date,
            Hora = FormHora.Value.ToString("HH:mm"),
            HoraFin = FormHoraFin.Value.ToString("HH:mm"),
            Estado = existente is not null && existente.SolicitudId == solicitud.Id
                ? existente.Estado
                : "En proceso"
        };

        try
        {
            if (!await VisitaService.GuardarAsync(visita))
            {
                ToastService.ShowWarning("No se pudo guardar: revise la solicitud, el técnico y que el horario esté libre.", "Atención");
                return;
            }

            await UpdateData();
            var guardada = visitas.First(v => v.Id == visita.Id);
            Detalle = CrearEvento(guardada);
            ToastService.ShowSuccess(FormVisitaId.HasValue
                ? "Visita actualizada correctamente."
                : "Visita programada correctamente.");
            CloseModals();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo guardar la visita de la solicitud {SolicitudId}.", solicitud.Id);
            ToastService.ShowError("Ocurrió un error al guardar la visita.");
        }
    }

    private async Task ConfirmarCancelar()
    {
        await CambiarEstadoVisitaAsync("Cancelada", "cancelar");
    }

    private async Task ConfirmarReactivar()
    {
        await CambiarEstadoVisitaAsync("En proceso", "reactivar");
    }

    private async Task CambiarEstadoVisitaAsync(string estado, string accion)
    {
        if (Detalle is null)
        {
            return;
        }

        try
        {
            if (!await VisitaService.CambiarEstadoAsync(Detalle.Id, estado))
            {
                ToastService.ShowWarning("Solo se puede cancelar una visita Pendiente o reactivar una visita Cancelada.", "Atención");
                return;
            }

            await UpdateData();
            Detalle = CrearEvento(visitas.First(v => v.Id == Detalle.Id));
            ToastService.ShowSuccess(accion == "cancelar"
                ? "Visita cancelada correctamente."
                : "Visita reactivada correctamente.");
            CloseModals();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo {Accion} la visita {VisitaId}.", accion, Detalle.Id);
            ToastService.ShowError("Ocurrió un error al actualizar la visita.");
        }
    }

    private async Task ConfirmarEliminarAsync()
    {
        if (Detalle is null)
        {
            return;
        }

        var visitaId = Detalle.Id;
        try
        {
            if (!await VisitaService.EliminarAsync(visitaId))
            {
                var motivo = ObtenerMotivoBloqueoEliminacion(visitaId) ?? "la visita cambió de estado";
                ToastService.ShowWarning($"No se puede eliminar esta visita porque {motivo}.", "Atención");
                return;
            }

            await UpdateData();
            Detalle = null;
            ToastService.ShowSuccess("Visita eliminada correctamente.");
            CloseModals();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo eliminar la visita {VisitaId}.", visitaId);
            ToastService.ShowError("Ocurrió un error al eliminar la visita.");
        }
    }
}
