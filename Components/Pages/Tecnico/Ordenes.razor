@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.OrdenTrabajoService OrdenService
@inject BlazorBootstrap.ToastService ToastService

<PageTitle>Órdenes de Trabajo | ElectroGestion</PageTitle>

<div style="margin-bottom:24px"><h1 class="page-title" style="font-family:'Manrope';font-size:31px;margin:0">Órdenes de trabajo</h1><p style="color:#6B7085;margin:5px 0 0">Tareas, materiales y herramientas para la ejecución en campo.</p></div>

<div style="background:white;border:1px solid #E3E5EE;border-radius:12px;padding:18px;margin-bottom:18px;display:flex;align-items:end;gap:14px;flex-wrap:wrap">
    <div><label for="orden-id-tec">ID</label><input id="orden-id-tec" @bind="FiltroId" @bind:event="oninput" placeholder="ID de orden" style="display:block;padding:9px;border:1px solid #D5D8E6;border-radius:7px;width:130px" /></div>
    <div><label for="orden-cliente-tec">Cliente</label><input id="orden-cliente-tec" @bind="FiltroCliente" @bind:event="oninput" placeholder="Nombre del cliente" style="display:block;padding:9px;border:1px solid #D5D8E6;border-radius:7px" /></div>
    <div><label for="orden-estado-tec">Estado</label><select id="orden-estado-tec" @bind="FiltroEstado" style="display:block;padding:9px;border:1px solid #D5D8E6;border-radius:7px"><option value="">Todos</option><option>En proceso</option><option>Finalizada</option></select></div>
</div>

@if (Cargando)
{ <p>Cargando órdenes...</p> }
else if (!OrdenesFiltradas.Any())
{ <div style="background:white;border:1px solid #E3E5EE;border-radius:12px;padding:28px;color:#6B7085">No hay órdenes con los filtros seleccionados.</div> }
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:16px">
    @foreach (var orden in OrdenesFiltradas)
    {
        <article style="background:white;border:1px solid #E3E5EE;border-radius:12px;padding:22px;display:flex;flex-direction:column;gap:16px">
            <div style="display:flex;justify-content:space-between;gap:12px;align-items:start"><div><div style="font-size:12px;color:#8B90A3;font-weight:700">@orden.Code · @orden.FechaCreacion.ToString("dd/MM/yyyy")</div><h2 style="font-size:20px;margin:5px 0">@orden.Cliente</h2><div style="color:#6B7085">@orden.TipoServicio</div></div><span style="white-space:nowrap;border-radius:20px;padding:5px 10px;background:@(orden.Estado == "Finalizada" ? "#D1FAE5" : "#DBEAFE");color:@(orden.Estado == "Finalizada" ? "#047857" : "#1D4ED8");font-size:12px;font-weight:700">@orden.Estado</span></div>
            <div><h3 style="font-size:13px;text-transform:uppercase;color:#6B7085;margin:0 0 8px">Tareas</h3>@foreach (var tarea in orden.Trabajos) { <div style="padding:3px 0">• @tarea</div> }</div>
            <div><h3 style="font-size:13px;text-transform:uppercase;color:#6B7085;margin:0 0 8px">Materiales de la cotización</h3>
                @if (orden.MaterialesCotizados.Count == 0) { <div style="color:#8B90A3">Sin materiales cotizados.</div> }
                else { <div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:14px"><thead><tr style="background:#F7F8FC"><th style="text-align:left;padding:8px">Material</th><th style="text-align:right;padding:8px">Cantidad</th></tr></thead><tbody>@foreach (var material in orden.MaterialesCotizados) { <tr style="border-top:1px solid #EFF0F6"><td style="padding:8px">@material.Codigo · @material.Nombre</td><td style="text-align:right;padding:8px">@material.Cantidad</td></tr> }</tbody></table></div> }
            </div>
            <div><h3 style="font-size:13px;text-transform:uppercase;color:#6B7085;margin:0 0 8px">Herramientas asignadas</h3>@if (orden.Herramientas.Count == 0) { <span style="color:#8B90A3">Sin herramientas asignadas.</span> } else { <div style="display:flex;flex-wrap:wrap;gap:6px">@foreach (var herramienta in orden.Herramientas) { <span style="padding:5px 9px;background:#F7F8FC;border:1px solid #E3E5EE;border-radius:15px;font-size:13px">@herramienta</span> }</div> }</div>
            @if (!string.IsNullOrWhiteSpace(orden.Observaciones)) { <div><h3 style="font-size:13px;text-transform:uppercase;color:#6B7085;margin:0 0 8px">Instrucciones de campo</h3><div>@orden.Observaciones</div></div> }
            <div style="margin-top:auto;padding-top:10px;border-top:1px solid #EFF0F6">
                @if (orden.Estado == "Finalizada") { <div style="text-align:center;color:#047857;font-weight:700">✓ Orden finalizada</div> }
                else { <button @onclick="() => Finalizar(orden.Id)" style="width:100%;padding:10px;border:0;border-radius:8px;background:#1D4ED8;color:white;font-weight:700;cursor:pointer">Completar trabajo en campo</button> }
            </div>
        </article>
    }
    </div>
}

@code {
    private List<ElectroGestion.Models.OrdenTrabajo> Ordenes = [];
    private bool Cargando;
    private string FiltroId = "", FiltroCliente = "", FiltroEstado = "";
    private IEnumerable<ElectroGestion.Models.OrdenTrabajo> OrdenesFiltradas => Ordenes.Where(o =>
        (string.IsNullOrWhiteSpace(FiltroId) || o.Id.ToString().Contains(FiltroId) || o.Code.Contains(FiltroId, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroCliente) || o.Cliente.Contains(FiltroCliente, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FiltroEstado) || o.Estado == FiltroEstado));

    protected override async Task OnInitializedAsync() => await Recargar();

    private async Task Recargar()
    {
        Cargando = true;
        try { Ordenes = await OrdenService.ObtenerTodasAsync(); }
        catch { ToastService.Notify(new ToastMessage(ToastType.Danger, "No se pudieron cargar las órdenes.")); }
        finally { Cargando = false; }
    }

    private async Task Finalizar(int id)
    {
        if (await OrdenService.CambiarEstadoAsync(id, "Finalizada")) { ToastService.Notify(new ToastMessage(ToastType.Success, "Orden finalizada.")); await Recargar(); }
        else ToastService.Notify(new ToastMessage(ToastType.Warning, "No se pudo finalizar la orden."));
    }
}
