@page "/levantamientos"
@implements IDisposable
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.SolicitudService SolicitudService
@inject ElectroGestion.Services.ClienteService ClienteService
@inject ElectroGestion.Services.ServicioService ServicioService
@inject NavigationManager NavManager

<PageTitle>Levantamientos | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div style="display:flex;align-items:flex-start;">
        <div>
            <div class="page-title" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px">Levantamientos</div>
            <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Gestiona los levantamientos técnicos.</div>
        </div>
    </div>
</div>

@if (!IsNuevoLev)
{
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:18px">
        <div style="display:flex;flex-direction:column;gap:18px;padding-bottom:12px;border-bottom:1px solid #EFF0F6">
            <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
                <div style="display:flex;align-items:center;gap:10px">
                    <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">ID:</span>
                    <input @bind="SearchId" @bind:event="oninput" placeholder="ID"
                        style="width:100px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
                </div>
                <div style="display:flex;align-items:center;gap:10px">
                    <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Cliente:</span>
                    <input @bind="SearchCliente" @bind:event="oninput" placeholder="Nombre del cliente"
                        style="width:200px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;color:#4A4E63" />
                </div>
                <div style="display:flex;align-items:center;gap:10px">
                    <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Tipo de Servicio:</span>
                    <select @bind="SearchTipo" style="width:190px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                        <option value="">Todos</option>
                        @foreach (var t in TiposServicio)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap" class="resp-search-block">
                <div style="display:flex;align-items:center;gap:10px">
                    <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Fecha:</span>
                    <input type="date" @bind="SearchFecha"
                        style="width:160px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63" />
                </div>
                <div style="display:flex;align-items:center;gap:10px">
                    <span style="font-family:'Manrope';font-weight:800;font-size:15px;color:#14162B">Estado:</span>
                    <select @bind="SearchEstado" style="width:170px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff;color:#4A4E63">
                        <option value="Todos">Todos</option>
                        @foreach (var e in EstadosLev)
                        {
                            <option value="@e">@e</option>
                        }
                    </select>
                </div>
                <div style="display:flex;gap:10px;justify-content:flex-end;margin-left:auto">
                    <button class="primary-btn" @onclick="Filtrar"
                        style="padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Buscar</button>
                </div>
            </div>
        </div>
        <div style="margin-top:18px;background:#F7F8FC;border:1px solid #EFF0F6;border-radius:12px;padding:16px">
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px" class="resp-grid-3">
                @foreach (var l in FilteredLevantamientos)
                {
                    var colors = AppStateService.GetBadgeColors(l.Estado);
                    var s = solicitudes.FirstOrDefault(x => x.Id == l.SolicitudId);
                    var clienteNombre = s?.Cliente?.Nombre ?? "Desconocido";
                    var servicioNombre = s?.Servicio?.Nombre ?? "Desconocido";
                    var fecha = s == null ? "Sin programar" : $"{AppStateService.FormatFecha(s.Fecha.ToString("yyyy-MM-dd"))} {AppStateService.FormatHora12(s.Hora)}";

                    <div style="background:#fff;border:1px solid #D9DCE9;border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:2px">
                        <div style="display:flex;justify-content:flex-end">
                            <span style="display:inline-block;padding:4px 10px;border-radius:20px;font-size:11.5px;font-weight:800;background:@colors.Bg;color:@colors.Fg">
                                @l.Estado
                            </span>
                        </div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:700">Cliente</div>
                        <div style="font-family:'Manrope';font-weight:800;font-size:16.5px">@clienteNombre</div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:700;margin-top:8px">Tipo de servicio</div>
                        <div style="font-size:14.5px">@servicioNombre</div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:700;margin-top:8px">Fecha programada</div>
                        <div style="font-size:14.5px">@fecha</div>

                        @if (l.Estado == "Borrador")
                        {
                            <div style="margin-top:9px;font-size:11.5px;font-weight:800;color:#B26A00;background:#FFF3E0;border-radius:6px;padding:5px 8px;display:inline-block;align-self:flex-start">
                                Borrador guardado
                            </div>
                        }

                        <button class="action-btn-card" @onclick="() => AbrirLevantamiento(l.Id)"
                            style="margin-top:14px;align-self:flex-end;padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer">
                            @(l.Estado == "En Espera Técnico" ? "Comenzar" : "Ver detalle")
                        </button>
                    </div>
                }
            </div>
            @if (!FilteredLevantamientos.Any())
            {
                <div style="padding:34px;text-align:center;color:#8B90A3;font-size:14px">
                    No hay levantamientos en este estado. Solo se muestran solicitudes con fecha y hora definidas.
                </div>
            }
        </div>
    </div>
}
else
{
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:26px">
        @if (DesdeSolicitud)
        {
            <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;background:#EDEBFF;border:1px solid #C9C3F5;border-radius:12px;padding:14px 16px;margin-bottom:22px">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#1D4ED8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="flex:0 0 20px">
                    <path d="M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17 M12 8.2v.2 M12 11.5v4.6"></path>
                </svg>
                <div style="font-size:13.5px;color:#2A2382;font-weight:700;flex:1;min-width:220px">@OrigenTexto</div>
                <button class="volver-btn" @onclick="VolverLevantamientos" style="padding:9px 14px;border:1px solid #A79EEE;background:#fff;color:#1D4ED8;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer">
                    Volver a levantamientos
                </button>
            </div>
        }
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px" class="resp-grid-3">
            <div>
                <label style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Cliente *</label>
                <select disabled="@DesdeSolicitud" @bind="FormCliente" style="width:100%;padding:12px 13px;border:1px solid #D5D8E6;border-radius:9px;font-size:14.5px;background:@(DesdeSolicitud ? "#F7F8FC" : "#fff")">
                    <option value="">Seleccionar cliente...</option>
                    @foreach (var c in clientes)
                    {
                        <option value="@c.Nombre">@c.Nombre</option>
                    }
                </select>
            </div>
            <div style="grid-column:span 2">
                <label style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Tipo de servicio *</label>
                <select disabled="@DesdeSolicitud" @bind="FormTipo" style="width:100%;padding:12px 13px;border:1px solid #D5D8E6;border-radius:9px;font-size:14.5px;background:@(DesdeSolicitud ? "#F7F8FC" : "#fff")">
                    <option value="">Seleccionar...</option>
                    @foreach (var t in TiposServicio)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div>
                <label style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Disponibilidad de los espacios físicos *</label>
                <input @bind="FormEspacios" placeholder="Ej. Sala técnica disponible" style="width:100%;padding:12px 13px;border:1px solid #D5D8E6;border-radius:9px;font-size:14.5px" />
            </div>
            <div>
                <label style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Cargas eléctricas *</label>
                <input @bind="FormCargas" placeholder="Ej. 12 kW" style="width:100%;padding:12px 13px;border:1px solid #D5D8E6;border-radius:9px;font-size:14.5px" />
            </div>
            <div>
                <label style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Estabilidad de la tensión *</label>
                <input @bind="FormTension" placeholder="Ej. 118-122 V estable" style="width:100%;padding:12px 13px;border:1px solid #D5D8E6;border-radius:9px;font-size:14.5px" />
            </div>
            <div>
                <label style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Recorrido físico de las tuberías *</label>
                <input @bind="FormTuberias" placeholder="Ej. 18 m EMT 3/4" style="width:100%;padding:12px 13px;border:1px solid #D5D8E6;border-radius:9px;font-size:14.5px" />
            </div>
            <div>
                <label style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Recorrido físico del cableado *</label>
                <input @bind="FormCableado" placeholder="Ej. 24 m THHN #10" style="width:100%;padding:12px 13px;border:1px solid #D5D8E6;border-radius:9px;font-size:14.5px" />
            </div>
            <div style="grid-row:span 2">
                <label style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Observaciones</label>
                <textarea @bind="FormObservaciones" placeholder="Notas del técnico..." style="width:100%;height:158px;padding:12px 13px;border:1px solid #D5D8E6;border-radius:9px;font-size:14.5px;resize:vertical"></textarea>
            </div>
        </div>

        <div style="margin-top:22px">
            <div style="font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:10px">Fotografías *</div>
            <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
                <button class="foto-btn" @onclick="AgregarFoto" style="width:132px;height:96px;border:1px dashed #A9AEC4;background:#F0F1F7;border-radius:11px;cursor:pointer;font-size:12.5px;font-weight:700;color:#4A4E63">
                    + Agregar foto
                </button>
                @foreach (var f in Fotos)
                {
                    <div style="position:relative;width:132px;height:96px;border:1px solid #D9DCE9;border-radius:11px;background:repeating-linear-gradient(135deg,#EEF0F8 0 8px,#F7F8FC 8px 16px);display:flex;align-items:center;justify-content:center;font-family:ui-monospace,monospace;font-size:11px;color:#8B90A3">
                        @f
                        <button @onclick="() => EliminarFoto(f)" style="position:absolute;top:-7px;right:-7px;width:22px;height:22px;border-radius:50%;border:1px solid #D9DCE9;background:#fff;cursor:pointer;color:#C4141B;font-size:12px;line-height:1">✕</button>
                    </div>
                }
            </div>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:11px;margin-top:26px;padding-top:20px;border-top:1px solid #EFF0F6">
            <button class="cancelar-btn" @onclick="CancelarLev" style="padding:12px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer">Cancelar</button>
            <button class="guardar-btn" @onclick="GuardarBorrador" style="padding:12px 20px;border:1px solid #1D4ED8;background:#fff;color:#1D4ED8;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer">Guardar</button>
            <button class="rechazar-btn" @onclick="RechazarLev" style="padding:12px 20px;border:1px solid #F5C2C4;background:#fff;color:#C4141B;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer">Cancelar servicio</button>
            <button class="enviar-btn" @onclick="EnviarAdmin" style="padding:12px 22px;border:0;background:#1D4ED8;color:#fff;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Enviar a Administración</button>
        </div>
    </div>
}

@code {
    private bool IsNuevoLev = false;
    private string SearchId = "";
    private string SearchCliente = "";
    private string SearchTipo = "";
    private DateTime? SearchFecha = null;
    private string SearchEstado = "Todos";
    private List<string> EstadosLev = new() { "En Espera Técnico", "En Espera Administración", "Aprobado", "Borrador" };

    private bool DesdeSolicitud = false;
    private string OrigenTexto = "";

    private string FormCliente = "";
    private string FormTipo = "";
    private string FormEspacios = "";
    private string FormCargas = "";
    private string FormTension = "";
    private string FormTuberias = "";
    private string FormCableado = "";
    private string FormObservaciones = "";
    private List<string> Fotos = new();
    private int? CurrentLevId;

    private void Filtrar()
    {
        StateHasChanged();
    }

    private List<ElectroGestion.Models.Solicitud> solicitudes = new();
    private List<ElectroGestion.Models.Cliente> clientes = new();
    private List<ElectroGestion.Models.Servicio> servicios = new();
    private List<string> TiposServicio = new();

    private List<ElectroGestion.Models.Levantamiento> FilteredLevantamientos => AppState.Levantamientos
        .Where(l => {
            var s = solicitudes.FirstOrDefault(x => x.Id == l.SolicitudId);
            bool matchId = string.IsNullOrEmpty(SearchId) || l.Id.ToString().Contains(SearchId);
            bool matchCliente = string.IsNullOrEmpty(SearchCliente) || (s != null && s.Cliente?.Nombre != null && s.Cliente.Nombre.Contains(SearchCliente, StringComparison.OrdinalIgnoreCase));
            bool matchTipo = string.IsNullOrEmpty(SearchTipo) || (s != null && s.Servicio?.Nombre == SearchTipo);
            bool matchFecha = !SearchFecha.HasValue || (s != null && s.Fecha.Date == SearchFecha.Value.Date);
            bool matchEstado = SearchEstado == "Todos" || l.Estado == SearchEstado;
            return matchId && matchCliente && matchTipo && matchFecha && matchEstado;
        })
        .OrderByDescending(x => x.Id).ToList();

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += OnStateChanged;
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        solicitudes = await SolicitudService.GetList(s => true);
        clientes = await ClienteService.GetList(c => true);
        servicios = await ServicioService.GetList(s => true);
        TiposServicio = servicios.Select(x => x.Nombre).Distinct().ToList();
    }

    public void Dispose()
    {
        AppState.OnChange -= OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await CargarDatos();
        await InvokeAsync(StateHasChanged);
    }

    private void GuardarLevantamientos()
    {
        // Placeholder
    }

    private void AbrirLevantamiento(int id)
    {
        var lev = AppState.Levantamientos.FirstOrDefault(l => l.Id == id);
        if (lev != null)
        {
            var s = solicitudes.FirstOrDefault(x => x.Id == lev.SolicitudId);
            IsNuevoLev = true;
            CurrentLevId = id;
            if (s != null)
            {
                DesdeSolicitud = true;
                OrigenTexto = $"Levantamiento de: {s.Cliente?.Nombre} - {s.Servicio?.Nombre}";
                FormCliente = s.Cliente?.Nombre ?? "";
                FormTipo = s.Servicio?.Nombre ?? "";
            }
            else
            {
                DesdeSolicitud = false;
            }

            // In a real app we'd load the existing lev.Datos into the form fields.
            Fotos = new List<string> { "foto_1.jpg", "foto_2.jpg" }; // mock
        }
    }

    private void VolverLevantamientos()
    {
        IsNuevoLev = false;
    }

    private void AgregarFoto()
    {
        Fotos.Add($"foto_{Fotos.Count + 1}.jpg");
    }

    private void EliminarFoto(string foto)
    {
        Fotos.Remove(foto);
    }

    private void CancelarLev()
    {
        VolverLevantamientos();
    }

    private void GuardarBorrador()
    {
        if (CurrentLevId.HasValue)
        {
            var l = AppState.Levantamientos.FirstOrDefault(x => x.Id == CurrentLevId.Value);
            if (l != null) l.Estado = "Borrador";
            AppState.NotifyStateChanged();
        }
        VolverLevantamientos();
    }

    private void RechazarLev()
    {
        if (CurrentLevId.HasValue)
        {
            var l = AppState.Levantamientos.FirstOrDefault(x => x.Id == CurrentLevId.Value);
            if (l != null) l.Estado = "Cancelado";
            AppState.NotifyStateChanged();
        }
        VolverLevantamientos();
    }

    private void EnviarAdmin()
    {
        if (CurrentLevId.HasValue)
        {
            var l = AppState.Levantamientos.FirstOrDefault(x => x.Id == CurrentLevId.Value);
            if (l != null) l.Estado = "En Espera Administración";
            AppState.NotifyStateChanged();
        }
        VolverLevantamientos();
    }
}
