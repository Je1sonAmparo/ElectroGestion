@page "/levantamientos"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.LevantamientoService LevantamientoService
@inject ElectroGestion.Services.VisitaService VisitaService
@inject BlazorBootstrap.ToastService ToastService
@inject ILogger<Levantamientos> Logger
<PageTitle>Levantamientos | ElectroGestion</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px">
    <div>
        <div @ref="TituloListado" class="page-title" tabindex="-1" style="font-family:'Manrope';font-weight:800;font-size:31px;letter-spacing:-.6px;outline:none">Levantamientos</div>
        <div style="color:#6B7085;font-size:14.5px;margin-top:5px">Gestiona los levantamientos técnicos.</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div role="alert" style="margin-bottom:16px;padding:12px 16px;border:1px solid #F5C2C4;background:#FDE9EA;color:#A61B22;border-radius:9px">
        @ErrorMessage
    </div>
}

@if (IsLoading)
{
    <div style="padding:34px;text-align:center;color:#6B7085">Cargando levantamientos...</div>
}
else if (CurrentSolicitud is null)
{
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:18px">
        <div style="display:flex;flex-direction:column;gap:18px;padding-bottom:12px;border-bottom:1px solid #EFF0F6">
            <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
                <label style="display:flex;align-items:center;gap:10px;font-weight:700">ID:
                    <input @bind="SearchId" @bind:event="oninput" placeholder="ID" style="width:100px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px" />
                </label>
                <label style="display:flex;align-items:center;gap:10px;font-weight:700">Cliente:
                    <input @bind="SearchCliente" @bind:event="oninput" placeholder="Nombre del cliente" style="width:200px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px" />
                </label>
                <label style="display:flex;align-items:center;gap:10px;font-weight:700">Tipo de servicio:
                    <select @bind="SearchTipo" style="width:210px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff">
                        <option value="">Todos</option>
                        @foreach (var tipo in TiposServicio)
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </label>
            </div>
            <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
                <label style="display:flex;align-items:center;gap:10px;font-weight:700">Fecha programada:
                    <input type="date" @bind="SearchFecha" @bind:format="yyyy-MM-dd" style="width:170px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff" />
                </label>
                <label style="display:flex;align-items:center;gap:10px;font-weight:700">Estado:
                    <select @bind="SearchEstado" style="width:210px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff">
                        <option value="Todos">Todos</option>
                        @foreach (var estado in EstadosLevantamiento)
                        {
                            <option value="@estado">@estado</option>
                        }
                    </select>
                </label>
                <label style="display:flex;align-items:center;gap:10px;font-weight:700">Técnico:
                    <select @bind="SearchTecnicoId" style="width:210px;padding:9px 12px;border:1px solid #D5D8E6;border-radius:6px;font-size:14px;background:#fff">
                        <option value="">Todos</option>
                        <option value="@TecnicoSinAsignar">Sin asignar</option>
                        @foreach (var tecnico in Tecnicos)
                        {
                            <option value="@tecnico.Id">@tecnico.Nombre</option>
                        }
                    </select>
                </label>
                <button @onclick="AplicarFiltros" style="margin-left:auto;padding:9px 16px;background:#1D4ED8;color:#fff;border:0;border-radius:6px;font-weight:700;font-size:14px;cursor:pointer">Buscar</button>
            </div>
        </div>

        <div style="margin-top:18px;background:#F7F8FC;border:1px solid #EFF0F6;border-radius:12px;padding:16px">
            <div style="display:grid;width:100%;max-width:1404px;grid-template-columns:repeat(3,minmax(0,1fr));grid-auto-rows:330px;column-gap:18px;row-gap:18px" class="resp-grid-3">
                @foreach (var solicitud in FilteredSolicitudes)
                {
                    var estado = solicitud.EstadoSolicitud?.Nombre ?? "Pendiente";
                    var colors = ElectroGestion.Services.AppStateService.GetBadgeColors(estado);
                    var visita = ObtenerVisita(solicitud.Id);
                    var levantamiento = solicitud.Levantamiento;
                    var fecha = visita is null
                        ? "Sin programar"
                        : $"{ElectroGestion.Services.AppStateService.FormatFecha(visita.Fecha.ToString("yyyy-MM-dd"))} · {ElectroGestion.Services.AppStateService.FormatHora12(visita.Hora)} - {ElectroGestion.Services.AppStateService.FormatHora12(visita.HoraFin)}";

                    <article style="box-sizing:border-box;width:100%;height:330px;background:#fff;border:1px solid #D9DCE9;border-radius:12px;padding:20px;display:flex;flex-direction:column;gap:2px">
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
                            <span style="font-size:12px;color:#8B90A3;font-weight:700">Solicitud #@solicitud.Id</span>
                            <span style="display:inline-block;padding:4px 10px;border-radius:20px;font-size:11.5px;font-weight:800;background:@colors.Bg;color:@colors.Fg">@estado</span>
                        </div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:700;margin-top:8px">Cliente</div>
                        <div style="font-family:'Manrope';font-weight:800;font-size:16.5px">@solicitud.Cliente?.Nombre</div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:700;margin-top:8px">Tipo de servicio</div>
                        <div style="font-size:14.5px">@solicitud.Servicio?.Nombre</div>
                        <div style="font-size:12px;color:#8B90A3;font-weight:700;margin-top:8px">Fecha programada</div>
                        <div style="font-size:14.5px">@fecha</div>
                        <div style="font-size:12.5px;color:#6B7085;margin-top:6px">
                            Técnico asignado: <strong>@(visita?.Tecnico?.Nombre ?? "Sin asignar")</strong>
                        </div>

                            @if (levantamiento?.BorradorGuardado == true)
                            {
                            <div style="margin-top:9px;font-size:11.5px;font-weight:800;color:#B26A00;background:#FFF3E0;border-radius:6px;padding:5px 8px;display:inline-block;align-self:flex-start">
                                Borrador guardado
                            </div>
                        }

                        <button @onclick="() => AbrirLevantamientoAsync(solicitud)" disabled="@IsLoading"
                            style="margin-top:auto;align-self:flex-end;min-width:116px;min-height:48px;padding:9px 14px;border:1px solid #D5D8E6;background:#fff;border-radius:9px;font-size:13px;font-weight:700;white-space:nowrap;cursor:pointer">
                            @TextoAccion(solicitud, levantamiento)
                        </button>
                    </article>
                }
            </div>

            @if (!FilteredSolicitudes.Any())
            {
                <div style="padding:34px;text-align:center;color:#8B90A3;font-size:14px">
                    @if (solicitudes.Count == 0)
                    {
                        <span>No hay solicitudes con visitas programadas para mostrar.</span>
                    }
                    else
                    {
                        <span>No hay levantamientos que coincidan con los filtros.</span>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    var visitaActual = ObtenerVisita(CurrentSolicitud.Id);
    <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:26px">
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;background:#EDEBFF;border:1px solid #C9C3F5;border-radius:12px;padding:14px 16px;margin-bottom:22px">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#1D4ED8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="flex:0 0 20px" aria-hidden="true">
                <path d="M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17 M12 8.2v.2 M12 11.5v4.6"></path>
            </svg>
            <div style="font-size:13.5px;color:#2A2382;font-weight:700;flex:1;min-width:220px">
                Levantamiento de: @CurrentSolicitud.Cliente?.Nombre - @CurrentSolicitud.Servicio?.Nombre
            </div>
            <button @onclick="CancelarEdicionAsync" style="padding:9px 14px;border:1px solid #A79EEE;background:#fff;color:#1D4ED8;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer">
                Volver a levantamientos
            </button>
            @if (CurrentSolicitud.EstadoSolicitud?.Nombre == "En Espera Administración")
            {
                <button @onclick="SolicitarEdicionEnviada" style="padding:9px 14px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer">
                    Editar información
                </button>
            }
        </div>

        @if (CurrentSolicitud.Levantamiento?.BorradorGuardado == true)
        {
            <div style="margin-bottom:18px;font-size:12px;font-weight:800;color:#B26A00;background:#FFF3E0;border-radius:6px;padding:8px 11px;display:inline-block">
                Borrador guardado
            </div>
        }

        <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px" class="resp-grid-3">
            <div>
                <label style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Cliente</label>
                <input value="@CurrentSolicitud.Cliente?.Nombre" readonly style="@ReadOnlyInputStyle" />
            </div>
            <div style="grid-column:span 2">
                <label style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Tipo de servicio</label>
                <input value="@CurrentSolicitud.Servicio?.Nombre" readonly style="@ReadOnlyInputStyle" />
            </div>
            <div>
                <label for="tecnico-asignado" style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Técnico asignado</label>
                @if (AppState.EsGerente)
                {
                    <select id="tecnico-asignado" value="@(visitaActual?.TecnicoId?.ToString() ?? "")" @onchange="CambiarTecnicoAsignadoAsync" disabled="@(IsSaving || visitaActual is null)" style="@InputStyle">
                        <option value="">Sin asignar</option>
                        @foreach (var tecnico in Tecnicos)
                        {
                            <option value="@tecnico.Id">@tecnico.Nombre</option>
                        }
                    </select>
                }
                else
                {
                    <input id="tecnico-asignado" value="@(visitaActual?.Tecnico?.Nombre ?? "Sin asignar")" readonly style="@ReadOnlyInputStyle" />
                }
            </div>
            <div>
                <label for="espacios" style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Disponibilidad de los espacios físicos *</label>
                <input id="espacios" @bind="FormEspacios" maxlength="2000" disabled="@SoloLectura" placeholder="Ej. Sala técnica disponible" style="@InputStyle" />
                @if (MostrarErrorRequerido(FormEspacios))
                {
                    <div role="alert" style="@ValidationMessageStyle">Este campo es obligatorio.</div>
                }
            </div>
            <div>
                <label for="cargas" style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Cargas eléctricas *</label>
                <input id="cargas" @bind="FormCargas" maxlength="2000" disabled="@SoloLectura" placeholder="Ej. 12 kW" style="@InputStyle" />
                @if (MostrarErrorRequerido(FormCargas))
                {
                    <div role="alert" style="@ValidationMessageStyle">Este campo es obligatorio.</div>
                }
            </div>
            <div>
                <label for="tension" style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Estabilidad de la tensión *</label>
                <input id="tension" @bind="FormTension" maxlength="2000" disabled="@SoloLectura" placeholder="Ej. 118-122 V estable" style="@InputStyle" />
                @if (MostrarErrorRequerido(FormTension))
                {
                    <div role="alert" style="@ValidationMessageStyle">Este campo es obligatorio.</div>
                }
            </div>
            <div>
                <label for="tuberias" style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Recorrido físico de las tuberías *</label>
                <input id="tuberias" @bind="FormTuberias" maxlength="2000" disabled="@SoloLectura" placeholder="Ej. 18 m EMT 3/4" style="@InputStyle" />
                @if (MostrarErrorRequerido(FormTuberias))
                {
                    <div role="alert" style="@ValidationMessageStyle">Este campo es obligatorio.</div>
                }
            </div>
            <div>
                <label for="cableado" style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Recorrido físico del cableado *</label>
                <input id="cableado" @bind="FormCableado" maxlength="2000" disabled="@SoloLectura" placeholder="Ej. 24 m THHN #10" style="@InputStyle" />
                @if (MostrarErrorRequerido(FormCableado))
                {
                    <div role="alert" style="@ValidationMessageStyle">Este campo es obligatorio.</div>
                }
            </div>
            <div style="grid-row:span 2">
                <label for="observaciones" style="display:block;font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:7px">Observaciones</label>
                <textarea id="observaciones" @bind="FormObservaciones" maxlength="4000" disabled="@SoloLectura" placeholder="Notas del técnico..." style="width:100%;height:158px;padding:12px 13px;border:1px solid #D5D8E6;border-radius:9px;font-size:14.5px;resize:vertical"></textarea>
            </div>
        </div>

        <div style="margin-top:22px">
            <div style="font-size:13px;font-weight:700;color:#4A4E63;margin-bottom:10px">Fotografías</div>
            <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
                @if (!SoloLectura)
                {
                    <label style="width:132px;height:96px;border:1px dashed #A9AEC4;background:#F0F1F7;border-radius:11px;cursor:pointer;font-size:12.5px;font-weight:700;color:#4A4E63;display:flex;align-items:center;justify-content:center;text-align:center">
                        + Agregar foto
                        <InputFile OnChange="AgregarFotosAsync" accept="image/*" multiple disabled="@SoloLectura" style="display:none" />
                    </label>
                }
                @foreach (var foto in Fotos)
                {
                    <div style="position:relative;width:132px;height:96px;border:1px solid #D9DCE9;border-radius:11px;overflow:hidden;background:#F7F8FC">
                        <button type="button" @onclick="() => AmpliarFoto(foto)" aria-label="Ampliar fotografía" style="display:block;width:100%;height:100%;padding:0;border:0;background:transparent;cursor:zoom-in">
                            <img src="@foto" alt="Fotografía del levantamiento" style="width:100%;height:100%;object-fit:cover" />
                        </button>
                        @if (!SoloLectura)
                        {
                            <button @onclick="() => EliminarFoto(foto)" aria-label="Quitar fotografía" style="position:absolute;top:5px;right:5px;z-index:1;width:24px;height:24px;border-radius:50%;border:1px solid #D9DCE9;background:#fff;cursor:pointer;color:#C4141B;font-size:12px;line-height:1">✕</button>
                        }
                    </div>
                }
            </div>
            @if (!SoloLectura)
            {
                <div style="margin-top:7px;color:#8B90A3;font-size:12px">Tamaño máximo por imagen: 5 MB.</div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(FormMessage))
        {
            <div role="alert" style="margin-top:18px;padding:11px 14px;border:1px solid #F5C2C4;background:#FDE9EA;color:#A61B22;border-radius:8px">@FormMessage</div>
        }

        <div style="display:flex;justify-content:flex-end;gap:11px;flex-wrap:wrap;margin-top:26px;padding-top:20px;border-top:1px solid #EFF0F6">
            <button @onclick="CancelarEdicionAsync" style="padding:12px 20px;border:1px solid #D5D8E6;background:#fff;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer">
                @(SoloLectura ? "Volver" : "Cancelar")
            </button>
            @if (!SoloLectura)
            {
                @if (EditandoEnviado)
                {
                    <button @onclick="GuardarCambiosEnviadosAsync" disabled="@IsSaving" style="padding:12px 20px;border:0;background:#1D4ED8;color:#fff;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer">Guardar cambios</button>
                }
                else
                {
                    <button @onclick="GuardarBorradorAsync" disabled="@IsSaving" style="padding:12px 20px;border:1px solid #1D4ED8;background:#fff;color:#1D4ED8;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer">Guardar</button>
                    <button @onclick="SolicitarEnvio" disabled="@IsSaving" style="padding:12px 22px;border:0;background:#1D4ED8;color:#fff;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Enviar a Administración</button>
                }
            }
        </div>
    </div>
}

@if (MostrarConfirmacionCancelar)
{
    <div role="presentation" style="@ModalBackdropStyle">
        <section role="dialog" aria-modal="true" aria-labelledby="cancel-title" style="@($"{ModalStyle};width:min(100%,620px)")">
            <h2 id="cancel-title" style="font-family:'Manrope';font-size:19px;margin:0 0 12px">@(EditandoEnviado ? "¿Descartar los cambios?" : "¿Desea guardar los cambios?")</h2>
            <p style="font-size:14px;color:#5E6378;line-height:1.55;margin:0">
                @if (EditandoEnviado)
                {
                    <span>Los cambios que todavía no ha guardado se perderán. ¿Desea volver a la información enviada?</span>
                }
                else
                {
                    <span>Hay información ingresada que todavía no se ha guardado. Si sale ahora, esos cambios se perderán. Puede guardarlos como borrador para continuar después.</span>
                }
            </p>
            <div style="display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;margin-top:22px">
                <button @onclick="CerrarConfirmacionCancelar" style="@SecondaryButtonStyle">Cancelar</button>
                @if (EditandoEnviado)
                {
                    <button @onclick="DescartarCambiosEnviados" style="@PrimaryButtonStyle">Descartar cambios</button>
                }
                else
                {
                    <button @onclick="SalirSinGuardarAsync" style="@SecondaryButtonStyle">Salir sin guardar</button>
                    <button @onclick="GuardarBorradorYSalirAsync" style="@PrimaryButtonStyle">Guardar como borrador y salir</button>
                }
            </div>
        </section>
    </div>
}

@if (MostrarConfirmacionEdicion)
{
    <div role="presentation" style="@ModalBackdropStyle">
        <section role="dialog" aria-modal="true" aria-labelledby="edit-title" style="@ModalStyle">
            <h2 id="edit-title" style="font-family:'Manrope';font-size:19px;margin:0 0 12px">Editar información enviada</h2>
            <p style="font-size:14px;color:#5E6378;line-height:1.55;margin:0">
                ¿Desea habilitar la edición de este levantamiento? Los cambios se guardarán en la información enviada a Administración.
            </p>
            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:22px">
                <button @onclick="CerrarConfirmacionEdicion" disabled="@IsSaving" style="@SecondaryButtonStyle">Cancelar</button>
                <button @onclick="ConfirmarEdicionEnviada" disabled="@IsSaving" style="@PrimaryButtonStyle">Continuar</button>
            </div>
        </section>
    </div>
}

@if (MostrarConfirmacionEnvio)
{
    <div role="presentation" style="@ModalBackdropStyle">
        <section role="dialog" aria-modal="true" aria-labelledby="send-title" style="@ModalStyle">
            <h2 id="send-title" style="font-family:'Manrope';font-size:19px;margin:0 0 12px">Enviar levantamiento a Administración</h2>
            <p style="font-size:14px;color:#5E6378;line-height:1.55;margin:0">
                ¿Está seguro de que desea enviar la información a Administración?
            </p>
            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:22px">
                <button @onclick="CerrarConfirmacionEnvio" disabled="@IsSaving" style="@SecondaryButtonStyle">Cancelar</button>
                <button @onclick="ConfirmarEnvioAsync" disabled="@IsSaving" style="@PrimaryButtonStyle">Enviar</button>
            </div>
        </section>
    </div>
}

@if (FotoAmpliada is not null)
{
    <div role="presentation" @onclick="CerrarFotoAmpliada" style="position:fixed;inset:0;z-index:1100;background:rgba(20,22,43,.82);display:flex;align-items:center;justify-content:center;padding:24px">
        <section role="dialog" aria-modal="true" aria-label="Fotografía ampliada" @onclick:stopPropagation="true" style="position:relative;max-width:95vw;max-height:92vh">
            <button type="button" @onclick="CerrarFotoAmpliada" aria-label="Cerrar fotografía ampliada" style="position:absolute;top:-14px;right:-14px;z-index:1;width:36px;height:36px;border:1px solid #D5D8E6;border-radius:50%;background:#fff;color:#25283B;font-size:20px;cursor:pointer">×</button>
            <img src="@FotoAmpliada" alt="Fotografía ampliada del levantamiento" style="display:block;max-width:95vw;max-height:88vh;object-fit:contain;border-radius:10px;box-shadow:0 20px 60px rgba(0,0,0,.35)" />
        </section>
    </div>
}

@code {
    private const int MaxPhotoSize = 5 * 1024 * 1024;
    private const string TecnicoSinAsignar = "sin-asignar";
    private static readonly string[] EstadosLevantamiento = ["Pendiente", "En proceso", "En Espera Administración", "Cancelada"];
    private const string InputStyle = "width:100%;padding:12px 13px;border:1px solid #D5D8E6;border-radius:9px;font-size:14.5px";
    private const string ReadOnlyInputStyle = "width:100%;padding:12px 13px;border:1px solid #D5D8E6;border-radius:9px;font-size:14.5px;background:#F7F8FC";
    private const string ModalBackdropStyle = "position:fixed;inset:0;z-index:1055;background:rgba(20,22,43,.48);display:flex;align-items:center;justify-content:center;padding:18px";
    private const string ModalStyle = "width:min(100%,520px);background:#fff;border-radius:14px;padding:24px;box-shadow:0 20px 60px rgba(20,22,43,.25)";
    private const string SecondaryButtonStyle = "padding:10px 15px;border:1px solid #D5D8E6;background:#fff;border-radius:8px;font-weight:700;cursor:pointer";
    private const string PrimaryButtonStyle = "padding:10px 15px;border:0;background:#1D4ED8;color:#fff;border-radius:8px;font-weight:700;cursor:pointer";
    private const string ValidationMessageStyle = "margin-top:5px;color:#A61B22;font-size:12px";

    private List<ElectroGestion.Models.Solicitud> solicitudes = new();
    private List<ElectroGestion.Models.Visita> visitas = new();
    private List<string> TiposServicio = new();
    private List<ElectroGestion.Models.Usuario> Tecnicos = new();
    private List<string> Fotos = new();
    private string? FotoAmpliada;
    private ElectroGestion.Models.Solicitud? CurrentSolicitud;
    private ElementReference TituloListado;
    private string SearchId = "";
    private string SearchCliente = "";
    private string SearchTipo = "";
    private DateTime? SearchFecha;
    private string SearchEstado = "Todos";
    private string SearchTecnicoId = "";
    private string FiltroId = "";
    private string FiltroCliente = "";
    private string FiltroTipo = "";
    private DateTime? FiltroFecha;
    private string FiltroEstado = "Todos";
    private string FiltroTecnicoId = "";
    private string FormEspacios = "";
    private string FormCargas = "";
    private string FormTension = "";
    private string FormTuberias = "";
    private string FormCableado = "";
    private string FormObservaciones = "";
    private string InitialSnapshot = "";
    private string? ErrorMessage;
    private string? FormMessage;
    private bool IsLoading;
    private bool IsSaving;
    private bool ValidacionIntentada;
    private bool SoloLectura;
    private bool EditandoEnviado;
    private bool MostrarConfirmacionCancelar;
    private bool MostrarConfirmacionEdicion;
    private bool MostrarConfirmacionEnvio;
    private bool DesplazarListadoAlInicio;

    private bool HayCambiosSinGuardar => InitialSnapshot.Length > 0 && InitialSnapshot != CrearSnapshot();

    private IEnumerable<ElectroGestion.Models.Solicitud> FilteredSolicitudes => solicitudes.Where(s =>
    {
        var visita = ObtenerVisita(s.Id);
        var estado = s.EstadoSolicitud?.Nombre ?? "Pendiente";
        return
            (string.IsNullOrWhiteSpace(FiltroId) || s.Id.ToString().Contains(FiltroId.Trim(), StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(FiltroCliente) || (s.Cliente?.Nombre ?? "").Contains(FiltroCliente.Trim(), StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(FiltroTipo) || (s.Servicio?.Nombre ?? "").Equals(FiltroTipo, StringComparison.OrdinalIgnoreCase)) &&
            (!FiltroFecha.HasValue || visita?.Fecha.Date == FiltroFecha.Value.Date) &&
            (string.IsNullOrWhiteSpace(FiltroTecnicoId) ||
                (FiltroTecnicoId == TecnicoSinAsignar
                    ? visita?.TecnicoId is null
                    : int.TryParse(FiltroTecnicoId, out var tecnicoId) && visita?.TecnicoId == tecnicoId)) &&
            (FiltroEstado == "Todos" || estado == FiltroEstado);
    });

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += OnAppStateChanged;
        if (AppState.EsGerente)
        {
            SearchEstado = "En Espera Administración";
        }

        AplicarFiltros();
        await CargarDatosAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!DesplazarListadoAlInicio || CurrentSolicitud is not null)
        {
            return;
        }

        DesplazarListadoAlInicio = false;
        await TituloListado.FocusAsync();
    }

    private async Task CargarDatosAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            solicitudes = await LevantamientoService.ObtenerSolicitudesProgramadasAsync();
            visitas = await VisitaService.ObtenerTodasAsync();
            Tecnicos = await VisitaService.ObtenerTecnicosAsync();
            TiposServicio = solicitudes
                .Select(s => s.Servicio?.Nombre)
                .Where(nombre => !string.IsNullOrWhiteSpace(nombre))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(nombre => nombre)
                .Select(nombre => nombre!)
                .ToList();

            if (CurrentSolicitud is not null)
            {
                CurrentSolicitud = solicitudes.FirstOrDefault(s => s.Id == CurrentSolicitud.Id);
                if (CurrentSolicitud is null)
                {
                    ErrorMessage = "La solicitud ya no tiene una visita activa y no se puede continuar con el levantamiento.";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudieron cargar las solicitudes programadas para levantamientos.");
            ErrorMessage = "Ocurrió un error al cargar los levantamientos. Intente actualizar la pantalla.";
            ToastService.ShowError(ErrorMessage, "Error");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private ElectroGestion.Models.Visita? ObtenerVisita(int solicitudId) =>
        visitas.FirstOrDefault(v => v.SolicitudId == solicitudId && v.Estado != "Cancelada") ??
        visitas.FirstOrDefault(v => v.SolicitudId == solicitudId);

    private async Task CambiarTecnicoAsignadoAsync(ChangeEventArgs args)
    {
        if (!AppState.EsGerente || CurrentSolicitud is null)
        {
            return;
        }

        var visita = ObtenerVisita(CurrentSolicitud.Id);
        if (visita is null)
        {
            ToastService.ShowWarning("La solicitud no tiene una visita asociada en la Agenda.", "Atención");
            return;
        }

        int? tecnicoId = null;
        var valor = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(valor))
        {
            if (!int.TryParse(valor, out var id))
            {
                ToastService.ShowWarning("El técnico seleccionado no es válido.", "Atención");
                return;
            }

            tecnicoId = id;
        }

        IsSaving = true;
        try
        {
            if (!await VisitaService.ActualizarTecnicoAsignadoAsync(visita.Id, tecnicoId))
            {
                ToastService.ShowWarning("No se pudo asignar el técnico. Verifique que no tenga otra visita en ese horario.", "Atención");
                return;
            }

            AppState.NotifyStateChanged();
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo actualizar el técnico de la visita {VisitaId}.", visita.Id);
            ToastService.ShowError("Ocurrió un error al actualizar el técnico asignado.", "Error");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private static string TextoAccion(
        ElectroGestion.Models.Solicitud solicitud,
        ElectroGestion.Models.Levantamiento? levantamiento)
    {
        var estado = solicitud.EstadoSolicitud?.Nombre ?? "Pendiente";
        if (estado == "Pendiente")
        {
            return "Iniciar levantamiento";
        }

        return estado == "En proceso" && levantamiento?.BorradorGuardado == true
            ? "Continuar levantamiento"
            : "Ver detalle";
    }

    private async Task AbrirLevantamientoAsync(ElectroGestion.Models.Solicitud solicitud)
    {
        ErrorMessage = null;
        FormMessage = null;
        var estado = solicitud.EstadoSolicitud?.Nombre ?? "Pendiente";

        if (estado is "Pendiente" or "En proceso")
        {
            IsSaving = true;
            try
            {
                if (!await LevantamientoService.IniciarAsync(solicitud.Id))
                {
                    ErrorMessage = "No se pudo iniciar el levantamiento. Verifique que la solicitud tenga una visita activa en la agenda.";
                    ToastService.ShowWarning(ErrorMessage, "Atención");
                    return;
                }

                AppState.NotifyStateChanged();
                await CargarDatosAsync();
                solicitud = solicitudes.First(s => s.Id == solicitud.Id);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "No se pudo iniciar el levantamiento de la solicitud {SolicitudId}.", solicitud.Id);
                ErrorMessage = "Ocurrió un error al iniciar el levantamiento. Intente nuevamente.";
                ToastService.ShowError(ErrorMessage, "Error");
                return;
            }
            finally
            {
                IsSaving = false;
            }
        }

        CurrentSolicitud = solicitud;
        SoloLectura = solicitud.EstadoSolicitud?.Nombre is "En Espera Administración" or "Cancelada";
        EditandoEnviado = false;
        await CargarFormularioAsync(solicitud.Levantamiento);
    }

    private async Task CargarFormularioAsync(ElectroGestion.Models.Levantamiento? levantamiento)
    {
        if (levantamiento is null && CurrentSolicitud is not null)
        {
            levantamiento = await LevantamientoService.ObtenerPorSolicitudAsync(CurrentSolicitud.Id);
        }

        FormEspacios = levantamiento?.DisponibilidadEspacios ?? "";
        FormCargas = levantamiento?.CargasElectricas ?? "";
        FormTension = levantamiento?.EstabilidadTension ?? "";
        FormTuberias = levantamiento?.RecorridoTuberias ?? "";
        FormCableado = levantamiento?.RecorridoCableado ?? "";
        FormObservaciones = levantamiento?.Observaciones ?? "";
        Fotos = JsonSerializer.Deserialize<List<string>>(levantamiento?.FotografiasJson ?? "[]") ?? new List<string>();
        InitialSnapshot = CrearSnapshot();
        ValidacionIntentada = false;
    }

    private async Task GuardarBorradorAsync()
    {
        if (CurrentSolicitud is null || SoloLectura)
        {
            return;
        }

        await GuardarDatosAsync();
        if (string.IsNullOrWhiteSpace(FormMessage))
        {
            CurrentSolicitud = null;
            await CargarDatosAsync();
            DesplazarListadoAlInicio = true;
        }
    }

    private async Task GuardarBorradorYSalirAsync()
    {
        MostrarConfirmacionCancelar = false;
        await GuardarDatosAsync();
        if (string.IsNullOrWhiteSpace(FormMessage))
        {
            CurrentSolicitud = null;
            await CargarDatosAsync();
            DesplazarListadoAlInicio = true;
        }
    }

    private async Task GuardarDatosAsync()
    {
        if (CurrentSolicitud is null)
        {
            return;
        }

        var solicitudId = CurrentSolicitud.Id;
        IsSaving = true;
        FormMessage = null;
        try
        {
            if (!await LevantamientoService.GuardarBorradorAsync(solicitudId, CrearLevantamiento()))
            {
                FormMessage = "No se pudo guardar el borrador. Verifique que el levantamiento continúe en proceso.";
                ToastService.ShowWarning(FormMessage, "Atención");
                return;
            }

            AppState.NotifyStateChanged();
            await CargarDatosAsync();
            CurrentSolicitud = solicitudes.FirstOrDefault(s => s.Id == solicitudId);
            InitialSnapshot = CrearSnapshot();
            ToastService.ShowSuccess("El levantamiento se guardó como borrador.", "Éxito");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo guardar el borrador de la solicitud {SolicitudId}.", solicitudId);
            FormMessage = "Ocurrió un error al guardar el borrador. Intente nuevamente.";
            ToastService.ShowError(FormMessage, "Error");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task GuardarCambiosEnviadosAsync()
    {
        if (CurrentSolicitud is null || !EditandoEnviado)
        {
            return;
        }

        if (!ValidarCamposRequeridos())
        {
            return;
        }

        var solicitudId = CurrentSolicitud.Id;
        IsSaving = true;
        FormMessage = null;
        try
        {
            if (!await LevantamientoService.ActualizarEnviadoAsync(solicitudId, CrearLevantamiento()))
            {
                FormMessage = "No se pudieron guardar los cambios. Verifique que el levantamiento siga en espera de Administración.";
                ToastService.ShowWarning(FormMessage, "Atención");
                return;
            }

            AppState.NotifyStateChanged();
            await CargarDatosAsync();
            CurrentSolicitud = solicitudes.FirstOrDefault(s => s.Id == solicitudId);
            await CargarFormularioAsync(CurrentSolicitud?.Levantamiento);
            EditandoEnviado = false;
            SoloLectura = true;
            ToastService.ShowSuccess("Los cambios se guardaron correctamente.", "Éxito");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudieron guardar los cambios del levantamiento enviado de la solicitud {SolicitudId}.", solicitudId);
            FormMessage = "Ocurrió un error al guardar los cambios. Intente nuevamente.";
            ToastService.ShowError(FormMessage, "Error");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void SolicitarEdicionEnviada() => MostrarConfirmacionEdicion = true;

    private void CerrarConfirmacionEdicion() => MostrarConfirmacionEdicion = false;

    private void ConfirmarEdicionEnviada()
    {
        MostrarConfirmacionEdicion = false;
        SoloLectura = false;
        EditandoEnviado = true;
        FormMessage = null;
        InitialSnapshot = CrearSnapshot();
        ToastService.ShowToast(ToastType.Info, "Edición habilitada", "Puede modificar la información del levantamiento.");
    }

    private void SolicitarEnvio()
    {
        FormMessage = null;
        if (!ValidarCamposRequeridos())
        {
            return;
        }

        MostrarConfirmacionEnvio = true;
    }

    private async Task ConfirmarEnvioAsync()
    {
        if (CurrentSolicitud is null)
        {
            return;
        }

        var solicitudId = CurrentSolicitud.Id;
        IsSaving = true;
        FormMessage = null;
        try
        {
            if (!await LevantamientoService.EnviarAAdministracionAsync(solicitudId, CrearLevantamiento()))
            {
                FormMessage = "No se pudo enviar el levantamiento. Verifique los datos obligatorios y el estado actual de la solicitud.";
                ToastService.ShowWarning(FormMessage, "Atención");
                return;
            }

            MostrarConfirmacionEnvio = false;
            AppState.NotifyStateChanged();
            CurrentSolicitud = null;
            await CargarDatosAsync();
            DesplazarListadoAlInicio = true;
            ToastService.ShowSuccess("El levantamiento se envió a Administración.", "Éxito");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo enviar el levantamiento de la solicitud {SolicitudId} a Administración.", solicitudId);
            FormMessage = "Ocurrió un error al enviar el levantamiento. Intente nuevamente.";
            ToastService.ShowError(FormMessage, "Error");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private bool ValidarCamposRequeridos()
    {
        ValidacionIntentada = true;
        return !MostrarErrorRequerido(FormEspacios) &&
            !MostrarErrorRequerido(FormCargas) &&
            !MostrarErrorRequerido(FormTension) &&
            !MostrarErrorRequerido(FormTuberias) &&
            !MostrarErrorRequerido(FormCableado);
    }

    private bool MostrarErrorRequerido(string? valor) =>
        ValidacionIntentada && string.IsNullOrWhiteSpace(valor);

    private ElectroGestion.Models.Levantamiento CrearLevantamiento() => new()
    {
        SolicitudId = CurrentSolicitud!.Id,
        DisponibilidadEspacios = FormEspacios,
        CargasElectricas = FormCargas,
        EstabilidadTension = FormTension,
        RecorridoTuberias = FormTuberias,
        RecorridoCableado = FormCableado,
        Observaciones = FormObservaciones,
        FotografiasJson = JsonSerializer.Serialize(Fotos)
    };

    private string CrearSnapshot() => JsonSerializer.Serialize(new
    {
        FormEspacios,
        FormCargas,
        FormTension,
        FormTuberias,
        FormCableado,
        FormObservaciones,
        Fotos
    });

    private async Task CancelarEdicionAsync()
    {
        FormMessage = null;
        if (EditandoEnviado)
        {
            if (HayCambiosSinGuardar)
            {
                MostrarConfirmacionCancelar = true;
                return;
            }

            EditandoEnviado = false;
            SoloLectura = true;
            return;
        }

        if (SoloLectura || !HayCambiosSinGuardar)
        {
            CurrentSolicitud = null;
            SoloLectura = false;
            EditandoEnviado = false;
            DesplazarListadoAlInicio = true;
            return;
        }

        MostrarConfirmacionCancelar = true;
    }

    private void CerrarConfirmacionCancelar()
    {
        MostrarConfirmacionCancelar = false;
        ToastService.ShowToast(ToastType.Info, "Levantamiento", "Continúa editando el formulario.");
    }

    private async Task DescartarCambiosEnviados()
    {
        MostrarConfirmacionCancelar = false;
        EditandoEnviado = false;
        SoloLectura = true;
        await CargarFormularioAsync(CurrentSolicitud?.Levantamiento);
        ToastService.ShowWarning("Los cambios se descartaron.", "Edición cancelada");
    }

    private Task SalirSinGuardarAsync()
    {
        MostrarConfirmacionCancelar = false;
        CurrentSolicitud = null;
        SoloLectura = false;
        DesplazarListadoAlInicio = true;
        ToastService.ShowToast(ToastType.Info, "Levantamiento", "Volvió a la lista principal.");
        ToastService.ShowWarning("Salió sin guardar los cambios.", "Cambios descartados");
        return Task.CompletedTask;
    }

    private void CerrarConfirmacionEnvio() => MostrarConfirmacionEnvio = false;

    private async Task AgregarFotosAsync(InputFileChangeEventArgs args)
    {
        if (SoloLectura)
        {
            return;
        }

        FormMessage = null;
        var seleccionadas = args.GetMultipleFiles(args.FileCount);
        foreach (var foto in seleccionadas)
        {
            if (!foto.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                FormMessage = "Solo se permiten archivos de imagen.";
                return;
            }

            if (foto.Size > MaxPhotoSize)
            {
                FormMessage = $"La imagen {foto.Name} supera el máximo de 5 MB.";
                return;
            }

            try
            {
                await using var stream = foto.OpenReadStream(MaxPhotoSize);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                Fotos.Add($"data:{foto.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}");
            }
            catch (IOException ex)
            {
                Logger.LogWarning(ex, "No se pudo leer la fotografía {NombreArchivo}.", foto.Name);
                FormMessage = $"No se pudo leer la imagen {foto.Name}. Intente seleccionarla nuevamente.";
                return;
            }
        }
    }

    private void EliminarFoto(string foto) => Fotos.Remove(foto);
    private void AmpliarFoto(string foto) => FotoAmpliada = foto;
    private void CerrarFotoAmpliada() => FotoAmpliada = null;

    private void AplicarFiltros()
    {
        FiltroId = SearchId;
        FiltroCliente = SearchCliente;
        FiltroTipo = SearchTipo;
        FiltroFecha = SearchFecha;
        FiltroEstado = SearchEstado;
        FiltroTecnicoId = SearchTecnicoId;
    }

    private void OnAppStateChanged() => _ = InvokeAsync(CargarDatosAsync);

    public void Dispose() => AppState.OnChange -= OnAppStateChanged;
}
