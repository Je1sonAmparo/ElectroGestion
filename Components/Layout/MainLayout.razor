@inherits LayoutComponentBase
@implements IDisposable
@inject ElectroGestion.Services.AppStateService AppState
@inject NavigationManager NavManager
@inject BlazorBootstrap.ToastService ToastService

@if (!AppState.IsAuthenticated)
{
    <ElectroGestion.Components.Pages.Compartidas.Login />
}
else
{
    <div style="min-height:100vh;display:flex">
        <aside class="@(SidebarCollapsed ? "is-collapsed" : "is-open")"
          style="width:@(SidebarCollapsed ? "80px" : "250px");flex:0 0 @(SidebarCollapsed ? "80px" : "250px");background:#fff;border-right:1px solid #E3E5EE;display:flex;flex-direction:column;padding:24px 0;position:sticky;top:0;height:100vh;transition:width 0.3s cubic-bezier(0.4, 0, 0.2, 1)">
          <button @onclick="ToggleSidebar" class="sidebar-toggle-btn"
            style="position:absolute;top:28px;right:-14px;width:28px;height:28px;border:1px solid #E3E5EE;background:#fff;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#6B7085;z-index:10;box-shadow:0 2px 5px rgba(0,0,0,0.05)">
            @if (SidebarCollapsed)
            {
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.3"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18l6-6-6-6" />
              </svg>
            }
            else
            {
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.3"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            }
          </button>
          
          <div style="padding:32px 0 28px;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:3px;overflow:hidden;width:100%;cursor:pointer" @onclick='() => NavManager.NavigateTo("/")'>
            @if (!SidebarCollapsed)
            {
              <div style="display:flex;align-items:center;justify-content:center;width:100%;padding-left:14px;padding-right:14px">
                <svg viewBox="10 0 74 60" width="42" height="34" style="flex:0 0 auto">
                  <defs>
                    <mask id="bolt-mask-sidebar-row">
                      <rect width="100" height="60" fill="white" />
                      <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="black" stroke="black" stroke-width="2.5"
                        stroke-linejoin="round" />
                    </mask>
                  </defs>
                  <text x="10" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#1D4ED8" letter-spacing="-1.5">E</text>
                  <text x="44" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#F59E0B" mask="url(#bolt-mask-sidebar-row)" letter-spacing="-1.5">G</text>
                  <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="#F59E0B" stroke="#F59E0B" stroke-width="0" stroke-linejoin="round" />
                </svg>
                <div style="font-family:'Manrope';font-weight:900;font-size:20px;letter-spacing:-0.5px;white-space:nowrap;line-height:1;margin-top:2px;margin-left:4px">
                  <span style="color:#1D4ED8">ELECTRO</span><span style="color:#334155">GESTIÓN</span>
                </div>
              </div>
            }
            else
            {
              <div style="display:flex;align-items:center;justify-content:center;width:100%">
                <svg viewBox="10 0 74 60" width="52" height="42">
                  <defs>
                    <mask id="bolt-mask-sidebar-col">
                      <rect width="100" height="60" fill="white" />
                      <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="black" stroke="black" stroke-width="2.5" stroke-linejoin="round" />
                    </mask>
                  </defs>
                  <text x="10" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#1D4ED8" letter-spacing="-1.5">E</text>
                  <text x="44" y="48" font-family="'Manrope', sans-serif" font-weight="900" font-size="52" fill="#F59E0B" mask="url(#bolt-mask-sidebar-col)" letter-spacing="-1.5">G</text>
                  <path d="M46 5 L34 32 H46 L38 58 L54 28 H42 Z" fill="#F59E0B" stroke="#F59E0B" stroke-width="0" stroke-linejoin="round" />
                </svg>
              </div>
            }
          </div>

          <nav style="display:flex;flex-direction:column;gap:4px;padding:0 12px;overflow-y:auto">
            @foreach (var item in GetNavItems())
            {
                var isActive = IsActiveRoute(item.Href);
                <NavLink class="@($"nav-item-btn {(isActive ? "active" : "")}")" 
                         href="@item.Href" 
                         Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" 
                         style="@($"position:relative;display:flex;align-items:center;gap:12px;width:100%;text-align:left;border:0;cursor:pointer;padding:12px {(SidebarCollapsed ? "16px" : "14px")};border-radius:10px;font-size:14.5px;font-weight:{(isActive ? "800" : "600")};background:{(isActive ? "#EDEBFF" : "transparent")};color:{(isActive ? "#1D4ED8" : "#4A4E63")};transition:all 0.2s;text-decoration:none;")"
                         title="@(SidebarCollapsed ? item.Label : "")">
                    <div style="position:relative;display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex:0 0 24px">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="position:relative;z-index:1;display:block;stroke: @(isActive ? "#1D4ED8" : "#6B7085")">
                            <path class="path-d1" d="@item.D1" stroke="@(isActive ? "#1D4ED8" : "#6B7085")" fill="none"></path>
                            @if (!string.IsNullOrEmpty(item.D2))
                            {
                                <path class="path-d2" d="@item.D2" stroke="@(isActive ? "#F59E0B" : "#A1A5B7")" fill="none"></path>
                            }
                        </svg>
                    </div>
                    @if (!SidebarCollapsed)
                    {
                        <span style="white-space:nowrap">@item.Label</span>
                    }
                </NavLink>
            }
          </nav>

          <div style="margin-top:auto;border-top:1px solid #EFF0F6;padding-top:18px;width:100%">
            @if (!SidebarCollapsed)
            {
              <div style="display:flex;align-items:center;gap:11px;padding-left:26px;padding-right:20px;width:100%;box-sizing:border-box">
                <div style="width:38px;height:38px;border-radius:50%;background:#1D4ED8;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-family:'Manrope';flex:0 0 38px">
                  @(AppState.Session?.Inicial ?? "U")</div>
                <div style="min-width:0">
                  <div style="font-weight:700;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                    @(AppState.Session?.Nombre ?? "Usuario")</div>
                  <div style="font-size:12px;color:#8B90A3">@(AppState.Session?.Rol ?? "Rol")</div>
                </div>
              </div>
              <button @onclick="() => showLogoutConfirm = true" class="logout-btn" style="margin:12px 20px 0;width:calc(100% - 40px);padding:9px;border:1px solid #E3E5EE;background:#fff;border-radius:9px;font-size:13px;font-weight:700;color:#C4141B;cursor:pointer">Cerrar sesión</button>
            }
            else
            {
              <div style="display:flex;align-items:center;justify-content:center;width:100%">
                <div style="width:38px;height:38px;border-radius:50%;background:#1D4ED8;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-family:'Manrope';flex:0 0 38px"
                  title="@(AppState.Session?.Nombre ?? "Usuario")">@(AppState.Session?.Inicial ?? "U")</div>
              </div>
              <button @onclick="() => showLogoutConfirm = true" class="logout-btn" title="Cerrar sesión"
                style="margin:12px 12px 0;padding:9px;border:1px solid #E3E5EE;background:#fff;border-radius:9px;font-size:13px;font-weight:700;color:#C4141B;cursor:pointer;display:flex;align-items:center;justify-content:center">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
                  <path d="M16 17l5-5-5-5"></path>
                  <path d="M21 12H9"></path>
                </svg>
              </button>
            }
          </div>
        </aside>
        
        <div class="sidebar-backdrop" @onclick="ToggleSidebar"></div>

        <main style="flex:1;min-width:0;padding:32px 38px 60px" class="resp-main">
          <CascadingValue Value="this">
            @Body
          </CascadingValue>
        </main>
    </div>

    @* Confirmation Modal for Logout *@
    @if (showLogoutConfirm)
    {
        <div style="position:fixed;inset:0;background:rgba(14,16,40,.5);display:flex;align-items:center;justify-content:center;padding:20px;z-index:9999">
            <div style="background:#fff;border-radius:16px;max-width:420px;width:100%;padding:26px;animation:tin .18s ease-out;box-shadow:0 20px 40px rgba(0,0,0,0.15)">
                <div style="font-family:'Manrope';font-weight:800;font-size:20px;color:#14162B">Cerrar sesión</div>
                <div style="color:#4A4E63;font-size:14.5px;margin-top:10px;line-height:1.55">¿Deseas cerrar la sesión actual? Los cambios guardados se mantienen.</div>
                <div style="display:flex;justify-content:flex-end;gap:11px;margin-top:22px">
                    <button @onclick="() => showLogoutConfirm = false"
                        style="padding:11px 18px;border:1px solid #D5D8E6;background:#fff;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer;color:#4A4E63">Cancelar</button>
                    <button @onclick="ConfirmLogout"
                        style="padding:11px 20px;border:0;background:#C4141B;color:#fff;border-radius:9px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Manrope'">Cerrar sesión</button>
                </div>
            </div>
        </div>
    }

}

@* BlazorBootstrap Toasts Container Matching XML *@
<Toasts class="toast-container p-0 m-0" AutoHide="true" Delay="6000" Placement="ToastsPlacement.TopRight" />

@code {
    private bool SidebarCollapsed { get; set; } = false;
    private bool showLogoutConfirm = false;

    public record NavItem(string Href, string Label, string D1, string D2);

    protected override void OnInitialized()
    {
        AppState.OnChange += OnAppStateChanged;
        NavManager.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= OnAppStateChanged;
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private async void OnAppStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    private bool IsActiveRoute(string href)
    {
        var rel = NavManager.ToBaseRelativePath(NavManager.Uri);
        var path = rel.Split('?')[0].Trim('/');
        if (string.IsNullOrEmpty(path)) path = "/";
        else path = "/" + path;

        if (href == "/") return path == "/";
        return path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<NavItem> GetNavItems()
    {
        if (AppState.EsGerente)
        {
            return new List<NavItem>
            {
                new("/", "Inicio", "M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z", "M9 22V12h6v10"),
                new("/solicitudes", "Solicitudes", "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6", "M9 9a2 2 0 1 1 4 0 2 2 0 0 1-4 0 M8 13h8 M8 17h8"),
                new("/agenda", "Agenda", "M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z M3 10h18", "M16 2v4 M8 2v4 M8 14h2 M14 14h2 M8 18h2 M14 18h2"),
                new("/levantamientos", "Levantamientos", "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 21v2", "M9.5 14.5l2-5 4-1-2 5z"),
                new("/cotizaciones", "Cotizaciones", "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z", "M14 2v6h6 M8 10h8 M8 14h8 M8 18h5"),
                new("/ordenes", "Órdenes", "M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z", "M11 11h5 M11 15h5 M11 19h5 M7 11l1.5 1.5 2-2 M7 15l1.5 1.5 2-2 M7 19l1.5 1.5 2-2"),
                new("/clientes", "Clientes", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M7.5 7a4 4 0 1 1 8 0 4 4 0 0 1-8 0", "M22 21v-2a4 4 0 0 0-3-3.87 M15 3.13a4 4 0 0 1 0 7.75"),
                new("/cobros", "Cobros", "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18", "M12 7v10 M8.5 13.5h7"),
                new("/servicios", "Servicios", "M12 3.5L3.5 8v12.5h17V8z M12 3.5v5", "M9 14.5h6 M9 17.5h6"),
                new("/inventario", "Inventario", "M6 4h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M9 4v4h6V4", "M15 15h5v5h-5z M16 15v-2h3v2"),
                new("/proveedores", "Proveedores", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M7.5 7a4 4 0 1 1 8 0 4 4 0 0 1-8 0 M22 21v-2a4 4 0 0 0-3-3.87", "M16 16a4 4 0 1 1 8 0 4 4 0 0 1-8 0 M20 14.5a1.5 1.5 0 0 0-3 0v.5l1.5.5v1 M20 18h0"),
                new("/reportes", "Reportes", "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6", "M8 18v-4 M12 18v-8 M16 18v-6 M7 12l4-4 3 3 4-4"),
                new("/historial", "Historial", "M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17", "M12 7.6V12l3.4 2.1")
            };
        }
        else
        {
            return new List<NavItem>
            {
                new("/", "Inicio", "M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z", "M9 22V12h6v10"),
                new("/solicitudes", "Solicitudes", "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6", "M9 9a2 2 0 1 1 4 0 2 2 0 0 1-4 0 M8 13h8 M8 17h8"),
                new("/agenda", "Agenda", "M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z M3 10h18", "M16 2v4 M8 2v4 M8 14h2 M14 14h2 M8 18h2 M14 18h2"),
                new("/levantamientos", "Levantamientos", "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 21v2", "M9.5 14.5l2-5 4-1-2 5z"),
                new("/ordenes", "Órdenes de trabajo", "M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z", "M11 11h5 M11 15h5 M11 19h5 M7 11l1.5 1.5 2-2 M7 15l1.5 1.5 2-2 M7 19l1.5 1.5 2-2"),
                new("/clientes", "Clientes", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M7.5 7a4 4 0 1 1 8 0 4 4 0 0 1-8 0", "M22 21v-2a4 4 0 0 0-3-3.87 M15 3.13a4 4 0 0 1 0 7.75"),
                new("/historial", "Historial", "M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17", "M12 7.6V12l3.4 2.1")
            };
        }
    }

    public void ToggleSidebar()
    {
        SidebarCollapsed = !SidebarCollapsed;
        StateHasChanged();
    }

    private void ConfirmLogout()
    {
        showLogoutConfirm = false;
        AppState.Logout();
        ToastService.ShowSuccess("Sesión cerrada correctamente.", "Éxito");
        NavManager.NavigateTo("/");
    }
}
