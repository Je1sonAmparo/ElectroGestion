@inject ElectroGestion.Services.AppStateService AppState
@inject ElectroGestion.Services.AutenticacionService Autenticacion
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(ElectroGestion.Components.Pages.NotFound)">
    <Found Context="routeData">
        @if (AppState.EsAdministrador && routeData.PageType != typeof(ElectroGestion.Components.Pages.Admin.Recuperacion))
        {
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:28px;max-width:680px">
                    <h1 style="font-family:'Manrope';font-weight:800;font-size:24px;color:#14162B">Acceso restringido</h1>
                    <p style="color:#6B7085;margin:0">Esta cuenta solo tiene acceso al módulo de recuperación.</p>
                </div>
            </LayoutView>
        }
        else if (!AppState.EsGerente && routeData.PageType == typeof(ElectroGestion.Components.Pages.Gerente.Cotizaciones))
        {
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div style="background:#fff;border:1px solid #E3E5EE;border-radius:14px;padding:28px;max-width:680px">
                    <h1 style="font-family:'Manrope';font-weight:800;font-size:24px;color:#14162B">Acceso restringido</h1>
                    <p style="color:#6B7085;margin:0">Solo el gerente puede ver cotizaciones.</p>
                </div>
            </LayoutView>
        }
        else
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        }
    </Found>
</Router>

@code {
    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (estado.User.Identity?.IsAuthenticated != true ||
            !int.TryParse(estado.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id)) return;
        var usuario = await Autenticacion.ObtenerUsuarioAsync(id);
        if (usuario is not null) AppState.Login(usuario);
    }
}
